    "Coins, upgrades and the ring network start over. This cannot be undone." : {
      "comment" : "Reset confirmation message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Münzen, Upgrades und das Ringnetz beginnen von vorn. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las monedas, las mejoras y la red de anillos empiezan de cero. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pièces, les améliorations et le réseau d'anneaux repartent de zéro. Impossible d'annuler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monete, potenziamenti e rete di anelli ripartono da zero. L'operazione non si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コイン、強化、リング網が最初からになります。元に戻すことはできません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moedas, melhorias e a rede de anéis voltam do zero. Isso não pode ser desfeito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金币、升级和轨道环网都将从头开始。此操作无法撤销。"
          }
        }
      }
    },
