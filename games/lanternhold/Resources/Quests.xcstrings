    "report.beacon_statues.c1" : {
      "comment" : "Sending 11 (stair), report choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mauer sagen, was sich dort regt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell the wall what moves on the road."
          }
        }
      }
    },
    "report.beacon_statues.c2" : {
      "comment" : "Sending 11 (stair), report choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dem Saal sagen, was dort steht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell the hall what stands on the road."
          }
        }
      }
    },
    "report.beacon_statues.r1" : {
      "comment" : "Sending 11 (stair), reaction to choice 1 (days 4 to 14: fewer brutes tonight).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Späher geht von Posten zu Posten. Heute Nacht weiß jeder Bogenschütze, woher die Unholde kommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scout walks the wall from post to post. Tonight every archer knows which way the brutes will come."
          }
        }
      }
    },
    "report.beacon_statues.r1b" : {
      "comment" : "Sending 11 (stair), reaction to choice 1 after day 14.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Späher geht von Posten zu Posten. Bei Tag liegt der Weg still, doch die Mauer schläft ruhiger, seit sie es weiß."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scout walks the wall from post to post. The road lies still by day, but the wall sleeps better for knowing."
          }
        }
      }
    },
    "report.beacon_statues.r2" : {
      "comment" : "Sending 11 (stair), reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei sechzig wird es still im Saal. Odile schlägt das Familienbuch auf und zählt die Burgherren noch einmal mit dem Finger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hall goes quiet at sixty. Odile opens the family book and counts the lords again with her finger."
          }
        }
      }
    },
    "report.beacon_statues.text" : {
      "comment" : "Sending 11 (from the stair), the scout's report.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laterne {lantern} ist heim. Von der Treppe aus zählte ich die steinernen Herren am Moorweg, jeder mit seiner Steinlaterne, alle uns zugewandt. Sechzig, und ein leerer Sockel. Das Buch sagt vierzig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lantern {lantern} is home. From the stair I counted the stone lords along the Moor Road, each with its stone lantern, all facing us. Sixty, and one empty plinth. The book says forty."
          }
        }
      }
    },
    "report.beacon_statues_lamp.c1" : {
      "comment" : "Sending 11 (lamp room), report choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mauer sagen, was sich dort regt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell the wall what moves on the road."
          }
        }
      }
    },
    "report.beacon_statues_lamp.c2" : {
      "comment" : "Sending 11 (lamp room), report choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dem Saal von dem Licht erzählen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell the hall about the light."
          }
        }
      }
    },
    "report.beacon_statues_lamp.r1" : {
      "comment" : "Sending 11 (lamp room), reaction to choice 1 (days 4 to 14: fewer brutes tonight).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Späher geht von Posten zu Posten. Heute Nacht weiß jeder Bogenschütze, woher die Unholde kommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scout goes from post to post. Tonight every archer knows which way the brutes will come."
          }
        }
      }
    },
    "report.beacon_statues_lamp.r1b" : {
      "comment" : "Sending 11 (lamp room), reaction to choice 1 after day 14.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Späher geht von Posten zu Posten. Bei Tag regt sich nichts auf dem Weg, doch jeder Bogenschütze blickt jetzt nach Westen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scout goes from post to post. Nothing moves on the road by day, but every archer now looks west."
          }
        }
      }
    },
    "report.beacon_statues_lamp.r2" : {
      "comment" : "Sending 11 (lamp room), reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Weile spricht niemand im Saal. Mutter Hesper sieht ins Herdfeuer, das sich nach Westen neigt, und schweigt ebenfalls."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody in the hall speaks for a while. Mother Hesper looks at the hearth, which leans west, and says nothing either."
          }
        }
      }
    },
    "report.beacon_statues_lamp.text" : {
      "comment" : "Sending 11 (from the lamp room), the scout's report.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laterne {lantern} ist heim, und ich hatte nicht mehr daran geglaubt. Von der Lampenstube sieht man über die sechzig Statuen hinaus: den Rand des Moors und weit draußen ein niedriges Licht, das nie flackert. Es brannte die ganze Nacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lantern {lantern} is home, and I did not think it would be. From the lamp room you see past the sixty statues: the moor's edge, and far out one low light that never flickers. It burned all night."
          }
        }
      }
    },
    "report.highcairn_rounded.c1" : {
      "comment" : "Sending 5 (rounded count), report choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nehmen, was er schickt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take what he sends."
          }
        }
      }
    },
    "report.highcairn_rounded.c2" : {
      "comment" : "Sending 5 (rounded count), report choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die wahre Zählung nachschicken"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send the true count after it."
          }
        }
      }
    },
    "report.highcairn_rounded.r1" : {
      "comment" : "Sending 5 (rounded count), reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Bogenschützin reitet aus Highcairn ein. Sie hält den Blick auf der Straße und ihre eigene Zählung im Kopf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One archer rides in from Highcairn. She keeps her eyes on the road and her own count in her head."
          }
        }
      }
    },
    "report.highcairn_rounded.r2" : {
      "comment" : "Sending 5 (rounded count), reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Reiter bringt die wahre Zählung im Galopp nach Norden. Hild Varn liest sie, bevor er reitet, und nickt einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rider takes the true Count north at a gallop. Hild Varn reads it before he goes and nods once."
          }
        }
      }
    },
    "report.highcairn_rounded.text" : {
      "comment" : "Sending 5 (rounded count), the rider's report.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laterne {lantern} ist heim. Lord Harrow las unsere geschönte Zählung und zählte dann selbst die Laternen an unseren Sätteln. Lange sagte er nichts. Dann schickte er einen Bogenschützen mit uns zurück, nicht zwei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lantern {lantern} is home. Lord Harrow read our rounded Count, then counted the lanterns on our saddles himself. He said nothing for a long time. Then he sent one archer back with us, not two."
          }
        }
      }
    },
    "report.highcairn_true.c1" : {
      "comment" : "Sending 5 (true count), report choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die zweite Hälfte des Aufgebots holen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take the second half of the levy."
          }
        }
      }
    },
    "report.highcairn_true.c2" : {
      "comment" : "Sending 5 (true count), report choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bögen lassen, um Hilds Wort bitten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave the bows. Ask for Hild's word."
          }
        }
      }
    },
    "report.highcairn_true.r1" : {
      "comment" : "Sending 5 (true count), reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Bogenschützen aus Highcairn reiten zu Mittag ein, graue Steinmale auf den Mänteln. Hild Varn stellt sie selbst auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two of Highcairn's archers ride in at noon, grey cairns on their cloaks. Hild Varn posts them herself."
          }
        }
      }
    },
    "report.highcairn_true.r2" : {
      "comment" : "Sending 5 (true count), reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Highcairn behält seine Bögen für die eigenen Hügel. Hild Varn schreibt nachts an ihren Vater und lässt Euch den Brief zuerst lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Highcairn keeps its bows for its own hills. Hild Varn writes to her father that night and lets you read it first."
          }
        }
      }
    },
    "report.highcairn_true.text" : {
      "comment" : "Sending 5 (true count), the rider's report.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laterne {lantern} ist heim. Lord Harrow las unsere Zählung zweimal und zählte dann selbst die Laternen an unseren Sätteln. „{Der Laternenanzünder|Die Laternenanzünderin} kann zählen“, sagte er. Der Rest des Aufgebots wartet an seinem Tor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lantern {lantern} is home. Lord Harrow read our Count twice, then counted the lanterns on our saddles himself. “The lamplighter can count,” he said. The rest of the levy waits at his gate."
          }
        }
      }
    },
    "report.lantern_lost.c1" : {
      "comment" : "Lost lantern, choice 1 (mourning kept).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Haken leer lassen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave the hook empty."
          }
        }
      }
    },
    "report.lantern_lost.c2" : {
      "comment" : "Lost lantern, choice 2 (the empty hook hidden).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram eine leere Laterne hängen lassen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have Bram hang a blank lantern."
          }
        }
      }
    },
    "report.lantern_lost.r1" : {
      "comment" : "Lost lantern, reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Dämmerung liest Mutter Hesper die Namen an der Flamme. Der Haken bleibt leer, und der Saal geht langsam daran vorbei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At dusk Mother Hesper reads the names at the Flame. The hook stays bare, and the hall walks past it slowly."
          }
        }
      }
    },
    "report.lantern_lost.r2" : {
      "comment" : "Lost lantern, reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram hängt eine Laterne ohne Nummer an den Haken. Vom Saal aus sieht es keiner. Brannock schon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram hangs a lantern with no number on the hook. From the hall nobody can tell. Brannock can."
          }
        }
      }
    },
    "report.lantern_lost.text" : {
      "comment" : "Brannock at the hook rail when a lantern did not come home. {lantern} is its number in digits.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laterne {lantern} kam nicht heim. Die Wache am Tor hat bis zum hellen Tag gewartet. Ich habe die Namen für die Flamme aufgeschrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lantern {lantern} did not come home. The watch at the gate waited until full light. I have written the names down for the Flame."
          }
        }
      }
    },
    "report.oil_round.c1" : {
      "comment" : "Sending 1, report choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Gasse damit erleuchten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light every lane with it."
          }
        }
      }
    },
    "report.oil_round.c2" : {
      "comment" : "Sending 1, report choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Mauer aufheben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it for the wall."
          }
        }
      }
    },
    "report.oil_round.r1" : {
      "comment" : "Sending 1, reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zur Dämmerung leuchtet Tallowford bis zur letzten Tür. Ein Kind malt eine Laterne ans Tor, und keiner wischt sie fort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By dusk Tallowford glows to the last door. A child chalks a lantern on the gate, and nobody washes it off."
          }
        }
      }
    },
    "report.oil_round.r2" : {
      "comment" : "Sending 1, reaction to choice 2 (days 4 to 14: fewer sootlings tonight).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fässer gehen hinauf auf den Wehrgang. Heute Nacht brennen die Feuerschalen hoch, und der Ruß hält Abstand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The barrels go up to the wall walk. Tonight the braziers burn high, and the soot keeps its distance."
          }
        }
      }
    },
    "report.oil_round.r2b" : {
      "comment" : "Sending 1, reaction to choice 2 on days outside 4 to 14 (the next brazier is free).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fässer warten an der Mauer. Brannock sagt, die nächste Feuerschale brennt mit Lichtzieheröl und kostet Euch nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The barrels wait by the wall. Brannock says the next brazier will burn on chandlers' oil and cost you nothing."
          }
        }
      }
    },
    "report.oil_round.text" : {
      "comment" : "Sending 1, Pip's report at the table. {lantern} is the lantern's number in digits.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laterne {lantern} ist heim, Eure Dochtheit, und ich auch, worauf keiner gewettet hat. Zwei Fässer neues Öl, ein Karren, ein Narr mit Blasen. Die Lichtzieher fragen, wo es brennen soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lantern {lantern} is home, Your Wickship, and so am I, which nobody bet on. Two barrels of new oil, one cart, one fool with blisters. The chandlers ask where it should burn."
          }
        }
      }
    },
