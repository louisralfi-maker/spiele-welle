{
  "sourceLanguage" : "en",
  "strings" : {
    "errand.beacon_statues.hook1" : {
      "comment" : "Sending 11: first line of its slip (statues of past lords along the road beyond the beacon).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von der Treppe des Leuchtfeuers sieht man die steinernen Herren an der Straße."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From the beacon's stair you see the stone lords on the road."
          }
        }
      }
    },
    "errand.beacon_statues.hook2" : {
      "comment" : "Sending 11: second line of its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit dem Dunklen Jahr hat sie keiner gezählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody has counted them since the Dark Year."
          }
        }
      }
    },
    "errand.beacon_statues.o1" : {
      "comment" : "Sending 11, order 1 (Odile's seal, no risk).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von der Treppe aus zählen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch from the stair."
          }
        }
      }
    },
    "errand.beacon_statues.o2" : {
      "comment" : "Sending 11, order 2 (few come back).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis in die Lampenstube steigen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Climb to the lamp room."
          }
        }
      }
    },
    "errand.beacon_statues.title" : {
      "comment" : "Sending 11: title of its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt die Statuen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Count the Statues"
          }
        }
      }
    },
    "errand.beaconfoot_smoke.hook1" : {
      "comment" : "Sending 10: first line (Beaconfoot, the keepers' hamlet at the Throat's mouth).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wache sah Rauch unter dem dunklen Leuchtfeuer, bei Beaconfoot."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The watch saw smoke under the dark beacon, at Beaconfoot."
          }
        }
      }
    },
    "errand.beaconfoot_smoke.hook2" : {
      "comment" : "Sending 10: second line.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dort kocht noch jemand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somebody is still cooking there."
          }
        }
      }
    },
    "errand.beaconfoot_smoke.o1" : {
      "comment" : "Sending 10: order.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von der Straße aus schauen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look from the road."
          }
        }
      }
    },
    "errand.beaconfoot_smoke.o2" : {
      "comment" : "Sending 10: order.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In die Höhlen gehen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go into the caves."
          }
        }
      }
    },
    "errand.beaconfoot_smoke.title" : {
      "comment" : "Sending 10: title on its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rauch bei Beaconfoot"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smoke at Beaconfoot"
          }
        }
      }
    },
    "errand.ford_planks.hook1" : {
      "comment" : "Sending 3: first line of its slip (the Wend is the valley's river).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Furt über die Wend holt sich jedes Frühjahr einen Karren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ford over the Wend takes a cart every spring."
          }
        }
      }
    },
    "errand.ford_planks.hook2" : {
      "comment" : "Sending 3: second line of its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stümpfe der alten Brücke stehen noch. Es fehlen nur Planken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The old bridge's stumps still stand. They want planks."
          }
        }
      }
    },
    "errand.ford_planks.title" : {
      "comment" : "Sending 3: title on its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planken auf die Stümpfe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planks on the Stumps"
          }
        }
      }
    },
    "errand.goldenacre_cart.hook1" : {
      "comment" : "Sending 6: first line (Lorenz Pell is House Oxmoor's steward).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek trägt Pells Briefe nach Osten und liest sie unterwegs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek carries Pell's letters east and reads them on the way."
          }
        }
      }
    },
    "errand.goldenacre_cart.hook2" : {
      "comment" : "Sending 6: second line.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebt ihm unsere mit, dann liest er ihre."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send ours with him, and he will read theirs."
          }
        }
      }
    },
    "errand.goldenacre_cart.o1" : {
      "comment" : "Sending 6: order (the thirty gold of Oxmoor's loan).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Darlehen zurückzahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay the loan back."
          }
        }
      }
    },
    "errand.goldenacre_cart.o2" : {
      "comment" : "Sending 6: order (the Lamp Tithe every house owes).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Liste des Lichtzehnts mitgeben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carry the lamp tithe list."
          }
        }
      }
    },
    "errand.goldenacre_cart.title" : {
      "comment" : "Sending 6: title on its slip (Marek, the travelling merchant).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mareks Karren nach Goldenacre"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek's Cart to Goldenacre"
          }
        }
      }
    },
    "errand.greybell_bell.hook1" : {
      "comment" : "Sending 9: first line (Lord Edric the Shut, year 412, the Dark Year).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burgherr Edric schickte unsere erste Glocke fort. Sie läutete von selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lord Edric sent our first bell away. It rang by itself."
          }
        }
      }
    },
    "errand.greybell_bell.hook2" : {
      "comment" : "Sending 9: second line (Dame Orla Lorn of Greybell).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dame Orla sagt, es ist Zeit, dass sie heimkommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dame Orla says it is time it came home."
          }
        }
      }
    },
    "errand.greybell_bell.title" : {
      "comment" : "Sending 9: title on its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die erste Glocke"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The First Bell"
          }
        }
      }
    },
    "errand.hemmet_sentence.hook1" : {
      "comment" : "Sending 4: first line of its slip (Finch, the bard; the Returned each say one thing).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finch schreibt auf, was die Heimgekehrten sagen, Wort für Wort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finch writes down what the Returned say, word for word."
          }
        }
      }
    },
    "errand.hemmet_sentence.hook2" : {
      "comment" : "Sending 4: second line of its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemmet an der Mühle sagt seit vierzig Jahren nur einen Satz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemmet at the mill has said one thing for forty years."
          }
        }
      }
    },
    "errand.hemmet_sentence.title" : {
      "comment" : "Sending 4: title on its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemmets Satz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemmet's Sentence"
          }
        }
      }
    },
    "errand.highcairn_count.hook1" : {
      "comment" : "Sending 5: first line of its slip (Highcairn's levy comes in two halves; the second for the castle's Count).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lord Varn schickt die andere Hälfte, sobald er unsere Zählung hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lord Varn sends the other half once he has our Count."
          }
        }
      }
    },
    "errand.highcairn_count.hook2" : {
      "comment" : "Sending 5: second line of its slip. The Count is the castle's tally of numbered lanterns.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt Highcairn die Zählung: Laternen hinaus, Laternen heim."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send Highcairn the Count: lanterns out, lanterns home."
          }
        }
      }
    },
    "errand.highcairn_count.o1" : {
      "comment" : "Sending 5, order 1 (Odile's seal).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die wahre Zählung überbringen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carry the true count."
          }
        }
      }
    },
    "errand.highcairn_count.o2" : {
      "comment" : "Sending 5, order 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine geschönte Zählung überbringen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carry a rounded count."
          }
        }
      }
    },
    "errand.highcairn_count.title" : {
      "comment" : "Sending 5: title of its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zählung für Highcairn"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Count for Highcairn"
          }
        }
      }
    },
    "errand.lantern_41.hook1" : {
      "comment" : "Sending 13: first line (Hild Varn's own words in the audience varn_ride).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebt mir zwei Reiter und eine nummerierte Laterne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give me two riders and a numbered lantern."
          }
        }
      }
    },
    "errand.lantern_41.hook2" : {
      "comment" : "Sending 13: second line.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich reite heute Nacht am dunklen Leuchtfeuer vorbei und finde ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I will ride out past the dark beacon tonight and find him."
          }
        }
      }
    },
    "errand.lantern_41.title" : {
      "comment" : "Sending 13: title of Hild Varn's ride (shown on the table, never offered).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laterne einundvierzig"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lantern Forty-One"
          }
        }
      }
    },
    "errand.ludo_number.hook1" : {
      "comment" : "Sending 12: first line.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo bittet, die Westtür des Leuchtfeuers zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo asks to read the beacon's west door."
          }
        }
      }
    },
    "errand.ludo_number.hook2" : {
      "comment" : "Sending 12: second line (the beacon's keepers).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hüter schrieben jede Laterne, die nach Westen ging, mit Kreide daran."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The keepers chalked there every lantern that went west."
          }
        }
      }
    },
    "errand.ludo_number.o1" : {
      "comment" : "Sending 12: order.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem Späher gehen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go with a scout."
          }
        }
      }
    },
    "errand.ludo_number.o2" : {
      "comment" : "Sending 12: order.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihn allein gehen lassen, wie er bittet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let him go alone, as he asks."
          }
        }
      }
    },
    "errand.ludo_number.title" : {
      "comment" : "Sending 12: title on its slip (Ser Ludo, the wandering knight).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ludos Nummer"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ludo's Number"
          }
        }
      }
    },
    "errand.mill_herbs.hook1" : {
      "comment" : "Sending 2: first line of its slip (Hemmet is one of the Returned).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der alte Hemmet an der Mühle zieht grauen Salbei gegen den Aschehusten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Old Hemmet at the mill grows grey sage for the ash cough."
          }
        }
      }
    },
    "errand.mill_herbs.hook2" : {
      "comment" : "Sending 2: second line of its slip (Tamsin, the cook).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin hat einen Korb, aber keine Beine übrig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin has a basket and no legs to spare."
          }
        }
      }
    },
    "errand.mill_herbs.title" : {
      "comment" : "Sending 2: title on its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kräuter von der Mühle"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herbs from the Mill"
          }
        }
      }
    },
    "errand.oil_round.hook1" : {
      "comment" : "Sending 1: first line of its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lichtzieher haben das erste Öl des Jahres gepresst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chandlers' row has pressed the first oil of the year."
          }
        }
      }
    },
    "errand.oil_round.hook2" : {
      "comment" : "Sending 1: second line of its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip bringt bis zum Morgen eine Karrenladung ans Tor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip can have a cartload at the gate by dawn."
          }
        }
      }
    },
    "errand.oil_round.title" : {
      "comment" : "Sending 1: title of its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öl für die Runde"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oil for the Round"
          }
        }
      }
    },
    "errand.saltgate_grey.hook1" : {
      "comment" : "Sending 7: first line (Saltgate is House Brine's harbour).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Saltgate spült das Meer graue Laternen an, mit jeder Flut mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grey lanterns wash ashore at Saltgate, more with each tide."
          }
        }
      }
    },
    "errand.saltgate_grey.hook2" : {
      "comment" : "Sending 7: second line (Ansel Quay, House Brine's envoy).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansel Quay zeigt einem der Unseren, wo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansel Quay will show one of ours where."
          }
        }
      }
    },
    "errand.saltgate_grey.title" : {
      "comment" : "Sending 7: title on its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die grauen Laternen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Grey Lanterns"
          }
        }
      }
    },
    "errand.stillmere_proof.hook1" : {
      "comment" : "Sending 8: first line (Ebba Calder, Stillmere's auditor, stood a night on the wall).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder hat ihren Bericht versiegelt: eine Nacht, sechzig Statuen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder has sealed her report: one night, sixty statues."
          }
        }
      }
    },
    "errand.stillmere_proof.hook2" : {
      "comment" : "Sending 8: second line (only proof in a Calder hand counts there).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stillmere zahlt nur für Beweise von eigener Hand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stillmere pays for proof in one of its own hands."
          }
        }
      }
    },
    "errand.stillmere_proof.o1" : {
      "comment" : "Sending 8: order.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So schicken, wie sie es schrieb"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send it as she wrote it."
          }
        }
      }
    },
    "errand.stillmere_proof.o2" : {
      "comment" : "Sending 8: order.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Statuen herausstreichen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strike the statues from it."
          }
        }
      }
    },
    "errand.stillmere_proof.title" : {
      "comment" : "Sending 8: title on its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweis für Stillmere"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proof for Stillmere"
          }
        }
      }
    },
