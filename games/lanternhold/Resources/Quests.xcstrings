{
  "sourceLanguage" : "en",
  "strings" : {
    "errand.beacon_statues.hook1" : {
      "comment" : "Sending 11: first line of its slip (statues of past lords along the road beyond the beacon).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von der Treppe des Leuchtfeuers sieht man die steinernen Herren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From the beacon's stair you see the stone lords on the road."
          }
        }
      }
    },
    "errand.beacon_statues.hook2" : {
      "comment" : "Sending 11: second line of its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit dem Dunklen Jahr hat sie keiner gezählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody has counted them since the Dark Year."
          }
        }
      }
    },
    "errand.beacon_statues.o1" : {
      "comment" : "Sending 11, order 1 (Odile's seal, no risk).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von der Treppe aus zählen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch from the stair."
          }
        }
      }
    },
    "errand.beacon_statues.o2" : {
      "comment" : "Sending 11, order 2 (few come back).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis in die Lampenstube steigen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Climb to the lamp room."
          }
        }
      }
    },
    "errand.beacon_statues.title" : {
      "comment" : "Sending 11: title of its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt die Statuen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Count the Statues"
          }
        }
      }
    },
    "errand.highcairn_count.hook1" : {
      "comment" : "Sending 5: first line of its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lord Harrow schickt den Rest des Aufgebots, wenn wir zählen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lord Harrow sends the rest of the levy once we can count."
          }
        }
      }
    },
    "errand.highcairn_count.hook2" : {
      "comment" : "Sending 5: second line of its slip. The Count is the castle's tally of numbered lanterns.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt Highcairn die Zählung: Laternen hinaus, Laternen heim."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send Highcairn the Count: lanterns out, lanterns home."
          }
        }
      }
    },
    "errand.highcairn_count.o1" : {
      "comment" : "Sending 5, order 1 (Odile's seal).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die wahre Zählung überbringen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carry the true count."
          }
        }
      }
    },
    "errand.highcairn_count.o2" : {
      "comment" : "Sending 5, order 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine geschönte Zählung überbringen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carry a rounded count."
          }
        }
      }
    },
    "errand.highcairn_count.title" : {
      "comment" : "Sending 5: title of its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zählung für Highcairn"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Count for Highcairn"
          }
        }
      }
    },
    "errand.oil_round.hook1" : {
      "comment" : "Sending 1: first line of its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lichtzieher haben das erste Öl des Jahres gepresst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chandlers' row has pressed the first oil of the year."
          }
        }
      }
    },
    "errand.oil_round.hook2" : {
      "comment" : "Sending 1: second line of its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip bringt bis zum Morgen eine Karrenladung ans Tor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip can have a cartload at the gate by dawn."
          }
        }
      }
    },
    "errand.oil_round.title" : {
      "comment" : "Sending 1: title of its slip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öl für die Runde"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oil for the Round"
          }
        }
      }
    },
