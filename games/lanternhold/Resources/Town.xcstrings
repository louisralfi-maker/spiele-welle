    "town.reason.leftAlone" : {
      "comment" : "Dawn report, why happiness changed: houses the lord did not collect from yesterday.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschonte Häuser"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houses left alone"
          }
        }
      }
    },
    "town.report.collected" : {
      "comment" : "Dawn report: gold that reached the purse yesterday (the households' tosses, the knocks, the collector's delivery). %@ is the amount.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestern eingesammelt: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collected yesterday: %@"
          }
        }
      }
    },
    "town.report.collector" : {
      "comment" : "Dawn report: the hired tax collector walked the town yesterday morning. %1$@ is the gold he put into the purse, %2$@ the wage he kept (one coin in eight).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Steuereintreiber brachte %1$@ (Lohn %2$@)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The collector brought %1$@ (wage %2$@)"
          }
        }
      }
    },
    "town.report.collectorEmpty" : {
      "comment" : "Dawn report: the hired tax collector found nobody owing (the lord had been first, or the doors stayed shut).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Steuereintreiber kam leer zurück"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The collector came back empty"
          }
        }
      }
    },
    "town.report.doubled" : {
      "comment" : "Dawn report: yesterday the double-taxes reward was taken.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelte Steuern: Jede Münze zählte doppelt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double taxes: every coin counted twice"
          }
        }
      }
    },
    "town.report.kept" : {
      "comment" : "Dawn report: gold nobody came for by the horn; the people kept it. %@ is the amount.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
