{
  "sourceLanguage" : "en",
  "strings" : {
    "town.access.door" : {
      "comment" : "VoiceOver only (never on screen): a door of the town that is shut to a knock now; %@ is the household's door form.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tür %@, zu"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ door, shut"
          }
        }
      }
    },
    "town.access.knock" : {
      "comment" : "VoiceOver only (never on screen): a door of the town that a touch knocks at; %@ is the household's door form (\"the chandler's\" / \"beim Kerzenzieher\").",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ anklopfen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knock at %@ door"
          }
        }
      }
    },
    "town.collector.act.dismiss" : {
      "comment" : "The join: the act on the collector's slip and his touch label while he is in service (%@: his name). English only in build 2.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send %@ home"
          }
        }
      }
    },
    "town.collector.act.hire" : {
      "comment" : "The join: the act on the collector's slip and his touch label before he is taken on, or after he was sent home (%@: his name). English only in build 2.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take on %@"
          }
        }
      }
    },
    "town.collector.back" : {
      "comment" : "Home with the box: every door of his round paid him.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Tür, die schuldete. Zählt nach, wenn Ihr wollt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every door that owed. Count it if you like."
          }
        }
      }
    },
    "town.collector.decline" : {
      "comment" : "The answer that does not hire him (audience choice).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt nicht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not now"
          }
        }
      }
    },
    "town.collector.dismissed" : {
      "comment" : "At his post, when a touch sends him away (from the next morning).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann ruht der Karren. Ihr wisst, wo ich bin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cart can rest. You know where I am."
          }
        }
      }
    },
    "town.collector.empty" : {
      "comment" : "Home with an empty box: the doors were shut (unrest).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle zu. Nicht eine Münze."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shut, every one. Not a coin."
          }
        }
      }
    },
    "town.collector.farmers" : {
      "comment" : "Why the fields are not on his round: the farmers pay the lord in person (TOWN.md section 6).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bauern zählen in Eure Hand. In keine andere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farmers count into your hand. Nobody else's."
          }
        }
      }
    },
    "town.collector.hire" : {
      "comment" : "The answer that hires the collector (audience choice).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take him on"
          }
        }
      }
    },
    "town.collector.hired" : {
      "comment" : "His reaction when taken on; he starts the next morning.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also bei Tagesanbruch. Die Türen, die Kiste, heim."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dawn, then. The doors, the box, home."
          }
        }
      }
    },
    "town.collector.lordFirst" : {
      "comment" : "Home with the box: the lord had collected at one of his doors first.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr wart vor mir da. Haben sie gesagt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You were there before me. They said so."
          }
        }
      }
    },
    "town.collector.name" : {
      "comment" : "The collector's name (the people lane's figure, PEOPLE.md 13). Never translated.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saul Tolliver"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saul Tolliver"
          }
        }
      }
    },
    "town.collector.offer" : {
      "comment" : "The collector offers himself at the first audience (two lines: who, what, the wage). Working people speak short and dry. German: Ihr/Euch.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Arm ließ ich an der Mauer, die Beine nicht. Ich gehe morgens Eure Türen ab und bringe die Kiste heim. Jede achte Münze."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lost the arm on the wall, kept the legs. I'll walk your doors at dawn and bring the box home. One coin in eight."
          }
        }
      }
    },
    "town.collector.rehired" : {
      "comment" : "At his post, when a touch takes him on again.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wieder zu den Türen. Morgen bei Tagesanbruch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back to the doors. Tomorrow at dawn."
          }
        }
      }
    },
    "town.door.chandler" : {
