          }
        }
      }
    },
    "petition.envoy_coast.c2" : {
      "comment" : "Petition envoy_coast: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir brauchen jeden Bogen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We need every bow"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitamos todos los arcos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nous faut tous nos arcs"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non possiamo cedere un solo arco"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弓は一張も欠かせない"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisamos de cada arco"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们需要每一张弓"
          }
        }
      }
    },
    "petition.envoy_coast.c3" : {
      "comment" : "Petition envoy_coast: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt ihnen lieber Lampenöl"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send them lamp oil instead"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mandaremos aceite de lámpara"
          }
        },
        "fr" : {
          "stringUnit" : {
