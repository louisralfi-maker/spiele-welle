        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "举办比武大会"
          }
        }
      }
    },
    "petition.ludo_tourney.c2" : {
      "comment" : "Petition ludo_tourney: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Bogenschießen, kein Preis"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archery only, no prize"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tiro con arco, sin premio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tir seulement, sans prix"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tiro con l’arco, niente premio"
          }
        },
        "ja" : {
          "stringUnit" : {
