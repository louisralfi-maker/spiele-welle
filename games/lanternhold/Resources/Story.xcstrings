          }
        }
      }
    },
    "petition.captured_sootling.c3" : {
      "comment" : "Petition captured_sootling: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasst ihn am Schlundtor frei"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let it go at the Throat gate"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suéltenlo en la puerta de la Garganta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relâchez-le à la porte de la Gorge"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liberatelo alla porta della Gola"
