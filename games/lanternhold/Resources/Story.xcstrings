{
  "sourceLanguage" : "en",
  "strings" : {
    "ending.speech_aldric" : {
      "comment" : "Dawn report after night 20 held: quotes the speech the king gave at the last stand.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wir holen Burgherr Aldric heim“, habt Ihr ihnen gesagt. Auf der Mauer vergaß es keiner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“We bring Lord Aldric home,” you told them. Nobody on the wall forgot it."
          }
        }
      }
    },
    "ending.speech_dawn" : {
      "comment" : "Dawn report after night 20 held: quotes the speech the king gave at the last stand.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wir halten bis zum Morgen“, habt Ihr ihnen gesagt. Und sie hielten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“We hold until dawn,” you told them. And they held."
          }
        }
      }
    },
    "ending.speech_honest" : {
      "comment" : "Dawn report after night 20 held: quotes the speech the king gave at the last stand.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Dafür war ich nie bestimmt“, habt Ihr ihnen gesagt. Sie folgten Euch trotzdem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“I was never meant for this,” you told them. They followed you anyway."
          }
        }
      }
    },
    "line.bard_returned" : {
      "comment" : "Court talk: bard.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küche, Wäsche, warmes Brot, eine Treppe, eine blaue Tür. Ich sammle, was die Heimgekehrten sagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitchen, washing, warm bread, a stair, a blue door. I collect what the Returned say."
          }
        }
      }
    },
    "line.bard_rhyme" : {
      "comment" : "Court talk: bard.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich reime „Laterne“ auf „Ferne“. Die Kritiker hassen es. Das Publikum weint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I rhyme “lantern” with “anthem”. Critics hate it. Audiences weep."
          }
        }
      }
    },
    "line.bard_song_line" : {
      "comment" : "Court talk: bard.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Haus braucht ein Lied, {Burgherr|Burgherrin}. Die meisten ein besseres, als sie verdienen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every house needs a song, my {lord|lady}. Most need a better one than they deserve."
          }
        }
      }
    },
    "line.bram_arrows" : {
      "comment" : "Court talk: bram.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfeile. Mehr Pfeile. Fragt mich morgen wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrows. More arrows. Ask me again tomorrow."
          }
        }
      }
    },
    "line.bram_arrows_refused" : {
      "comment" : "Court talk: bram (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr habt Mareks Pfeile weggeschickt. Gut. Meine fliegen gerade."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You sent Marek’s arrows away. Good. Mine fly straight."
          }
        }
      }
    },
    "line.bram_beacon" : {
      "comment" : "Court talk: bram.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schale fürs Leuchtfeuer. Viel Eisen. Schaffe ich. Brauche danach Schlaf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The beacon bowl. Big iron. I can do it. Need sleep after."
          }
        }
      }
    },
    "line.bram_bell_hint" : {
      "comment" : "Court talk: bram, a hint about bell_for_arrows.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frage heute wegen der Glocke. Frage nicht gern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Going to ask about the bell today. Won’t like asking."
          }
        }
      }
    },
    "line.bram_endless" : {
      "comment" : "Court talk: bram.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch da. Hämmere noch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still here. Still hammering."
          }
        }
      }
    },
    "line.bram_first" : {
      "comment" : "Court talk: bram.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hm. {Neuer Herr|Neue Herrin}. Braucht Ihr was geschmiedet, fragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hm. New {lord|lady}. Need anything forged, ask."
          }
        }
      }
    },
    "line.bram_giant" : {
      "comment" : "Court talk: bram.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Großer Brocken heute Nacht. Alles zweimal geschärft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Big one tonight. Sharpened everything twice."
          }
        }
      }
    },
    "line.bram_lanterns" : {
      "comment" : "Court talk: bram.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neun Laternen heute früh vom Stein geholt. Scharniere auf der falschen Seite. Nicht unsere Arbeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nine lanterns off the stone this morning. Hinges on the wrong side. Not our work."
          }
        }
      }
    },
    "line.bram_reforged" : {
      "comment" : "Court talk: bram.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vierzig gute Pfeile. Aus Mareks Schrott. Nicht schlecht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forty good arrows. From Marek’s rubbish. Not bad."
          }
        }
      }
    },
    "line.bram_test_hint" : {
      "comment" : "Court talk: bram, a hint about marek_arrows.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mareks Pfeile. Lasst mich erst einen sehen. Nur einen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek’s arrows. Let me see one first. Just one."
          }
        }
      }
    },
    "line.brannock_after_giant" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ding war größer als das Torhaus, und wir sind noch hier. Denkt daran, wenn es schlimm wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That thing was taller than the gatehouse, and we are still here. Remember that when it gets bad."
          }
        }
      }
    },
    "line.brannock_endless" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Nacht zähle ich die Jungs auf der Mauer. Jeden Morgen zähle ich sie wieder. Das ist der ganze Beruf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every night I count the lads on the wall. Every dawn I count them again. That is the whole job."
          }
        }
      }
    },
    "line.brannock_first" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Torhaus hält, {Herr|Herrin}. Feuerschalen ans Tor, eine Pfahlgrube davor. Dann reden wir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatehouse holds, {lord|my lady}. Braziers by the gate, a stake pit in front. Then we talk."
          }
        }
      }
    },
    "line.brannock_gerald" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Jungs halten bei Dämmerung am Schlundtor noch nach Gerald Ausschau. Ich habe es ihnen nicht verboten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lads still look for Gerald at the Throat gate at dusk. I have not told them to stop."
          }
        }
      }
    },
    "line.brannock_giant" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Späher sagen, der Boden im Nebel bebt wie eine Trommel. Heute Nacht kommt etwas Großes. Jeder Mann auf die Mauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scouts say the ground in the fog shakes like a drum. Something big tonight. Every man on the walls."
          }
        }
      }
    },
    "line.brannock_guest" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euer Gast steht nachts auf den Zinnen und friert nie. Mir gefällt das nicht. Den Jungs schon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your guest stands on the battlements at night and never shivers. I do not like it. The lads do."
          }
        }
      }
    },
    "line.brannock_hounds" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bald kommen Hunde. Schnell, und sie springen über Palisaden. Stein hält sie auf. Merkt Euch das."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hounds come soon. Fast, and they leap palisades. Stone stops them. Remember that."
          }
        }
      }
    },
    "line.brannock_last" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was auch aus dem Nebel kommt, {Herr|Herrin}, ich bin froh, dass da oben Eure Laterne hängt und nicht meine."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whatever comes out of the fog, {lord|my lady}, I am glad it is your lantern up there and not mine."
          }
        }
      }
    },
    "line.brannock_last_hint" : {
      "comment" : "Court talk: brannock, a hint about last_stand.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Jungs wollen ein Wort von Euch, {Herr|Herrin}. Am Thron. Haltet es kurz, sie zählen Pfeile."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lads want a word from you, {lord|my lady}. At the throne. Keep it short, they are counting arrows."
          }
        }
      }
    },
    "line.brannock_light" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst Licht, sagtet Ihr. Schön. Aber Licht schießt nicht zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light first, you said. Fine. But light does not shoot back."
          }
        }
      }
    },
    "line.brannock_pole" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Stange. Nein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That pole. No."
          }
        }
      }
    },
    "line.brannock_promised" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr habt mir einen Turm versprochen. Ich habe schon ausgesucht, welche Jungs zuerst hinaufdürfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You promised me a tower. I have already picked which lads go up first."
          }
        }
      }
    },
    "line.brannock_refused" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr habt dem Herold nein gesagt. Gut. Ich hätte ihm Schlimmeres gesagt, aber es ist Euer Saal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You told the herald no. Good. I would have told him worse, but it is your hall."
          }
        }
      }
    },
    "line.brannock_runner" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euer kleines Lampenkind hat letzte Nacht vier Feuerschalen neu entzündet. Schneller als meine Männer. Sagt es ihnen nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your little lamp-runner relit four braziers last night. Faster than my men. Do not tell them."
          }
        }
      }
    },
    "line.brannock_scarecrow" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem fernen Feld steht eine Vogelscheuche mit meinem Gesicht. Die Krähen haben mehr Respekt vor ihr als die Rekruten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is a scarecrow in the far field wearing my face. The crows respect it more than the recruits."
          }
        }
      }
    },
    "line.brannock_sergeant" : {
      "comment" : "Court talk: brannock, a hint about old_sergeant.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Saal fragt ein alter Feldwebel nach einem Speer. Schnarcht auf Wache. Der beste Mann, den ich je hatte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is an old sergeant in the hall asking for a spear. Snores on watch. Best man I ever had."
          }
        }
      }
    },
    "line.brannock_speech_aldric" : {
      "comment" : "Court talk: brannock (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Alten schärfen ihre Schwerter für Aldric. Nicht um ihn zu töten. Um ihn heimzuholen. Eure Worte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The old hands sharpen their swords for Aldric. Not to kill him. To bring him home. Your words."
          }
        }
      }
    },
    "line.brannock_speech_dawn" : {
      "comment" : "Court talk: brannock (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wir halten bis zum Morgen.“ Kurz. Den Jungs gefiel es. Jetzt sagen sie es sich gegenseitig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“We hold until dawn.” Short. The lads liked it. They are saying it to each other now."
          }
        }
      }
    },
    "line.brannock_speech_honest" : {
      "comment" : "Court talk: brannock (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie dafür bestimmt, sagtet Ihr. Dem trauen die Jungs mehr als jedem Stirnreif."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never meant for this, you said. The lads trust that more than any circlet."
          }
        }
      }
    },
    "line.brannock_tax_hint" : {
      "comment" : "Court talk: brannock, a hint about war_tax.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute bitte ich um Gold, {Herr|Herrin}. Es wird Euch nicht gefallen. Mir auch nicht. Den Mauern ist das egal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today I ask for gold, {lord|my lady}. You will not like it. I do not like it either. Walls do not care."
          }
        }
      }
    },
    "line.brannock_tower_hint" : {
      "comment" : "Court talk: brannock, a hint about tower_request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe heute eine Bitte für die Audienz, {Herr|Herrin}. Es geht um Pfeile. Und einen Turm. Vor allem den Turm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have a request for the audience today, {lord|my lady}. About arrows. And a tower. Mostly the tower."
          }
        }
      }
    },
    "line.brannock_walls" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst Mauern, dann Lieder. So werden alte Soldaten alt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walls first, songs later. That is how old soldiers get to be old."
          }
        }
      }
    },
    "line.brannock_window" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das dunkle Fenster im Bergfried. Die Jungs schauen vor der Wache hinauf. Danke, {Herr|Herrin}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dark window in the keep. The lads look up at it before the watch. Thank you, {lord|my lady}."
          }
        }
      }
    },
    "line.calder_statues" : {
      "comment" : "Court talk: ebbaCalder.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vierzig Burgherren in Eurem Buch. Sechzig Statuen, ehe der Nebel beginnt. Einer von uns irrt sich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forty lords in your book. Sixty statues before the fog. One of us is wrong."
          }
        }
      }
    },
    "line.envoy_lanterns" : {
      "comment" : "Court talk: envoy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Saltgate treiben das ganze Jahr graue Laternen an. Kein Lichtzieher von uns hat sie gemacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grey lanterns wash up at Saltgate all year. No chandler of ours made them."
          }
        }
      }
    },
    "line.envoy_lighthouse" : {
      "comment" : "Court talk: envoy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unser Leuchtturm brennt die ganze Nacht, {Lord|Lady} Lantern. Die Dinge im Wasser klettern ihm schon entgegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our lighthouse burns all night, {Lord|Lady} Lantern. The things in the water have started climbing toward it."
          }
        }
      }
    },
    "line.envoy_sea" : {
      "comment" : "Court talk: envoy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An der Küste blicken unsere Mauern aufs Meer. Ihr habt nur eine Tür. Ich beneide Euch um die eine Front."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the coast our walls face the sea. Here you face one door. I envy you your single front."
          }
        }
      }
    },
    "line.envoy_thanks" : {
      "comment" : "Court talk: envoy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Küste erinnert sich an Eure Hilfe, {Lord|Lady} {lord}. Meine Herrin hat einen Wachturm nach {dem Laternenanzünder|der Laternenanzünderin} benannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The coast remembers your help, {Lord|Lady} {lord}. My lady has named a watchtower after the lamplighter."
          }
        }
      }
    },
    "line.herald_fire" : {
      "comment" : "Court talk: herald.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euer Feuer ist sehr klein, {Laternenanzünder|Laternenanzünderin}. Er hat größere erlöschen sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your fire is very small, lamplighter. He has watched larger ones go out."
          }
        }
      }
    },
    "line.herald_throne" : {
      "comment" : "Court talk: herald.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der König unter der Düsternis erinnert sich an diesen Saal. An den Thron. Daran, dass er seiner war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The King beneath the Gloom remembers this hall. He remembers the throne. He remembers it was his."
          }
        }
      }
    },
    "line.hesper_beacon" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Leuchtfeuer und die Flamme sind verwandt, Kind des Hauses. Ein Feuer, vor langer Zeit in zwei Schalen entzündet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The beacon and the Flame are kin, child of the house. One fire, lit long ago in two bowls."
          }
        }
      }
    },
    "line.hesper_bell" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kapelle hat jetzt keine Stimme, Kind des Hauses. Ich schlage im Morgengrauen auf einen Topf. Die Flamme tut, als merke sie nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chapel has no voice now, child of the house. I ring a pot at dawn. The Flame pretends not to notice."
          }
        }
      }
    },
    "line.hesper_blessed" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich segne das Tal jetzt an jedem Morgen. Ob es hilft, weiß ich nicht. Das Tal scheint es zu glauben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I bless the valley each dawn now. I cannot say whether it helps. The valley seems to think so."
          }
        }
      }
    },
    "line.hesper_endless" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Flamme hat Burgherren und Mauern überdauert. Sie wird auch die Lange Wacht überdauern. Das würde ich gern sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Flame has outlived lords and walls. It will outlive the Long Watch. I would like to see that."
          }
        }
      }
    },
    "line.hesper_first" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen, Kind des Hauses. Die Flamme brennt seit tausend Jahren in diesem Saal. Seid bitte nicht {derjenige|diejenige}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome, child of the house. The Flame has burned in this hall for a thousand years. Please do not be the one."
          }
        }
      }
    },
    "line.hesper_flame" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Flamme erinnert sich an jeden Burgherrn. Vor allem an die, die sie erlöschen ließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Flame remembers every lord. Mostly the ones who let it go out."
          }
        }
      }
    },
    "line.hesper_giant_hint" : {
      "comment" : "Court talk: hesper, a hint about hesper_giant.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich muss Euch heute am Thron sprechen, Kind des Hauses. Die Flamme hat mir im Morgengrauen etwas gezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I must speak with you at the throne today, child of the house. The Flame showed me something at dawn."
          }
        }
      }
    },
    "line.hesper_goat" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die heilige Ziege hat heute Morgen ein Gesangbuch gefressen. Ich nehme es als Kritik."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The holy goat ate a hymnal this morning. I choose to take it as a review."
          }
        }
      }
    },
    "line.hesper_gone" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit sie fort ist, neigt sich die Flamme zum Schlund, als suche sie nach ihr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Flame leans toward the Throat since she left, as if it were looking for her."
          }
        }
      }
    },
    "line.hesper_hunger" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Düsternis ist kein Geschöpf, Kind des Hauses. Sie ist ein Hunger. Die Kreaturen sind nur ihre Zähne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Gloom is not a creature, child of the house. It is a hunger. The creatures are only its teeth."
          }
        }
      }
    },
    "line.hesper_lantern" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Laterne brennt grau, weil sie in der Düsternis brannte. Ein Licht, das zurückkam. Ich hielt das nicht für möglich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her lantern burns grey because it burned in the Gloom. A light that came back. I did not think one could."
          }
        }
      }
    },
    "line.hesper_night20" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute Nacht brennt die Flamme für jeden von ihnen, Kind des Hauses. Auch für ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonight the Flame burns for every one of them, child of the house. For him too."
          }
        }
      }
    },
    "line.hesper_relic" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilger knien vor Mareks Hühnerknochen. Die Flamme stört das nicht. Glaube findet seinen eigenen Weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilgrims kneel before Marek’s chicken bone. The Flame does not mind. Faith finds its own way."
          }
        }
      }
    },
    "line.hesper_truce_hint" : {
      "comment" : "Court talk: hesper, a hint about truce_end.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommt zum Thron, Kind des Hauses. Seit dem Handel ist die Flamme blau. Ich möchte darüber sprechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come to the throne, child of the house. The Flame has been blue since the bargain. I want to speak of it."
          }
        }
      }
    },
    "line.hesper_unwarned" : {
      "comment" : "Court talk: hesper (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stadt erfuhr vom Riesen durch ihre bebenden Böden. Nächstes Mal fragen sie zuerst mich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The town learned of the giant from its own shaking floors. They will ask me first next time."
          }
        }
      }
    },
    "line.hesper_vigil" : {
      "comment" : "Court talk: hesper (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich hielt die Wache. Der Boden bebte, die Flamme nicht. Denkt daran, wenn der Nächste kommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I kept the vigil. The ground shook, and the Flame did not. Remember that when the next one comes."
          }
        }
      }
    },
    "line.hesper_west" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Dämmerung neigt sich die Flamme nach Westen. Ich rede mir nicht mehr ein, es sei der Luftzug."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At dusk the Flame leans west. I have stopped telling myself it is the draught."
          }
        }
      }
    },
    "line.hild_father" : {
      "comment" : "Court talk: hildVarn.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vater sagt, eine Mauer ist so gut wie der, der sie im Morgengrauen zählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Father says a wall is as good as whoever counts it at dawn."
          }
        }
      }
    },
    "line.ludo_goose" : {
      "comment" : "Court talk: serLudo.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe vieles erschlagen, {edler Herr|edle Herrin}. Vor allem Zeit. Aber auch einmal eine sehr große Gans."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have slain many things, good my {lord|lady}. Mostly time. But also, once, a very large goose."
          }
        }
      }
    },
    "line.ludo_helmet" : {
      "comment" : "Court talk: serLudo.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mein Helm ist ein Erbstück. Mein Großvater war ein viel größerer Mann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My helmet is an heirloom. My grandfather was a much larger man."
          }
        }
      }
    },
    "line.ludo_walls" : {
      "comment" : "Court talk: serLudo.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Mut, {edler Herr|edle Herrin}! Ich habe Eure Mauern geprüft. Hervorragende Mauern. Ich bin gegen zwei gelaufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Courage, good my {lord|lady}! I have inspected your walls. Excellent walls. I walked into two of them."
          }
        }
      }
    },
    "line.marek_arrows_hint" : {
      "comment" : "Court talk: marek, a hint about marek_arrows.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute habe ich ein Angebot, so gut, dass es mir wehtut. Fragt jeden. Fragt den Herrn, für den es bestimmt war. Ach. Nun ja."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today I have a bargain so good it hurts me to offer it. Ask anyone. Ask the lord it was meant for. Ah. Well."
          }
        }
      }
    },
    "line.marek_bargain" : {
      "comment" : "Court talk: marek.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles hat seinen Preis, Eure Strahlkraft. Heute ist meiner sehr vernünftig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything has a price, Your Radiance. Today mine is very reasonable."
          }
        }
      }
    },
    "line.marek_caught" : {
      "comment" : "Court talk: marek.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euer Schmied hat sehr kräftige Finger, Eure Strahlkraft. Ich bewundere ihn künftig aus der Ferne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your smith has very strong fingers, Your Radiance. I have decided to admire him from a distance."
          }
        }
      }
    },
    "line.marek_coast" : {
      "comment" : "Court talk: marek.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Küstenstraße ist nass in letzter Zeit. Das Meer kriecht sie hinauf. Schlecht fürs Geschäft, gut für Boote."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The coast road is wet these days. The sea is creeping up it. Bad for business, good for boats."
          }
        }
      }
    },
    "line.marek_endless" : {
      "comment" : "Court talk: marek.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tal, das nie fällt, ist ein Markt, der nie schließt. Ich trinke auf Eure Mauern, Eure Strahlkraft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A valley that never falls is a market that never closes. I drink to your walls, Your Radiance."
          }
        }
      }
    },
    "line.marek_gloom" : {
      "comment" : "Court talk: marek.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Düsternis ist schlecht fürs Geschäft, Eure Strahlkraft. Im Krieg kauft keiner Sonnenschirme. Ich habe es versucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Gloom is terrible for trade, Your Radiance. Nobody buys a parasol in a war. I have tried."
          }
        }
      }
    },
    "line.marek_letters" : {
      "comment" : "Court talk: marek.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goldenacre schreibt an alle, Eure Strahlkraft. Ich trage die Briefe nur aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goldenacre writes to everyone, Your Radiance. I only carry the letters."
          }
        }
      }
    },
    "line.marek_spyglass_hint" : {
      "comment" : "Court talk: marek, a hint about marek_spyglass.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute etwas Besonderes. Messing. Ehrlich. Ich weiß, ich sage immer ehrlich. Diesmal meine ich das Messing."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something special today. Brass. Honest. I know I always say honest. This time I mean the brass."
          }
        }
      }
    },
    "line.marek_stays" : {
      "comment" : "Court talk: marek.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Tag in Eurem Burghof! Die Wachen schulden mir elf Gold. Ich war nie glücklicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day in your courtyard! The guards owe me eleven gold. I have never been happier."
          }
        }
      }
    },
    "line.odile_aldric" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommt Aldric heim, muss ich ihm seinen Stirnreif zurückgeben. Ich habe den Papierkram liebgewonnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If Aldric comes home, I must give him back his circlet. I have grown rather fond of the paperwork."
          }
        }
      }
    },
    "line.odile_beacon" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fundament, Turm, Schale. Drei Stufen, {mein Herr|meine Herrin}. Die Schatzkammer hat zu allen dreien eine Meinung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Footing, tower, bowl. Three stages, my {lord|lady}. The treasury has opinions about all three."
          }
        }
      }
    },
    "line.odile_counsel" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt bei der Audienz nach meinem Rat. Ich gebe ihn umsonst. Das Einzige hier, was umsonst ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At an audience, ask for my counsel. I give it freely. It is the only free thing in this castle."
          }
        }
      }
    },
    "line.odile_door" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pläne setzen die Tür des Leuchtfeuers an die Westseite. Burgherrin Oriel machte keine Fehler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The plans put the beacon’s door on the west side. Lady Oriel did not make mistakes."
          }
        }
      }
    },
    "line.odile_doubted" : {
      "comment" : "Court talk: odile (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pläne des Leuchtfeuers liegen unter Später, {mein Herr|meine Herrin}. Ich sehe jeden Morgen in diese Schublade."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The beacon’s plans are filed under Later, my {lord|lady}. I check that drawer every morning."
          }
        }
      }
    },
    "line.odile_endless" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch eine Nacht, noch ein Morgen. Ich schreibe kein Datum mehr ins Kassenbuch. Ich schreibe „wieder“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another night, another dawn. I no longer write the date in the ledger. I write “again”."
          }
        }
      }
    },
    "line.odile_family_hint" : {
      "comment" : "Court talk: odile, a hint about family_leaving.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Saal will eine Familie das Tal verlassen. Drei Steuerzahler, {mein Herr|meine Herrin}. Ich habe sie unterstrichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A family in the hall wants to leave the valley. Three taxpayers, my {lord|lady}. I have underlined them."
          }
        }
      }
    },
    "line.odile_first_day" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Stirnreif ist ein Hut, der widerspricht, {mein Herr|meine Herrin}. Setzt Euch, wenn Ihr bereit seid."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A circlet is a hat that argues back, my {lord|lady}. Sit when you are ready."
          }
        }
      }
    },
    "line.odile_guest" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unser Gast isst nichts, schläft nirgends und zahlt keine Steuern. Ich habe ihr ein eigenes Kassenbuch angelegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our guest eats nothing, sleeps nowhere and pays no tax. I have opened a separate ledger for her."
          }
        }
      }
    },
    "line.odile_guilds" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zunftmeister verneigen sich jetzt genau so tief wie ihre Steuern. Ich habe nachgemessen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The guild masters now bow exactly as deep as their taxes. I measured."
          }
        }
      }
    },
    "line.odile_handed" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kassenbuch ist ausgeglichen, {mein Herr|meine Herrin}. Ich wünschte, das fühlte sich nicht so an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ledger balances, my {lord|lady}. I wish it did not feel like this when it balances."
          }
        }
      }
    },
    "line.odile_night20" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was heute Nacht auch geschieht, {mein Herr|meine Herrin}, die Bücher sind in Ordnung. Das wird jemand wissen wollen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whatever happens tonight, my {lord|lady}, the books are in order. Someone will want to know that."
          }
        }
      }
    },
    "line.odile_plans_hint" : {
      "comment" : "Court talk: odile, a hint about beacon_plans.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommt heute zum Thron, {mein Herr|meine Herrin}. Ich habe im Archiv etwas gefunden, das keine Steuerrolle ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come to the throne today, my {lord|lady}. I found something in the archive that is not a tax roll."
          }
        }
      }
    },
    "line.odile_refugees" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Leute aus Beaconfoot zahlen ihre Steuern früh und vollständig. Ich muss vielleicht aufhören, mich zu beklagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Beaconfoot folk pay their taxes early and in full. I may have to stop complaining about them."
          }
        }
      }
    },
    "line.odile_taxes" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Pult setzt Ihr die Steuern. Niedrige machen Freunde, hohe machen Mauern. Wählt Eure Feinde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lectern sets the taxes. Low taxes make friends, high taxes make walls. Choose your enemies."
          }
        }
      }
    },
    "line.odile_treasury" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schatzkammer ist ein Eimer, {mein Herr|meine Herrin}. Steuern fließen hinein, und die Mauern trinken sie leer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The treasury is a bucket, my {lord|lady}. Taxes pour in, and the walls drink it dry."
          }
        }
      }
    },
    "line.odile_war_tax" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr habt Brannock eine Kriegssteuer versprochen. Das Pult steht gleich dort, {mein Herr|meine Herrin}. Ich erwähne es nur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You promised Brannock a war tax. The lectern is right there, my {lord|lady}. I merely mention it."
          }
        }
      }
    },
    "line.orla_cleft" : {
      "comment" : "Court talk: orlaLorn.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euer Haus kam aus dem Spalt herab, {junger|junge} Taper. Meines sah es kommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your house came down out of the Cleft, young Taper. Mine watched it come."
          }
        }
      }
    },
    "line.pip_aldric" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der alte Herr ist der neue Feind, und {der neue Herr|die neue Herrin} ist {der alte Laternenanzünder|die alte Laternenanzünderin}. Schreibt das jemand auf?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The old lord is the new enemy, and the new {lord|lady} is the old lamplighter. Somebody write this down."
          }
        }
      }
    },
    "line.pip_arrows" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mareks Pfeile fliegen wie Gänse. Meistens nach Süden, und nur im Herbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek’s arrows fly like geese. Mostly south, and only in autumn."
          }
        }
      }
    },
    "line.pip_beacon" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Leuchtfeuer, so hell, dass es das Dunkel bricht! Endlich ein Licht, das ich nicht tragen muss."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beacon so bright it breaks the dark! At last, a light nobody will ask me to carry."
          }
        }
      }
    },
    "line.pip_crown" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euer Stirnreif ist etwas groß, Eure Dochtheit. Keine Sorge. Er passt, sobald Euch der Kopf schwillt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your circlet is a little big, Your Wickship. Never mind. It will fit once your head swells."
          }
        }
      }
    },
    "line.pip_crows" : {
      "comment" : "Court talk: pip, a hint about crow_rags.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kind will Eure Feuerschalen in Lumpen kleiden. Endlich eine Mode, die die Krähen respektieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A child wants to dress your braziers in rags. Finally, a fashion the crows respect."
          }
        }
      }
    },
    "line.pip_endless" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nacht dreißig-irgendwas. Mir sind die Witze über das Dunkel ausgegangen. Jetzt erzähle ich welche über Brannock."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Night thirty-something. I ran out of jokes about the dark. Now I just tell them about Brannock."
          }
        }
      }
    },
    "line.pip_farewell_hint" : {
      "comment" : "Court talk: pip, a hint about pip_farewell.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe heute etwas Wichtiges für die Audienz. Es ist ein Witz. Er ist sehr wichtig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have something important for the audience today. It is a joke. It is very important."
          }
        }
      }
    },
    "line.pip_first" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Ein neuer Herr|Eine neue Herrin}! Der letzte ritt ins Dunkel. Mal sehen, wie weit Ihr bis zur Teestunde kommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new {lord|lady}! The last one rode into the dark. Let us see how far you get before teatime."
          }
        }
      }
    },
    "line.pip_guest" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unser Gast hat eine graue Laterne und keinen Namen. Also eine Wahrsagerin oder eine Steuereintreiberin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our guest has a grey lantern and no name. A fortune-teller, then, or a tax collector."
          }
        }
      }
    },
    "line.pip_handed" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei stille Nächte für einen Gast. Billig, wenn man es so sieht. Niemand sieht mir in die Augen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three quiet nights for one guest. Cheap, as these things go. Nobody will look me in the eye."
          }
        }
      }
    },
    "line.pip_herald_hint" : {
      "comment" : "Court talk: pip, a hint about herald_demand.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Saal steht ein Herold, der nach kalter Asche riecht. Ich habe ihm einen Witz erzählt. Er hat seitdem nicht geblinzelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is a herald in the hall who smells of cold ash. I told him a joke. He has not blinked since."
          }
        }
      }
    },
    "line.pip_joke_told" : {
      "comment" : "Court talk: pip (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie lachen immer noch über den Witz, Eure Dochtheit. Ich habe ihn noch viermal erzählt. Er wird besser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They are still laughing at the joke, Your Wickship. I have told it four more times. It gets better."
          }
        }
      }
    },
    "line.pip_matches" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben {den Laternenanzünder zum Burgherrn|die Laternenanzünderin zur Burgherrin} gemacht. Endlich weiß hier jemand, wo die Zündhölzer liegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They made the lamplighter {lord|lady}. At last someone here knows where the matches are."
          }
        }
      }
    },
    "line.pip_minister" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Minister für Witze habe ich den Dienstag für lustig erklärt. Keiner hat es gemerkt. Schuld ist die Düsternis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As Minister of Jokes I have declared Tuesdays funny. Nobody noticed. I blame the Gloom."
          }
        }
      }
    },
    "line.pip_mocked" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe einen Herold des Lichtlosen Königs schweigend hinausgehen lassen. Mein bestes Publikum. Schwierig, allerdings."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I made a herald of the Lightless King leave in silence. My finest audience. Tough crowd, though."
          }
        }
      }
    },
    "line.pip_pages" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elf Seiten fehlen im großen Buch. Ich habe es gefragt, warum. Bücher sind furchtbare Klatschmäuler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eleven pages gone from the big book. I asked it why. Books are terrible gossips."
          }
        }
      }
    },
    "line.pip_refugees_hint" : {
      "comment" : "Court talk: pip, a hint about refugees_gate.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Tor stehen Leute, die neun Nächte gelaufen sind. Unsere größte Sorge heute war die Suppe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are people at the gate who walked for nine nights. Our biggest worry today was the soup."
          }
        }
      }
    },
    "line.pip_satire" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ganze Tal singt {vom Burgherrn, der|von der Burgherrin, die} nicht zahlen wollte. Ich habe der Ziege den Refrain beigebracht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The whole valley sings about the {lord|lady} who would not pay. I taught the goat the chorus."
          }
        }
      }
    },
    "line.pip_saved_joke" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich hebe den Witz immer noch auf, Eure Dochtheit. Also müsst Ihr uns alle am Leben halten. Das ist ein Befehl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am still saving the joke, Your Wickship. So you must keep us all alive. That is an order."
          }
        }
      }
    },
    "line.pip_turned" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr habt einer Frau mit Laterne das Tor verschlossen. Mutig, für {einen Laternenanzünder|eine Laternenanzünderin}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You shut the gate on a woman with a lantern. Bold, for a lamplighter."
          }
        }
      }
    },
    "line.pip_verse_nine" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strophe neun geht mir nicht aus dem Kopf, Eure Dochtheit. Der Stirnreif ist zu groß, trallala. Meine liebste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verse nine is stuck in my head, Your Wickship. The circlet is too big, tra la. It is my favourite."
          }
        }
      }
    },
    "line.seren_aldric" : {
      "comment" : "Court talk: seren.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Früher hat er viel gelacht. Ich würde es gern noch einmal hören."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He laughed a great deal, before. I would like to hear it once more."
          }
        }
      }
    },
    "line.seren_doubt" : {
      "comment" : "Court talk: seren (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr fragtet, warum erst jetzt. Fragt wieder, wenn er vor Eurer Mauer steht. Ich bin dann noch hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You asked why only now. Ask again when he stands at your wall. I will still be here."
          }
        }
      }
    },
    "line.seren_gate" : {
      "comment" : "Court talk: seren, a hint about stranger_gate.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Licht schwindet, {Laternenanzünder|Laternenanzünderin}. Öffnet, oder seht mir beim Warten zu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The light is going, lamplighter. Open, or watch me wait."
          }
        }
      }
    },
    "line.seren_kitchen" : {
      "comment" : "Court talk: seren.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt, was dort draußen ist, und ich sage: eine Küche. Ich habe es mit anderen Wörtern versucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask what is out there and I say: a kitchen. I have tried other words."
          }
        }
      }
    },
    "line.seren_lantern" : {
      "comment" : "Court talk: seren.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Laterne ist nicht kalt, {Laternenanzünder|Laternenanzünderin}. Sie ist nur sehr weit fort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My lantern is not cold, lamplighter. It is only very far away."
          }
        }
      }
    },
    "line.seren_light" : {
      "comment" : "Court talk: seren.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltet ihn im Licht. Lasst ihn nicht hinausgehen. Keinen Augenblick."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold him in the light. Do not let him walk out of it. Not for a moment."
          }
        }
      }
    },
    "line.seren_nearer" : {
      "comment" : "Court talk: seren.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Nacht kommt es ein wenig näher. Nicht die Kreaturen. Das, was hinter ihnen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every night it comes a little nearer. Not the creatures. The thing behind them."
          }
        }
      }
    },
    "line.seren_night20" : {
      "comment" : "Court talk: seren.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute Nacht stehe ich beim Leuchtfeuer. Wenn er fällt, fange ich auf, was von ihm bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonight I stand by the beacon. If he falls, I will be there to catch what is left."
          }
        }
      }
    },
    "line.seren_patient" : {
      "comment" : "Court talk: seren.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Dunkel ist geduldig. Es ist seine einzige Tugend."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dark is patient. It is its only virtue."
          }
        }
      }
    },
    "line.seren_reveal_hint" : {
      "comment" : "Court talk: seren, a hint about seren_reveal.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommt heute zum Thron. Es gibt etwas, das ich Euch in der ersten Nacht hätte sagen sollen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come to the throne today. There is something I should have told you on the first night."
          }
        }
      }
    },
    "line.seren_vow" : {
      "comment" : "Court talk: seren (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr gabt mir Euer Wort für Aldric. Ich habe schon weniger durch die Düsternis getragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You gave me your word for Aldric. I have carried less than that through the Gloom."
          }
        }
      }
    },
    "line.tamsin_arrows_hint" : {
      "comment" : "Court talk: tamsin, a hint about marek_arrows.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek verkauft heute Pfeile? Mein Vetter hat von dem Kahn gekauft. Die biegen sich im Regen. Merkt Euch das."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek is selling arrows today? My cousin bought from that barge. They bend in the rain. Mark me."
          }
        }
      }
    },
    "line.tamsin_bard_hint" : {
      "comment" : "Court talk: tamsin, a hint about bard_song.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Barde im Saal, {mein Herr|meine Herrin}. Zahlt nichts, besingt alles. Achtet auf Euren Beutel und Euren Ruf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bard in the hall, my {lord|lady}. Pays nothing, sings everything. Mind your purse and your reputation."
          }
        }
      }
    },
    "line.tamsin_cough_hint" : {
      "comment" : "Court talk: tamsin, a hint about ash_cough.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die halbe Gasse hustet grau. Heute kommt jemand deswegen zum Thron. Weidenrinde hilft, sagt ihnen das."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half the lane coughs grey. Someone will come to the throne about it. Willow bark works, tell them."
          }
        }
      }
    },
    "line.tamsin_endless" : {
      "comment" : "Court talk: tamsin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suppe für die Nachtwache, Suppe für die Tagwache. Wenn die Düsternis je endet, backe ich einen Kuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soup for the night watch, soup for the day watch. If the Gloom ever ends, I am baking a cake."
          }
        }
      }
    },
    "line.tamsin_first" : {
      "comment" : "Court talk: tamsin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wieder in meiner Küche, {lord}? {Mein Herr|Meine Herrin}, meine ich. Achtet auf Katze, Ofen und Suppe, in dieser Reihenfolge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back in my kitchen, {lord}? My {lord|lady}, I mean. Mind the cat, the oven and the soup, in that order."
          }
        }
      }
    },
    "line.tamsin_goat_hint" : {
      "comment" : "Court talk: tamsin, a hint about goat_chapel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Kapelle steht eine Ziege und im Saal eine Bäuerin. Hesper tobt. Der beste Tag des Monats."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is a goat in the chapel and a farmwife in the hall. Hesper is furious. Best day this month."
          }
        }
      }
    },
    "line.tamsin_gossip" : {
      "comment" : "Court talk: tamsin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bäckersfrau sagt, die Düsternis rieche nach nasser Asche. Sie muss es wissen. Sie verbrennt das Brot."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The baker’s wife says the Gloom smells of wet ash. She would know. She burns the bread."
          }
        }
      }
    },
    "line.tamsin_guest" : {
      "comment" : "Court talk: tamsin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unser Gast isst die Suppe kalt. Ich frage nicht mehr. Manche Leute sind eben so."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our guest takes her soup cold. I have stopped asking. Some people are like that."
          }
        }
      }
    },
    "line.tamsin_herald_hint" : {
      "comment" : "Court talk: tamsin, a hint about herald_demand.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Saal steht ein Mann, der nicht atmet, {mein Herr|meine Herrin}. Die Milch wurde sauer, als er an meiner Tür vorbeiging."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is a man in the hall who does not breathe, my {lord|lady}. The milk turned when he passed my door."
          }
        }
      }
    },
    "line.tamsin_herbs" : {
      "comment" : "Court talk: tamsin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kräutergarten der Witwe hat meine Suppen gerettet und die halbe Gasse dazu. Weide, Salbei und Minze."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The widow’s herb garden saved my soups and half the lane’s chests. Willow, sage and mint, love."
          }
        }
      }
    },
    "line.tamsin_ludo_hint" : {
      "comment" : "Court talk: tamsin, a hint about ludo_arrives.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Saal steht ein Ritter mit einem Helm wie ein Suppentopf. Er wollte Nachschlag, bevor ich aufgetragen hatte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A knight in the hall with a helmet like a soup pot. He asked for seconds before I served firsts."
          }
        }
      }
    },
    "line.tamsin_miller_hint" : {
      "comment" : "Court talk: tamsin, a hint about miller_hoard.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Müller hat wieder zugesperrt. Die Mütter stehen heute vor Eurem Thron, merkt Euch das."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The miller has locked his doors again. The mothers will be at your throne today, mark me."
          }
        }
      }
    },
    "line.tamsin_mother" : {
      "comment" : "Court talk: tamsin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Mutter ging einmal hinein. Alles, was sie je davon sagte: Das Brot war noch warm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My mother went in once. All she ever said of it was: the bread was still warm."
          }
        }
      }
    },
    "line.tamsin_oven_hint" : {
      "comment" : "Court talk: tamsin, a hint about tamsin_oven.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich komme heute zu Eurer Audienz, {mein Herr|meine Herrin}. Es geht um den Ofen. Es geht immer um den Ofen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I will be at your audience today, my {lord|lady}. It is about the oven. It is always about the oven."
          }
        }
      }
    },
    "line.tamsin_pip" : {
      "comment" : "Court talk: tamsin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip hat gestern eine ganze Pastete gestohlen und es auf die Düsternis geschoben. Die hat wohl Krümel im Bart."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip stole a whole pie yesterday and blamed the Gloom. The Gloom has crumbs in its beard, apparently."
          }
        }
      }
    },
    "line.tamsin_place" : {
      "comment" : "Court talk: tamsin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe wieder für ihn gedeckt. Sagt, ich soll aufhören, und ich höre auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I laid his place again. Tell me to stop and I will."
          }
        }
      }
    },
    "line.tamsin_refugees_hint" : {
      "comment" : "Court talk: tamsin, a hint about refugees_gate.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flüchtlinge am Tor, sechs Stück, und zwei Kleine. Ich habe schon den großen Topf aufgesetzt. Nur so."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refugees at the gate, six of them, and two little ones. I have put the big pot on. Just saying."
          }
        }
      }
    },
    "line.tamsin_stranger_hint" : {
      "comment" : "Court talk: tamsin, a hint about stranger_gate.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Frau mit grauer Laterne am Tor! Der Bäcker schwört, sie sei geradewegs aus dem Nebel gekommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A woman at the gate with a grey lantern! The baker swears she walked out of the fog itself."
          }
        }
      }
    },
    "line.tamsin_well" : {
      "comment" : "Court talk: tamsin, a hint about well_repair.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Marktbrunnen? Grün wie eine Froschhochzeit. Heute kommt bestimmt jemand deswegen betteln, merkt Euch das."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The market well? Green as a frog’s wedding. Someone will come begging about it today, mark me."
          }
        }
      }
    },
    "petition.ash_cough.c1" : {
      "comment" : "Petition ash_cough: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kräuterfrau bezahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay the herb-wife"
          }
        }
      }
    },
    "petition.ash_cough.c2" : {
      "comment" : "Petition ash_cough: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt die Kranken fort"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send the sick away"
          }
        }
      }
    },
    "petition.ash_cough.c3" : {
      "comment" : "Petition ash_cough: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das geht vorüber"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It will pass"
          }
        }
      }
    },
    "petition.ash_cough.hint" : {
      "comment" : "Petition ash_cough: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünfzehn Gold für Weidenrinde oder eine Gasse voller Särge. Diese Rechnung kann sogar ich. Bezahlt die Kräuterfrau."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fifteen gold for willow bark, or a lane full of coffins. Even I can do that sum. Pay the herb-wife."
          }
        }
      }
    },
    "petition.ash_cough.r1" : {
      "comment" : "Petition ash_cough: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei Tage riecht die Gasse nach Weide und Dampf. Dann hört der Husten auf, und ein Junge schläft bis Mittag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lane smells of willow and steam for three days. Then the coughing stops, and somebody’s boy sleeps till noon."
          }
        }
      }
    },
    "petition.ash_cough.r2" : {
      "comment" : "Petition ash_cough: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Familien aus Beaconfoot ziehen über die Talstraße fort. Der Husten hört auf. Das Singen am Brunnen auch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two families of Beaconfoot folk leave by the valley road. The coughing stops. So does the singing at the well."
          }
        }
      }
    },
    "petition.ash_cough.r3a" : {
      "comment" : "Petition ash_cough: choice 3, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es geht binnen einer Woche vorüber, wie solche Dinge eben. Die Kräuterfrau ist empört."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It passes within a week, as such things do. The herb-wife is furious about it."
          }
        }
      }
    },
    "petition.ash_cough.r3b" : {
      "comment" : "Petition ash_cough: choice 3, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es geht nicht vorüber. Der alte Hemmet von der Mühle wacht eines Morgens nicht auf, und die Gasse gibt dem Haus die Schuld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It does not pass. Old Hemmet from the mill does not wake one morning, and the lane blames the house."
          }
        }
      }
    },
    "petition.ash_cough.text" : {
      "comment" : "Petition ash_cough (farmwife, follow-up of refugees_gate): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit die Leute aus Beaconfoot da sind, hustet die halbe Gasse grau. Die Kräuterfrau will fünfzehn Gold für Weidenrinde und Dampf. Manche sagen, schickt die Neuen zurück, woher sie kamen. Ich will nur, dass mein Junge schläft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Since the Beaconfoot folk came, half our lane coughs grey. The herb-wife wants fifteen gold for willow bark and steam. Some say send the newcomers back where they came from. I only want my boy to sleep."
          }
        }
      }
    },
    "petition.bad_arrows.c1" : {
      "comment" : "Petition bad_arrows: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spitzen umschmieden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reforge the heads"
          }
        }
      }
    },
    "petition.bad_arrows.c2" : {
      "comment" : "Petition bad_arrows: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trotzdem verschießen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shoot them anyway"
          }
        }
      }
    },
    "petition.bad_arrows.c3" : {
      "comment" : "Petition bad_arrows: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurück zu Marek damit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send them back to Marek"
          }
        }
      }
    },
    "petition.bad_arrows.hint" : {
      "comment" : "Petition bad_arrows: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünf Gold, um fünfzehn schon verlorene zu retten. Ich hasse es, wenn die Rechnung aufgeht. Lasst Bram sie umschmieden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Five gold to rescue fifteen already lost. I hate it when the arithmetic is right. Let Bram reforge them."
          }
        }
      }
    },
    "petition.bad_arrows.r1" : {
      "comment" : "Petition bad_arrows: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram nickt einmal. Den ganzen Tag klingt die Esse, und zur Dämmerung liegen vierzig Pfeile in einer Reihe, jeder so gerade wie seine Meinungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram nods once. All day the forge rings, and at dusk forty arrows lie in a row, each as straight as his opinions."
          }
        }
      }
    },
    "petition.bad_arrows.r2" : {
      "comment" : "Petition bad_arrows: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Nacht taumeln die Pfeile wie betrunkene Spatzen. Die Rußwesen machen sich nicht einmal die Mühe, sich zu ducken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That night the arrows tumble like drunk sparrows. The soot creatures do not even bother to duck."
          }
        }
      }
    },
    "petition.bad_arrows.r3a" : {
      "comment" : "Petition bad_arrows: choice 3, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Burghof gestellt, zahlt Marek jede Münze zurück und schiebt es auf den Herrn vom See. Der ist ertrunken und widerspricht nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cornered in the courtyard, Marek refunds every coin and blames the lake lord. The lake lord, being drowned, cannot object."
          }
        }
      }
    },
    "petition.bad_arrows.r3b" : {
      "comment" : "Petition bad_arrows: choice 3, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek ist im Morgengrauen über die Flussstraße fort. Auf seine Ladeklappe hat jemand gekreidet: „Kein Umtausch. Herzlichst, M.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek left at dawn by the river road. On the cart’s tailboard someone chalked: “No refunds. Fondly, M.”"
          }
        }
      }
    },
    "petition.bad_arrows.text" : {
      "comment" : "Petition bad_arrows (bram, follow-up of marek_arrows): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mareks Pfeile. Die Hälfte krumm. Der Rest hohl. Befiedert mit Huhn. Ich kann die Spitzen abnehmen und vierzig gute daraus schmieden. Kostet die Esse einen Tag und fünf Gold Kohle. Oder wir verschießen die hier und beten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek’s arrows. Half are bent. The rest are hollow. Fletched with chicken. I can strip the heads and forge forty good ones. Costs the forge a day and five gold of charcoal. Or we shoot these and pray."
          }
        }
      }
    },
    "petition.banners_new.c1" : {
      "comment" : "Petition banners_new: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Banner"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New banners"
          }
        }
      }
    },
    "petition.banners_new.c2" : {
      "comment" : "Petition banners_new: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die halbe Sonne behalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the half sun"
          }
        }
      }
    },
    "petition.banners_new.hint" : {
      "comment" : "Petition banners_new: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparsamkeit und Respekt. Meine zwei Lieblingswörter, und ausnahmsweise sind sie sich einig. Behaltet die alten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thrift and respect. My two favourite words, and for once they agree. Keep the old ones."
          }
        }
      }
    },
    "petition.banners_new.r1" : {
      "comment" : "Petition banners_new: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Abend hängen die neuen Banner, blaugrün und golden. Pip salutiert jedes Mal, wenn er vorbeigeht, und heimlich tut Ihr es auch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new banners go up by evening, teal and gold. Pip salutes them every time he passes, and so, secretly, do you."
          }
        }
      }
    },
    "petition.banners_new.r2" : {
      "comment" : "Petition banners_new: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die alten Banner bleiben. Manche der älteren Wachen nicken ihnen morgens zu, so wie man jemandem zunickt, den man vermisst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The old banners stay. Some of the older guards nod to them in the morning, the way you nod to someone you miss."
          }
        }
      }
    },
    "petition.banners_new.text" : {
      "comment" : "Petition banners_new (odile): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mein Herr|Meine Herrin}, die ältesten Banner im Saal zeigen eine halbe Sonne über der Laterne, und die Motten haben das meiste gefressen. Zwanzig Gold für neues Tuch, schlicht blaugrün und gold. Oder wir behalten die alten, aus Respekt und Sparsamkeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the hall’s oldest banners show half a sun above the lantern, and the moths have eaten most of it. Twenty gold buys new cloth, plain teal and gold. Or we keep the old ones, out of respect and thrift."
          }
        }
      }
    },
    "petition.bard_satire.c1" : {
      "comment" : "Petition bard_satire: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Stille zahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay for silence"
          }
        }
      }
    },
    "petition.bard_satire.c2" : {
      "comment" : "Petition bard_satire: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann singt es eben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sing it, then"
          }
        }
      }
    },
    "petition.bard_satire.c3" : {
      "comment" : "Petition bard_satire: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An den Pranger mit ihm"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put him in the stocks"
          }
        }
      }
    },
    "petition.bard_satire.hint" : {
      "comment" : "Petition bard_satire: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Erpresser zu bezahlen wird zur Gewohnheit. Ihn auszulachen ist die Heilung. Lasst ihn singen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paying a blackmailer is a habit. Laughing at him is a cure. Let him sing."
          }
        }
      }
    },
    "petition.bard_satire.r1" : {
      "comment" : "Petition bard_satire: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Barde nimmt das Gold und singt ein anderes Lied. Es handelt von {einem Burgherrn, der|einer Burgherrin, die} Barden für Stille bezahlt. Auch das ist beliebt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bard takes the gold and sings a different song. It is about a {lord|lady} who pays bards for silence. It is also popular."
          }
        }
      }
    },
    "petition.bard_satire.r2" : {
      "comment" : "Petition bard_satire: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das tut er. Überall. Ihr hört den Refrain im Saal gepfiffen und einmal, ganz leise, aus Odiles Schreibstube."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He does. Everywhere. You hear the chorus whistled in the hall, and once, faintly, from Odile’s study."
          }
        }
      }
    },
    "petition.bard_satire.r3" : {
      "comment" : "Petition bard_satire: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Barde singt vom Pranger aus vor mehr Publikum als je zuvor. Manche bringen Kissen mit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bard sings from the stocks to a larger crowd than ever. Some of them bring cushions."
          }
        }
      }
    },
    "petition.bard_satire.text" : {
      "comment" : "Petition bard_satire (bard, follow-up of bard_song): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}! Ihr erinnert Euch vielleicht an mich. Ich habe ein neues Lied geschrieben: „{Der Burgherr, der|Die Burgherrin, die} nicht zahlen wollte“. Es ist sehr beliebt. Ich könnte natürlich aufhören, es zu singen. Künstler müssen essen. Dreißig Gold kaufen sehr viel Stille."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}! You may remember me. I have written a new song, “The {Lord|Lady} Who Would Not Pay”. It is very popular. I could stop singing it, of course. Artists must eat. Thirty gold buys a great deal of silence."
          }
        }
      }
    },
    "petition.bard_song.c1" : {
      "comment" : "Petition bard_song: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwanzig für die Ballade"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twenty for the ballad"
          }
        }
      }
    },
    "petition.bard_song.c2" : {
      "comment" : "Petition bard_song: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vierzig, ohne Strophe neun"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forty, and lose verse nine"
          }
        }
      }
    },
    "petition.bard_song.c3" : {
      "comment" : "Petition bard_song: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Haus braucht keine Balladen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A house needs no ballads"
          }
        }
      }
    },
    "petition.bard_song.hint" : {
      "comment" : "Petition bard_song: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Lied ist billiger als eine Statue und reist weiter. Bezahlt die Ballade. Behaltet Strophe neun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A song is cheaper than a statue and travels further. Pay for the ballad. Keep verse nine."
          }
        }
      }
    },
    "petition.bard_song.r1" : {
      "comment" : "Petition bard_song: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zum Wochenende singt das Tal den Refrain. Strophe neun handelt davon, dass der Stirnreif zu groß ist. Sie ist die beliebteste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By the week’s end the valley sings the chorus. Verse nine is about the circlet being too big. It is the favourite."
          }
        }
      }
    },
    "petition.bard_song.r2" : {
      "comment" : "Petition bard_song: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Barde singt zehn Strophen, wunderschön. Irgendwie kennt das ganze Tal trotzdem Strophe neun auswendig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bard sings ten verses, beautifully. Somehow the whole valley still knows verse nine by heart."
          }
        }
      }
    },
    "petition.bard_song.r3" : {
      "comment" : "Petition bard_song: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Barde verneigt sich mit einem viel zu breiten Lächeln und geht, etwas Neues und ziemlich Eingängiges summend."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bard bows, smiling far too widely, and leaves humming something new and quite catchy."
          }
        }
      }
    },
    "petition.bard_song.text" : {
      "comment" : "Petition bard_song (bard): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}! Ich habe eine Ballade {vom Laternenanzünder, der Burgherr|von der Laternenanzünderin, die Burgherrin} wurde, gedichtet, elf Strophen, mit einem Refrain über die Laterne. Für zwanzig Gold singe ich sie in jeder Schenke von hier bis zur Küste. Für vierzig lasse ich Strophe neun weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}! I have composed a ballad of the lamplighter {lord|lady}, eleven verses, with a chorus about the lantern. For twenty gold I sing it in every tavern from here to the coast. For forty, I leave out verse nine."
          }
        }
      }
    },
    "petition.barn_fire.c1" : {
      "comment" : "Petition barn_fire: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Haus zahlt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The house pays"
          }
        }
      }
    },
    "petition.barn_fire.c2" : {
      "comment" : "Petition barn_fire: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schützen zahlen von ihrem Sold"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archers pay from their wages"
          }
        }
      }
    },
    "petition.barn_fire.c3" : {
      "comment" : "Petition barn_fire: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schuld ist die Düsternis"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blame the Gloom"
          }
        }
      }
    },
    "petition.barn_fire.hint" : {
      "comment" : "Petition barn_fire: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unser Pfeil, unsere Scheune. Bezahlt sie und bittet Brannock, auf das dunkle Ende des Schlunds zu zielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our arrow, our barn. Pay for it, and ask Brannock to aim at the dark end of the Throat."
          }
        }
      }
    },
    "petition.barn_fire.r1" : {
      "comment" : "Petition barn_fire: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachbarn stellen die neue Scheune an einem Tag auf. Brannock schickt zwei Schützen zum Helfen, als eine Art Entschuldigung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The neighbours raise the new barn in a day. Brannock sends two archers to help, as a kind of apology."
          }
        }
      }
    },
    "petition.barn_fire.r2" : {
      "comment" : "Petition barn_fire: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Scheune wird vom Sold der Schützen neu gebaut. Einer gibt seinen Bogen ab und murmelt, er habe auf einen Rußling gezielt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The barn is rebuilt from the archers’ pay. One of them hands in his bow, muttering that he was aiming at a sootling."
          }
        }
      }
    },
    "petition.barn_fire.r3" : {
      "comment" : "Petition barn_fire: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das schwarze Gerippe der Scheune steht das ganze Jahr am ersten Feld. Niemand lässt Euch vergessen, wessen Pfeil es war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The barn’s black shell stands by the first field all year. Nobody lets you forget whose arrow it was."
          }
        }
      }
    },
    "petition.barn_fire.text" : {
      "comment" : "Petition barn_fire (farmer): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, einer Eurer Brandpfeile ist letzte Nacht zu kurz geflogen und in meiner Scheune gelandet. Das Heu, der Karren, das Dach, alles hin. Eure Schützen sagen, es tue ihnen leid. Den Kühen nicht. Wer bezahlt die neue Scheune?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, one of your fire arrows fell short last night and landed in my barn. The hay, the cart, the roof, all gone. Your archers say sorry. The cows do not. Who pays for a new barn?"
          }
        }
      }
    },
    "petition.beacon_plans.c1" : {
      "comment" : "Petition beacon_plans: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann bauen wir es"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then we build it"
          }
        }
      }
    },
    "petition.beacon_plans.c2" : {
      "comment" : "Petition beacon_plans: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt der Stadt die Pläne"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the town the plans"
          }
        }
      }
    },
    "petition.beacon_plans.c3" : {
      "comment" : "Petition beacon_plans: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mauern gehen vor"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The walls come first"
          }
        }
      }
    },
    "petition.beacon_plans.hint" : {
      "comment" : "Petition beacon_plans: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mauern halten eine Nacht. Das hier könnte die Nächte beenden. Baut es, {mein Herr|meine Herrin}, bevor Brannock einen vierten Turm verlangt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walls hold a night. This could end them. Build it, my {lord|lady}, before Brannock asks for a fourth tower."
          }
        }
      }
    },
    "petition.beacon_plans.r1" : {
      "comment" : "Petition beacon_plans: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile lächelt beinahe. „Ich war so frei, den Platz heute Morgen räumen zu lassen. Versucht, überrascht auszusehen.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile almost smiles. “I took the liberty of having the site cleared this morning. Do try to look surprised.”"
          }
        }
      }
    },
    "petition.beacon_plans.r2" : {
      "comment" : "Petition beacon_plans: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pläne werden am Marktbrunnen angeschlagen. Am Abend malen Kinder Leuchtfeuer in den Staub, viel zu hoch, jedes mit der Tür nach Westen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The plans go up on the market well. By evening children draw beacons in the dust, far too tall, each with its door facing west."
          }
        }
      }
    },
    "petition.beacon_plans.r3" : {
      "comment" : "Petition beacon_plans: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Natürlich“, sagt Odile und legt die Pläne unter Später ab. Ihr bemerkt, dass sie sie nicht sehr tief ablegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Of course,” says Odile, and files the plans under Later. You notice she does not file them very deep."
          }
        }
      }
    },
    "petition.beacon_plans.text" : {
      "comment" : "Petition beacon_plans (odile, story days 11-12): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mein Herr|Meine Herrin}, unter neunhundert Jahren Zehntrollen fand ich dies: Burgherrin Oriels Pläne des Großen Leuchtfeuers. Fundament, Turm, Schale. Am Rand schrieb sie, sein Licht breche jedes Dunkel der Düsternis. Zweimal unterstrichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, under nine hundred years of tithe rolls I found these: Lady Oriel’s plans of the Great Beacon. Footing, tower, bowl. In the margin she wrote that its light breaks any darkness of the Gloom. Twice underlined."
          }
        }
      }
    },
    "petition.bell_for_arrows.c1" : {
      "comment" : "Petition bell_for_arrows: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schmelzt die Glocke ein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melt the bell"
          }
        }
      }
    },
    "petition.bell_for_arrows.c2" : {
      "comment" : "Petition bell_for_arrows: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Glocke bleibt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bell stays"
          }
        }
      }
    },
    "petition.bell_for_arrows.hint" : {
      "comment" : "Petition bell_for_arrows: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Glocke ruft zum Gebet. Pfeile machen es überflüssig. Trotzdem hat Hesper die Kerzen in der Hand. Behaltet die Glocke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bell calls people to prayer. Arrows spare them the need. Still, Hesper controls the candles. Keep the bell."
          }
        }
      }
    },
    "petition.bell_for_arrows.r1" : {
      "comment" : "Petition bell_for_arrows: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Nacht fliegen vierhundert Bronzespitzen von den Mauern. Im Morgengrauen schweigt die Kapelle, und Hesper sieht Euch nicht an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That night four hundred bronze heads fly from the walls. At dawn the chapel is silent, and Hesper does not look at you."
          }
        }
      }
    },
    "petition.bell_for_arrows.r2" : {
      "comment" : "Petition bell_for_arrows: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram zuckt die Schultern. „Dachte ich mir.“ Er geht zurück an die Esse und schlägt das Eisen etwas härter als sonst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram shrugs. “Thought so.” He goes back to his forge and hits the iron a little harder than usual."
          }
        }
      }
    },
    "petition.bell_for_arrows.text" : {
      "comment" : "Petition bell_for_arrows (bram): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kapellenglocke. Gute Bronze. Vierhundert Pfeilspitzen stecken darin, vielleicht mehr. Hesper wird mich hassen. Frage trotzdem. Glocken halten keine Rußlinge auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chapel bell. Good bronze. Four hundred arrowheads in it, maybe more. Hesper will hate me. Asked anyway. Bells don’t stop sootlings."
          }
        }
      }
    },
    "petition.border_family.c1" : {
      "comment" : "Petition border_family: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen im Tal"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to the valley"
          }
        }
      }
    },
    "petition.border_family.c2" : {
      "comment" : "Petition border_family: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur wenn einer auf den Mauern dient"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only if one serves on the walls"
          }
        }
      }
    },
    "petition.border_family.c3" : {
      "comment" : "Petition border_family: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben keinen Platz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We have no room"
          }
        }
      }
    },
    "petition.border_family.hint" : {
      "comment" : "Petition border_family: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Paar Hände mehr für die Felder. Felder fragen nie, woher die Hände kommen. Lasst sie herein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two more pairs of hands for the fields. Fields never ask where hands come from. Let them in."
          }
        }
      }
    },
    "petition.border_family.r1" : {
      "comment" : "Petition border_family: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie schlafen einen Tag und eine Nacht. Dann stehen sie im Morgengrauen auf dem fernen Feld und arbeiten, als könnte der Boden weglaufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They sleep a day and a night. Then they are out in the far field at dawn, working as if the soil might run away."
          }
        }
      }
    },
    "petition.border_family.r2" : {
      "comment" : "Petition border_family: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einer nimmt einen Speer, der andere eine Hacke. Beide blicken zum Schlund, als wüssten sie genau, was darin lebt. Das tun sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One takes a spear, the other a hoe. Both look at the Throat as if they knew exactly what lives in it. They do."
          }
        }
      }
    },
    "petition.border_family.r3" : {
      "comment" : "Petition border_family: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ziehen weiter zur Küste. Tamsin schickt ihnen mit einem Küchenjungen Brot hinterher, und der Junge kommt ohne zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They walk on toward the coast. Tamsin sends bread after them with a kitchen boy, who comes back without it."
          }
        }
      }
    },
    "petition.border_family.text" : {
      "comment" : "Petition border_family (refugee): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir sind zwei weitere aus Beaconfoot, alles, was von einer Familie übrig ist. Die Düsternis nahm unser Haus. Wir schlafen in einer Scheune und bestellen jedes Feld, das Ihr uns gebt. Wir bitten nur, nie wieder draußen schlafen zu müssen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We are two more from Beaconfoot, all that is left of a family. The Gloom took our house. We will sleep in a barn and work any field you give us. We only ask never to sleep outside again."
          }
        }
      }
    },
    "petition.border_scouts.c1" : {
      "comment" : "Petition border_scouts: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfähle und Pech kaufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy the stakes and pitch"
          }
        }
      }
    },
    "petition.border_scouts.c2" : {
      "comment" : "Petition border_scouts: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertraut den Mauern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trust the walls"
          }
        }
      }
    },
    "petition.border_scouts.hint" : {
      "comment" : "Petition border_scouts: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Späher sehen jede Woche eine große Welle. Eines Tages werden sie recht haben. Heute, vermute ich, noch nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scouts see a great wave every week. One day they will be right. Not, I suspect, today."
          }
        }
      }
    },
    "petition.border_scouts.r1" : {
      "comment" : "Petition border_scouts: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zur Dämmerung starrt der Grund des Schlunds vor neuen Pfählen. Als die Welle kommt, ist sie dünner, als sie sein wollte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Throat’s floor bristles with new stakes by dusk. When the wave comes, it comes thinner than it meant to."
          }
        }
      }
    },
    "petition.border_scouts.r2" : {
      "comment" : "Petition border_scouts: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Späher salutiert. In der Nacht tun die Mauern ihre Arbeit, wie Mauern es tun, und die Späher sorgen sich weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scout salutes. That night the walls do their work, as walls do, and the scouts go back to worrying."
          }
        }
      }
    },
    "petition.border_scouts.text" : {
      "comment" : "Petition border_scouts (soldier, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}, die Späher sagen, die Düsternis ballt sich heute Nacht tiefer als sonst, wie ein angehaltener Atem. Zwanzig Gold kaufen zusätzliche Pfähle und Pech für den Grund des Schlunds. Oder wir vertrauen den Mauern, wie immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the scouts say the Gloom is massing deeper than usual tonight, like a held breath. Twenty gold would buy extra stakes and pitch for the Throat’s floor. Or we trust the walls, as we always have."
          }
        }
      }
    },
    "petition.calder_audit.c1" : {
      "comment" : "Petition calder_audit: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steht heute Nacht bei den Schützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stand with the archers tonight."
          }
        }
      }
    },
    "petition.calder_audit.c2" : {
      "comment" : "Petition calder_audit: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seht vom Bergfried aus zu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch from the keep."
          }
        }
      }
    },
    "petition.calder_audit.c3" : {
      "comment" : "Petition calder_audit: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mauer ist kein Ort für Gäste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wall is no place for guests."
          }
        }
      }
    },
    "petition.calder_audit.hint" : {
      "comment" : "Petition calder_audit: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie glaubt nur Büchern. Gebt ihr eine Nacht, die sich eintragen lässt. Bei den Schützen, {mein Herr|meine Herrin}, nicht hinter Glas."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She believes ledgers. Give her a night worth entering in one. With the archers, my {lord|lady}, not behind glass."
          }
        }
      }
    },
    "petition.calder_audit.r1" : {
      "comment" : "Petition calder_audit: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder fragt, wo sie stehen soll und welcher Haken ihrer ist. Brannock reicht ihr eine nummerierte Laterne. Die Nummer schreibt sie zuerst auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder asks where to stand and which hook is hers. Brannock hands her a numbered lantern. She writes the number down first."
          }
        }
      }
    },
    "petition.calder_audit.r2" : {
      "comment" : "Petition calder_audit: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie dankt Euch genau so viel, wie ein Fenster verdient. Die ganze Nacht brennt ihre Kerze im Bergfried. Sie schreibt sehr wenig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She thanks you exactly as much as a window deserves. All night her candle burns in the keep. She writes very little."
          }
        }
      }
    },
    "petition.calder_audit.r3" : {
      "comment" : "Petition calder_audit: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Dann schreibe ich, dass man es mir nicht gezeigt hat“, sagt sie ohne Groll und klappt ihr Buch zu. Es klingt leise und endgültig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Then I shall write that I was not shown,” she says, without heat, and closes her ledger. It makes a small, final sound."
          }
        }
      }
    },
    "petition.calder_audit.text" : {
      "comment" : "Petition calder_audit (ebbaCalder, story days 12-13): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder, Prüferin aus Stillmere. Zehn Generationen der Seestädte haben Euren Lichtzehnt gezahlt und keinen Schatten gesehen, {Lord|Lady} Lantern. Die Syndizi zahlen erst wieder, wenn einer von uns einen sieht. Ich bitte um eine Nacht auf Eurer Mauer und schreibe auf, was ich sehe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder, auditor of Stillmere. Ten generations of lake towns have paid your Lamp Tithe and seen no shadow, {Lord|Lady} Lantern. The syndics voted to stop until one of us does. I ask to stand one night on your wall and write down what I see."
          }
        }
      }
    },
    "petition.captured_sootling.c1" : {
      "comment" : "Petition captured_sootling: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht ihn"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put it out"
          }
        }
      }
    },
    "petition.captured_sootling.c2" : {
      "comment" : "Petition captured_sootling: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behaltet ihn zum Erforschen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it for study"
          }
        }
      }
    },
    "petition.captured_sootling.c3" : {
      "comment" : "Petition captured_sootling: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasst ihn am Schlundtor frei"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let it go at the Throat gate"
          }
        }
      }
    },
    "petition.captured_sootling.hint" : {
      "comment" : "Petition captured_sootling: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht ihn. Wollte die Düsternis, dass wir Haustiere haben, würde sie Kätzchen schicken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put it out. If the Gloom wanted us to have pets, it would send kittens."
          }
        }
      }
    },
    "petition.captured_sootling.r1" : {
      "comment" : "Petition captured_sootling: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper hält das Glas an die Flamme, bis das kleine Ding erlischt. Niemand lacht. Pip nimmt die Mütze ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper holds the jar to the Flame until the small thing goes out. Nobody laughs. Pip takes off his cap."
          }
        }
      }
    },
    "petition.captured_sootling.r2a" : {
      "comment" : "Petition captured_sootling: choice 2, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram findet heraus, dass Gerald Eisenspäne hasst. In der Nacht werden die Pfahlgruben damit bestreut, und weniger Rußlinge kommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram finds that Gerald hates iron filings. That night the stake pits are dusted with them, and fewer sootlings come."
          }
        }
      }
    },
    "petition.captured_sootling.r2b" : {
      "comment" : "Petition captured_sootling: choice 2, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Mitternacht entkommt Gerald aus dem Glas. Der Nebel ist in dieser Nacht dichter denn je, als suche er nach ihm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerald escapes the jar at midnight. The fog that night is thicker than ever, as if it were looking for him."
          }
        }
      }
    },
    "petition.captured_sootling.r3" : {
      "comment" : "Petition captured_sootling: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Dämmerung wird das Glas am Schlundtor geöffnet. Gerald blickt einmal zum Herdlicht zurück, dann geht er, wohin sie alle gehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At dusk the jar is opened at the Throat gate. Gerald looks back once at the hearth light, then goes the way they all go."
          }
        }
      }
    },
    "petition.captured_sootling.text" : {
      "comment" : "Petition captured_sootling (soldier): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}! Wir haben einen Rußling in einem Gurkenglas gefangen! Er ist klein und still und hält sich an die Seite, wo der Herd ist. Hesper sagt, löscht ihn. Odile sagt, erforscht ihn. Pip sagt, gebt ihm einen Namen. Er heißt jetzt Gerald. Was machen wir mit Gerald?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}! We caught a sootling in a pickle jar! It is small and silent and keeps to the side where the hearth is. Hesper says put it out. Odile says study it. Pip says name it. We named it Gerald. What do we do with Gerald?"
          }
        }
      }
    },
    "petition.castle_statue.c1" : {
      "comment" : "Petition castle_statue: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meißelt sie"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carve it"
          }
        }
      }
    },
    "petition.castle_statue.c2" : {
      "comment" : "Petition castle_statue: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nehmt die Steine für Mauern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the stone for walls"
          }
        }
      }
    },
    "petition.castle_statue.hint" : {
      "comment" : "Petition castle_statue: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünfzehn Gold Brot für eine Statue, die die Stadt lieben und Pip verkleiden wird. Lasst meißeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fifteen gold of bread for a statue the town will love and Pip will dress up. Carve it."
          }
        }
      }
    },
    "petition.castle_statue.r1" : {
      "comment" : "Petition castle_statue: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binnen einer Woche steht Sankt Taper in Stein am Ende des Burghofs, die Laterne erhoben. Die Nase ist Eure. Nachts hängt Pip eine echte Laterne daran."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a week Saint Taper stands at the courtyard’s end in stone, lantern raised. The nose is yours. Pip hangs a real lantern on it at night."
          }
        }
      }
    },
    "petition.castle_statue.r2" : {
      "comment" : "Petition castle_statue: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Steinmetze zucken die Schultern und schleppen die Steine zur mittleren Linie. Einer ritzt trotzdem eine winzige Laterne in einen Block."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The masons shrug and haul the stone to the middle line. One of them carves a tiny lantern into a block anyway."
          }
        }
      }
    },
    "petition.castle_statue.text" : {
      "comment" : "Petition castle_statue (builder): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, wir Steinmetze haben Steine von der äußeren Linie übrig. Statuen von Burgherren sind für die Toten und stehen an der Moorstraße. Also: Sankt Taper mit seiner Laterne, für den Burghof, für fünfzehn Gold Brot. Ich nehme Eure Nase."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, we masons have stone left over from the outer line. Statues of lords are for the dead and stand on the moor road. So: Saint Taper with his lantern, for the courtyard, for fifteen gold of bread. I will use your nose."
          }
        }
      }
    },
    "petition.child_question.c1" : {
      "comment" : "Petition child_question: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still und voller Sterne"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiet, and full of stars"
          }
        }
      }
    },
    "petition.child_question.c2" : {
      "comment" : "Petition child_question: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eines Tages wirst du sie sehen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One day you will see them"
          }
        }
      }
    },
    "petition.child_question.c3" : {
      "comment" : "Petition child_question: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daran erinnert sich keiner mehr"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody remembers anymore"
          }
        }
      }
    },
    "petition.child_question.hint" : {
      "comment" : "Petition child_question: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt dem Kind die Wahrheit, aber die schöne Hälfte davon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell the child the truth, but the nice half of it."
          }
        }
      }
    },
    "petition.child_question.r1" : {
      "comment" : "Petition child_question: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kind hört mit riesigen Augen zu und rennt dann los, um allen zu erzählen, {der Burgherr|die Burgherrin} habe die Sterne gezählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The child listens with enormous eyes, then runs off to tell everyone that the {lord|lady} has counted the stars."
          }
        }
      }
    },
    "petition.child_question.r2" : {
      "comment" : "Petition child_question: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kind nickt sehr ernst, als hättet Ihr einen Eid geschworen. Vielleicht habt Ihr das."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The child nods very seriously, as if you had sworn an oath. Perhaps you have."
          }
        }
      }
    },
    "petition.child_question.r3" : {
      "comment" : "Petition child_question: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kind runzelt die Stirn und geht die älteste Frau im Tal fragen, die sich an alles erinnert, und zwar laut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The child frowns, then goes to ask the oldest woman in the valley, who remembers everything, loudly."
          }
        }
      }
    },
    "petition.child_question.text" : {
      "comment" : "Petition child_question (child, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, meine Oma sagt, bevor das Leuchtfeuer erlosch, waren die Nächte still, und von der Mauer sah man sein Licht den ganzen Schlund hinunter. Stimmt das? Wie war das? Ich habe immer nur die Feuer gesehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, my gran says before the beacon went dark the nights were quiet, and from the wall you could see its light all the way down the Throat. Is that true? What was it like? I have only ever seen the fires."
          }
        }
      }
    },
    "petition.chronicle.c1" : {
      "comment" : "Petition chronicle: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt die Chronik"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write the Chronicle"
          }
        }
      }
    },
    "petition.chronicle.c2" : {
      "comment" : "Petition chronicle: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Geschichte kann warten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "History can wait"
          }
        }
      }
    },
    "petition.chronicle.hint" : {
      "comment" : "Petition chronicle: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin natürlich voreingenommen. Ich habe außerdem recht. Bezahlt das Papier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am biased, of course. I am also right. Pay for the paper."
          }
        }
      }
    },
    "petition.chronicle.r1" : {
      "comment" : "Petition chronicle: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schreiber schlägt das alte Buch auf, um es fortzuführen, und findet elf Stummel, wo Burgherr Edric Seiten herausschnitt. Odile beginnt auf einer frischen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scribe opens the old book to carry on from it and finds eleven stubs where Lord Edric cut pages. Odile begins on a clean one."
          }
        }
      }
    },
    "petition.chronicle.r2" : {
      "comment" : "Petition chronicle: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Die Geschichte hat die Angewohnheit, nicht zu warten“, sagt Odile und schreibt es trotzdem auf, auf die Rückseite einer Steuerrolle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“History has a way of not waiting,” says Odile, and writes it down anyway, on the back of a tax roll."
          }
        }
      }
    },
    "petition.chronicle.text" : {
      "comment" : "Petition chronicle (odile, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mein Herr|Meine Herrin}, jemand sollte die Lange Wacht aufschreiben: jede gehaltene Nacht, jeden verlorenen Namen, jeden Narrenwitz. Ich melde mich freiwillig, mit Schreiber, Tinte und gutem Papier. Zwanzig Gold. Geschichte ist nicht billig, aber sie hält."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, someone should write down the Long Watch: every night held, every name lost, every fool’s joke. I volunteer, with a scribe, ink and good paper. Twenty gold. History is not cheap, but it lasts."
          }
        }
      }
    },
    "petition.crow_plague.c1" : {
      "comment" : "Petition crow_plague: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brennt die Stoppeln ab"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burn the stubble"
          }
        }
      }
    },
    "petition.crow_plague.c2" : {
      "comment" : "Petition crow_plague: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vogelscheuchen auf jedes Feld"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarecrows on every field"
          }
        }
      }
    },
    "petition.crow_plague.c3" : {
      "comment" : "Petition crow_plague: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krähen müssen auch fressen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crows must eat too"
          }
        }
      }
    },
    "petition.crow_plague.hint" : {
      "comment" : "Petition crow_plague: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbrannte Stoppeln sind der Hunger von morgen. Vogelscheuchen kosten Stroh und ein wenig Stolz. Vogelscheuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burnt stubble is next year’s hunger. Scarecrows cost straw and a little pride. Scarecrows."
          }
        }
      }
    },
    "petition.crow_plague.r1" : {
      "comment" : "Petition crow_plague: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Rauch treibt die Krähen in den Schlund, wo viele ersticken. In dieser Nacht erreichen nur wenige die Feuerschalen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The smoke drives the crows into the Throat, where many choke. That night few of them reach the braziers."
          }
        }
      }
    },
    "petition.crow_plague.r2" : {
      "comment" : "Petition crow_plague: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Abend hat jedes Feld eine Strohwache, jede wie jemand vom Hof gekleidet. Die von Odile ist die furchterregendste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By evening every field has a straw guard, each dressed like someone at court. Odile’s is the most frightening."
          }
        }
      }
    },
    "petition.crow_plague.r3" : {
      "comment" : "Petition crow_plague: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bauer starrt Euch lange an. Dann geht er heim und setzt sich auf sein Feld, nur um im Weg zu sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The farmer stares at you for a long time. Then he goes home and sits in his field, just to be in the way."
          }
        }
      }
    },
    "petition.crow_plague.text" : {
      "comment" : "Petition crow_plague (farmer, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, die Rußkrähen haben die Felder entdeckt. Sie fressen die Saat nicht. Sie sitzen darauf, zu Hunderten, und die Saat wird grau. Ich kann die Stoppeln abbrennen, um sie zu vertreiben, oder wir versuchen es mit Vogelscheuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the soot crows have found the fields. They do not eat the seed. They sit on it, hundreds of them, and the seed turns grey. I can burn the stubble to drive them off, or we try scarecrows."
          }
        }
      }
    },
    "petition.crow_rags.c1" : {
      "comment" : "Petition crow_rags: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bindet sie fest"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tie them on"
          }
        }
      }
    },
    "petition.crow_rags.c2" : {
      "comment" : "Petition crow_rags: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feuerschalen sind kein Spielzeug"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braziers are no toys"
          }
        }
      }
    },
    "petition.crow_rags.hint" : {
      "comment" : "Petition crow_rags: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kind hat öfter recht als die Generäle. Sagt ja."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The child is right more often than the generals. Say yes."
          }
        }
      }
    },
    "petition.crow_rags.r1" : {
      "comment" : "Petition crow_rags: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem Arm voll rotem Stoff rennt das Kind davon. Heute Nacht ziehen die Krähen weite Kreise."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off runs the child with an armful of red cloth. Tonight the crows circle wide."
          }
        }
      }
    },
    "petition.crow_rags.r2" : {
      "comment" : "Petition crow_rags: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Stampfen, und weg. Hinterher sind der Wache am Tor rätselhafterweise beide Stiefel aufgeschnürt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A stamped foot, and gone. The guard says his bootlaces came undone on the way out."
          }
        }
      }
    },
    "petition.crow_rags.text" : {
      "comment" : "Petition crow_rags (child): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte, {Burgherr|Burgherrin}, Rußkrähen hassen bunte Lumpen! Meine Oma sagt das. Lasst mich vor der Dunkelheit rote Lumpen um die Feuerschalen binden, dann bleiben sie weg. Sechs habe ich schon gebunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please, my {lord|lady}, soot crows hate bright rags! My gran says so. Let me tie red rags round the braziers before dark and they will keep away. I tied six already."
          }
        }
      }
    },
    "petition.deserter.c1" : {
      "comment" : "Petition deserter: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auspeitschen, wie es das Gesetz will"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flog him, as the law says"
          }
        }
      }
    },
    "petition.deserter.c2" : {
      "comment" : "Petition deserter: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt ihn heim in die Stadt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send him home to the town"
          }
        }
      }
    },
    "petition.deserter.c3" : {
      "comment" : "Petition deserter: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begnadigt, zurück auf die Mauer"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pardon him, back to the wall"
          }
        }
      }
    },
    "petition.deserter.hint" : {
      "comment" : "Petition deserter: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ausgepeitschter Soldat bleibt ein Soldat, und die anderen werden sich an die Peitsche erinnern. Begnadigt ihn einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A flogged soldier is still a soldier, and the others will remember the flogging. Pardon him once."
          }
        }
      }
    },
    "petition.deserter.r1" : {
      "comment" : "Petition deserter: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Junge nimmt die Hiebe ohne einen Laut. In der Nacht steht er auf seinem Posten und weicht keinen Schritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The boy takes his strokes without a sound. That night he stands his post and does not move a step."
          }
        }
      }
    },
    "petition.deserter.r2" : {
      "comment" : "Petition deserter: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er gibt seinen Bogen ab und geht heim in die Backstube seiner Mutter. Brannock nennt es Verschwendung. Die Backstube nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He hands in his bow and goes home to his mother’s bakery. Brannock calls it a waste. The bakery does not."
          }
        }
      }
    },
    "petition.deserter.r3" : {
      "comment" : "Petition deserter: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Junge weint, salutiert und weint wieder. Brannock sagt nichts, stellt ihn aber auf der Mauer neben sich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The boy weeps, salutes, then weeps again. Brannock says nothing, but puts the lad next to himself on the wall."
          }
        }
      }
    },
    "petition.deserter.text" : {
      "comment" : "Petition deserter (soldier): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}, der Junge ist von der mittleren Linie gelaufen, als die Hunde kamen. Brannock will ihn auspeitschen lassen. Er ist der Sohn meiner Schwester. Er läuft nicht wieder weg. Das schwöre ich auf meinen eigenen Schild."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the boy ran from the middle line when the hounds came. Brannock wants him flogged. He is my sister’s son. He will not run again. I swear it on my own shield."
          }
        }
      }
    },
    "petition.eclipse_omen.c1" : {
      "comment" : "Petition eclipse_omen: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entzündet die Feuerkörbe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light the fire-baskets"
          }
        }
      }
    },
    "petition.eclipse_omen.c2" : {
      "comment" : "Petition eclipse_omen: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betet stattdessen mit mir"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pray with me instead"
          }
        }
      }
    },
    "petition.eclipse_omen.c3" : {
      "comment" : "Petition eclipse_omen: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omen sind etwas für Priester"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omens are for priests"
          }
        }
      }
    },
    "petition.eclipse_omen.hint" : {
      "comment" : "Petition eclipse_omen: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öl ist billiger als Särge, und beim Mond irrt die Flamme selten. Entzündet die Feuerkörbe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oil is cheaper than coffins, and the Flame is rarely wrong about the moon. Light the fire-baskets."
          }
        }
      }
    },
    "petition.eclipse_omen.r1" : {
      "comment" : "Petition eclipse_omen: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Simse brennen die ganze Nacht wie eine Lichterkette. Der Mond wird schwarz, und der Schlund bleibt hell vom Rand bis zum Grund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ledges burn like a string of lamps all night. The moon goes black, and the Throat stays lit from rim to floor."
          }
        }
      }
    },
    "petition.eclipse_omen.r2" : {
      "comment" : "Petition eclipse_omen: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kapelle füllt sich, und die Stadt betet mit Euch. Der Mond wird trotzdem schwarz, und die Düsternis kommt dicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chapel fills, and the town prays with you. The moon goes black anyway, and the Gloom comes thick."
          }
        }
      }
    },
    "petition.eclipse_omen.r3a" : {
      "comment" : "Petition eclipse_omen: choice 3, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mond bleibt die ganze Nacht silbern. Hesper sagt beim Frühstück nichts, und zwar sehr laut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The moon stays silver all night. Hesper says nothing at breakfast, very loudly."
          }
        }
      }
    },
    "petition.eclipse_omen.r3b" : {
      "comment" : "Petition eclipse_omen: choice 3, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Mitternacht erlischt der Mond wie ein zugedrückter Docht, und die Düsternis kommt in doppelten Reihen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At midnight the moon goes out like a pinched wick, and the Gloom comes in doubled ranks."
          }
        }
      }
    },
    "petition.eclipse_omen.text" : {
      "comment" : "Petition eclipse_omen (hesper, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kind des Hauses, die Flamme sagt, heute Nacht wird der Mond schwarz. In solchen Nächten kommt die Düsternis in doppelten Reihen. Die alten Feuerkörbe auf den Simsen des Schlunds könnten das Dunkel zurückhalten, wenn jemand das Öl bezahlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Child of the house, the Flame says the moon goes black tonight. On such nights the Gloom comes in doubled ranks. The old fire-baskets on the Throat’s ledges could hold the dark back, if someone pays for the oil."
          }
        }
      }
    },
    "petition.envoy_coast.c1" : {
      "comment" : "Petition envoy_coast: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt zwei Schützen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send two archers"
          }
        }
      }
    },
    "petition.envoy_coast.c2" : {
      "comment" : "Petition envoy_coast: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir brauchen jeden Bogen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We need every bow"
          }
        }
      }
    },
    "petition.envoy_coast.c3" : {
      "comment" : "Petition envoy_coast: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt ihnen lieber Lampenöl"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send them lamp oil instead"
          }
        }
      }
    },
    "petition.envoy_coast.hint" : {
      "comment" : "Petition envoy_coast: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silber für zwei Schützen, während die Düsternis jede Nacht kommt. Die Küste kann für uns beten. Lehnt ab, höflich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silver for two archers, while the Gloom comes nightly. The coast can pray for us. Refuse, politely."
          }
        }
      }
    },
    "petition.envoy_coast.r1" : {
      "comment" : "Petition envoy_coast: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Freiwillige reiten im Morgengrauen mit dem Gesandten zur Küste. Odile zählt das Silber zweimal und nennt es Diplomatie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two volunteers ride for the coast with the envoy at dawn. Odile counts the silver twice and calls it diplomacy."
          }
        }
      }
    },
    "petition.envoy_coast.r2" : {
      "comment" : "Petition envoy_coast: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gesandte verneigt sich, nicht überrascht. „Dann betet, dass das Meer Eure Tür nie findet, {Lord|Lady} Lantern.“ Zurück bleibt ein Geruch nach Salz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The envoy bows, unsurprised. “Then pray the sea never finds your door, {Lord|Lady} Lantern.” He leaves a smell of salt behind."
          }
        }
      }
    },
    "petition.envoy_coast.r3" : {
      "comment" : "Petition envoy_coast: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gesandte nimmt das Öl mit echter Dankbarkeit an. „Die Küste wird sich an {den Laternenanzünder|die Laternenanzünderin} erinnern“, sagt er, und er meint es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The envoy accepts the oil with real gratitude. “The coast will remember the lamplighter,” he says, and means it."
          }
        }
      }
    },
    "petition.envoy_coast.text" : {
      "comment" : "Petition envoy_coast (envoy): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Lord|Lady} Lantern, ich bringe schlechte Nachrichten von der Küste. Das Meer steigt jede Nacht höher, und Dinge klettern unsere Klippen hinauf, dem Leuchtturm entgegen. Meine Herrin bittet um zwei Schützen, die das Dunkel kennen. Sie zahlt in Silber."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Lord|Lady} Lantern, I bring ill news from the coast. The sea rises higher every night, and things climb our cliffs toward the lighthouse. My lady asks for two archers who know the dark. She repays in silver."
          }
        }
      }
    },
    "petition.envoy_tide.c1" : {
      "comment" : "Petition envoy_tide: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tor wird sich öffnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gate will open"
          }
        }
      }
    },
    "petition.envoy_tide.c2" : {
      "comment" : "Petition envoy_tide: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das können wir nicht versprechen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We cannot promise that"
          }
        }
      }
    },
    "petition.envoy_tide.hint" : {
      "comment" : "Petition envoy_tide: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Versprechen für eine Truhe Fisch. Diesen Handel würde ich jeden Tag machen. Versprecht es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A promise for a chest of fish. I would make that trade every day of the week. Promise."
          }
        }
      }
    },
    "petition.envoy_tide.r1" : {
      "comment" : "Petition envoy_tide: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gesandte kniet nieder, was Gesandte nie tun. Später verkauft Odile den Salzfisch auf dem Markt und summt dabei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The envoy kneels, which envoys never do. Later Odile sells the salt fish at the market, humming."
          }
        }
      }
    },
    "petition.envoy_tide.r2" : {
      "comment" : "Petition envoy_tide: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er lässt den Fisch trotzdem da. „Für Eure Schützen“, sagt er. „Irgendwer sollte vor dem Ende gut essen.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He leaves the fish anyway. “For your archers,” he says. “Someone should eat well before the end.”"
          }
        }
      }
    },
    "petition.envoy_tide.text" : {
      "comment" : "Petition envoy_tide (envoy): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Lord|Lady} Lantern, noch einmal die Küste. Die schwarze Flut hat unseren unteren Hafen geholt. Meine Herrin schickt eine Truhe Salzfisch und bittet um eines: Wenn die Küste fällt, öffnet sich dann Euer Tor für ihre Leute?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Lord|Lady} Lantern, the coast again. The black tide took our lower harbour. My lady sends a chest of salt fish and asks one thing: if the coast falls, will your gate open to its people?"
          }
        }
      }
    },
    "petition.family_leaving.c1" : {
      "comment" : "Petition family_leaving: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geht mit meinem Segen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go with my blessing"
          }
        }
      }
    },
    "petition.family_leaving.c2" : {
      "comment" : "Petition family_leaving: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt, dieses Jahr zahlt das Haus"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay, and this year is on the house"
          }
        }
      }
    },
    "petition.family_leaving.c3" : {
      "comment" : "Petition family_leaving: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand verlässt das Tal"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody leaves the valley"
          }
        }
      }
    },
    "petition.family_leaving.hint" : {
      "comment" : "Petition family_leaving: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei Steuerzahler, die gehen, sind drei Steuerzahler, die gehen. Zwanzig Gold, um sie zu halten, sind ein Schnäppchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three taxpayers walking away is three taxpayers walking away. Twenty gold to keep them is a bargain."
          }
        }
      }
    },
    "petition.family_leaving.r1" : {
      "comment" : "Petition family_leaving: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ziehen im Morgengrauen los, mit Handkarren und Ziege. Ihr Fenster bleibt dunkel, und die Gasse ist stiller, als sie sein sollte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They leave at dawn with a handcart and a goat. Their window stays dark, and the lane is quieter than it should be."
          }
        }
      }
    },
    "petition.family_leaving.r2" : {
      "comment" : "Petition family_leaving: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zögert, dann schlägt er ein. Am Abend schickt seine Frau eine Pastete hinauf, leicht verbrannt, als Friedensangebot."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He hesitates, then shakes your hand. That evening his wife sends up a pie, slightly burnt, as a peace offering."
          }
        }
      }
    },
    "petition.family_leaving.r3" : {
      "comment" : "Petition family_leaving: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie bleiben. Sie lächeln nicht. Am Abend lächelt auch sonst niemand in ihrer Gasse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They stay. They do not smile. Neither, by evening, does anyone else in their lane."
          }
        }
      }
    },
    "petition.family_leaving.text" : {
      "comment" : "Petition family_leaving (townsman): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, meine Familie zieht an die Küste. Die Nächte sind zu laut, die Steuern zu hoch, und meine Frau sagt, ein Haus, das nie schläft, bleibt nicht stehen. Ich wollte es Euch nur ins Gesicht sagen, wie es sich gehört."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, my family is leaving for the coast. The nights are too loud, the taxes too high, and my wife says a house that never sleeps cannot stand. I only came to say it to your face, as is proper."
          }
        }
      }
    },
    "petition.fence_feud.c1" : {
      "comment" : "Petition fence_feud: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rückt ihn zurück"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move it back"
          }
        }
      }
    },
    "petition.fence_feud.c2" : {
      "comment" : "Petition fence_feud: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilt den Fuß"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Split the foot"
          }
        }
      }
    },
    "petition.fence_feud.c3" : {
      "comment" : "Petition fence_feud: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kohlrennen soll entscheiden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settle it with a cabbage race"
          }
        }
      }
    },
    "petition.fence_feud.hint" : {
      "comment" : "Petition fence_feud: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rückt ihn zurück. Ein Zaun, der einmal geht, geht wieder, und bald wandert das ganze Tal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move it back. A fence that walks once will walk again, and soon the whole valley is moving."
          }
        }
      }
    },
    "petition.fence_feud.r1" : {
      "comment" : "Petition fence_feud: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zaun kommt zurück. Der Nachbar murmelt, er werde einfach wieder gehen. In dieser Nacht tut er es nicht, vielleicht aus Scham."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The fence goes back. The neighbour mutters that it will only walk again. That night it does not, possibly from shame."
          }
        }
      }
    },
    "petition.fence_feud.r2" : {
      "comment" : "Petition fence_feud: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder bekommt einen halben Fuß. Beide murren. Daran erkennt man, dass es gerecht war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each gets half a foot. Both grumble. That is how you know it was fair."
          }
        }
      }
    },
    "petition.fence_feud.r3a" : {
      "comment" : "Petition fence_feud: choice 3, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ganze Tal kommt zum Zuschauen. Der Bittsteller gewinnt um einen Kohlkopf und wird im Triumph heimgetragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The whole valley turns out to watch. The petitioner wins by a cabbage and is carried home in triumph."
          }
        }
      }
    },
    "petition.fence_feud.r3b" : {
      "comment" : "Petition fence_feud: choice 3, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Nachbar gewinnt und behält den Fuß. Der Bittsteller schwört, die Kohlköpfe seien verhext gewesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The neighbour wins and keeps the foot. The petitioner swears the cabbages were enchanted."
          }
        }
      }
    },
    "petition.fence_feud.text" : {
      "comment" : "Petition fence_feud (farmer, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, mein Nachbar hat unseren Zaun in der Nacht einen Fuß weit auf mein Land gerückt. Er sagt, der Zaun sei von selbst gegangen, aus Angst vor der Düsternis. Zäune gehen nicht. Ich will meinen Fuß zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, my neighbour moved our fence a foot onto my land in the night. He says the fence walked by itself, out of fear of the Gloom. Fences do not walk. I want my foot back."
          }
        }
      }
    },
    "petition.first_plough.c1" : {
      "comment" : "Petition first_plough: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Pflug segnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bless the plough"
          }
        }
      }
    },
    "petition.first_plough.c2" : {
      "comment" : "Petition first_plough: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Ein Burgherr|Eine Burgherrin} segnet keine Werkzeuge"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A {lord|lady} blesses no tools"
          }
        }
      }
    },
    "petition.first_plough.hint" : {
      "comment" : "Petition first_plough: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Antwort kostet Gold oder Wohlwollen, {Burgherr|Burgherrin} {lord}. Diese kostet einen Segen, und Segen sind umsonst. Segnet den Pflug."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every answer costs gold or goodwill, {Lord|Lady} {lord}. This one costs a blessing, and blessings are free. Bless the plough."
          }
        }
      }
    },
    "petition.first_plough.r1" : {
      "comment" : "Petition first_plough: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er strahlt, küsst die Pflugschar und läuft los, um es bis Mittag dem halben Tal zu erzählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He beams, kisses the blade and runs off to tell half the valley before noon."
          }
        }
      }
    },
    "petition.first_plough.r2" : {
      "comment" : "Petition first_plough: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schlurft hinaus. Ihr hört ihn der Wache sagen, der Stirnreif sei ohnehin zu groß."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He shuffles out. You hear him tell the guard that the circlet looks too big anyway."
          }
        }
      }
    },
    "petition.first_plough.text" : {
      "comment" : "Petition first_plough (farmer, story day 1): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}! Der Frost hat mir den Pflug gesprengt, just an dem Morgen, als der Stirnreif an Euch ging. Die Leute sagen, die Hand {eines neuen Burgherrn|einer neuen Burgherrin} bringt Glück. Segnet Ihr den neuen, bevor ich das lange Feld umbreche?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}! The frost cracked my plough on the very morning the circlet passed. Folk say a new {lord|lady}’s touch brings luck. Would you bless the new one before I break the long field?"
          }
        }
      }
    },
    "petition.footbridge.c1" : {
      "comment" : "Petition footbridge: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Steg flicken"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mend the bridge"
          }
        }
      }
    },
    "petition.footbridge.c2" : {
      "comment" : "Petition footbridge: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nehmt die alten Palisadenpfähle"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the old palisade stakes"
          }
        }
      }
    },
    "petition.footbridge.c3" : {
      "comment" : "Petition footbridge: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watet noch eine Weile"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wade a while longer"
          }
        }
      }
    },
    "petition.footbridge.hint" : {
      "comment" : "Petition footbridge: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwanzig Gold für einen Steg jetzt oder vierzig für Wagenräder bis zum Sommer. Lasst ihn flicken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twenty gold for a bridge now, or forty for cart wheels by summer. Mend it."
          }
        }
      }
    },
    "petition.footbridge.r1" : {
      "comment" : "Petition footbridge: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Abend steht der Steg, ein wenig schief, aber stolz. Die Kinder rennen bis zur Dunkelheit darüber hin und her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By evening the bridge stands, a little crooked but proud. Children run across it until dark."
          }
        }
      }
    },
    "petition.footbridge.r2a" : {
      "comment" : "Petition footbridge: choice 2, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die alten Pfähle ergeben einen soliden Steg. Jemand ritzt „Lanterns Steg“ ins Geländer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The old stakes make a sturdy bridge. Someone carves “Lantern’s crossing” into the rail."
          }
        }
      }
    },
    "petition.footbridge.r2b" : {
      "comment" : "Petition footbridge: choice 2, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die alten Pfähle halten einen Tag. Dann halten sie stattdessen den Bach auf, und eine Kuh ist sehr überrascht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The old stakes hold for a day. Then they hold the brook instead, and a cow is very surprised."
          }
        }
      }
    },
    "petition.footbridge.r3" : {
      "comment" : "Petition footbridge: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er nickt, krempelt bedeutungsvoll die Hosen hoch und hinterlässt eine Spur nasser Fußabdrücke quer durch den Saal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He nods, rolls up his trousers in a meaningful way, and leaves a trail of wet footprints across the hall."
          }
        }
      }
    },
    "petition.footbridge.text" : {
      "comment" : "Petition footbridge (builder): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, der Steg über den Bach ist im Frühjahr weggeschwemmt worden. Die Leute waten zum fernen Feld, und diese Woche haben zwei Karren ein Rad verloren. Zwanzig Gold für Bretter und Pflöcke. Den Rest mache ich für Suppe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the footbridge over the brook washed out in the spring. Folk wade to the far field, and two carts lost wheels this week. Twenty gold buys planks and pegs. I do the rest for soup."
          }
        }
      }
    },
    "petition.goat_chapel.c1" : {
      "comment" : "Petition goat_chapel: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neues Altartuch bezahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay for a new altar cloth"
          }
        }
      }
    },
    "petition.goat_chapel.c2" : {
      "comment" : "Petition goat_chapel: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ziege gehört der Flamme"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goat belongs to the Flame"
          }
        }
      }
    },
    "petition.goat_chapel.c3" : {
      "comment" : "Petition goat_chapel: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ziege geht nach Hause"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goat goes home"
          }
        }
      }
    },
    "petition.goat_chapel.hint" : {
      "comment" : "Petition goat_chapel: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Ziege ist Eigentum, und die Flamme besitzt schon genug. Schickt sie nach Hause."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A goat is property, and the Flame owns quite enough already. Send it home."
          }
        }
      }
    },
    "petition.goat_chapel.r1" : {
      "comment" : "Petition goat_chapel: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle gehen zufrieden, bis auf die Ziege, die gerade Geschmack an Stickereien gefunden hatte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone leaves content except the goat, who had grown fond of embroidery."
          }
        }
      }
    },
    "petition.goat_chapel.r2" : {
      "comment" : "Petition goat_chapel: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ziege bekommt ein Band und eine Ecke der Kapelle. Sie frisst das Band. Hesper nennt das ein Zeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goat gets a ribbon and a corner of the chapel. It eats the ribbon. Hesper calls this a sign."
          }
        }
      }
    },
    "petition.goat_chapel.r3" : {
      "comment" : "Petition goat_chapel: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ziege trabt heim. Mutter Hesper spricht einen Tag lang nicht mit Euch, was manche bei Hofe einen Segen nennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goat trots home. Mother Hesper does not speak to you for a day, which some at court call a blessing."
          }
        }
      }
    },
    "petition.goat_chapel.text" : {
      "comment" : "Petition goat_chapel (farmwife): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, meine Ziege ist in die Kapelle spaziert und hat Mutter Hespers Altartuch gefressen. Sie sagt, die Ziege sei nun heilig und müsse bleiben. Es ist meine einzige Ziege. Sie ist nicht heilig. Sie hat nur Hunger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, my goat wandered into the chapel and ate Mother Hesper’s altar cloth. She says the goat is now holy and must stay. It is my only goat. It is not holy. It is just hungry."
          }
        }
      }
    },
    "petition.guards_on_wall.c1" : {
      "comment" : "Petition guards_on_wall: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt sie auf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Post them"
          }
        }
      }
    },
    "petition.guards_on_wall.c2" : {
      "comment" : "Petition guards_on_wall: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasst sie tagsüber schlafen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let them sleep by day"
          }
        }
      }
    },
    "petition.guards_on_wall.hint" : {
      "comment" : "Petition guards_on_wall: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelangweilte Wachen sind der billigste Trost, den ein Haus kaufen kann. Stellt sie auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bored guards are the cheapest comfort a house can buy. Post them."
          }
        }
      }
    },
    "petition.guards_on_wall.r1" : {
      "comment" : "Petition guards_on_wall: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Wachen stehen den ganzen Tag glänzend auf dem Wehrgang. Kinder winken ihnen. Sie dürfen nicht zurückwinken und tun es doch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two guards stand on the wall walk all day, gleaming. Children wave at them. They are not allowed to wave back, and do."
          }
        }
      }
    },
    "petition.guards_on_wall.r2" : {
      "comment" : "Petition guards_on_wall: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock brummt. „Ausgeruhte Wachen also.“ In der Nacht sind seine Männer hellwach, und die Stadt merkt nichts davon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock grunts. “Rested guards, then.” That night his men are sharp and the town is none the wiser."
          }
        }
      }
    },
    "petition.guards_on_wall.text" : {
      "comment" : "Petition guards_on_wall (brannock): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}. Tagsüber steht der Wehrgang leer, und die Stadt schaut auf eine leere Mauer. Gebt mir zwei Wachen da oben, in voller Rüstung, bei Sonne und Regen. Kostet nichts außer ihrer Langeweile. Die Stadt wird besser schlafen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Lord|My lady}. By day the wall walk stands empty, and the town looks up at an empty wall. Give me two guards up there in full kit, sun or rain. Costs nothing but their boredom. The town will sleep better."
          }
        }
      }
    },
    "petition.haunted_cellar.c1" : {
      "comment" : "Petition haunted_cellar: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt zwei Wachen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send two guards"
          }
        }
      }
    },
    "petition.haunted_cellar.c2" : {
      "comment" : "Petition haunted_cellar: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt Mutter Hesper"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send Mother Hesper"
          }
        }
      }
    },
    "petition.haunted_cellar.c3" : {
      "comment" : "Petition haunted_cellar: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratten. Kauft eine Katze."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rats. Buy a cat."
          }
        }
      }
    },
    "petition.haunted_cellar.hint" : {
      "comment" : "Petition haunted_cellar: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratten flüstern nicht. Ich auch nicht, wenn es um Dinge der Flamme geht. Schickt Mutter Hesper."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rats do not whisper. Neither do I, about matters of the Flame. Send Mother Hesper."
          }
        }
      }
    },
    "petition.haunted_cellar.r1a" : {
      "comment" : "Petition haunted_cellar: choice 1, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wachen finden ihren Bruder, seit dem Frühjahr als verloren gezählt, hinter den Fässern. Er kam im Morgengrauen durchs Schlundtor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The guards find her brother, counted lost in spring, sitting behind the barrels. He came in by the Throat gate at dawn."
          }
        }
      }
    },
    "petition.haunted_cellar.r1b" : {
      "comment" : "Petition haunted_cellar: choice 1, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wachen finden eine Decke, eine kalte Lampe und niemanden. In dieser Nacht kommt der Nebel weiter als je zuvor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The guards find a blanket, a cold lamp and nobody. That night the fog comes further than ever."
          }
        }
      }
    },
    "petition.haunted_cellar.r2" : {
      "comment" : "Petition haunted_cellar: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper geht allein hinunter und kommt mit dem Bruder der Frau herauf, seit dem Frühjahr als verloren gezählt. Er sagt nur: „Eine blaue Tür.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper goes down alone and comes up with the woman’s brother, counted lost in spring. All he says is: “A blue door.”"
          }
        }
      }
    },
    "petition.haunted_cellar.r3" : {
      "comment" : "Petition haunted_cellar: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin leiht ihr die Küchenkatze. Die Katze geht hinunter, kommt sehr schnell wieder herauf und weigert sich, darüber zu reden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin lends her the kitchen cat. The cat goes down, comes up very fast, and refuses to discuss it."
          }
        }
      }
    },
    "petition.haunted_cellar.text" : {
      "comment" : "Petition haunted_cellar (townswoman): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, nachts kratzt etwas in meinem Keller, und die Kerzen dort unten gehen von selbst aus. Mein Mann sagt, Ratten. Ratten flüstern nicht. Ich will Soldaten, oder einen Priester, oder beides."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, something scratches in my cellar at night, and the candles down there go out by themselves. My husband says rats. Rats do not whisper. I want soldiers, or a priest, or both."
          }
        }
      }
    },
    "petition.herald_alone.c1" : {
      "comment" : "Petition herald_alone: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Öl ausgießen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour out the oil"
          }
        }
      }
    },
    "petition.herald_alone.c2" : {
      "comment" : "Petition herald_alone: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keinen Tropfen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not a single drop"
          }
        }
      }
    },
    "petition.herald_alone.hint" : {
      "comment" : "Petition herald_alone: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Dunkel zu bezahlen ist, wie einen Streuner zu füttern. Er kommt wieder und bringt Freunde mit. Keinen Tropfen, {mein Herr|meine Herrin}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paying the dark is like feeding a stray. It comes back, and it brings friends. Not a drop, my {lord|lady}."
          }
        }
      }
    },
    "petition.herald_alone.r1" : {
      "comment" : "Petition herald_alone: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Dämmerung fließt Lampenöl für sechzig Gold über den Grund des Schlunds. Im Morgengrauen ist jede Rußspur fort. Den Wachen gefällt die Stille nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At dusk sixty gold of lamp oil runs out over the Throat’s floor. At dawn every soot track is gone. The guards dislike the quiet."
          }
        }
      }
    },
    "petition.herald_alone.r2" : {
      "comment" : "Petition herald_alone: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Dann holt er es sich aus der Asche“, sagt der Herold. Im Staub des Saals hinterlässt er keine Fußspuren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Then he will take it from the ashes,” says the herald. In the dust of the hall he leaves no footprints."
          }
        }
      }
    },
    "petition.herald_alone.text" : {
      "comment" : "Petition herald_alone (herald, story day 17): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der König unter der Düsternis grüßt {den Laternenanzünder|die Laternenanzünderin}. Die Frau mit der grauen Laterne ist nicht hier, sieht er. Also verlangt er Geringeres: Lampenöl für sechzig Gold, bei Dämmerung auf dem Grund des Schlunds ausgegossen. Gießt es aus, und Eure Stadt schläft drei Nächte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The King beneath the Gloom greets the lamplighter. The woman with the grey lantern is not here, he sees. So he asks less: sixty gold of lamp oil, poured out on the Throat’s floor at dusk. Pour it, and your town sleeps three nights."
          }
        }
      }
    },
    "petition.herald_demand.c1" : {
      "comment" : "Petition herald_demand: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nehmt sie mit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take her"
          }
        }
      }
    },
    "petition.herald_demand.c2" : {
      "comment" : "Petition herald_demand: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie bleibt. Sagt ihm das."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She stays. Tell him so."
          }
        }
      }
    },
    "petition.herald_demand.c3" : {
      "comment" : "Petition herald_demand: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll er es doch versuchen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell him to come and try"
          }
        }
      }
    },
    "petition.herald_demand.hint" : {
      "comment" : "Petition herald_demand: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Haus, das seine Gäste ausliefert, hat bald keine mehr. Und wenn er sie will, brauchen wir sie. Lehnt ab. Höflich, wenn es sein muss."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A house that hands over its guests soon has none. And if he wants her, we need her. Refuse him. Politely, if you must."
          }
        }
      }
    },
    "petition.herald_demand.r1" : {
      "comment" : "Petition herald_demand: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren erhebt sich, bevor jemand sie berühren kann. Sie nimmt ihre graue Laterne ab, geht neben dem Herold hinaus und blickt nicht zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren rises before anyone can touch her. She takes down her grey lantern, walks out beside the herald and does not look back."
          }
        }
      }
    },
    "petition.herald_demand.r2" : {
      "comment" : "Petition herald_demand: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die kalten Augen des Herolds ruhen lange auf Euch. „Er wird sich an {den Laternenanzünder|die Laternenanzünderin} erinnern.“ In dieser Nacht drängt die Düsternis härter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The herald’s cold eyes rest on you a long moment. “He will remember the lamplighter.” That night the Gloom comes harder."
          }
        }
      }
    },
    "petition.herald_demand.r3" : {
      "comment" : "Petition herald_demand: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip lacht zuerst, dann die Wachen, dann der ganze Saal. Der Herold geht schweigend. In dieser Nacht kommt die Düsternis mit aller Wucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip laughs first, then the guards, then the whole hall. The herald leaves in silence. That night the Gloom comes hard."
          }
        }
      }
    },
    "petition.herald_demand.text" : {
      "comment" : "Petition herald_demand (herald, story day 17): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der König unter der Düsternis grüßt {den Laternenanzünder auf seinem|die Laternenanzünderin auf ihrem} geliehenen Stuhl. Er will nur die Frau mit der grauen Laterne. Gebt sie mir, und drei Nächte lang wird Euer Städtchen schlafen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The King beneath the Gloom greets the lamplighter on {his|her} borrowed chair. He wants only the woman with the grey lantern. Give her to me, and for three nights your little town will sleep."
          }
        }
      }
    },
    "petition.hesper_bowl.c1" : {
      "comment" : "Petition hesper_bowl: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schale kaufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy the bowl"
          }
        }
      }
    },
    "petition.hesper_bowl.c2" : {
      "comment" : "Petition hesper_bowl: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Flamme brennt gut genug"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Flame burns well enough"
          }
        }
      }
    },
    "petition.hesper_bowl.hint" : {
      "comment" : "Petition hesper_bowl: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreißig Gold für ein Lied bei Sonnenaufgang. Die Flamme brannte vor der Schale und wird es auch danach tun. Behaltet das Gold."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thirty gold for a song at sunrise. The Flame burned before the bowl and will after it. Keep the gold."
          }
        }
      }
    },
    "petition.hesper_bowl.r1" : {
      "comment" : "Petition hesper_bowl: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Morgengrauen glänzt die neue Schale auf dem Altar, und Hesper singt den alten Segen über das Tal. Sogar Brannock nimmt den Helm ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At dawn the new bowl gleams on the altar, and Hesper sings the old blessing over the valley. Even Brannock takes off his helmet."
          }
        }
      }
    },
    "petition.hesper_bowl.r2" : {
      "comment" : "Petition hesper_bowl: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper verneigt sich. „Sie brennt“, stimmt sie zu. „Das ist nicht dasselbe wie segnen.“ Sie erwähnt es nicht wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper bows. “It burns,” she agrees. “That is not the same as blessing.” She does not mention it again."
          }
        }
      }
    },
    "petition.hesper_bowl.text" : {
      "comment" : "Petition hesper_bowl (hesper): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kind des Hauses, die alte Opferschale der Flamme ist in der Kälte gesprungen. Eine neue aus Bronze kostet dreißig Gold. Mit ihr kann die Kapelle das Tal an jedem Morgen segnen, wie in Aldrics Wacht. Ohne sie brennt die Flamme nur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Child of the house, the Flame’s old offering bowl cracked in the cold. A new one in bronze costs thirty gold. With it, the chapel can bless the valley at every dawn, as it did in Aldric’s watch. Without it, the Flame only burns."
          }
        }
      }
    },
    "petition.hesper_giant.c1" : {
      "comment" : "Petition hesper_giant: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltet die Wache allein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the vigil alone"
          }
        }
      }
    },
    "petition.hesper_giant.c2" : {
      "comment" : "Petition hesper_giant: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruft die Stadt in die Kapelle"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Call the town to the chapel"
          }
        }
      }
    },
    "petition.hesper_giant.c3" : {
      "comment" : "Petition hesper_giant: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht der Stadt keine Angst"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not frighten the town"
          }
        }
      }
    },
    "petition.hesper_giant.hint" : {
      "comment" : "Petition hesper_giant: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Flamme hat sich schon geirrt, aber nie in einer solchen Nacht. Lasst sie wachen und spart die Kerzen für später."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Flame has been wrong before, never on a night like this. Let her keep her vigil, and save the candles for later."
          }
        }
      }
    },
    "petition.hesper_giant.r1" : {
      "comment" : "Petition hesper_giant: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie verneigt sich und kehrt zur Flamme zurück. Die ganze Nacht rührt sich ihr Schatten nicht, nicht einmal, als der Boden zu beben beginnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She bows and returns to the Flame. All night her shadow does not move, not even when the ground begins to shake."
          }
        }
      }
    },
    "petition.hesper_giant.r2" : {
      "comment" : "Petition hesper_giant: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zur Dämmerung ist die Kapelle übervoll. Hundert Kerzen brennen vor dem Altar, und einen Abend lang hat niemand im Tal Angst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By dusk the chapel overflows. A hundred candles burn before the altar, and for one evening nobody in the valley is afraid."
          }
        }
      }
    },
    "petition.hesper_giant.r3" : {
      "comment" : "Petition hesper_giant: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie senkt den Blick. „Wie Ihr sagt.“ Als in der Nacht der Boden bebt, erfährt die Stadt es vom Boden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She lowers her eyes. “As you say.” That night, when the ground shakes, the town hears of it from the ground."
          }
        }
      }
    },
    "petition.hesper_giant.text" : {
      "comment" : "Petition hesper_giant (hesper, story day 10): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Flamme brannte im Morgengrauen schwarz, Kind des Hauses, drei Atemzüge lang. Das tat sie schon einmal, in der Nacht, als die äußere Linie fiel, in Burgherrin Ysmays Wacht. Heute Nacht geht etwas Schweres durch die Düsternis. Lasst mich Wache halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Flame burned black at dawn, child of the house, for the space of three breaths. It did that once before, the night the outer line fell, in Lady Ysmay’s watch. Something heavy walks in the Gloom tonight. Let me keep a vigil."
          }
        }
      }
    },
    "petition.keep_window.c1" : {
      "comment" : "Petition keep_window: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pflegt den Brauch"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the custom"
          }
        }
      }
    },
    "petition.keep_window.c2" : {
      "comment" : "Petition keep_window: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir brauchen jedes Licht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We need every light"
          }
        }
      }
    },
    "petition.keep_window.hint" : {
      "comment" : "Petition keep_window: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bräuche kosten nichts, und Soldaten merken sich, wer sie pflegt. Pflegt ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Customs cost nothing, and soldiers notice who keeps them. Keep it."
          }
        }
      }
    },
    "petition.keep_window.r1" : {
      "comment" : "Petition keep_window: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Nacht bleibt ein Fenster des Bergfrieds dunkel. Auf den Mauern blicken die Schützen hinauf und stehen ein wenig gerader."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That night one window of the keep stays dark. On the walls, the archers glance up at it, and stand a little straighter."
          }
        }
      }
    },
    "petition.keep_window.r2" : {
      "comment" : "Petition keep_window: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper neigt den Kopf. „Zuerst die Lebenden also.“ Nachts strahlt der Bergfried, und niemand erwähnt den alten Brauch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper inclines her head. “The living first, then.” The keep blazes at night, and nobody mentions the old custom."
          }
        }
      }
    },
    "petition.keep_window.text" : {
      "comment" : "Petition keep_window (hesper): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kind des Hauses, nach der Zählung bleibt für jede Laterne, die nicht heimkommt, ihr Haken in der Kapelle ein Jahr leer und ein Fenster des Bergfrieds dunkel, damit der Schlund sieht, dass wir uns erinnern. Der Brauch endete mit Aldric. Pflegen wir ihn wieder?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Child of the house, by the Count a lantern that does not come back leaves its hook in the chapel empty for a year, and one keep window dark, so the Throat can see we remember. The custom lapsed with Aldric. Shall we keep it again?"
          }
        }
      }
    },
    "petition.lantern_lanes.c1" : {
      "comment" : "Petition lantern_lanes: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erleuchtet die Gassen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light the lanes"
          }
        }
      }
    },
    "petition.lantern_lanes.c2" : {
      "comment" : "Petition lantern_lanes: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tragt Eure eigene Laterne"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carry your own lantern"
          }
        }
      }
    },
    "petition.lantern_lanes.hint" : {
      "comment" : "Petition lantern_lanes: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Ein Laternenanzünder als Burgherr, der|Eine Laternenanzünderin als Burgherrin, die} Laternen verweigert. Die Barden würden das nie vergessen. Erleuchtet die Gassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lamplighter {lord|lady} who refuses lanterns. The bards would never let it go. Light the lanes."
          }
        }
      }
    },
    "petition.lantern_lanes.r1" : {
      "comment" : "Petition lantern_lanes: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An diesem Abend zündet Ihr die erste selbst an, aus alter Gewohnheit. Die ganze Gasse jubelt, und Euch fällt fast die Stange aus der Hand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That evening you light the first one yourself, out of habit. The whole lane cheers, and you nearly drop the pole."
          }
        }
      }
    },
    "petition.lantern_lanes.r2" : {
      "comment" : "Petition lantern_lanes: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er verneigt sich. Bis zum Wochenende verkauft jedes Haus kleine Laternen, zu Preisen, auf die Odile stolz wäre."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He bows. By the week’s end every house sells little lanterns, at prices that make Odile proud of them."
          }
        }
      }
    },
    "petition.lantern_lanes.text" : {
      "comment" : "Petition lantern_lanes (townsman): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, die Gassen hinter dem Markt sind nach der Dämmerung schwarz wie ein Kamin. Die Leute stolpern, die Diebe nicht. Fünfzehn Gold, und an jeder Ecke hängt eine Laterne. Gerade Ihr wisst doch, was eine Laterne wert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the lanes behind the market are black as a chimney after dusk. Folk trip, thieves don’t. Fifteen gold hangs a lantern on every corner. You of all people know what a lantern is worth."
          }
        }
      }
    },
    "petition.lantern_night.c1" : {
      "comment" : "Petition lantern_night: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tausend Laternen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A thousand lanterns"
          }
        }
      }
    },
    "petition.lantern_night.c2" : {
      "comment" : "Petition lantern_night: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Laterne pro Haus"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One lantern per house"
          }
        }
      }
    },
    "petition.lantern_night.c3" : {
      "comment" : "Petition lantern_night: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Düsternis würde nur lachen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Gloom would only laugh"
          }
        }
      }
    },
    "petition.lantern_night.hint" : {
      "comment" : "Petition lantern_night: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Laterne pro Haus zahlt die Stadt, nicht das Haus. Meine liebste Art von Fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One lantern per house costs the town, not the house. My favourite kind of festival."
          }
        }
      }
    },
    "petition.lantern_night.r1" : {
      "comment" : "Petition lantern_night: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tal leuchtet wie ein Sternenfeld. Sogar die Schützen auf der Mauer drehen sich um, nur für einen Augenblick."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The valley glows like a field of stars. Even the archers on the wall turn round to look, just for a moment."
          }
        }
      }
    },
    "petition.lantern_night.r2" : {
      "comment" : "Petition lantern_night: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Fenster bekommt ein kleines Licht. Es ist stiller, als Pip wollte, und schöner, als er erwartet hatte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each window gets one small light. It is quieter than Pip wanted and lovelier than he expected."
          }
        }
      }
    },
    "petition.lantern_night.r3" : {
      "comment" : "Petition lantern_night: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Das tut sie immer“, sagt Pip. „Deshalb sollten wir zuerst lachen.“ Er schmollt den Rest des Tages."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“It always does,” says Pip. “That is why we should laugh first.” He sulks for the rest of the day."
          }
        }
      }
    },
    "petition.lantern_night.text" : {
      "comment" : "Petition lantern_night (pip, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Dochtheit, ich schlage eine Nacht der Laternen vor: Jedes Haus hängt eine ins Fenster, jedes Kind trägt eine durch die Gasse, und wir lachen die Düsternis hinter tausend kleinen Feuern aus. Frech, aber billig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Wickship, I propose a Night of Lanterns: every house hangs one in the window, every child carries one in the lane, and we laugh at the Gloom from behind a thousand small fires. Rude, but cheap."
          }
        }
      }
    },
    "petition.last_stand.c1" : {
      "comment" : "Petition last_stand: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wir halten bis zum Morgen.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“We hold until dawn.”"
          }
        }
      }
    },
    "petition.last_stand.c2" : {
      "comment" : "Petition last_stand: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wir holen Burgherr Aldric heim.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“We bring Lord Aldric home.”"
          }
        }
      }
    },
    "petition.last_stand.c3" : {
      "comment" : "Petition last_stand: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Dafür war ich nie bestimmt.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“I was never meant for this.”"
          }
        }
      }
    },
    "petition.last_stand.hint" : {
      "comment" : "Petition last_stand: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versprecht ihnen den Morgen. Das ist das Einzige, was Euch morgen niemand mehr nehmen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promise them the dawn. It is the one thing nobody can take back from you tomorrow."
          }
        }
      }
    },
    "petition.last_stand.r1" : {
      "comment" : "Petition last_stand: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Brüllen läuft die Mauern entlang und hinab in den Schlund. Irgendwo im Dunkel lauscht etwas."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A roar runs along the walls and down into the Throat. Somewhere in the dark, something listens."
          }
        }
      }
    },
    "petition.last_stand.r2" : {
      "comment" : "Petition last_stand: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die alten Soldaten verstummen zuerst. Dann ziehen sie die Schwerter und halten sie hoch, einer nach dem anderen, der Düsternis entgegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The old soldiers fall silent first. Then they draw their swords and hold them up, one by one, toward the Gloom."
          }
        }
      }
    },
    "petition.last_stand.r3" : {
      "comment" : "Petition last_stand: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Moment rührt sich niemand. Dann lacht Brannock. „Keiner von uns war dafür bestimmt, {Herr|Herrin}. Und doch sind wir hier.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For a moment no one moves. Then Brannock laughs. “None of us were meant for this, my {lord|lady}. Here we are anyway.”"
          }
        }
      }
    },
    "petition.last_stand.text" : {
      "comment" : "Petition last_stand (brannock, story day 20): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}. Jeder Mann steht auf den Mauern, jede Feuerschale ist gefüllt. Die Jungs hätten gern ein Wort von {ihrem Herrn|ihrer Herrin}, bevor es dunkel wird. Ein kurzes, wenn ich bitten darf. Sie müssen noch Pfeile zählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}. Every man is on the walls, every brazier is stacked. The lads would like a word from their {lord|lady} before the dark. A short one, if you please. They still have arrows to count."
          }
        }
      }
    },
    "petition.lorn_visit.c1" : {
      "comment" : "Petition lorn_visit: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzählt mir von der Glocke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell me about the bell."
          }
        }
      }
    },
    "petition.lorn_visit.c2" : {
      "comment" : "Petition lorn_visit: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile, seht im Familienbuch nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile, check the family book."
          }
        }
      }
    },
    "petition.lorn_visit.c3" : {
      "comment" : "Petition lorn_visit: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dankt ihr und geleitet sie hinaus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank her and see her out."
          }
        }
      }
    },
    "petition.lorn_visit.hint" : {
      "comment" : "Petition lorn_visit: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greybell sagt das seit Jahrhunderten und wird dafür ausgelacht. Sie ist über achtzig und kam selbst. Fragt nach der Glocke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greybell has said so for centuries and been laughed at for it. She is past eighty and came herself. Ask about the bell."
          }
        }
      }
    },
    "petition.lorn_visit.r1" : {
      "comment" : "Petition lorn_visit: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie erzählt langsam: eine graue Glocke, ein Riss, fein wie ein Haar, ein Seil, an dem niemand zog. Das Kind mit ihrem Stock kennt es auswendig und hört doch zu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She tells it slowly: a grey bell, a hair-fine crack, a rope nobody pulled. The child with her stick knows it by heart and still listens."
          }
        }
      }
    },
    "petition.lorn_visit.r2" : {
      "comment" : "Petition lorn_visit: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile schlägt das Jahr 412 auf und hält inne. Elf Stummel in der Bindung, sauber geschnitten. „Aha“, sagt Dame Orla. „Ein Messer hat dieses Haus also doch.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile turns to the year 412 and stops. Eleven stubs in the binding, cut clean. “So,” says Dame Orla. “This house does keep a knife.”"
          }
        }
      }
    },
    "petition.lorn_visit.r3" : {
      "comment" : "Petition lorn_visit: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Aldrics Großmutter hat mich auch hinausgeleitet“, sagt sie und steht ohne Hilfe auf. „Sie wurde wenigstens rot.“ Das Kind nimmt den Stock und sieht sich nicht um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Aldric’s grandmother saw me out too,” she says, rising unaided. “She at least blushed.” The child takes the stick and does not look back."
          }
        }
      }
    },
    "petition.lorn_visit.text" : {
      "comment" : "Petition lorn_visit (orlaLorn, story days 14-15): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt Euch, {junger|junge} Taper, ich sitze schon. Orla Lorn von Greybell. Euer Haus kam aus dem Spalt herab, nicht zu ihm hinauf. Meines sah zu. Wir hüten die erste Glocke Eures Saals. Burgherr Edric schickte sie im Dunklen Jahr fort, weil sie läutete, ohne dass eine Hand am Seil war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sit, young Taper, I already have. Orla Lorn of Greybell. Your house came down out of the Cleft, not up to it. Mine watched. We keep your hall’s first bell. Lord Edric sent it away in the Dark Year, because it rang with no hand on the rope."
          }
        }
      }
    },
    "petition.ludo_arrives.c1" : {
      "comment" : "Petition ludo_arrives: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen, Ser Ludo"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome, Ser Ludo"
          }
        }
      }
    },
    "petition.ludo_arrives.c2" : {
      "comment" : "Petition ludo_arrives: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann erschlagt sie heute Nacht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slay it tonight, then"
          }
        }
      }
    },
    "petition.ludo_arrives.c3" : {
      "comment" : "Petition ludo_arrives: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Helden haben wir keine Betten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We have no beds for heroes"
          }
        }
      }
    },
    "petition.ludo_arrives.hint" : {
      "comment" : "Petition ludo_arrives: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wird essen wie drei Männer und kämpfen wie ein halber. Aber die Kinder lieben ihn. Gebt ihm zu essen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He will eat like three men and fight like half of one. But the children adore him. Feed him."
          }
        }
      }
    },
    "petition.ludo_arrives.r1" : {
      "comment" : "Petition ludo_arrives: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo verneigt sich so tief, dass ihm der Helm herunterfällt. Tamsin bekocht ihn für drei. Die Kinder folgen ihm überallhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo bows so deeply that his helmet falls off. Tamsin feeds him for three. The children follow him everywhere."
          }
        }
      }
    },
    "petition.ludo_arrives.r2" : {
      "comment" : "Petition ludo_arrives: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo marschiert zur Dämmerung singend in den Schlund. Im Morgengrauen findet man ihn schlafend in einer Pfahlgrube, unverletzt und unbesiegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo marches into the Throat at dusk, singing. At dawn he is found asleep in a stake pit, unhurt and undefeated."
          }
        }
      }
    },
    "petition.ludo_arrives.r3" : {
      "comment" : "Petition ludo_arrives: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo geht mit großer Würde, läuft gegen das Fallgatter und geht noch einmal, mit etwas weniger Würde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo departs with great dignity, walks into the portcullis, and departs again with slightly less."
          }
        }
      }
    },
    "petition.ludo_arrives.text" : {
      "comment" : "Petition ludo_arrives (serLudo): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seid gegrüßt, {edler Herr|edle Herrin}! Ich bin Ser Ludo von den Sieben Hügeln, Bezwinger des Lindwurms von Brackwasser, beinahe. Ich bin gekommen, um Eure Düsternis eigenhändig zu erschlagen. Ich bitte nur um ein Bett, ein Mahl und Hilfe mit diesem Helm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hail, good my {lord|lady}! I am Ser Ludo of the Seven Hills, slayer of the Wyrm of Brackwater, very nearly. I have come to slay your Gloom single-handed. I ask only a bed, a meal, and help with this helmet."
          }
        }
      }
    },
    "petition.ludo_old.c1" : {
      "comment" : "Petition ludo_old: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufhängen, und ein Mahl für den Helden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hang it, and feast the hero"
          }
        }
      }
    },
    "petition.ludo_old.c2" : {
      "comment" : "Petition ludo_old: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufhängen, aber kein Mahl"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hang it, hold the feast"
          }
        }
      }
    },
    "petition.ludo_old.c3" : {
      "comment" : "Petition ludo_old: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist das ein Ziegenzahn?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is that a goat’s tooth?"
          }
        }
      }
    },
    "petition.ludo_old.hint" : {
      "comment" : "Petition ludo_old: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist ein Ziegenzahn. Aber die Geschichte kostet nichts, und die Kinder werden sie lieben. Hängt ihn auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is a goat’s tooth. But the story is free, and the children will love it. Hang it up."
          }
        }
      }
    },
    "petition.ludo_old.r1" : {
      "comment" : "Petition ludo_old: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zahn hängt über dem Herd. Ser Ludo erzählt die Geschichte jeden Abend, und der Drache wird jedes Mal größer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tooth hangs above the hearth. Ser Ludo tells the tale every night, and the dragon grows larger each time."
          }
        }
      }
    },
    "petition.ludo_old.r2" : {
      "comment" : "Petition ludo_old: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo ist trotzdem entzückt. Bis zum Wochenende hat der Drache drei Köpfe und schuldet ihm Geld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo is delighted all the same. By the week’s end the dragon has three heads and owes him money."
          }
        }
      }
    },
    "petition.ludo_old.r3" : {
      "comment" : "Petition ludo_old: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo richtet sich zu voller Größe auf, die nicht beträchtlich ist. „Es war eine sehr große Ziege.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo draws himself up to his full height, which is not much. “It was a very large goat.”"
          }
        }
      }
    },
    "petition.ludo_old.text" : {
      "comment" : "Petition ludo_old (serLudo, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seid gegrüßt, {edler Herr|edle Herrin}! Ser Ludo kehrt zurück, älter und ein klein wenig weiser. Ich bringe Euch einen Zahn des Großen Drachen des Nordens, erschlagen von meiner eigenen Hand. Ich bitte nur, ihn in Eurem Saal aufzuhängen und jeden Abend die Geschichte zu erzählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hail, good my {lord|lady}! Ser Ludo returns, older and very slightly wiser. I bring you a tooth of the Great Dragon of the North, slain by my own hand. I ask only to hang it in your hall and tell the story nightly."
          }
        }
      }
    },
    "petition.ludo_returns.c1" : {
      "comment" : "Petition ludo_returns: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die große Laterne bezahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fund the great lantern"
          }
        }
      }
    },
    "petition.ludo_returns.c2" : {
      "comment" : "Petition ludo_returns: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte geht heim, Ser Ludo"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please go home, Ser Ludo"
          }
        }
      }
    },
    "petition.ludo_returns.hint" : {
      "comment" : "Petition ludo_returns: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zehn Gold, um einen Narren zu beschäftigen und die Stadt zum Lachen zu bringen. Ich habe schon Schlimmeres ausgegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten gold to keep a fool busy and the town laughing. I have spent worse."
          }
        }
      }
    },
    "petition.ludo_returns.r1a" : {
      "comment" : "Petition ludo_returns: choice 1, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo schwenkt die ganze Nacht seine Laterne am Rand des Nebels. Zu allgemeinem Erstaunen stieben die Rußlinge davon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo waves his lantern at the edge of the fog all night. To everyone’s astonishment, the sootlings scatter."
          }
        }
      }
    },
    "petition.ludo_returns.r1b" : {
      "comment" : "Petition ludo_returns: choice 1, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binnen Minuten brennt sein Federbusch. Er schwenkt die Laterne trotzdem weiter. So hat die Stadt noch nie gelacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Within minutes his plume is on fire. He keeps waving the lantern anyway. The town has never laughed so much."
          }
        }
      }
    },
    "petition.ludo_returns.r2" : {
      "comment" : "Petition ludo_returns: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er geht im Morgengrauen, den Helm unter dem Arm, und verspricht, mit einem Drachen wiederzukommen. Niemand weiß, ob das eine Drohung ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He leaves at dawn, helmet under his arm, promising to return with a dragon. Nobody can tell whether it is a threat."
          }
        }
      }
    },
    "petition.ludo_returns.text" : {
      "comment" : "Petition ludo_returns (serLudo, follow-up of ludo_arrives): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Edler Herr|Edle Herrin}! Ich habe die Düsternis aus nächster Nähe studiert, aus einer Pfahlgrube heraus. Ich habe einen Plan: eine große Laterne an einer Stange, getragen von einem tapferen Ritter. Mir. Ich brauche zehn Gold für Öl und eine längere Stange."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good my {lord|lady}! I have studied the Gloom from very close, from inside a stake pit. I have a plan: a great lantern on a pole, carried by a brave knight. Me. I need ten gold of oil and a longer pole."
          }
        }
      }
    },
    "petition.ludo_tourney.c1" : {
      "comment" : "Petition ludo_tourney: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltet das Turnier ab"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold the tournament"
          }
        }
      }
    },
    "petition.ludo_tourney.c2" : {
      "comment" : "Petition ludo_tourney: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Bogenschießen, kein Preis"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archery only, no prize"
          }
        }
      }
    },
    "petition.ludo_tourney.c3" : {
      "comment" : "Petition ludo_tourney: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Spiele im Krieg"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No games during a war"
          }
        }
      }
    },
    "petition.ludo_tourney.hint" : {
      "comment" : "Petition ludo_tourney: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwanzig Gold Preisgeld oder ein Nachmittag Bogenübung, den die Stadt Feiertag nennen wird. Bogenschießen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twenty gold of prize money, or an afternoon of archery practice the town will call a holiday. Archery."
          }
        }
      }
    },
    "petition.ludo_tourney.r1" : {
      "comment" : "Petition ludo_tourney: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bogenschießen ist prächtig, das Lanzenstechen weniger. Ser Ludo wird von einer Milchkuh aus dem Sattel geworfen und nennt es seinen schönsten Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archery is splendid, the jousting worse. Ser Ludo is unhorsed by a milk cow and calls it his finest day."
          }
        }
      }
    },
    "petition.ludo_tourney.r2" : {
      "comment" : "Petition ludo_tourney: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Schützen schießen den ganzen Nachmittag auf Strohrußlinge. Ser Ludo gewinnt den Preis für die größte Begeisterung, eine Karotte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your archers shoot at straw sootlings all afternoon. Ser Ludo wins the prize for most enthusiasm, a carrot."
          }
        }
      }
    },
    "petition.ludo_tourney.r3" : {
      "comment" : "Petition ludo_tourney: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo salutiert, geknickt. Er verbringt den Tag damit, seinen Schild zu polieren, der längst glänzt, und ihn anzuseufzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo salutes, crestfallen. He spends the day polishing his shield, which already gleams, and sighing at it."
          }
        }
      }
    },
    "petition.ludo_tourney.text" : {
      "comment" : "Petition ludo_tourney (serLudo): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Edler Herr|Edle Herrin}! Ein Tal in Gefahr braucht Mut, und Mut braucht ein Turnier! Lanzenstechen, Bogenschießen, ein Preis von zwanzig Gold. Gewinnen werde natürlich ich, aber die anderen müssen glauben, sie könnten es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good my {lord|lady}! A valley in danger needs courage, and courage needs a tournament! Jousting, archery, a prize of twenty gold. I shall win, naturally, but the others must believe they could."
          }
        }
      }
    },
    "petition.marek_arrows.c1" : {
      "comment" : "Petition marek_arrows: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pfeile kaufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy the arrows"
          }
        }
      }
    },
    "petition.marek_arrows.c2" : {
      "comment" : "Petition marek_arrows: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsere Pfeile macht Bram"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram makes our arrows"
          }
        }
      }
    },
    "petition.marek_arrows.c3" : {
      "comment" : "Petition marek_arrows: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram soll erst einen prüfen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let Bram test one first"
          }
        }
      }
    },
    "petition.marek_arrows.hint" : {
      "comment" : "Petition marek_arrows: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tausend Pfeile für fünfzehn Gold. So schnell verliert nicht einmal Marek Geld. Kauft, bevor ihm seine Preise wieder einfallen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A thousand arrows for fifteen gold. Even Marek cannot lose money that fast. Buy them before he remembers his prices."
          }
        }
      }
    },
    "petition.marek_arrows.r1" : {
      "comment" : "Petition marek_arrows: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek zählt die Münzen zweimal und die Pfeile gar nicht. „Ein Vergnügen, Eure Strahlkraft. Wahrlich, ein Vergnügen.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek counts the coins twice and the arrows not at all. “A pleasure, Your Radiance. Truly, a pleasure.”"
          }
        }
      }
    },
    "petition.marek_arrows.r2" : {
      "comment" : "Petition marek_arrows: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek verneigt sich so tief, dass seine Feder den Boden fegt. „Euer Verlust, Eure Strahlkraft.“ Aus der Küche schallt Tamsins Lachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek bows so low his feather sweeps the floor. “Your loss, Your Radiance.” From the kitchen comes Tamsin’s laugh."
          }
        }
      }
    },
    "petition.marek_arrows.r3a" : {
      "comment" : "Petition marek_arrows: choice 3, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram biegt den Pfeil zwischen zwei Fingern, und er knickt wie Stroh. Marek findet, blass, zehn Gold zur Wiedergutmachung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram bends the arrow between two fingers and it folds like straw. Marek, pale, finds ten gold to make amends."
          }
        }
      }
    },
    "petition.marek_arrows.r3b" : {
      "comment" : "Petition marek_arrows: choice 3, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brams Probepfeil fliegt gerade und spaltet einen Pfosten, also kauft Ihr alle. Es war natürlich der einzige gute."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram’s test arrow flies true and splits a post, so you buy the lot. It was, of course, the only good one."
          }
        }
      }
    },
    "petition.marek_arrows.text" : {
      "comment" : "Petition marek_arrows (marek, story days 6-7): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Strahlkraft! Ein Kahn voller Pfeile kam den Fluss herauf, bestimmt für einen Herrn der Seestädte, der leider ertrunken ist. Tausend Schäfte für fünfzehn Gold! Ich verliere an jedem, aber ich fände keinen Schlaf, wüsste ich Eure Schützen im Mangel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Radiance! A barge of arrows came up the river, meant for a lord of the lake towns who has, sadly, drowned. A thousand shafts for fifteen gold! I lose money on every one, but I could not sleep knowing your archers went short."
          }
        }
      }
    },
    "petition.marek_oil.c1" : {
      "comment" : "Petition marek_oil: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Fass kaufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy a barrel"
          }
        }
      }
    },
    "petition.marek_oil.c2" : {
      "comment" : "Petition marek_oil: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute nicht, Marek"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not tonight, Marek"
          }
        }
      }
    },
    "petition.marek_oil.hint" : {
      "comment" : "Petition marek_oil: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mareks Öl ist entweder großartig oder Wasser mit Ehrgeiz. Mein Kassenbuch kennt den Unterschied nicht. Verzichtet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek’s oil is either brilliant or water with ambitions. My ledger cannot tell the difference. Pass."
          }
        }
      }
    },
    "petition.marek_oil.r1" : {
      "comment" : "Petition marek_oil: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Öl brennt die ganze Nacht blau in den Gruben, und die Rußlinge, die hineinfallen, klettern nicht wieder heraus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The oil burns blue in the pits all night, and the sootlings that fall in do not climb out."
          }
        }
      }
    },
    "petition.marek_oil.r2" : {
      "comment" : "Petition marek_oil: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek lüftet den Hut. „Dann morgen. Der Preis bleibt derselbe, es sei denn, er steigt.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek tips his hat. “Tomorrow, then. The price will be the same, unless it is higher.”"
          }
        }
      }
    },
    "petition.marek_oil.text" : {
      "comment" : "Petition marek_oil (marek, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Strahlkraft! Feueröl aus dem Süden, das gute, das blau brennt. Gießt es in die Pfahlgruben, und die Rußlinge leuchten wie Festlaternen. Fünfundzwanzig Gold das Fass. Nur heute. Vermutlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Radiance! Fire oil from the south, the good kind that burns blue. Pour it in the stake pits and the sootlings light up like festival lanterns. Twenty-five gold a barrel. Tonight only. Probably."
          }
        }
      }
    },
    "petition.marek_relic.c1" : {
      "comment" : "Petition marek_relic: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Reliquie kaufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy the relic"
          }
        }
      }
    },
    "petition.marek_relic.c2" : {
      "comment" : "Petition marek_relic: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt sie erst Hesper"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show it to Hesper first"
          }
        }
      }
    },
    "petition.marek_relic.c3" : {
      "comment" : "Petition marek_relic: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Handschrift ist das Problem"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your handwriting is the problem"
          }
        }
      }
    },
    "petition.marek_relic.hint" : {
      "comment" : "Petition marek_relic: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist ein Huhn. Ein weitgereistes Huhn, aber ein Huhn. Nein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is a chicken. A well-travelled chicken, but a chicken. No."
          }
        }
      }
    },
    "petition.marek_relic.r1" : {
      "comment" : "Petition marek_relic: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Reliquie kommt in die Kapelle, und Pilger kommen aus dem Nachbartal. Hesper nennt sie einen Hühnerknochen und zündet trotzdem eine Kerze an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relic goes up in the chapel and pilgrims come from the next valley. Hesper calls it a chicken bone and lights a candle anyway."
          }
        }
      }
    },
    "petition.marek_relic.r2" : {
      "comment" : "Petition marek_relic: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper wirft einen Blick darauf: Huhn. Marek, unerschüttert, bietet ihn für fünf Gold als Suppenknochen an. Tamsin kauft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper takes one look: chicken. Marek, unshaken, offers it as a soup bone for five gold. Tamsin buys it."
          }
        }
      }
    },
    "petition.marek_relic.r3" : {
      "comment" : "Petition marek_relic: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek schnappt nach Luft, die Hand auf dem Herzen, bis in die Seele verletzt. Bis Mittag hat er sich erholt und will Pip einen seltenen Kiesel verkaufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek gasps, hand on heart, wounded to the soul. He recovers by lunch and tries to sell Pip a rare pebble."
          }
        }
      }
    },
    "petition.marek_relic.text" : {
      "comment" : "Petition marek_relic (marek): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Strahlkraft, seht: ein Fingerknochen des heiligen Taper, des ersten Laternenanzünders, gesegnet und beglaubigt. Die Kapelle wäre geehrt. Vierzig Gold, eine Kleinigkeit für einen Heiligen. Die Urkunde habe ich eigenhändig verfasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Radiance, behold: a fingerbone of Saint Taper, the first lamplighter, blessed and certified. The chapel would be honoured. Forty gold, a trifle for a saint. The certificate is in my own hand."
          }
        }
      }
    },
    "petition.marek_spyglass.c1" : {
      "comment" : "Petition marek_spyglass: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fernrohr kaufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy the spyglass"
          }
        }
      }
    },
    "petition.marek_spyglass.c2" : {
      "comment" : "Petition marek_spyglass: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Geschäfte mehr, Marek"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No more deals, Marek"
          }
        }
      }
    },
    "petition.marek_spyglass.hint" : {
      "comment" : "Petition marek_spyglass: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek schwört, es sei ehrlich, und genau deshalb zähle ich hinterher meine Finger. Lehnt ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek swears it is honest, which is how I know to count my fingers afterwards. Decline."
          }
        }
      }
    },
    "petition.marek_spyglass.r1a" : {
      "comment" : "Petition marek_spyglass: choice 1, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist ehrlich. In der Nacht sieht der Ausguck die Hunde sich sammeln, und die Schützen sind bereit, bevor sie losrennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is honest. That night the lookout sees the hounds gather, and the archers are ready before they run."
          }
        }
      }
    },
    "petition.marek_spyglass.r1b" : {
      "comment" : "Petition marek_spyglass: choice 1, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fernrohr zeigt alles auf dem Kopf. Brannock sagt, es sei hervorragend, um Fledermäuse zu beobachten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The spyglass shows everything upside down. Brannock says it is very good for watching bats."
          }
        }
      }
    },
    "petition.marek_spyglass.r2" : {
      "comment" : "Petition marek_spyglass: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek seufzt. „Eines Tages verkaufe ich Euch etwas Ehrliches, Eure Strahlkraft, und Ihr werdet mir nicht glauben.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek sighs. “One day I shall sell you something honest, Your Radiance, and you will not believe me.”"
          }
        }
      }
    },
    "petition.marek_spyglass.text" : {
      "comment" : "Petition marek_spyglass (marek): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Strahlkraft, ein Fernrohr von der Küste, Messing und ehrlich. Von Eurem höchsten Turm sähen Eure Schützen den Ruß eine Meile weit kommen. Dreißig Gold. Und es ist ehrlich. Ich bestehe darauf. Dieses ist ehrlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Radiance, a spyglass from the coast, brass and true. From your tallest tower your archers would see the soot coming a mile off. Thirty gold. And it is honest. I insist. This one is honest."
          }
        }
      }
    },
    "petition.marek_stall.c1" : {
      "comment" : "Petition marek_stall: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Karren darf bleiben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the cart stay"
          }
        }
      }
    },
    "petition.marek_stall.c2" : {
      "comment" : "Petition marek_stall: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder dritte Tag genügt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every third day is plenty"
          }
        }
      }
    },
    "petition.marek_stall.hint" : {
      "comment" : "Petition marek_stall: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek jeden Tag heißt Mareks Preise jeden Tag. Lasst ihn trotzdem bleiben. Die Wachen mögen ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek every day means Marek’s prices every day. Let him stay anyway. The guards like him."
          }
        }
      }
    },
    "petition.marek_stall.r1" : {
      "comment" : "Petition marek_stall: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein gestreiftes Sonnendach wird Teil des Burghofs. Binnen einer Woche schulden ihm die Wachen Geld, und er kennt jedes Geheimnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "His striped awning becomes part of the courtyard. Within a week the guards owe him money and he knows every secret."
          }
        }
      }
    },
    "petition.marek_stall.r2" : {
      "comment" : "Petition marek_stall: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek verneigt sich schwungvoll. „Dann werde ich Euch jeden dritten Tag schrecklich vermissen.“ Traurig sieht er nicht aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek bows with a flourish. “Then every third day I shall miss you terribly.” He does not look sad."
          }
        }
      }
    },
    "petition.marek_stall.text" : {
      "comment" : "Petition marek_stall (marek): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Strahlkraft, meine alten Knochen sind der Flussstraße müde. Lasst meinen Karren jeden Tag in Eurem Burghof stehen, nicht nur jeden dritten. Miete? Zehn Gold sofort und die besten Preise im Tal, für immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Radiance, my old bones are tired of the river road. Let my cart stand in your courtyard every day, not just every third. Rent? Ten gold now, and the best prices in the valley for ever."
          }
        }
      }
    },
    "petition.market_stall.c1" : {
      "comment" : "Petition market_stall: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkauft ihm die Erlaubnis"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sell him the licence"
          }
        }
      }
    },
    "petition.market_stall.c2" : {
      "comment" : "Petition market_stall: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schützt die Weber"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protect the weavers"
          }
        }
      }
    },
    "petition.market_stall.hint" : {
      "comment" : "Petition market_stall: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreißig Gold für ein Sonnendach. Die Weber werden murren, aber sie murren in allen Farben. Verkauft die Erlaubnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thirty gold for an awning. The weavers will grumble, but they grumble in every colour. Sell the licence."
          }
        }
      }
    },
    "petition.market_stall.r1" : {
      "comment" : "Petition market_stall: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein gestreiftes Sonnendach steht bald am Brunnen. Die Weber starren über den Platz, dann kommen sie herüber und kaufen Blau."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "His striped awning goes up beside the well. The weavers glare across the square, then come over to buy blue."
          }
        }
      }
    },
    "petition.market_stall.r2" : {
      "comment" : "Petition market_stall: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er packt seine Bänder und zieht an die Küste. Die Weber schicken Euch einen Schal, im selben Grau wie immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He packs his ribbons and leaves for the coast. The weavers send you a scarf, in the same grey as always."
          }
        }
      }
    },
    "petition.market_stall.text" : {
      "comment" : "Petition market_stall (merchant): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, ich verkaufe Farben und Bänder aus dem Süden. Ich hätte gern einen Stand auf Eurem Markt und biete dreißig Gold für die Erlaubnis. Eure Weber sagen, ich ruiniere sie. Das sagen Eure Weber auch über den Regen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, I sell dyes and ribbons from the south. I would like a stall on your market and offer thirty gold for the licence. Your weavers say I will ruin them. Your weavers also say that about rain."
          }
        }
      }
    },
    "petition.mill_wheel.c1" : {
      "comment" : "Petition mill_wheel: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flickt das Rad"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mend the wheel"
          }
        }
      }
    },
    "petition.mill_wheel.c2" : {
      "comment" : "Petition mill_wheel: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahlt eine Weile von Hand"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grind by hand a while"
          }
        }
      }
    },
    "petition.mill_wheel.hint" : {
      "comment" : "Petition mill_wheel: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünfzehn Gold oder eine Stadt mit lahmen Armen und kurzer Lunte. Flickt das Rad."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fifteen gold or a town with sore arms and short tempers. Mend the wheel."
          }
        }
      }
    },
    "petition.mill_wheel.r1" : {
      "comment" : "Petition mill_wheel: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am nächsten Morgen dreht und knarrt das Rad zufrieden. Der Bäcker schickt den ersten Laib aus dem neuen Mehl hinauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By the next morning the wheel turns and creaks happily. The baker sends up the first loaf from the new flour."
          }
        }
      }
    },
    "petition.mill_wheel.r2" : {
      "comment" : "Petition mill_wheel: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stadt mahlt von Hand und schimpft im Takt. Ein Arbeitslied entsteht. Es ist nicht schmeichelhaft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The town grinds by hand and complains in rhythm. A work song is born. It is not flattering."
          }
        }
      }
    },
    "petition.mill_wheel.text" : {
      "comment" : "Petition mill_wheel (builder, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, das Mühlrad ist im Frost gesprungen. Ohne es mahlt die Stadt von Hand, und die Leute werden schon unhöflich. Fünfzehn Gold für neue Schaufeln. Bis morgen dreht es sich wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the mill wheel cracked in the frost. Without it the town grinds by hand, and folk are already rude about it. Fifteen gold for new paddles. I can have it turning by tomorrow."
          }
        }
      }
    },
    "petition.miller_hoard.c1" : {
      "comment" : "Petition miller_hoard: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Mühle per Befehl"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the mill by order"
          }
        }
      }
    },
    "petition.miller_hoard.c2" : {
      "comment" : "Petition miller_hoard: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mehl für die Stadt kaufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy the flour for the town"
          }
        }
      }
    },
    "petition.miller_hoard.c3" : {
      "comment" : "Petition miller_hoard: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder setzt seinen eigenen Preis"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A man may set his own price"
          }
        }
      }
    },
    "petition.miller_hoard.hint" : {
      "comment" : "Petition miller_hoard: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwingt einen Müller, und jeder Händler im Tal versteckt seine Ware. Lasst den Markt das regeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force one miller and every merchant in the valley hides his goods. Let the market sort him out."
          }
        }
      }
    },
    "petition.miller_hoard.r1" : {
      "comment" : "Petition miller_hoard: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mittags brechen die Wachen das Schloss auf. Die Mütter jubeln, und der Müller schreibt einen langen Brief an einen sehr wichtigen Herrn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The guards break the lock at noon. The mothers cheer, and the miller writes a long letter to somebody important."
          }
        }
      }
    },
    "petition.miller_hoard.r2" : {
      "comment" : "Petition miller_hoard: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Haus kauft zum Preis des Müllers und verkauft zu dem des letzten Monats. Odile zuckt bei jedem einzelnen Sack zusammen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The house buys at the miller’s price and sells at last month’s. Odile winces at every single sack."
          }
        }
      }
    },
    "petition.miller_hoard.r3" : {
      "comment" : "Petition miller_hoard: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Müller verneigt sich tief und hält die Türen verschlossen. Die Mütter stehen stattdessen an der Burgküche an, und Tamsin gehen die Haferflocken aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The miller bows deeply and keeps his doors locked. The mothers queue at the castle kitchen instead, and Tamsin runs out of oats."
          }
        }
      }
    },
    "petition.miller_hoard.text" : {
      "comment" : "Petition miller_hoard (farmwife): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, der Müller hat sein Mehl weggeschlossen und den Preis verdoppelt, weil, so sagt er, die Düsternis die Mühle holen könnte. Meine Kinder essen Brei aus Hoffnung. Zwingt ihn, seine Türen zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the miller has locked up his flour and doubled the price, because, he says, the Gloom might take the mill. My children eat porridge made of hope. Make him open his doors."
          }
        }
      }
    },
    "petition.noble_hunt.c1" : {
      "comment" : "Petition noble_hunt: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewährt die Rechte"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant the rights"
          }
        }
      }
    },
    "petition.noble_hunt.c2" : {
      "comment" : "Petition noble_hunt: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Wild des Tals gehört allen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The valley’s game is for all"
          }
        }
      }
    },
    "petition.noble_hunt.hint" : {
      "comment" : "Petition noble_hunt: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vierzig Gold jetzt und bis zum Frühjahr ein Tal voller Wilderer und Groll. Sogar ich ließe das Wild allen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forty gold now, and a valley of poachers and grudges by spring. Even I would keep the game common."
          }
        }
      }
    },
    "petition.noble_hunt.r1" : {
      "comment" : "Petition noble_hunt: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er geht mit einem Pergament. Bis zum Wochenende werden Bauern bestraft, weil sie auf ihren eigenen Feldern Kaninchen fangen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He leaves with a parchment. By the week’s end, farmers are fined for snaring rabbits on their own fields."
          }
        }
      }
    },
    "petition.noble_hunt.r2" : {
      "comment" : "Petition noble_hunt: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er geht, ohne sich zu verneigen. In dieser Nacht wird im halben Tal Kaninchen geschmort, und eine Schüssel geht hinauf zur Burg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He leaves without bowing. That night rabbit stew is cooked in half the valley, and a bowl is sent up to the castle."
          }
        }
      }
    },
    "petition.noble_hunt.text" : {
      "comment" : "Petition noble_hunt (noble): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, ich spreche für das Haus Oxmoor, das unter Burgherr Aldric die Jagdrechte dieses Tals besaß. Das Haus hätte sie gern zurück. Dafür ein Geschenk von vierzig Gold an Euer Haus und Wildbret für Eure Tafel an jedem Festtag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, I speak for House Oxmoor, which held the hunting rights of this valley under Lord Aldric. The house should like them back. In return, a gift of forty gold to your house, and venison for your table on every feast day."
          }
        }
      }
    },
    "petition.odile_ledger.c1" : {
      "comment" : "Petition odile_ledger: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jagt den Dieb"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hunt the thief"
          }
        }
      }
    },
    "petition.odile_ledger.c2" : {
      "comment" : "Petition odile_ledger: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasst es gut sein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let it go"
          }
        }
      }
    },
    "petition.odile_ledger.c3" : {
      "comment" : "Petition odile_ledger: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt noch einmal, Odile"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Count it again, Odile"
          }
        }
      }
    },
    "petition.odile_ledger.hint" : {
      "comment" : "Petition odile_ledger: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich würde ihn jagen. Aber ein Haus, das seine Schreiber für achtzehn Gold jagt, zählt bald seine Münzen selbst. Lasst es gut sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I would hunt him. But a house that hunts its clerks for eighteen gold soon counts its own coins. Let it go."
          }
        }
      }
    },
    "petition.odile_ledger.r1a" : {
      "comment" : "Petition odile_ledger: choice 1, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es war der Nachtschreiber, der Kerzen für die Kapelle kaufte. Hesper gibt das Gold zurück. Odile bleibt ungerührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It was the night clerk, buying candles for the chapel. Hesper gives back the gold. Odile is unmoved."
          }
        }
      }
    },
    "petition.odile_ledger.r1b" : {
      "comment" : "Petition odile_ledger: choice 1, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Jagd bringt nichts als böses Blut. Drei Schreiber kündigen aus Protest. Das Gold bleibt verschwunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hunt finds nothing but bad feeling. Three clerks resign in protest. The gold stays lost."
          }
        }
      }
    },
    "petition.odile_ledger.r2" : {
      "comment" : "Petition odile_ledger: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile klappt das Kassenbuch mit einem hallenden Knall zu. „Wie {mein Herr|meine Herrin} wünscht.“ Sie wird es wöchentlich erwähnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile closes the ledger with a snap that echoes. “As my {lord|lady} wishes.” She will mention it weekly."
          }
        }
      }
    },
    "petition.odile_ledger.r3" : {
      "comment" : "Petition odile_ledger: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie zählt noch einmal, langsam, vor Euren Augen. Es fehlen achtzehn Gold. Zweimal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She counts again, slowly, in front of you. It is eighteen gold short. Twice."
          }
        }
      }
    },
    "petition.odile_ledger.text" : {
      "comment" : "Petition odile_ledger (odile): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mein Herr|Meine Herrin}, in der Schatzkammer fehlen achtzehn Gold, und mein Kassenbuch irrt nie. Entweder stiehlt ein Schreiber, oder Pip hat zählen gelernt. Ich kann den Dieb in aller Stille jagen, aber eine Jagd kostet Freunde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the treasury is eighteen gold short, and my ledger is never wrong. Either a clerk is stealing, or Pip has learned to count. I can hunt the thief quietly, but a hunt costs friends."
          }
        }
      }
    },
    "petition.old_sergeant.c1" : {
      "comment" : "Petition old_sergeant: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen zurück, Feldwebel"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome back, sergeant"
          }
        }
      }
    },
    "petition.old_sergeant.c2" : {
      "comment" : "Petition old_sergeant: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schont Eure Knie, alter Freund"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rest your knees, old friend"
          }
        }
      }
    },
    "petition.old_sergeant.hint" : {
      "comment" : "Petition old_sergeant: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein alter Soldat am Tor ist zwei junge wert. Nehmt ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An old soldier at the gate is worth two young ones. Take him."
          }
        }
      }
    },
    "petition.old_sergeant.r1" : {
      "comment" : "Petition old_sergeant: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er salutiert so heftig, dass sein Helm klingt. Brannock tut so, als freue er sich nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He salutes so hard his helmet rings. Brannock pretends not to be glad."
          }
        }
      }
    },
    "petition.old_sergeant.r2" : {
      "comment" : "Petition old_sergeant: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er verneigt sich, ein wenig steif. Später hört Ihr ihn in der Küche sagen, {der neue Herr|die neue Herrin} habe ein gütiges Gesicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He bows, a little stiffly. Later you hear him tell the kitchen the new {lord|lady} has a kind face."
          }
        }
      }
    },
    "petition.old_sergeant.text" : {
      "comment" : "Petition old_sergeant (soldier): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe zwanzig Winter das Tor des alten Herrn gehalten. Meine Knie sind hin, mein Arm nicht. Gebt mir einen Speer und einen Platz am Tor, und ich verlange keinen Lohn außer Suppe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I held the old lord’s gate for twenty winters. My knees are done, my arm is not. Give me a spear and a place by the gate, and I ask no pay but soup."
          }
        }
      }
    },
    "petition.oxmoor_gift.c1" : {
      "comment" : "Petition oxmoor_gift: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lampe bleibt. Keine Unterschrift."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the lamp. Sign nothing."
          }
        }
      }
    },
    "petition.oxmoor_gift.c2" : {
      "comment" : "Petition oxmoor_gift: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterschreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign."
          }
        }
      }
    },
    "petition.oxmoor_gift.c3" : {
      "comment" : "Petition oxmoor_gift: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beides zurück, mit Dank."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send both back, kindly."
          }
        }
      }
    },
    "petition.oxmoor_gift.hint" : {
      "comment" : "Petition oxmoor_gift: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Geschenk mit einem Papier darunter ist eine Schuld. Behaltet die Lampe, {mein Herr|meine Herrin}. Von Lampen verstehen wir etwas. Unterschreibt nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gift with a paper under it is a debt. Keep the lamp, my {lord|lady}. Lamps we understand. Sign nothing."
          }
        }
      }
    },
    "petition.oxmoor_gift.r1" : {
      "comment" : "Petition oxmoor_gift: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pell verneigt sich, als hätte er genau das erhofft. Odile trägt die Lampe am ausgestreckten Arm hinaus und zählt ihr Silber zweimal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pell bows as if this were the answer he had hoped for. Odile carries the lamp out at arm’s length and counts its silver twice."
          }
        }
      }
    },
    "petition.oxmoor_gift.r2" : {
      "comment" : "Petition oxmoor_gift: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreißig Gold auf dem Tisch, noch warm von seiner Hand. Pell löscht Euren Namen mit großer Sorgfalt ab. Odile sagt den Rest des Tages kein Wort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thirty gold on the table, still warm from his hand. Pell blots your name with great care. Odile says nothing for the rest of the day."
          }
        }
      }
    },
    "petition.oxmoor_gift.r3" : {
      "comment" : "Petition oxmoor_gift: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Goldenacre wird sich dieser Höflichkeit erinnern“, sagt Pell und lächelt mit allen Zähnen. Odile bringt ihn selbst bis ans Tor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Goldenacre will remember the courtesy,” says Pell, smiling with every tooth. Odile walks him to the gate herself."
          }
        }
      }
    },
    "petition.oxmoor_gift.text" : {
      "comment" : "Petition oxmoor_gift (lorenzPell, story days 5-6): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorenz Pell, Verwalter der Lady Petra Oxmoor von Goldenacre. Meine Herrin schickt eine Silberlampe für Eure Tafel, {Lord|Lady} Lantern, und ein kleines Papier: dreißig Gold noch heute, geliehen auf das Tal. Eine Förmlichkeit unter Freunden. Die Feder ist schon eingetaucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorenz Pell, steward to Lady Petra Oxmoor of Goldenacre. My lady sends a silver lamp for your table, {Lord|Lady} Lantern, and one small paper: thirty gold today, lent against the valley. A formality between friends. The pen is already inked."
          }
        }
      }
    },
    "petition.pilgrims.c1" : {
      "comment" : "Petition pilgrims: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herein, gegen Gebühr"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let them in, for a fee"
          }
        }
      }
    },
    "petition.pilgrims.c2" : {
      "comment" : "Petition pilgrims: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herein, umsonst"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let them in freely"
          }
        }
      }
    },
    "petition.pilgrims.c3" : {
      "comment" : "Petition pilgrims: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tor bleibt den Unseren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gate is for our own"
          }
        }
      }
    },
    "petition.pilgrims.hint" : {
      "comment" : "Petition pilgrims: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glaube, der Eintritt zahlt, bleibt Glaube. Und er zahlt. Lasst sie herein, für eine Münze pro Kopf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faith that pays an entry fee is still faith. And it pays. Let them in, for a coin each."
          }
        }
      }
    },
    "petition.pilgrims.r1" : {
      "comment" : "Petition pilgrims: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pilger füllen die Kapelle und die Schatzkammer. Die Stadt murrt über das Gedränge und verkauft ihnen alles, was sie hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pilgrims fill the chapel and the treasury. The town grumbles about crowds and sells them everything it owns."
          }
        }
      }
    },
    "petition.pilgrims.r2" : {
      "comment" : "Petition pilgrims: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pilger beten, weinen und legen Blumen am Tor nieder. Irgendwie fühlt sich der Saal einen Tag lang heiliger an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pilgrims pray, weep and leave flowers at the gate. Somehow the hall feels holier for a day."
          }
        }
      }
    },
    "petition.pilgrims.r3" : {
      "comment" : "Petition pilgrims: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pilger knien stattdessen vor dem Tor und beten dort die ganze Nacht. Die Wachen finden das unheimlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pilgrims kneel outside the gate instead and pray there all night. The guards find it unsettling."
          }
        }
      }
    },
    "petition.pilgrims.text" : {
      "comment" : "Petition pilgrims (widow, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, Pilger sind aus drei Tälern weit gekommen, um die Burg zu sehen, die die Düsternis aufhält, und die Flamme, die nie erlischt. Sie würden zahlen, um in der Kapelle zu beten. Oder das Tor bleibt den Unseren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, pilgrims have come from three valleys away to see the castle that holds back the Gloom and the Flame that never goes out. They would pay to pray in the chapel. Or we keep the gate for our own."
          }
        }
      }
    },
    "petition.pip_farewell.c1" : {
      "comment" : "Petition pip_farewell: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzähl ihn, Pip"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell it, Pip"
          }
        }
      }
    },
    "petition.pip_farewell.c2" : {
      "comment" : "Petition pip_farewell: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb ihn für danach auf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save it for after"
          }
        }
      }
    },
    "petition.pip_farewell.hint" : {
      "comment" : "Petition pip_farewell: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn wir morgen sterben, dann lieber lachend. Sagt ihm nicht, dass ich das gesagt habe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If we die tomorrow, I would rather do it laughing. Do not tell him I said so."
          }
        }
      }
    },
    "petition.pip_farewell.r1" : {
      "comment" : "Petition pip_farewell: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Als Odile den Namen aus dem Familienbuch vorlas, sah der ganze Hof zur Leiter.“ Der Saal tobt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“When Odile read the name from the family book, the whole court looked at the ladder.” The hall roars."
          }
        }
      }
    },
    "petition.pip_farewell.r2" : {
      "comment" : "Petition pip_farewell: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip grinst. „Dann müssen wir eben leben, Eure Dochtheit. Ich weigere mich, ihn zu verschwenden.“ Er jongliert drei Äpfel aus dem Saal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip grins. “Then we have to live, Your Wickship. I refuse to waste it.” He juggles three apples out of the hall."
          }
        }
      }
    },
    "petition.pip_farewell.text" : {
      "comment" : "Petition pip_farewell (pip, story day 19): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Dochtheit, morgen kommt der Lichtlose König, und ich habe meinen besten Witz noch nicht erzählt. Sterben wir alle, stirbt er mit uns, und das wäre die eigentliche Tragödie. Darf ich ihn jetzt erzählen, vor dem ganzen Saal?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Wickship, tomorrow the Lightless King comes, and I have not yet told my best joke. If we all die, it dies with us, and that would be the real tragedy. May I tell it now, to the whole hall?"
          }
        }
      }
    },
    "petition.pip_minister.c1" : {
      "comment" : "Petition pip_minister: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewährt, Herr Minister"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Granted, Minister"
          }
        }
      }
    },
    "petition.pip_minister.c2" : {
      "comment" : "Petition pip_minister: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hut und Siegel, kein Kuchen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat and seal, no cake"
          }
        }
      }
    },
    "petition.pip_minister.c3" : {
      "comment" : "Petition pip_minister: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narren brauchen kein Ministerium"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fools need no ministry"
          }
        }
      }
    },
    "petition.pip_minister.hint" : {
      "comment" : "Petition pip_minister: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebt ihm den Hut und das Siegel. Bekommt er Kuchen, will er bald einen Haushalt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give him the hat and the seal. If he gets cake, he will want a budget."
          }
        }
      }
    },
    "petition.pip_minister.r1" : {
      "comment" : "Petition pip_minister: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pips erster Erlass verbietet das Stirnrunzeln an Markttagen. Alle ignorieren ihn, was laut Pip beweist, dass das Gesetz wirkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip’s first decree bans frowning on market days. Everyone ignores it, which Pip says proves the law is working."
          }
        }
      }
    },
    "petition.pip_minister.r2" : {
      "comment" : "Petition pip_minister: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip nimmt würdevoll an und siegelt sofort Odiles Kassenbuch mit einem Marmeladenstempel. Odiles Antwort ist nicht überliefert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip accepts with dignity and at once seals Odile’s ledger with a jam stamp. Odile’s reply is not recorded."
          }
        }
      }
    },
    "petition.pip_minister.r3" : {
      "comment" : "Petition pip_minister: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip verneigt sich so tief, dass seine Schellen den Boden berühren. „{Ein weiser Herr|Eine weise Herrin}“, sagt er. „Weise und kein bisschen lustig.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip bows so low his bells touch the floor. “A wise {lord|lady},” he says. “Wise, and not one bit funny.”"
          }
        }
      }
    },
    "petition.pip_minister.text" : {
      "comment" : "Petition pip_minister (pip): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Dochtheit, jeder Hof hat Minister. Odile hat die Schatzkammer, Brannock die Mauern, Hesper die Flamme. Ich bitte darum, Minister für Witze zu werden, mit Hut, Siegel und einem Lohn von einem Kupfer und einem Kuchen pro Woche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Wickship, every court has ministers. Odile has the treasury, Brannock the walls, Hesper the Flame. I ask to be Minister of Jokes, with a hat, a seal and a salary of one copper and one cake a week."
          }
        }
      }
    },
    "petition.pitch_trap.c1" : {
      "comment" : "Petition pitch_trap: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versucht es mit Teer"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try the tar"
          }
        }
      }
    },
    "petition.pitch_trap.c2" : {
      "comment" : "Petition pitch_trap: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Frau hat recht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your wife is right"
          }
        }
      }
    },
    "petition.pitch_trap.hint" : {
      "comment" : "Petition pitch_trap: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine letzte Idee war eine selbstzündende Kerze. Sie zündete seinen Hut an. Dankt ihm und schickt ihn heim."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "His last idea was a self-lighting candle. It lit his hat. Thank him and send him home."
          }
        }
      }
    },
    "petition.pitch_trap.r1a" : {
      "comment" : "Petition pitch_trap: choice 1, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gruben gehen in Flammen auf. Rußlinge strömen hinein und kommen nicht wieder heraus. Der Handwerker tanzt auf der Mauer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pits go up in sheets of fire. Sootlings pour in and do not come out. The builder dances on the wall."
          }
        }
      }
    },
    "petition.pitch_trap.r1b" : {
      "comment" : "Petition pitch_trap: choice 1, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Teer fängt vor der Dunkelheit Feuer und brennt den ganzen Nachmittag. Seine Augenbrauen wachsen nach. Irgendwann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tar catches before dark and burns all afternoon. His eyebrows will grow back. Eventually."
          }
        }
      }
    },
    "petition.pitch_trap.r2" : {
      "comment" : "Petition pitch_trap: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er seufzt und geht heim. Seine Frau schickt Euch einen Korb Pflaumen, was Ihr als Dank versteht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He sighs and goes home. His wife sends you a basket of plums, which you take as thanks."
          }
        }
      }
    },
    "petition.pitch_trap.text" : {
      "comment" : "Petition pitch_trap (builder): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, ich habe eine Idee. Wir graben die Pfahlgruben tiefer und kleiden sie mit Teer aus, und wenn der Ruß hineinfällt: wusch! Ich brauche fünfzehn Gold für Teer. Meine Frau sagt, ich soll aufhören, Ideen zu haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, I have an idea. We dig the stake pits deeper and line them with tar, and when the soot falls in: whoosh! I need fifteen gold for tar. My wife says I should stop having ideas."
          }
        }
      }
    },
    "petition.plough_harvest.c1" : {
      "comment" : "Petition plough_harvest: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In die Schatzkammer"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Into the treasury"
          }
        }
      }
    },
    "petition.plough_harvest.c2" : {
      "comment" : "Petition plough_harvest: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Erntefest für alle"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A harvest feast for all"
          }
        }
      }
    },
    "petition.plough_harvest.c3" : {
      "comment" : "Petition plough_harvest: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behaltet alles, Ihr habt es verdient"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it all, you earned it"
          }
        }
      }
    },
    "petition.plough_harvest.hint" : {
      "comment" : "Petition plough_harvest: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine halbe Ernte füllt die Schatzkammer für einen Tag. Ein Fest füllt die Stadt für einen Monat. Das sehe sogar ich. Feiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half a harvest fills the treasury for a day. A feast fills the town for a month. Even I can see it. Feast."
          }
        }
      }
    },
    "petition.plough_harvest.r1" : {
      "comment" : "Petition plough_harvest: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Säcke gehen auf den Markt, die Münzen in die Schatzkammer. Er wirkt stolz und ein wenig enttäuscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sacks go to market and the coin to the treasury. He looks proud, and a little disappointed."
          }
        }
      }
    },
    "petition.plough_harvest.r2" : {
      "comment" : "Petition plough_harvest: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das gestreifte Zelt steht auf dem Platz, und das Brot ist zur Dämmerung noch warm. Jemand tanzt mit Brannock. Kurz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The striped tent goes up on the square, and the bread is still warm at dusk. Somebody dances with Brannock. Briefly."
          }
        }
      }
    },
    "petition.plough_harvest.r3" : {
      "comment" : "Petition plough_harvest: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er starrt, dann lacht er, dann umarmt er versehentlich die nächste Wache. Die Wache umarmt ihn seltsamerweise zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He stares, then laughs, then hugs the nearest guard by mistake. The guard, oddly, hugs back."
          }
        }
      }
    },
    "petition.plough_harvest.text" : {
      "comment" : "Petition plough_harvest (farmer): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, erinnert Ihr Euch an den Pflug, den Ihr gesegnet habt? Das lange Feld trug doppelt! Die ersten Säcke stehen am Tor. Die Hälfte für das Haus, dachte ich, es sei denn, das Haus gönnt der Stadt lieber ein Fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, remember the plough you blessed? The long field gave double! I brought the first sacks to the gate. Half for the house, I thought, unless the house would rather the town had a feast."
          }
        }
      }
    },
    "petition.quack_amulets.c1" : {
      "comment" : "Petition quack_amulets: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben und besteuern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licence him, and tax it"
          }
        }
      }
    },
    "petition.quack_amulets.c2" : {
      "comment" : "Petition quack_amulets: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jagt ihn aus dem Tal"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run him out of the valley"
          }
        }
      }
    },
    "petition.quack_amulets.c3" : {
      "comment" : "Petition quack_amulets: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutter Hesper soll urteilen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let Mother Hesper judge him"
          }
        }
      }
    },
    "petition.quack_amulets.hint" : {
      "comment" : "Petition quack_amulets: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Betrug, der die Leute schlafen lässt und anständig besteuert wird, heißt Regierung. Erlaubt es ihm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fraud that helps people sleep, taxed at a fair rate, is called a government. Licence him."
          }
        }
      }
    },
    "petition.quack_amulets.r1" : {
      "comment" : "Petition quack_amulets: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Abend trägt die halbe Stadt ein Blechamulett. Sicherer ist niemand, alle schlafen besser, und die Schatzkammer ist voller."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By evening half the town wears a tin amulet. Nobody is safer, everybody sleeps better, and the treasury is up."
          }
        }
      }
    },
    "petition.quack_amulets.r2" : {
      "comment" : "Petition quack_amulets: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er geht in Eile und verliert dabei Amulette. Die Kinder sammeln sie und tauschen sie gegen Murmeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He leaves in a hurry, dropping amulets. The children collect them and trade them for marbles."
          }
        }
      }
    },
    "petition.quack_amulets.r3a" : {
      "comment" : "Petition quack_amulets: choice 3, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper hält ein Amulett in die Flamme. Es schmilzt zu einer Pfütze aus Blech, und die Menge lacht ihn aus dem Tal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper holds an amulet to the Flame. It melts into a puddle of tin, and the crowd laughs him out of the valley."
          }
        }
      }
    },
    "petition.quack_amulets.r3b" : {
      "comment" : "Petition quack_amulets: choice 3, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper hält ein Amulett in die Flamme, die golden auflodert. Sie runzelt die Stirn und schweigt. Bis Mittag ist er ausverkauft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper holds an amulet to the Flame, which flares up gold. She frowns and says nothing. He sells out by noon."
          }
        }
      }
    },
    "petition.quack_amulets.text" : {
      "comment" : "Petition quack_amulets (merchant): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Gnädigster Burgherr|Gnädigste Burgherrin}, ich verkaufe Amulette der Flamme, jedes gegen die Düsternis gesegnet, zwei Kupfer das Stück. Die Priesterin nennt mich einen Betrüger. Ich nenne es Glauben zum fairen Preis. Ich bitte um Eure Erlaubnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most gracious {lord|lady}, I sell amulets of the Flame, each blessed against the Gloom, two coppers apiece. The priestess calls me a fraud. I call it faith at a fair price. I ask your licence to trade."
          }
        }
      }
    },
    "petition.refugees_gate.c1" : {
      "comment" : "Petition refugees_gate: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasst alle herein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let them all in"
          }
        }
      }
    },
    "petition.refugees_gate.c2" : {
      "comment" : "Petition refugees_gate: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Kinder und die Alten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the children and the old"
          }
        }
      }
    },
    "petition.refugees_gate.c3" : {
      "comment" : "Petition refugees_gate: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt sie fort"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn them away"
          }
        }
      }
    },
    "petition.refugees_gate.hint" : {
      "comment" : "Petition refugees_gate: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sechs Mäuler eine Woche vor dem Ende, und keine einzige Mauer dafür. Die Talstraße ist offen. Ich weiß, wie das klingt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Six mouths a week before the end, and not one wall to show for them. The valley road is open. I know how that sounds."
          }
        }
      }
    },
    "petition.refugees_gate.r1" : {
      "comment" : "Petition refugees_gate: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schweigend kommen sie durch das Tor, dann alle auf einmal unter Tränen. Tamsin schöpft schon Suppe, bevor jemand sie darum bittet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They come through the gate in silence, then all at once in tears. Tamsin is ladling soup before anyone asks her."
          }
        }
      }
    },
    "petition.refugees_gate.r2" : {
      "comment" : "Petition refugees_gate: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei treten ein. Drei gehen wortlos den Weg zurück, den sie kamen. Im Saal sieht niemand den anderen an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three walk in. Three turn back the way they came without a word. Nobody in the hall looks at anybody else."
          }
        }
      }
    },
    "petition.refugees_gate.r3" : {
      "comment" : "Petition refugees_gate: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie gehen zurück, wie sie gekommen sind. Die Wache am Tor bittet um frühe Ablösung und sagt nicht, warum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They go back the way they came. The guard on the gate asks to be relieved early and does not say why."
          }
        }
      }
    },
    "petition.refugees_gate.text" : {
      "comment" : "Petition refugees_gate (refugee, story days 13-14): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir kommen aus Beaconfoot, dem Weiler der Hüter an der Mündung des Schlunds, dem ersten, den die Düsternis fraß. Sechs sind wir noch. Neun Nächte versteckten wir uns in seinen Höhlen, die Kleinen im Arm. Wir können graben, flicken, kochen, kämpfen. Wir bitten um ein Dach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We come from Beaconfoot, the keepers’ hamlet at the Throat’s mouth, the first the Gloom ate. Six of us are left. We hid nine nights in the Throat’s caves, carrying the little ones. We can dig, mend, cook and fight. We ask for a roof."
          }
        }
      }
    },
    "petition.scarecrow.c1" : {
      "comment" : "Petition scarecrow: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behaltet sie"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it"
          }
        }
      }
    },
    "petition.scarecrow.c2" : {
      "comment" : "Petition scarecrow: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebt ihr lieber einen Stirnreif"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give it a circlet instead"
          }
        }
      }
    },
    "petition.scarecrow.c3" : {
      "comment" : "Petition scarecrow: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauptmann Brannock hat recht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captain Brannock is right"
          }
        }
      }
    },
    "petition.scarecrow.hint" : {
      "comment" : "Petition scarecrow: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie verscheucht Krähen und ärgert Brannock. Ich sehe keinen Nachteil. Behaltet sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It frightens crows and annoys Brannock. I fail to see a downside. Keep it."
          }
        }
      }
    },
    "petition.scarecrow.r1" : {
      "comment" : "Petition scarecrow: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vogelscheuche bewacht das ferne Feld. Brannock macht jeden Tag einen großen Bogen um sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scarecrow guards the far field. Brannock walks a long way round it, every single day."
          }
        }
      }
    },
    "petition.scarecrow.r2" : {
      "comment" : "Petition scarecrow: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt sieht sie aus wie Ihr. Die Krähen haben überhaupt keine Angst. Die Kinder sagen, das liegt daran, dass die Krähen Euch mögen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now it looks like you. The crows are not scared at all. The children say it is because the crows like you."
          }
        }
      }
    },
    "petition.scarecrow.r3" : {
      "comment" : "Petition scarecrow: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vogelscheuche kommt weg, der Eimer zurück an den Brunnen. Irgendwo beschließt ein Kind, niemals Soldat zu werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scarecrow comes down and the bucket goes back to the well. Somewhere a child decides never to be a soldier."
          }
        }
      }
    },
    "petition.scarecrow.text" : {
      "comment" : "Petition scarecrow (child): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, wir haben eine Vogelscheuche fürs ferne Feld gebaut und sie wie Hauptmann Brannock aussehen lassen, mit einem Eimer als Helm, weil nichts gruseliger ist. Er sagt, sie muss weg. Dürfen wir sie behalten? Bitte?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, we built a scarecrow for the far field and made it look like Captain Brannock, with a bucket for a helmet, because nothing is scarier. He says it must come down. Can we keep it? Please?"
          }
        }
      }
    },
    "petition.scout_report.c1" : {
      "comment" : "Petition scout_report: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Pech kaufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy the pitch"
          }
        }
      }
    },
    "petition.scout_report.c2" : {
      "comment" : "Petition scout_report: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdoppelt lieber die Wache"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double the watch instead"
          }
        }
      }
    },
    "petition.scout_report.c3" : {
      "comment" : "Petition scout_report: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Späher sehen überall Schatten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scouts see shadows everywhere"
          }
        }
      }
    },
    "petition.scout_report.hint" : {
      "comment" : "Petition scout_report: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwanzig Gold Pech gegen zwei Unholde. Brannock würde das Doppelte zahlen. Kauft es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twenty gold of pitch against two brutes. Brannock would pay double. Buy it."
          }
        }
      }
    },
    "petition.scout_report.r1" : {
      "comment" : "Petition scout_report: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Nacht brennen die Pfahlgruben wie Lampen, und zwei große Gestalten kehren rauchend in den Nebel zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That night the stake pits burn like lamps, and two great shapes turn back into the fog, smoking."
          }
        }
      }
    },
    "petition.scout_report.r2" : {
      "comment" : "Petition scout_report: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wache wird verdoppelt und ist um Mitternacht müde. Die Unholde kommen trotzdem, aber wenigstens sieht sie jeder kommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The watch is doubled and tired by midnight. The brutes come anyway, but at least everyone sees them coming."
          }
        }
      }
    },
    "petition.scout_report.r3" : {
      "comment" : "Petition scout_report: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Späher salutiert und geht. Im Morgengrauen lehnt eine Rampe aus Geröll an der äußeren Linie, mannshoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scout salutes and goes. At dawn a ramp of scree leans against the outer line, as high as a man."
          }
        }
      }
    },
    "petition.scout_report.text" : {
      "comment" : "Petition scout_report (soldier): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}, ich bin letzte Nacht bis an den Nebel geschlichen. Unholde, mindestens drei, die Geröll an die äußere Linie schichten wie eine Rampe. Ein Fass Pech auf den Pfählen würde sie verbrennen. Pech kostet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, I crept to the edge of the fog last night. Brutes, three at least, piling scree against the outer line like a ramp. A barrel of pitch on the stakes would burn them. Pitch costs."
          }
        }
      }
    },
    "petition.seren_at_gate.c1" : {
      "comment" : "Petition seren_at_gate: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diesmal öffne ich"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the gate this time"
          }
        }
      }
    },
    "petition.seren_at_gate.c2" : {
      "comment" : "Petition seren_at_gate: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt den Rest von dort"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say the rest from there"
          }
        }
      }
    },
    "petition.seren_at_gate.hint" : {
      "comment" : "Petition seren_at_gate: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie kam zurück, nachdem wir ihr die Tür vor der Nase zugeschlagen haben. Entweder ist sie verrückt, oder wir brauchen sie. Vermutlich beides. Lasst sie herein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She came back after we shut the door in her face. Either she is mad or we need her. Both, I expect. Let her in."
          }
        }
      }
    },
    "petition.seren_at_gate.r1" : {
      "comment" : "Petition seren_at_gate: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie tritt ein, als wäre sie nie fort gewesen, und hängt ihre graue Laterne in die hinterste Ecke des Saals. „Danke“, sagt sie. Einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She walks in as if she had never left and hangs her grey lantern in the hall’s far corner. “Thank you,” she says. Once."
          }
        }
      }
    },
    "petition.seren_at_gate.r2" : {
      "comment" : "Petition seren_at_gate: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Haltet ihn im Licht, bis er fällt“, ruft sie. „Ich warte am Rand des Dunkels.“ Dann ist das graue Licht fort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Hold him in the light until he falls,” she calls. “I will wait at the edge of the dark.” Then the grey light is gone."
          }
        }
      }
    },
    "petition.seren_at_gate.text" : {
      "comment" : "Petition seren_at_gate (seren, story days 15-16): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr habt Euer Tor verschlossen gehalten, {Laternenanzünder|Laternenanzünderin}. Ich verüble es Euch nicht. Aber hört dies durch das Tor: Aldric ist nicht gefallen. Das Dunkel hat ihn nicht getötet. Es hat ihn gekrönt. Nur im Licht des Großen Leuchtfeuers ist er verwundbar. Ich bin Seren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You kept your gate shut, lamplighter. I do not blame you. But hear this through it: Aldric did not fall. The dark did not kill him. It crowned him. Only in the Great Beacon’s light can he be hurt. I am Seren."
          }
        }
      }
    },
    "petition.seren_reveal.c1" : {
      "comment" : "Petition seren_reveal: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann holen wir ihn heim"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then we bring him home"
          }
        }
      }
    },
    "petition.seren_reveal.c2" : {
      "comment" : "Petition seren_reveal: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt der Stadt die Wahrheit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell the town the truth"
          }
        }
      }
    },
    "petition.seren_reveal.c3" : {
      "comment" : "Petition seren_reveal: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warum erst jetzt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why tell me only now?"
          }
        }
      }
    },
    "petition.seren_reveal.hint" : {
      "comment" : "Petition seren_reveal: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich weiß nicht, wie man einen Burgherrn begräbt, der noch herumläuft. Ihn heimzuholen klingt ordentlicher. Versprecht es ihr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have no idea how to bury a lord who is still walking. Bringing him home sounds tidier. Promise her."
          }
        }
      }
    },
    "petition.seren_reveal.r1" : {
      "comment" : "Petition seren_reveal: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren sieht Euch lange an. „Haltet ihn im Licht, bis er fällt. Dann findet meine Laterne, was von ihm übrig ist.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren looks at you for a long time. “Hold him in the light until he falls. Then my lantern can find what is left of him.”"
          }
        }
      }
    },
    "petition.seren_reveal.r2a" : {
      "comment" : "Petition seren_reveal: choice 2, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachricht läuft durchs Tal wie Feuer durchs Stroh. Die Alten weinen, und jemand hängt Aldrics Farben an die Mühle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The news runs through the valley like fire through straw. Old folk weep, and someone hangs Aldric’s colours from the mill."
          }
        }
      }
    },
    "petition.seren_reveal.r2b" : {
      "comment" : "Petition seren_reveal: choice 2, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Abend weiß die Stadt, dass ihr alter Herr die Düsternis anführt. Die Türen werden früh verriegelt, und in der Taverne singt niemand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By evening the town knows its old lord leads the Gloom. Doors are barred early, and nobody sings at the tavern."
          }
        }
      }
    },
    "petition.seren_reveal.r3" : {
      "comment" : "Petition seren_reveal: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Weil Ihr mir vor einer Woche nicht geglaubt hättet“, sagt Seren. „Und jetzt habt Ihr Mauern, die ihn halten können.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Because a week ago you would not have believed me,” says Seren. “And now you have walls worth holding him with.”"
          }
        }
      }
    },
    "petition.seren_reveal.text" : {
      "comment" : "Petition seren_reveal (seren, story days 15-16): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mein Name ist Seren. Ich hütete das Große Leuchtfeuer, bis es erlosch, und ritt mit Aldric, um es neu zu entzünden. Er ist nicht gefallen, {Laternenanzünder|Laternenanzünderin}. Das Dunkel hat ihn nicht getötet. Es hat ihn gekrönt. Nur im Licht des Leuchtfeuers ist er verwundbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My name is Seren. I kept the Great Beacon until it went dark, and I rode with Aldric to light it again. He did not fall, lamplighter. The dark did not kill him. It crowned him. Only in the beacon’s light can he be hurt."
          }
        }
      }
    },
    "petition.seren_watch.c1" : {
      "comment" : "Petition seren_watch: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nehmt einen Platz auf der Mauer"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a place on the wall"
          }
        }
      }
    },
    "petition.seren_watch.c2" : {
      "comment" : "Petition seren_watch: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt am Herd"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay by the hearth"
          }
        }
      }
    },
    "petition.seren_watch.hint" : {
      "comment" : "Petition seren_watch: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wollte sie uns verraten, wäre die Mauer ein schlechter Ort dafür. Zu viele Schützen. Lasst sie wachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If she meant to betray us, the wall is a poor place for it. Too many archers. Let her watch."
          }
        }
      }
    },
    "petition.seren_watch.r1" : {
      "comment" : "Petition seren_watch: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ganze Nacht steht sie auf der Mauer und sagt hier und da ein Wort. Wohin sie zeigt, kommen die Hunde, und die Schützen warten schon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All night she stands on the wall, saying a word here and there. Where she points, the hounds come, and the archers wait."
          }
        }
      }
    },
    "petition.seren_watch.r2" : {
      "comment" : "Petition seren_watch: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie neigt den Kopf und kehrt in ihre Ecke zurück. Die graue Laterne brennt die ganze Nacht und scheint den Schlund zu beobachten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She inclines her head and goes back to her corner. The grey lantern burns all night, and seems to watch the Throat."
          }
        }
      }
    },
    "petition.seren_watch.text" : {
      "comment" : "Petition seren_watch (seren): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasst mich heute Nacht auf der Mauer stehen, {Laternenanzünder|Laternenanzünderin}. Ich weiß, wie sich das Dunkel bewegt, bevor es sich bewegt. Ich kann Euren Schützen sagen, wohin sie sehen müssen. Einen Bogen rühre ich nicht an. Ich will nur nützlich sein in diesem Haus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let me stand on the wall tonight, lamplighter. I know how the dark moves before it moves. I can tell your archers where to look. I will not touch a bow. I only want to be useful in this house."
          }
        }
      }
    },
    "petition.soldiers_pay.c1" : {
      "comment" : "Petition soldiers_pay: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhöht ihren Sold"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raise their pay"
          }
        }
      }
    },
    "petition.soldiers_pay.c2" : {
      "comment" : "Petition soldiers_pay: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Sold ist gerecht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Their pay is fair"
          }
        }
      }
    },
    "petition.soldiers_pay.c3" : {
      "comment" : "Petition soldiers_pay: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezahlt sie mit Ehren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay them in honours"
          }
        }
      }
    },
    "petition.soldiers_pay.hint" : {
      "comment" : "Petition soldiers_pay: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bänder sind billiger als Kupfer und halten länger. Gebt ihnen Ehren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ribbons are cheaper than coppers and last longer. Give them honours."
          }
        }
      }
    },
    "petition.soldiers_pay.r1" : {
      "comment" : "Petition soldiers_pay: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachricht erreicht die Mauern vor dem Soldaten. In der Nacht singen die Schützen im Dienst, schlecht, aber laut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The news reaches the walls before the soldier does. That night the archers sing on duty, badly but loudly."
          }
        }
      }
    },
    "petition.soldiers_pay.r2a" : {
      "comment" : "Petition soldiers_pay: choice 2, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie murren und bleiben. Soldaten murren immer. Daran erkennt man, dass sie noch leben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They grumble and stay. Soldiers always grumble. It is how you know they are still alive."
          }
        }
      }
    },
    "petition.soldiers_pay.r2b" : {
      "comment" : "Petition soldiers_pay: choice 2, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einer legt seinen Bogen nieder und geht heim auf sein Feld. Zwei andere denken laut darüber nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One of them lays down his bow and walks home to his field. Two others think about it loudly."
          }
        }
      }
    },
    "petition.soldiers_pay.r3" : {
      "comment" : "Petition soldiers_pay: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Schütze bekommt ein Band mit einer kleinen goldenen Laterne. Sie beschweren sich und tragen es dann jeden Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each archer gets a ribbon with a little gold lantern. They complain, then wear them every day."
          }
        }
      }
    },
    "petition.soldiers_pay.text" : {
      "comment" : "Petition soldiers_pay (soldier): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}, wir Schützen stehen jede Nacht auf den Mauern, für den Lohn einer Gänsemagd. Die Jungs wollen zwei Kupfer mehr pro Nacht. Keiner traute sich, es dem Hauptmann zu sagen, also schickten sie mich. Ich habe den kürzeren Halm gezogen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, we archers stand on the walls every night for the pay of a goose-girl. The lads want two more coppers a night. Nobody dared say it to the captain, so they sent me. I drew the short straw."
          }
        }
      }
    },
    "petition.statue_market.c1" : {
      "comment" : "Petition statue_market: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Statue, unbedingt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A statue, by all means"
          }
        }
      }
    },
    "petition.statue_market.c2" : {
      "comment" : "Petition statue_market: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebt dem Heiligen Aldrics Gesicht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give the saint Lord Aldric’s face"
          }
        }
      }
    },
    "petition.statue_market.c3" : {
      "comment" : "Petition statue_market: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Marmor kommt in die Mauern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The marble goes into the walls"
          }
        }
      }
    },
    "petition.statue_market.hint" : {
      "comment" : "Petition statue_market: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vierzig Gold für einen steinernen Heiligen, während die Lebenden Mauern brauchen. Steckt den Marmor in die Mauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forty gold for a stone saint while the living need walls. Put the marble in the walls."
          }
        }
      }
    },
    "petition.statue_market.r1" : {
      "comment" : "Petition statue_market: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binnen einer Woche steht sie. Die Nase stimmt nicht, die Laterne schon, und die Tauben sind sofort einverstanden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It goes up within the week. The nose is wrong, the lantern is right, and the pigeons approve at once."
          }
        }
      }
    },
    "petition.statue_market.r2" : {
      "comment" : "Petition statue_market: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sankt Taper erhebt sich in Marmor mit Aldrics Gesicht, die Laterne in der Hand. Die Alten legen ihm jeden Morgen Blumen zu Füßen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saint Taper rises in marble with Aldric’s face, lantern in hand. Old folk leave flowers at his feet every morning."
          }
        }
      }
    },
    "petition.statue_market.r3" : {
      "comment" : "Petition statue_market: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Edelmann verneigt sich steif. Der Marmor wandert in die mittlere Linie, wo ihn vor allem der Ruß bewundern wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The noble bows stiffly. The marble goes into the middle line, where it will be admired mostly by soot."
          }
        }
      }
    },
    "petition.statue_market.text" : {
      "comment" : "Petition statue_market (noble): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, die Gilde der Steinmetze möchte Eure Wacht mit einer Statue auf dem Marktplatz ehren. Statuen von Burgherren sind für die Toten, also: Sankt Taper, die Laterne erhoben, in weißem Marmor. Sie bitten nur, dass das Haus den Marmor bezahlt. Vierzig Gold."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the guild of masons wishes to honour your watch with a statue on the market square. Statues of lords are for the dead, so: Saint Taper, lantern raised, in white marble. They ask only that the house buys the marble. Forty gold."
          }
        }
      }
    },
    "petition.stranger_gate.c1" : {
      "comment" : "Petition stranger_gate: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet das Tor"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the gate"
          }
        }
      }
    },
    "petition.stranger_gate.c2" : {
      "comment" : "Petition stranger_gate: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tor bleibt zu"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the gate shut"
          }
        }
      }
    },
    "petition.stranger_gate.hint" : {
      "comment" : "Petition stranger_gate: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie stand im Morgengrauen am Schlundtor, auf der Seite, von der niemand kommt. Spionin oder Geschenk. Spione sind drinnen billiger. Öffnet das Tor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She stood at the Throat gate at dawn, the side nobody comes from. A spy or a gift. Spies are cheaper inside. Open the gate."
          }
        }
      }
    },
    "petition.stranger_gate.r1" : {
      "comment" : "Petition stranger_gate: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wortlos tritt sie ein und hängt die graue Laterne in die hinterste Ecke des Saals. Das Herdfeuer neigt sich von ihr weg, nur ein wenig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She steps in without a word and hangs the grey lantern in the hall’s far corner. The hearth fire leans away from it, just a little."
          }
        }
      }
    },
    "petition.stranger_gate.r2" : {
      "comment" : "Petition stranger_gate: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie nickt, als hätte sie damit gerechnet. Beim Horn ist das graue Licht vor dem Tor verschwunden, und die Nacht kommt ein wenig kälter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She nods, as if she had counted on it. At the horn the grey light is gone from the gate, and the night comes on a little colder."
          }
        }
      }
    },
    "petition.stranger_gate.text" : {
      "comment" : "Petition stranger_gate (seren, story days 4-5): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich komme vom Rand der Düsternis, mit dieser Laterne. Sie brennt grau und wärmt nicht, also verlangt es nicht von ihr. Die Nacht ist nah, und da draußen kennt das Dunkel meinen Namen. Öffnet Euer Tor, {Laternenanzünder|Laternenanzünderin}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have walked from the edge of the Gloom with this lantern. It burns grey and gives no warmth, so do not ask it to. Night is close, and out there the dark knows my name. Open your gate, lamplighter."
          }
        }
      }
    },
    "petition.tamsin_oven.c1" : {
      "comment" : "Petition tamsin_oven: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Maurer bezahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay the mason"
          }
        }
      }
    },
    "petition.tamsin_oven.c2" : {
      "comment" : "Petition tamsin_oven: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram kann ihn flicken"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram can mend it"
          }
        }
      }
    },
    "petition.tamsin_oven.c3" : {
      "comment" : "Petition tamsin_oven: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann eben Fladenbrot"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flat bread it is"
          }
        }
      }
    },
    "petition.tamsin_oven.hint" : {
      "comment" : "Petition tamsin_oven: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fladenbrot hat noch niemanden umgebracht. Brannocks Männer kauen an guten Tagen Steine. Behaltet die zwanzig Gold."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flat bread never killed anyone. Brannock’s men chew rocks on a good day. Keep the twenty gold."
          }
        }
      }
    },
    "petition.tamsin_oven.r1" : {
      "comment" : "Petition tamsin_oven: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Abend faucht der neue Ofen. Tamsin bäckt einen Laib in Laternenform und lässt Euch die erste Scheibe essen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new oven roars by evening. Tamsin bakes a loaf in the shape of a lantern and makes you eat the first slice."
          }
        }
      }
    },
    "petition.tamsin_oven.r2a" : {
      "comment" : "Petition tamsin_oven: choice 2, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram flickt den Ofen mit Eisenbändern und Schweigen. Er funktioniert besser als neu und klingt, wenn er heiß ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram mends the oven with iron bands and silence. It works better than new and rings when it is hot."
          }
        }
      }
    },
    "petition.tamsin_oven.r2b" : {
      "comment" : "Petition tamsin_oven: choice 2, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram flickt den Ofen. Mittags explodiert er. Niemand ist verletzt, aber die Küche liegt jetzt größtenteils im Freien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram mends the oven. It explodes at noon. Nobody is hurt, but the kitchen is now mostly outdoors."
          }
        }
      }
    },
    "petition.tamsin_oven.r3" : {
      "comment" : "Petition tamsin_oven: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fladenbrot bis zum Frühjahr. Die Wachen nennen es Schildbrot und benutzen es auch so. Tamsin ist nicht erheitert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flat bread till spring. The guards call it shield-bread and use it as such. Tamsin is not amused."
          }
        }
      }
    },
    "petition.tamsin_oven.text" : {
      "comment" : "Petition tamsin_oven (tamsin): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mein Herr|Meine Herrin}, der Küchenofen ist letzte Nacht glatt durchgebrochen. Das Brot kommt heraus wie Dachziegel, und die Wache sagt das, laut. Ein Maurer will zwanzig Gold. Oder ich backe bis zum Frühjahr auf dem Herd."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the kitchen oven cracked clean through last night. The bread comes out like roof tiles, and the guard says so, loudly. A mason wants twenty gold. Or I bake on the hearth till spring."
          }
        }
      }
    },
    "petition.tapestry_aldric.c1" : {
      "comment" : "Petition tapestry_aldric: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hängt ihn im Saal auf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hang it in the hall"
          }
        }
      }
    },
    "petition.tapestry_aldric.c2" : {
      "comment" : "Petition tapestry_aldric: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezahlt sie, dann hängt ihn auf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay her, then hang it"
          }
        }
      }
    },
    "petition.tapestry_aldric.c3" : {
      "comment" : "Petition tapestry_aldric: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Saal gehört den Lebenden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hall belongs to the living"
          }
        }
      }
    },
    "petition.tapestry_aldric.hint" : {
      "comment" : "Petition tapestry_aldric: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kostet nichts, er ist schön, und er erinnert daran, wer als Erster hinausritt. Hängt ihn auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is free, it is beautiful, and it reminds people who rode out first. Hang it."
          }
        }
      }
    },
    "petition.tapestry_aldric.r1" : {
      "comment" : "Petition tapestry_aldric: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er hängt nun hinter dem Thron. Im Feuerschein scheint Aldrics Laterne zu flackern, und die Witwe weint leise."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It goes up behind the throne. In the firelight Aldric’s lantern seems to flicker, and the widow weeps quietly."
          }
        }
      }
    },
    "petition.tapestry_aldric.r2" : {
      "comment" : "Petition tapestry_aldric: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie lehnt das Gold dreimal ab und nimmt es beim vierten Mal. Der Saal fühlt sich sofort älter und wärmer an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She refuses the gold three times and takes it the fourth. The hall feels older and warmer at once."
          }
        }
      }
    },
    "petition.tapestry_aldric.r3" : {
      "comment" : "Petition tapestry_aldric: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie rollt ihn wortlos wieder zusammen. Odile nennt es später die richtige Wahl. Sie klingt nicht überzeugt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She rolls it up again without a word. Odile later calls it the right choice. She does not sound sure."
          }
        }
      }
    },
    "petition.tapestry_aldric.text" : {
      "comment" : "Petition tapestry_aldric (widow): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, ich habe einen Wandteppich gewebt, Burgherr Aldric auf dem Ritt zum Leuchtfeuer, elf Jahre lang an jedem Abend. Ich möchte, dass er im großen Saal hängt, wo er saß. Ich verlange nichts dafür, nur dass er nicht in die Küche kommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, I wove a tapestry of Lord Aldric riding to the beacon, eleven years of evenings. I would like it to hang in the great hall where he sat. I ask nothing for it, only that it not go in the kitchen."
          }
        }
      }
    },
    "petition.tavern_brawl.c1" : {
      "comment" : "Petition tavern_brawl: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schützen zahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archers pay"
          }
        }
      }
    },
    "petition.tavern_brawl.c2" : {
      "comment" : "Petition tavern_brawl: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bauern zahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The farmers pay"
          }
        }
      }
    },
    "petition.tavern_brawl.c3" : {
      "comment" : "Petition tavern_brawl: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Haus zahlt, beide Seiten trinken"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The house pays, both sides drink"
          }
        }
      }
    },
    "petition.tavern_brawl.hint" : {
      "comment" : "Petition tavern_brawl: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schützen haben Sold und nichts, wofür sie ihn ausgeben könnten. Lasst sie zahlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archers have wages and nothing to spend them on. Let them pay."
          }
        }
      }
    },
    "petition.tavern_brawl.r1" : {
      "comment" : "Petition tavern_brawl: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schützen zahlen, beleidigt. In der Nacht schießen sie mit ungewohnter Wut, was Brannock einen Lichtblick nennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archers pay, sulking. That night they shoot with unusual anger, which Brannock calls a silver lining."
          }
        }
      }
    },
    "petition.tavern_brawl.r2" : {
      "comment" : "Petition tavern_brawl: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bauern zahlen und gehen murrend heim. Am nächsten Markttag kosten Eier für Soldaten das Doppelte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The farmers pay and go home muttering. On the next market day, eggs cost soldiers double."
          }
        }
      }
    },
    "petition.tavern_brawl.r3" : {
      "comment" : "Petition tavern_brawl: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Seiten müssen auf Kosten des Hauses aufeinander trinken. Bei der dritten Runde singen sie dasselbe Lied."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both sides are made to drink to each other on the house’s coin. By the third round they sing the same song."
          }
        }
      }
    },
    "petition.tavern_brawl.text" : {
      "comment" : "Petition tavern_brawl (townsman): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, letzte Nacht haben Eure Schützen meine Schenke zerlegt. Zwei Tische, eine Bank und der gute Spiegel. Sie sagen, ein Bauer habe sie Kerzenlöscher genannt. Die Bauern sagen, die Schützen hätten angefangen. Einer zahlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, last night your archers wrecked my alehouse. Two tables, a bench and the good mirror. They say a farmer called them candle-snuffers. The farmers say the archers started it. Someone pays."
          }
        }
      }
    },
    "petition.tax_grumble.c1" : {
      "comment" : "Petition tax_grumble: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brot und Feuerholz für alle"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bread and firewood for all"
          }
        }
      }
    },
    "petition.tax_grumble.c2" : {
      "comment" : "Petition tax_grumble: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mauern brauchen die Steuern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The walls need the taxes"
          }
        }
      }
    },
    "petition.tax_grumble.hint" : {
      "comment" : "Petition tax_grumble: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne ich die Schatzkammer einmal, erwarten sie es zweimal. Senkt lieber am Pult die Steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If I open the treasury once, they will expect it twice. Lower the taxes at the lectern instead."
          }
        }
      }
    },
    "petition.tax_grumble.r1" : {
      "comment" : "Petition tax_grumble: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den ganzen Nachmittag rollen Karren mit Brot und Holz durch die Gassen. Am Abend rauchen die Kamine, und die Leute winken wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carts of bread and wood roll through the lanes all afternoon. That evening the chimneys smoke and people wave again."
          }
        }
      }
    },
    "petition.tax_grumble.r2" : {
      "comment" : "Petition tax_grumble: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er nickt, ohne zuzustimmen. Beim Hinausgehen begegnet er Odile, die ihn voller Mitgefühl ansieht und sonst nichts tut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He nods without agreeing. On the way out he passes Odile, who gives him a look of perfect sympathy and nothing else."
          }
        }
      }
    },
    "petition.tax_grumble.text" : {
      "comment" : "Petition tax_grumble (townsman, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, die Stadt ist müde. Jeden Morgen mehr Steuern, jede Nacht mehr Lärm. Die Leute fragen, ob das Haus nicht einmal die Schatzkammer öffnen könnte, für Brot und Feuerholz, bevor die Ersten gehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the town is tired. Every dawn more taxes, every night more noise. Folk ask whether the house might open the treasury once, for bread and firewood, before people start leaving."
          }
        }
      }
    },
    "petition.thief_bread.c1" : {
      "comment" : "Petition thief_bread: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An den Pranger mit ihm"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put him in the stocks"
          }
        }
      }
    },
    "petition.thief_bread.c2" : {
      "comment" : "Petition thief_bread: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er arbeitet es in Eurer Backstube ab"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He works it off in your bakery"
          }
        }
      }
    },
    "petition.thief_bread.c3" : {
      "comment" : "Petition thief_bread: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Haus bezahlt das Brot"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The house pays for the bread"
          }
        }
      }
    },
    "petition.thief_bread.hint" : {
      "comment" : "Petition thief_bread: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei Laibe Gnade für fünf Gold. Billiger kann man sich nicht beliebt machen. Bezahlt das Brot."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three loaves of mercy for five gold. I have never seen a cheaper way to be loved. Pay for the bread."
          }
        }
      }
    },
    "petition.thief_bread.r1" : {
      "comment" : "Petition thief_bread: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er steht einen Tag am Pranger. Niemand wirft etwas. Am Abend hat ihm jemand Brot vor die Füße gelegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He stands in the stocks for a day. Nobody throws anything. By evening someone has left bread at his feet."
          }
        }
      }
    },
    "petition.thief_bread.r2" : {
      "comment" : "Petition thief_bread: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie nimmt ihn auf. Er verbrennt das erste Blech und das zweite, und beim zehnten bleibt er für immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She takes him on. He burns the first batch and the second, and by the tenth he is staying for good."
          }
        }
      }
    },
    "petition.thief_bread.r3" : {
      "comment" : "Petition thief_bread: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr bezahlt die Laibe. Der Junge rennt davon, bevor ihm jemand danken kann, aber am nächsten Morgen sind die Burgstufen gefegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You pay for the loaves. The boy runs before anyone can thank him, but next morning the castle steps are swept."
          }
        }
      }
    },
    "petition.thief_bread.text" : {
      "comment" : "Petition thief_bread (townswoman): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, ein Junge hat drei Laibe aus meiner Backstube gestohlen, und die Wache hat ihn erwischt. Er ist vielleicht zwölf und sehr mager. Das Gesetz sagt: der Pranger. Ich sage: Das Gesetz hat noch nie Brot gebacken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, a boy stole three loaves from my bakery, and the guard caught him. He is maybe twelve and very thin. The law says the stocks. I say the law has never baked bread."
          }
        }
      }
    },
    "petition.tithe_letters.c1" : {
      "comment" : "Petition tithe_letters: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hängt die Banner auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hang the banners."
          }
        }
      }
    },
    "petition.tithe_letters.c2" : {
      "comment" : "Petition tithe_letters: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hängt keines auf. Wir halten allein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hang none. We hold alone."
          }
        }
      }
    },
    "petition.tithe_letters.hint" : {
      "comment" : "Petition tithe_letters: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kahle Wand sagt dem Tal, dass wir allein sind. Schon ein Banner sagt etwas anderes. Hängt sie auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bare wall tells the valley we are alone. Even one banner says otherwise. Hang them."
          }
        }
      }
    },
    "petition.tithe_letters.r1" : {
      "comment" : "Petition tithe_letters: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis Mittag hängen sie über den Bänken, weniger als Haken da sind. Odile staubt die leeren Haken trotzdem ab. „Für später“, sagt sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By noon they hang over the benches, fewer than the hooks. Odile dusts the empty hooks all the same. “For later,” she says."
          }
        }
      }
    },
    "petition.tithe_letters.r2" : {
      "comment" : "Petition tithe_letters: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile faltet jedes Banner in seinen alten Falten und legt es in die Truhe. „Allein ist billiger“, sagt sie. „Besser habe ich nicht gesagt.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile folds each banner along its old creases and lays it in the chest. “Alone is cheaper,” she says. “I did not say better.”"
          }
        }
      }
    },
    "petition.tithe_letters.text" : {
      "comment" : "Petition tithe_letters (odile, story days 16): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mein Herr|Meine Herrin}, die Zehntbriefe sind da. Die Häuser, die noch zahlen, haben ihre Banner mitgeschickt, wie es Brauch ist. Hängt sie im Saal auf, und jeder Bittsteller sieht, wer zu uns steht. Und wer nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the tithe letters are in. The houses that still pay have sent their banners with them, as the custom is. Hang them in the hall, and every petitioner sees who stands with us. And who does not."
          }
        }
      }
    },
    "petition.tower_request.c1" : {
      "comment" : "Petition tower_request: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr bekommt Euren Turm"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You shall have your tower"
          }
        }
      }
    },
    "petition.tower_request.c2" : {
      "comment" : "Petition tower_request: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst Licht, dann Pfeile"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light first, then arrows"
          }
        }
      }
    },
    "petition.tower_request.hint" : {
      "comment" : "Petition tower_request: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wird jede Woche einen Turm verlangen, bis er stirbt. Dieser ist zufällig eine gute Idee. Sagt ja."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He will ask for a tower every week until he dies. This one happens to be a good idea. Say yes."
          }
        }
      }
    },
    "petition.tower_request.r1" : {
      "comment" : "Petition tower_request: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock brummt, was bei ihm fast schon ein Lied ist. Im Hinausgehen tritt er den Pflock am Tor ein wenig gerader."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock grunts, which from him is practically a song. On his way out he kicks the stake by the gate a little straighter."
          }
        }
      }
    },
    "petition.tower_request.r2" : {
      "comment" : "Petition tower_request: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ein Laternenkrieg also“, murmelt er. Er sagt nicht, dass Ihr falsch liegt. Bis Mittag haben seine Jungs eine Feuerschale für Euch bereit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A lamplighter’s war, then,” he mutters. He does not say you are wrong. By noon his lads have a brazier ready for you."
          }
        }
      }
    },
    "petition.tower_request.text" : {
      "comment" : "Petition tower_request (brannock, story days 2-3): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}. Feuerschalen halten den Ruß in Schach, aber Licht allein hat noch nie etwas mit Zähnen aufgehalten. Baut einen Bogenturm am Tor und gebt meinen Jungs einen Hochsitz. Den Platz habe ich selbst abgesteckt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Lord|My lady}. Braziers keep the soot honest, but light never stopped anything with teeth. Raise an archer tower by the gate and give my lads a perch to shoot from. I staked the spot myself."
          }
        }
      }
    },
    "petition.truce_drill.c1" : {
      "comment" : "Petition truce_drill: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drillt sie"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drill them"
          }
        }
      }
    },
    "petition.truce_drill.c2" : {
      "comment" : "Petition truce_drill: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasst die Stadt ruhen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the town rest"
          }
        }
      }
    },
    "petition.truce_drill.hint" : {
      "comment" : "Petition truce_drill: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stille ist geliehen. Lasst die Stadt schlafen, solange sie kann; sie braucht die Kraft dringender als Brannock seinen Drill."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The quiet is borrowed. Let the town sleep while it can; it will need the strength more than Brannock needs the drill."
          }
        }
      }
    },
    "petition.truce_drill.r1" : {
      "comment" : "Petition truce_drill: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Dämmerung hallt der Schlund von Sehnen und Brannocks Stimme. Zwei der Jungs treffen schon das Scheunentor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By dusk the Throat rings with twanging strings and Brannock’s voice. Two of the lads can already hit the barn."
          }
        }
      }
    },
    "petition.truce_drill.r2" : {
      "comment" : "Petition truce_drill: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Abend lang ist die Taverne voll und die Gassen sind laut. Niemand spricht über den Preis der Stille."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For one evening the tavern is full and the lanes are loud. Nobody mentions the price of the quiet."
          }
        }
      }
    },
    "petition.truce_drill.text" : {
      "comment" : "Petition truce_drill (brannock, follow-up of the herald's truce): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}. Die Düsternis hat letzte Nacht Wort gehalten. Kein einziger Rußling. Noch zwei stille Nächte, erkauft zu einem Preis, den ich nicht nenne. Gebt mir zwanzig Gold und die jungen Hände der Stadt, und ich mache bis zum Ende Schützen aus ihnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Lord|My lady}. The Gloom kept its word last night. Not a sootling. Two quiet nights left, bought at a price I will not name. Give me twenty gold and the town’s young hands, and I make archers of them by the end."
          }
        }
      }
    },
    "petition.truce_end.c1" : {
      "comment" : "Petition truce_end: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zündet die Kerze an"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light the candle"
          }
        }
      }
    },
    "petition.truce_end.c2" : {
      "comment" : "Petition truce_end: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute Nacht keine Reue"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No regrets tonight"
          }
        }
      }
    },
    "petition.truce_end.hint" : {
      "comment" : "Petition truce_end: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kerze kostet nichts und gesteht alles. Zündet sie an, {mein Herr|meine Herrin}. Ich sehe weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A candle costs nothing and confesses everything. Light it, my {lord|lady}. I will look the other way."
          }
        }
      }
    },
    "petition.truce_end.r1" : {
      "comment" : "Petition truce_end: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper stellt eine Kerze abseits der anderen. Die ganze Nacht brennt sie kerzengerade, während sich die übrigen zum Schlund neigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper sets one candle apart from the others. All night it burns straight up, while the rest lean toward the Throat."
          }
        }
      }
    },
    "petition.truce_end.r2" : {
      "comment" : "Petition truce_end: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wie Ihr wünscht.“ Hesper verneigt sich. Die Flamme bleibt blau bis zum Morgen, und die Stadt schläft, ohne zu wissen, warum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“As you wish.” Hesper bows. The Flame stays blue until dawn, and the town sleeps without knowing why."
          }
        }
      }
    },
    "petition.truce_end.text" : {
      "comment" : "Petition truce_end (hesper, follow-up of the herald's truce): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die letzte stille Nacht, Kind des Hauses. Seit dem Handel brennt die Flamme niedrig und blau, als hielte sie den Atem an. Morgen kommt er selbst. Ich würde heute eine Kerze anzünden für das, was wir bezahlt haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The last quiet night, child of the house. The Flame has burned low and blue since the bargain, as if it held its breath. Tomorrow he comes himself. I would light a candle tonight for what we paid."
          }
        }
      }
    },
    "petition.varn_levy.c1" : {
      "comment" : "Petition varn_levy: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen. Nehmt die mittlere Linie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome. Take the middle line."
          }
        }
      }
    },
    "petition.varn_levy.c2" : {
      "comment" : "Petition varn_levy: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt Eurem Vater, ich kann zählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell your father I can count."
          }
        }
      }
    },
    "petition.varn_levy.c3" : {
      "comment" : "Petition varn_levy: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst Suppe, dann Mauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soup first, then walls."
          }
        }
      }
    },
    "petition.varn_levy.hint" : {
      "comment" : "Petition varn_levy: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ist zwanzig, und Lord Varn zählt nach, was er uns schickt. Die mittlere Linie, {mein Herr|meine Herrin}. Die äußere soll sie sich verdienen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She is twenty, and Lord Varn counts what he sends us. The middle line, my {lord|lady}. Let her earn the outer one."
          }
        }
      }
    },
    "petition.varn_levy.r1" : {
      "comment" : "Petition varn_levy: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild sieht zur mittleren Linie, dann zu Euch. „Ein klarer Befehl“, sagt sie. „Damit kann Highcairn arbeiten.“ Bis Mittag steht ihr Aufgebot."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild looks at the middle line, then at you. “A clear order,” she says. “Highcairn can work with that.” By noon her levy is posted."
          }
        }
      }
    },
    "petition.varn_levy.r2" : {
      "comment" : "Petition varn_levy: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild schreibt es Wort für Wort auf, im Stehen. „Das gefällt ihm, oder es gefällt ihm nicht.“ Vor der Dämmerung reitet sie damit nach Norden. Das Aufgebot bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild writes it down word for word, standing. “He will like that, or he will not.” She rides north with it before dusk. The levy stays."
          }
        }
      }
    },
    "petition.varn_levy.r3" : {
      "comment" : "Petition varn_levy: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin macht die Bergsoldaten satt, ehe jemand fragt, wo sie schlafen. Hild isst im Stehen und sagt dann: „Jetzt die Mauern.“ Sie lächelt beinahe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin feeds the hill soldiers before anyone asks where they sleep. Hild eats standing, then says: “Now the walls.” She is almost smiling."
          }
        }
      }
    },
    "petition.varn_levy.text" : {
      "comment" : "Petition varn_levy (hildVarn, story days 3-4): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild Varn von Highcairn, {Burgherr|Burgherrin}. Ich bringe das halbe Herbstaufgebot und einen Brief meines Vaters. Die andere Hälfte folgt, schreibt er, sobald {der neue Herr|die neue Herrin} gezeigt hat, dass {er|sie} zählen kann. Für mich bitte ich um eines: einen Platz an der äußeren Linie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild Varn of Highcairn, {Lord|Lady} Lantern. I bring half the autumn levy and my father’s letter. The other half follows, he writes, once the new {lord|lady} has shown a head for counting. For myself I ask one thing: a place on the outer line."
          }
        }
      }
    },
    "petition.varn_ride.c1" : {
      "comment" : "Petition varn_ride: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der letzten Nacht gehen wir beide."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the last night, we both go."
          }
        }
      }
    },
    "petition.varn_ride.c2" : {
      "comment" : "Petition varn_ride: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nein. Ich brauche Euch auf der Mauer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. I need you on the wall."
          }
        }
      }
    },
    "petition.varn_ride.c3" : {
      "comment" : "Petition varn_ride: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geht. Nehmt eine nummerierte Laterne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go. Take a numbered lantern."
          }
        }
      }
    },
    "petition.varn_ride.hint" : {
      "comment" : "Petition varn_ride: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Nächte vor der schlimmsten will sie Reiter hinausführen. Schlagt es ihr nicht ab. Vertagt es, und meint es ernst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two nights before the worst one, and she wants to take riders out. Do not refuse her. Postpone her, and mean it."
          }
        }
      }
    },
    "petition.varn_ride.r1" : {
      "comment" : "Petition varn_ride: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild mustert Euch, wie sie eine Mauer mustert. „Wir beide“, sagt sie. „Ich nehme Euch beim Wort.“ Sie geht zurück an ihre Linie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild studies you the way she studies a wall. “Both of us,” she says. “I will hold you to that.” She goes back to her line."
          }
        }
      }
    },
    "petition.varn_ride.r2" : {
      "comment" : "Petition varn_ride: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ein klarer Befehl“, sagt Hild, und mehr nicht. Bei Dämmerung steht sie noch vor dem Horn auf der Mauer, das Gesicht zum Dunkel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A clear order,” says Hild, and that is all. At dusk she is on the wall before the horn, her face to the dark."
          }
        }
      }
    },
    "petition.varn_ride.r3" : {
      "comment" : "Petition varn_ride: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laterne einundvierzig zieht bei Dämmerung durchs Tor, drei Reiter darunter. Brannock sieht ihr nach, bis sie ein Funke ist und dann keiner mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lantern forty-one goes out through the gate at dusk, three riders under it. Brannock watches until it is a spark, and then is not."
          }
        }
      }
    },
    "petition.varn_ride.text" : {
      "comment" : "Petition varn_ride (hildVarn, story days 18): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}. Burgherr Aldric trug mich auf den Schultern, als ich sechs war. Hier reden alle von ihm, und keiner geht nachsehen. Gebt mir zwei Reiter und eine nummerierte Laterne. Ich reite heute Nacht am dunklen Leuchtfeuer vorbei und finde ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Lord|Lady} Lantern. Lord Aldric carried me on his shoulders when I was six. Here everyone speaks of him and nobody goes to look. Give me two riders and a numbered lantern. I will ride out past the dark beacon tonight and find him."
          }
        }
      }
    },
    "petition.veteran_bow.c1" : {
      "comment" : "Petition veteran_bow: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhestand in Ehren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire with honour"
          }
        }
      }
    },
    "petition.veteran_bow.c2" : {
      "comment" : "Petition veteran_bow: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch eine Saison, Soldat"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One more season, soldier"
          }
        }
      }
    },
    "petition.veteran_bow.c3" : {
      "comment" : "Petition veteran_bow: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werdet unser Ausbilder"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Become our drillmaster"
          }
        }
      }
    },
    "petition.veteran_bow.hint" : {
      "comment" : "Petition veteran_bow: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Schütze sagt, seine Augen ließen nach. Die meisten sagen es vor einer langen Nacht. Noch eine Saison."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every archer says his eyes are going. Most of them say it before a long night. One more season."
          }
        }
      }
    },
    "petition.veteran_bow.r1" : {
      "comment" : "Petition veteran_bow: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er hängt seinen Bogen über die Tür der Taverne. Jeder junge Schütze berührt ihn auf dem Weg zur Mauer, für Glück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He hangs his bow above the tavern door. Every young archer touches it for luck on the way to the wall."
          }
        }
      }
    },
    "petition.veteran_bow.r2" : {
      "comment" : "Petition veteran_bow: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er salutiert, langsam. In der Nacht schießt er gut und beschwert sich den ganzen nächsten Morgen darüber."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He salutes, slowly. That night he shoots well, and complains about it all the next morning."
          }
        }
      }
    },
    "petition.veteran_bow.r3" : {
      "comment" : "Petition veteran_bow: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er nimmt die jungen Schützen im Morgengrauen mit, jeden Morgen. Nach einer Woche treffen sie, was sie anvisieren, und fürchten ihn mehr als die Düsternis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He takes the young archers out at dawn, every dawn. Within a week they hit what they aim at and fear him more than the Gloom."
          }
        }
      }
    },
    "petition.veteran_bow.text" : {
      "comment" : "Petition veteran_bow (soldier, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}, dreißig Nächte stand ich auf Euren Mauern, und meine Augen sind nicht mehr, was sie waren. Schießen kann ich noch, meistens auf das Richtige. Ich würde meinen Bogen gern an den Nagel hängen. Oder die Jungen lehren, wenn Ihr zahlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, thirty nights I have stood on your walls, and my eyes are not what they were. I can still shoot, mostly at the right things. I would like to hang up my bow. Or teach the young ones, if you pay."
          }
        }
      }
    },
    "petition.wall_frost.c1" : {
      "comment" : "Petition wall_frost: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasst die Mauern neu verfugen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-point the walls"
          }
        }
      }
    },
    "petition.wall_frost.c2" : {
      "comment" : "Petition wall_frost: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisher hat es gehalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It has held so far"
          }
        }
      }
    },
    "petition.wall_frost.hint" : {
      "comment" : "Petition wall_frost: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mauern, die fest aussehen, sind die liebste Lüge der Baumeister. Bezahlt den Mörtel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walls that look sound are a builder’s favourite lie. Pay for the mortar."
          }
        }
      }
    },
    "petition.wall_frost.r1" : {
      "comment" : "Petition wall_frost: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bauleute arbeiten den ganzen kalten Nachmittag. Zur Dämmerung sind die Mauern grau, hässlich und sehr fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The builders work through the cold afternoon. By dusk the walls are grey and ugly and very solid."
          }
        }
      }
    },
    "petition.wall_frost.r2a" : {
      "comment" : "Petition wall_frost: choice 2, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es hält. Der Handwerker zuckt die Schultern und sagt, ewig halte es nicht, was für alles gilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It holds. The builder shrugs and says it will not hold forever, which is true of everything."
          }
        }
      }
    },
    "petition.wall_frost.r2b" : {
      "comment" : "Petition wall_frost: choice 2, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Mitternacht rutscht eine ganze Steinlage von der Mauer, und die Düsternis drängt mit aller Macht an die Lücke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At midnight a whole course of stones slides off the wall, and the Gloom pours at the gap with a will."
          }
        }
      }
    },
    "petition.wall_frost.text" : {
      "comment" : "Petition wall_frost (builder, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, der Frost ist in den alten Mörtel der Mauern gekrochen. Es sieht fest aus, ist es aber nicht. Fünfzehn Gold, um das Schlimmste neu zu verfugen, bevor die nächste harte Nacht kommt. Oder wir hoffen, dass es hält."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the frost has got into the old mortar of the walls. It looks sound, but it is not. Fifteen gold to re-point the worst of it before the next hard night. Or we hope it holds."
          }
        }
      }
    },
    "petition.war_tax.c1" : {
      "comment" : "Petition war_tax: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich setze die Kriegssteuer fest"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I will set the war tax"
          }
        }
      }
    },
    "petition.war_tax.c2" : {
      "comment" : "Petition war_tax: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal die Zünfte schröpfen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleed the guilds once"
          }
        }
      }
    },
    "petition.war_tax.c3" : {
      "comment" : "Petition war_tax: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stadt zahlt genug"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The town pays enough"
          }
        }
      }
    },
    "petition.war_tax.hint" : {
      "comment" : "Petition war_tax: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versprecht ihm die Kriegssteuer. Gnädig sein könnt Ihr am Pult immer noch. Versprechen sind die billigste Münze eines Hauses."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promise him the war tax. You can still be merciful at the lectern. Promises are the cheapest coin a house has."
          }
        }
      }
    },
    "petition.war_tax.r1" : {
      "comment" : "Petition war_tax: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock salutiert. „Das Pult steht neben dem Thron, {Herr|Herrin}. Die Stadt wird es hassen. Die Mauern nicht.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock salutes. “The lectern is by the throne, {lord|my lady}. The town will hate it. The walls will not.”"
          }
        }
      }
    },
    "petition.war_tax.r2" : {
      "comment" : "Petition war_tax: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis Mittag klimpern vierzig Gold in die Schatzkammer, und die Zunftmeister verneigen sich nicht mehr ganz so tief."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By noon forty gold clinks into the treasury, and the guild masters stop bowing quite so low."
          }
        }
      }
    },
    "petition.war_tax.r3" : {
      "comment" : "Petition war_tax: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachricht rollt schneller über den Markt als ein heruntergefallener Apfel. Brannock sagt nichts, und das ist schlimmer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Word runs across the market faster than a dropped apple. Brannock says nothing, which is worse."
          }
        }
      }
    },
    "petition.war_tax.text" : {
      "comment" : "Petition war_tax (brannock, story days 8-9): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}. Jetzt erlaubt das alte Gesetz eine Kriegssteuer, und die äußere Linie ist offen. Ich brauche Schützen, und Schützen essen. Setzt am Pult die Kriegssteuer fest, oder schröpft einmal die Zünfte. So oder so: Ich brauche Gold."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Lord|My lady}. The old law now allows a war tax, and the outer line is open. I need archers, and archers eat. Set the war tax at the lectern, or bleed the guilds once. Either way, I need gold."
          }
        }
      }
    },
    "petition.watch_feast.c1" : {
      "comment" : "Petition watch_feast: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein großes Fest"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A great feast"
          }
        }
      }
    },
    "petition.watch_feast.c2" : {
      "comment" : "Petition watch_feast: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein bescheidenes Fest"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A modest feast"
          }
        }
      }
    },
    "petition.watch_feast.c3" : {
      "comment" : "Petition watch_feast: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feste können warten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feasts can wait"
          }
        }
      }
    },
    "petition.watch_feast.hint" : {
      "comment" : "Petition watch_feast: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kleines Fest hält sie fröhlich. Ein großes hält sie fröhlich und mich wach. Ein kleines."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A small feast keeps them merry. A large one keeps them merry and me awake. A small one."
          }
        }
      }
    },
    "petition.watch_feast.r1" : {
      "comment" : "Petition watch_feast: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Feuer auf dem Platz sieht man bis in die fernen Berge. Die Stadt tanzt, und für eine Nacht wirkt das Dunkel klein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bonfire on the square is seen from the far mountains. The town dances, and for one night the dark seems small."
          }
        }
      }
    },
    "petition.watch_feast.r2" : {
      "comment" : "Petition watch_feast: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brot, ein Feuer und drei Fiedler, die zwei Lieder kennen. Es genügt. Es ist sogar ziemlich schön."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bread, a fire and three fiddlers who know two songs. It is enough. It is, in fact, rather lovely."
          }
        }
      }
    },
    "petition.watch_feast.r3" : {
      "comment" : "Petition watch_feast: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stadt nickt und geht früh heim. Der Platz bleibt dunkel, und jemand schreibt „Wann?“ an den Brunnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The town nods and goes home early. The square stays dark, and someone writes “When?” on the well."
          }
        }
      }
    },
    "petition.watch_feast.text" : {
      "comment" : "Petition watch_feast (townswoman, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, die Stadt möchte ein Fest der Langen Wacht feiern, für jede Nacht, die die Mauern gehalten haben. Brot, ein Feuer auf dem Platz, Tanz. Wir hätten gern den Segen des Hauses und, nun ja, seinen Geldbeutel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the town wants a Feast of the Long Watch, for every night the walls have held. Bread, a bonfire on the square. We would like the house’s blessing and, well, the house’s purse."
          }
        }
      }
    },
    "petition.wedding_feast.c1" : {
      "comment" : "Petition wedding_feast: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zelt und den Wein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tent and the wine"
          }
        }
      }
    },
    "petition.wedding_feast.c2" : {
      "comment" : "Petition wedding_feast: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur das Zelt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the tent"
          }
        }
      }
    },
    "petition.wedding_feast.c3" : {
      "comment" : "Petition wedding_feast: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Feste, solange die Düsternis kommt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No feasts while the Gloom comes"
          }
        }
      }
    },
    "petition.wedding_feast.hint" : {
      "comment" : "Petition wedding_feast: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Hochzeit ist ein Fest, das die Stadt selbst bezahlt. Leiht das Zelt, behaltet den Wein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A wedding is a festival the town pays for itself. Lend the tent, keep the wine."
          }
        }
      }
    },
    "petition.wedding_feast.r1" : {
      "comment" : "Petition wedding_feast: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zelt steht gestreift und stolz auf dem Platz. Getanzt wird bis zum Horn, manche sagen, noch darüber hinaus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tent goes up striped and proud on the square. The dancing lasts until the horn, and some say past it."
          }
        }
      }
    },
    "petition.wedding_feast.r2" : {
      "comment" : "Petition wedding_feast: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie bringen ihren eigenen Wein mit, der furchtbar ist, und niemanden stört es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They bring their own wine, which is terrible, and nobody minds."
          }
        }
      }
    },
    "petition.wedding_feast.r3" : {
      "comment" : "Petition wedding_feast: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hochzeit findet trotzdem statt, leise, in einer Scheune. Die Brautmutter wechselt die Straßenseite, wenn Ihr vorbeikommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wedding happens anyway, quietly, in a barn. The bride’s mother crosses the street when you pass."
          }
        }
      }
    },
    "petition.wedding_feast.text" : {
      "comment" : "Petition wedding_feast (townswoman): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, meine Tochter heiratet zum Vollmond den Sohn des Müllers. Das ganze Tal kommt, und genau das ist das Problem. Leiht uns das Haus das Festzelt? Und vielleicht eine Kleinigkeit für den Wein?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, my daughter marries the miller’s son at the full moon. The whole valley is coming, which is the trouble. Would the house lend us the festival tent? And perhaps a little something for the wine?"
          }
        }
      }
    },
    "petition.well_dispute.c1" : {
      "comment" : "Petition well_dispute: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen gerechten Preis festsetzen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a fair price"
          }
        }
      }
    },
    "petition.well_dispute.c2" : {
      "comment" : "Petition well_dispute: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Brunnen doch reparieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fix the well after all"
          }
        }
      }
    },
    "petition.well_dispute.hint" : {
      "comment" : "Petition well_dispute: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repariert den Brunnen, dann verdurstet der Streit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fix the well, and the quarrel dies of thirst."
          }
        }
      }
    },
    "petition.well_dispute.r1a" : {
      "comment" : "Petition well_dispute: choice 1, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Preis hält. Die Brisks murren, die anderen trinken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The price holds. The Brisks grumble, the rest drink."
          }
        }
      }
    },
    "petition.well_dispute.r1b" : {
      "comment" : "Petition well_dispute: choice 1, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Brisks verstecken ihre Kessel. Bei Einbruch der Nacht hat niemand Wasser, und alle geben Euch die Schuld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Brisks hide their kettles. By nightfall nobody has water and everybody blames you."
          }
        }
      }
    },
    "petition.well_dispute.r2" : {
      "comment" : "Petition well_dispute: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Maurer grinst über das zusätzliche Gold. Die Kessel der Brisks werden kalt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The mason grins at the extra gold. The Brisks’ kettles go cold."
          }
        }
      }
    },
    "petition.well_dispute.text" : {
      "comment" : "Petition well_dispute (townsman, follow-up of well_repair): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit der Brunnen verdorben ist, verkauft Familie Brisk abgekochtes Wasser, einen Kupfer pro Becher. Die anderen Familien wollen sie auspeitschen lassen. Ich will nur einen gerechten Preis, {Burgherr|Burgherrin}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Since the well went bad, the Brisk family sells boiled water at a copper a cup. The other families want them flogged. I only want a fair price, my {lord|lady}."
          }
        }
      }
    },
    "petition.well_repair.c1" : {
      "comment" : "Petition well_repair: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Maurer bezahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay the mason"
          }
        }
      }
    },
    "petition.well_repair.c2" : {
      "comment" : "Petition well_repair: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sollen sie das Wasser abkochen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let them boil the water"
          }
        }
      }
    },
    "petition.well_repair.hint" : {
      "comment" : "Petition well_repair: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünfzehn Gold für sauberes Wasser sind billiger als eine kranke Stadt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fifteen gold for clean water is cheaper than a sick town."
          }
        }
      }
    },
    "petition.well_repair.r1" : {
      "comment" : "Petition well_repair: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Abend kommt der Eimer klar herauf. Jemand hat eine Blume ans Seil gebunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By evening the bucket comes up clear. Someone has tied a flower to the rope."
          }
        }
      }
    },
    "petition.well_repair.r2" : {
      "comment" : "Petition well_repair: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie nickt steif. Abkochen, sagt sie, werde sie den Ersten, dem das Feuerholz ausgeht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She nods stiffly. Boiling, she says, is what she will do to whoever runs out of firewood first."
          }
        }
      }
    },
    "petition.well_repair.text" : {
      "comment" : "Petition well_repair (townswoman): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Marktbrunnen ist wieder grün. Die Kinder trinken aus dem Bach, und der Bach schmeckt nach Ziege. Fünfzehn Gold bezahlen einen Maurer, ein Seil und einen neuen Eimer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The market well has gone green again. The children drink from the brook, and the brook tastes of goat. Fifteen gold buys a mason, a rope and a new bucket."
          }
        }
      }
    },
    "petition.widow_garden.c1" : {
      "comment" : "Petition widow_garden: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blumen und Bohnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowers and beans"
          }
        }
      }
    },
    "petition.widow_garden.c2" : {
      "comment" : "Petition widow_garden: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Garten mit Heilkräutern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A garden of healing herbs"
          }
        }
      }
    },
    "petition.widow_garden.c3" : {
      "comment" : "Petition widow_garden: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesseln geben gute Suppe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettles make good soup"
          }
        }
      }
    },
    "petition.widow_garden.hint" : {
      "comment" : "Petition widow_garden: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blumen erfreuen das Auge. Kräuter erfreuen die Kräuterfrau, die weniger verlangt, wenn sie selbst anbaut. Pflanzt Kräuter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowers please the eye. Herbs please the herb-wife, who charges less when she grows her own. Plant herbs."
          }
        }
      }
    },
    "petition.widow_garden.r1" : {
      "comment" : "Petition widow_garden: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kinder pflanzen erst alles verkehrt herum. Eine Woche später stehen Blumen in Kästen und Bohnen in Reihen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The children plant everything upside down at first. A week later there are flowers in boxes and beans in rows."
          }
        }
      }
    },
    "petition.widow_garden.r2" : {
      "comment" : "Petition widow_garden: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weide, Salbei und Minze wachsen, wo die Nesseln standen. Die Kräuterfrau kommt täglich und tut, als wäre sie nicht dankbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willow, sage and mint grow where the nettles were. The herb-wife visits daily and pretends she is not grateful."
          }
        }
      }
    },
    "petition.widow_garden.r3" : {
      "comment" : "Petition widow_garden: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie lacht, ein wenig. „Das hat er auch immer gesagt.“ Dann geht sie allein nach Hause."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She laughs, a little. “He used to say that.” Then she goes home alone."
          }
        }
      }
    },
    "petition.widow_garden.text" : {
      "comment" : "Petition widow_garden (widow): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, mein Mann hatte einen Garten beim ersten Haus. Seit er tot ist, wachsen dort Brennnesseln. Ich bin zu alt zum Graben, aber die Kinder würden helfen, wenn ihnen jemand Samen gäbe und einen Grund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, my husband kept a garden by the first house. Since he passed, it has gone to nettles. I am too old to dig, but the children would help if someone gave them seeds and a reason."
          }
        }
      }
    },
    "petition.widow_pension.c1" : {
      "comment" : "Petition widow_pension: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Witwenpfennig zahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay the widow’s penny"
          }
        }
      }
    },
    "petition.widow_pension.c2" : {
      "comment" : "Petition widow_pension: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stattdessen ein Platz in der Küche"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A place in the kitchen instead"
          }
        }
      }
    },
    "petition.widow_pension.c3" : {
      "comment" : "Petition widow_pension: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alte Versprechen starben mit ihm"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Old promises died with him"
          }
        }
      }
    },
    "petition.widow_pension.hint" : {
      "comment" : "Petition widow_pension: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alte Versprechen kosten wenig und kaufen viel Treue auf den Mauern. Zahlt ihr den Pfennig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Old promises cost little and buy a great deal of loyalty on the walls. Pay her."
          }
        }
      }
    },
    "petition.widow_pension.r1" : {
      "comment" : "Petition widow_pension: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie nimmt die Münzen mit beiden Händen. Am Abend weiß jede Soldatenfrau, dass {der neue Herr|die neue Herrin} alte Versprechen hält."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She takes the coins in both hands. By evening every soldier’s wife knows the new {lord|lady} keeps old promises."
          }
        }
      }
    },
    "petition.widow_pension.r2" : {
      "comment" : "Petition widow_pension: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin lässt sie Rüben schälen und reden. Beim Abendessen sind sie beste Freundinnen und haben drei Rufe ruiniert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin puts her to peeling turnips and talking. By supper they are best friends and have ruined three reputations."
          }
        }
      }
    },
    "petition.widow_pension.r3" : {
      "comment" : "Petition widow_pension: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie nickt langsam und geht. In der Wachstube verstummen einige der älteren Männer, wenn Ihr vorbeikommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She nods slowly and leaves. In the guardroom, some of the older men stop talking when you pass."
          }
        }
      }
    },
    "petition.widow_pension.text" : {
      "comment" : "Petition widow_pension (widow): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, mein Mann hielt die äußere Linie für Burgherr Aldric und starb dort. Die Zählung führt seinen Namen, und sein Laternenhaken in der Kapelle ist leer. Der alte Herr zahlte mir jeden Monat einen Witwenpfennig. Das Haus seither nicht. Ich verlange, was versprochen war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, my husband held the outer line for Lord Aldric and died there. The Count has his name, and his lantern’s hook in the chapel hangs empty. The old lord paid me a widow’s penny each month. The house has not. I ask what was promised."
          }
        }
      }
    },
    "petition.young_recruit.c1" : {
      "comment" : "Petition young_recruit: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann sei unser Lampenkind"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be our lamp-runner, then"
          }
        }
      }
    },
    "petition.young_recruit.c2" : {
      "comment" : "Petition young_recruit: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag in fünf Jahren wieder"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In five years, ask again"
          }
        }
      }
    },
    "petition.young_recruit.c3" : {
      "comment" : "Petition young_recruit: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Mutter erfährt davon"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your mother will hear of this"
          }
        }
      }
    },
    "petition.young_recruit.hint" : {
      "comment" : "Petition young_recruit: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kinder auf den Mauern sind eine Schande. Kinder, die Feuerschalen neu entzünden, sind ein Gewinn. Macht ein Lampenkind daraus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Children on the walls are a disgrace. Children who relight braziers are a bargain. Make it a lamp-runner."
          }
        }
      }
    },
    "petition.young_recruit.r1" : {
      "comment" : "Petition young_recruit: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Nacht huscht eine kleine Gestalt mit einem Kienspan zwischen den Feuerschalen umher und entzündet jede neu, die die Krähen löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That night a small figure darts between the braziers with a taper, relighting every one the crows put out."
          }
        }
      }
    },
    "petition.young_recruit.r2" : {
      "comment" : "Petition young_recruit: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kind salutiert feierlich, mit der falschen Hand. Brannock salutiert mit der richtigen zurück, genauso feierlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The child salutes solemnly, with the wrong hand. Brannock salutes back with the right one, just as solemnly."
          }
        }
      }
    },
    "petition.young_recruit.r3" : {
      "comment" : "Petition young_recruit: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kind wird sehr blass und geht sofort. Manche Drohungen wirken auf jeden Rang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The child goes very pale and leaves at once. Some threats work on every rank."
          }
        }
      }
    },
    "petition.young_recruit.text" : {
      "comment" : "Petition young_recruit (child): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, ich bin fast dreizehn und treffe eine Krähe auf vierzig Schritt mit einem Stein. Hauptmann Brannock hat mich ausgelacht. Lasst mich mit den Schützen auf die Mauer! Ich habe keine Angst. Nur vor meiner Mutter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, I am almost thirteen and I can hit a crow at forty paces with a stone. Captain Brannock laughed at me. Let me be an archer! I will not be scared. I am only scared of my mother."
          }
        }
      }
    },
    "remember.arrows_refused" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram schmiedet weiter Eure Pfeile."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram keeps forging your arrows."
          }
        }
      }
    },
    "remember.banners_hung" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Banner der Häuser hängen in Eurem Saal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The houses’ banners hang in your hall."
          }
        }
      }
    },
    "remember.beacon_doubted" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile hält die Pläne griffbereit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile keeps the plans within reach."
          }
        }
      }
    },
    "remember.brazier_gift" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure nächste Feuerschale kostet nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your next brazier costs nothing."
          }
        }
      }
    },
    "remember.brazier_gift.tile" : {
      "comment" : "Audience card, a choice tile: what the choice brings (instead of 'Will be remembered').",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nächste Feuerschale gratis"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next brazier free"
          }
        }
      }
    },
    "remember.calder_coddled" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stillmeres Prüferin sah die Nacht durch Glas."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stillmere’s auditor saw the night through glass."
          }
        }
      }
    },
    "remember.calder_refused" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Stillmeres Buch steht: nicht gezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stillmere’s ledger says: not shown."
          }
        }
      }
    },
    "remember.calder_with" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder steht heute Nacht auf der Mauer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder stands tonight’s watch."
          }
        }
      }
    },
    "remember.giant_unwarned" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand hat die Stadt gewarnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody warned the town."
          }
        }
      }
    },
    "remember.hild_rode" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild Varn ritt aus, unter Laterne einundvierzig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild Varn rode out under lantern forty-one."
          }
        }
      }
    },
    "remember.hild_stays" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild Varn bleibt auf der Mauer, auf Euren Befehl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild Varn stays on the wall, by your order."
          }
        }
      }
    },
    "remember.holds_alone" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Saal hängt kein Banner außer Eurem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No banner hangs in the hall but your own."
          }
        }
      }
    },
    "remember.lorn_dismissed" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dame Orla geht ungehört heim."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dame Orla goes home unheard."
          }
        }
      }
    },
    "remember.lorn_heard" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greybell wurde angehört, dieses eine Mal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greybell was listened to, for once."
          }
        }
      }
    },
    "remember.oxmoor_debt" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oxmoor hält ein Papier mit Eurem Namen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oxmoor holds a paper with your name on it."
          }
        }
      }
    },
    "remember.oxmoor_lamp" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oxmoors Lampe bleibt. Euer Name bleibt Eurer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oxmoor’s lamp stays. Your name stays yours."
          }
        }
      }
    },
    "remember.oxmoor_refused" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oxmoor achtet Euch und verzeiht es nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oxmoor respects you, and will not forgive it."
          }
        }
      }
    },
    "remember.pip_joke_saved" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip hebt den Witz für den Morgen danach auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip saves the joke for the morning after."
          }
        }
      }
    },
    "remember.pip_joke_told" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Saal erzählt den Witz noch jahrelang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hall will tell the joke for years."
          }
        }
      }
    },
    "remember.seren_doubted" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren hat Euren Zweifel gehört."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren heard your doubt."
          }
        }
      }
    },
    "remember.seren_outside" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren wartet am Rand des Dunkels."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren waits at the edge of the dark."
          }
        }
      }
    },
    "remember.speech_aldric" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die alten Soldaten kämpfen, um Aldric heimzuholen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The old soldiers fight to bring Aldric home."
          }
        }
      }
    },
    "remember.speech_dawn" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mauern sagen es weiter: bis zum Morgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The walls repeat it: until dawn."
          }
        }
      }
    },
    "remember.speech_honest" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wissen, wer Ihr seid. Sie bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They know who you are. They stay."
          }
        }
      }
    },
    "remember.stranger_in" : {
      "comment" : "Audience card after a choice: what the court remembers of it (one line of the change row).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die graue Laterne hängt in Eurem Saal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The grey lantern hangs in your hall."
          }
        }
      }
    },
    "remember.stranger_turned_away" : {
