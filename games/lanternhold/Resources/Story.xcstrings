        }
      }
    },
    "petition.haunted_cellar.c2" : {
      "comment" : "Petition haunted_cellar: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt Mutter Hesper"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send Mother Hesper"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que vaya Madre Hesper"
          }
        },
        "fr" : {
