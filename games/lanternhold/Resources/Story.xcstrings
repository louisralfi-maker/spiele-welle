    "petition.war_tax.hint" : {
      "comment" : "Petition war_tax: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versprecht ihm die Kriegssteuer. Gnädig sein könnt Ihr am Pult immer noch. Versprechen sind die billigste Münze eines Hauses."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promise him the war tax. You can still be merciful at the lectern. Promises are the cheapest coin a house has."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prométale el impuesto de guerra. En el atril aún podrá ser clemente. Las promesas son la moneda más barata de una casa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promettez-lui l’impôt de guerre. Vous pourrez encore être {clément|clémente} au lutrin. Les promesses sont la monnaie la moins chère d’une maison."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promettetegli la tassa di guerra. Al leggio potrete ancora essere clemente. Le promesse sono la moneta più a buon mercato di una casata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戦時税は、お約束ください。慈悲なら、書見台でいつでもかけられます。約束は、家が持つ一番安い硬貨です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prometa a ele o imposto de guerra. Ainda pode ser clemente no atril. Promessas são a moeda mais barata de uma casa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "答应他战争税。到了书案前，您照样可以手下留情。许诺是一个家族最便宜的钱币。"
          }
        }
      }
    },
    "petition.war_tax.r1" : {
      "comment" : "Petition war_tax: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock salutiert. „Das Pult steht neben dem Thron, {Herr|Herrin}. Die Stadt wird es hassen. Die Mauern nicht.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock salutes. “The lectern is by the throne, {lord|my lady}. The town will hate it. The walls will not.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock saluda. «El atril está junto al trono, {señor|señora}. El pueblo lo odiará. Las murallas, no.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock salue. « Le lutrin est près du trône, {monseigneur|madame}. La ville va détester. Les murailles, non. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock saluta. «Il leggio è accanto al trono, {signore|signora}. Il borgo la odierà. Le mura no.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラノックが敬礼する。「書見台は城主の座の隣です、城主。町は嫌がるでしょう。城壁は嫌がらない」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock bate continência. “O atril fica ao lado do trono, {senhor|senhora}. A cidade vai odiar. As muralhas, não.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布兰诺克行了个礼。“书案就在主座旁边，城主。镇上会恨它。城墙不会。”"
          }
        }
      }
    },
    "petition.war_tax.r2" : {
      "comment" : "Petition war_tax: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis Mittag klimpern vierzig Gold in die Schatzkammer, und die Zunftmeister verneigen sich nicht mehr ganz so tief."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By noon forty gold clinks into the treasury, and the guild masters stop bowing quite so low."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al mediodía caen cuarenta monedas de oro en el tesoro, y los maestros de gremio ya no hacen reverencias tan hondas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À midi, quarante pièces d’or tintent dans le trésor, et les maîtres de guilde s’inclinent un peu moins bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mezzogiorno quaranta monete d’oro tintinnano nel tesoro, e i capi delle corporazioni smettono di inchinarsi così in basso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昼までに金貨40枚が金庫で鳴り、組合の親方たちの頭は、前ほど深く下がらなくなる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao meio-dia, quarenta moedas de ouro tilintam no tesouro, e os mestres de guilda já não se curvam tanto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不到中午，40金币叮当落进府库，行会会首们鞠躬也不再那么低了。"
          }
        }
      }
    },
    "petition.war_tax.r3" : {
      "comment" : "Petition war_tax: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachricht rollt schneller über den Markt als ein heruntergefallener Apfel. Brannock sagt nichts, und das ist schlimmer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Word runs across the market faster than a dropped apple. Brannock says nothing, which is worse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La noticia cruza el mercado más rápido que una manzana caída. Brannock no dice nada, que es peor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle roule à travers le marché plus vite qu’une pomme tombée. Brannock ne dit rien, ce qui est pire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voce corre per il mercato più veloce di una mela caduta. Brannock non dice niente, il che è peggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "噂は、落ちた林檎が転がるより速く市場を駆けめぐる。ブラノックは何も言わない。そのほうが、こたえる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A notícia rola pelo mercado mais rápido que maçã caída do cesto. Brannock não diz nada, o que é pior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消息在集市上滚得比掉落的苹果还快。布兰诺克一言不发，这更糟。"
          }
        }
      }
    },
    "petition.war_tax.text" : {
      "comment" : "Petition war_tax (brannock, story days 8-9): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}. Jetzt erlaubt das alte Gesetz eine Kriegssteuer, und die äußere Linie ist offen. Ich brauche Schützen, und Schützen essen. Setzt am Pult die Kriegssteuer fest, oder schröpft einmal die Zünfte. So oder so: Ich brauche Gold."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Lord|My lady}. The old law now allows a war tax, and the outer line is open. I need archers, and archers eat. Set the war tax at the lectern, or bleed the guilds once. Either way, I need gold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Señor|Señora}. La ley antigua permite ahora un impuesto de guerra, y la línea exterior está abierta. Necesito arqueros, y los arqueros comen. Fije el impuesto de guerra en el atril, o exprima una vez a los gremios. De un modo u otro, necesito oro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}. La vieille loi autorise désormais un impôt de guerre, et la ligne extérieure est ouverte. Il me faut des archers, et les archers mangent. Fixez l’impôt de guerre au lutrin, ou saignez les guildes une fois. D’une façon ou d’une autre, il me faut de l’or."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Signore|Signora}. Ora la vecchia legge consente una tassa di guerra, e la linea esterna è aperta. Mi servono arcieri, e gli arcieri mangiano. Fissate la tassa di guerra al leggio, o spremete le corporazioni una volta sola. In un modo o nell’altro, mi serve oro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主。古い掟で、今は戦時税が許されています。外の防衛線も開いた。弓兵が要るし、弓兵は食う。書見台で戦時税を定めるか、一度だけ組合から絞り取るか。どちらにせよ、金が要ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Senhor|Senhora}. A velha lei agora permite um imposto de guerra, e a linha externa está aberta. Preciso de arqueiros, e arqueiros comem. Fixe o imposto de guerra no atril, ou sangre as guildas uma vez. De um jeito ou de outro, preciso de ouro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主。如今旧法准许征战争税，外防线也打开了。我需要弓手，弓手要吃饭。去书案定下战争税，或者让行会放一次血。不管怎样，我需要钱。"
          }
        }
      }
    },
