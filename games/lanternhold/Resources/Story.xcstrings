    },
    "petition.bad_arrows.hint" : {
      "comment" : "Petition bad_arrows: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünf Gold, um fünfzehn schon verlorene zu retten. Ich hasse es, wenn die Rechnung aufgeht. Lasst Bram sie umschmieden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Five gold to rescue fifteen already lost. I hate it when the arithmetic is right. Let Bram reforge them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinco monedas de oro para rescatar quince ya perdidas. Odio que las cuentas cuadren. Deje que Bram las vuelva a forjar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinq pièces d’or pour en sauver quinze déjà perdues. Je déteste quand le calcul est juste. Laissez Bram les reforger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinque monete d’oro per salvarne quindici già perse. Odio quando i conti tornano. Lasciate che Bram le riforgi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう失った15枚を救うのに5枚。計算が合うときほど、腹立たしいことはありません。ブラムに打ち直させましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinco moedas de ouro para salvar quinze já perdidas. Detesto quando a conta fecha. Deixe Bram reforjá-las."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "花5金币，救回已经赔掉的15金币。算术对的时候我最恨。让布拉姆重铸吧。"
          }
        }
      }
    },
    "petition.bad_arrows.r1" : {
      "comment" : "Petition bad_arrows: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram nickt einmal. Den ganzen Tag klingt die Esse, und zur Dämmerung liegen vierzig Pfeile in einer Reihe, jeder so gerade wie seine Meinungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram nods once. All day the forge rings, and at dusk forty arrows lie in a row, each as straight as his opinions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram asiente una vez. Todo el día suena la fragua, y al anochecer hay cuarenta flechas en fila, cada una tan recta como sus opiniones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram hoche la tête une fois. Toute la journée, la forge sonne, et au crépuscule, quarante flèches sont alignées, chacune aussi droite que ses opinions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram annuisce una volta. Per tutto il giorno la forgia risuona, e al crepuscolo quaranta frecce stanno in fila, ognuna dritta come le sue opinioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラムは一度だけうなずく。一日じゅう鍛冶場が鳴り、日暮れには四十本の矢が一列に並ぶ。どれも、彼の意見と同じくらいまっすぐだ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram assente uma vez. A forja ressoa o dia inteiro, e ao crepúsculo quarenta flechas estão enfileiradas, cada uma tão reta quanto as opiniões dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布拉姆点了一下头。铁砧响了一整天，黄昏时，四十支箭排成一排，每一支都跟他说话一样直。"
          }
        }
      }
    },
    "petition.bad_arrows.r2" : {
      "comment" : "Petition bad_arrows: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Nacht taumeln die Pfeile wie betrunkene Spatzen. Die Rußwesen machen sich nicht einmal die Mühe, sich zu ducken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That night the arrows tumble like drunk sparrows. The soot creatures do not even bother to duck."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa noche, las flechas dan tumbos como gorriones borrachos. Las criaturas de hollín ni se molestan en agacharse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette nuit-là, les flèches culbutent comme des moineaux ivres. Les créatures de suie ne prennent même pas la peine de se baisser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quella notte le frecce ruzzolano come passeri ubriachi. Le creature di fuliggine non si prendono nemmeno il disturbo di abbassarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その夜、矢は酔った雀のようによろめいて飛ぶ。煤影どもは、身をかがめる手間すらかけない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naquela noite as flechas cambaleiam feito pardais bêbados. As criaturas de fuligem nem se dão ao trabalho de se abaixar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那一夜，箭像喝醉的麻雀一样乱翻。煤影连躲都懒得躲。"
          }
        }
      }
    },
    "petition.bad_arrows.r3a" : {
      "comment" : "Petition bad_arrows: choice 3, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Burghof gestellt, zahlt Marek jede Münze zurück und schiebt es auf den Herrn vom See. Der ist ertrunken und widerspricht nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cornered in the courtyard, Marek refunds every coin and blames the lake lord. The lake lord, being drowned, cannot object."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acorralado en el patio de armas, Marek devuelve hasta la última moneda y culpa al señor del lago. El señor del lago, como está ahogado, no protesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coincé dans la cour, Marek rembourse chaque pièce et accuse le seigneur du lac. Le seigneur du lac, étant noyé, ne proteste pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messo alle strette nel cortile, Marek rimborsa ogni moneta e dà la colpa al signore del lago. Il quale, essendo annegato, non può obiettare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中庭で追い詰められたマレクは、硬貨を一枚残らず返し、湖の領主のせいにする。湖の領主は溺れているので、文句も言えない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encurralado no pátio, Marek devolve cada moeda e põe a culpa no senhor do lago. O senhor do lago, afogado como está, não pode protestar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "马雷克在庭院里被堵住，一文不少地退了钱，把错推给那位湖上的大人。那位大人已经淹死，无从反驳。"
          }
        }
      }
    },
    "petition.bad_arrows.r3b" : {
      "comment" : "Petition bad_arrows: choice 3, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek ist im Morgengrauen über die Flussstraße fort. Auf seine Ladeklappe hat jemand gekreidet: „Kein Umtausch. Herzlichst, M.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek left at dawn by the river road. On the cart’s tailboard someone chalked: “No refunds. Fondly, M.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek se fue al alba por el camino del río. En la trasera de su carro alguien escribió con tiza: «No se admiten devoluciones. Con cariño, M.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek est parti à l’aube par la route de la rivière. Sur le hayon de sa charrette, quelqu’un a écrit à la craie : « Ni repris ni échangé. Affectueusement, M. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek se n’è andato all’alba per la strada del fiume. Sulla sponda del carro qualcuno ha scritto col gesso: «Niente rimborsi. Con affetto, M.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マレクは夜明けに、川沿いの道から去っていた。荷車のあおり板に、誰かが白墨で書いている。「返品お断り。親愛をこめて、マレク」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek partiu na alvorada pela estrada do rio. Na tampa traseira da carroça, alguém escreveu a giz: “Não fazemos devoluções. Com carinho, M.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "马雷克天一亮就沿着河边的路走了。车尾板上有人用粉笔写着：“概不退换。爱你们的马某。”"
          }
        }
      }
    },
    "petition.bad_arrows.text" : {
      "comment" : "Petition bad_arrows (bram, follow-up of marek_arrows): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mareks Pfeile. Die Hälfte krumm. Der Rest hohl. Befiedert mit Huhn. Ich kann die Spitzen abnehmen und vierzig gute daraus schmieden. Kostet die Esse einen Tag und fünf Gold Kohle. Oder wir verschießen die hier und beten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek’s arrows. Half are bent. The rest are hollow. Fletched with chicken. I can strip the heads and forge forty good ones. Costs the forge a day and five gold of charcoal. Or we shoot these and pray."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las flechas de Marek. La mitad, torcidas. El resto, huecas. Emplumadas con gallina. Puedo quitar las puntas y forjar cuarenta buenas. Le cuesta a la fragua un día y cinco monedas de oro de carbón. O disparamos estas y rezamos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les flèches de Marek. La moitié tordues. Les autres creuses. Empennées de poulet. Je peux ôter les pointes et en forger quarante bonnes. Ça coûte un jour de forge et cinq pièces d’or de charbon. Ou on tire celles-là et on prie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le frecce di Marek. Metà storte. Le altre vuote dentro. Impennate con penne di gallina. Posso staccare le punte e forgiarne quaranta buone. Costa alla forgia un giorno e cinque monete d’oro di carbone. Oppure tiriamo queste e preghiamo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マレクの矢。半分は曲がってる。残りは中が空。矢羽根は鶏。鏃を外して、良いのを四十本打ち直せます。鍛冶場が一日つぶれて、炭に金貨5枚。でなけりゃ、これを撃って祈るか。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flechas de Marek. Metade torta. O resto oco. Empenadas com galinha. Posso tirar as pontas e forjar quarenta boas. Custa à forja um dia e cinco moedas de ouro de carvão. Ou atiramos estas e rezamos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "马雷克的箭。一半是弯的。其余是空心的。羽毛用的是鸡毛。我能拆下箭头，打出四十支好箭。炉子要烧一天，木炭要5金币。不然就射这些，然后祈祷。"
          }
        }
      }
    },
    "petition.banners_new.c1" : {
      "comment" : "Petition banners_new: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
