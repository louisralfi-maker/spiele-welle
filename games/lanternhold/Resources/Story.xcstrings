    "petition.tamsin_oven.c3" : {
      "comment" : "Petition tamsin_oven: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann eben Fladenbrot"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flat bread it is"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pues pan de rescoldo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va pour la galette"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pane sotto la cenere, allora"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "なら、平たいパンでいい"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Então, pão achatado"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那就吃薄饼"
          }
        }
      }
    },
    "petition.tamsin_oven.hint" : {
      "comment" : "Petition tamsin_oven: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fladenbrot hat noch niemanden umgebracht. Brannocks Männer kauen an guten Tagen Steine. Behaltet die zwanzig Gold."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flat bread never killed anyone. Brannock’s men chew rocks on a good day. Keep the twenty gold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pan de rescoldo nunca mató a nadie. Los hombres de Brannock mascan piedras en un buen día. Guárdese las veinte monedas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La galette n’a jamais tué personne. Les hommes de Brannock mâchent des cailloux les bons jours. Gardez les vingt pièces d’or."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pane sotto la cenere non ha mai ucciso nessuno. Gli uomini di Brannock, nei giorni buoni, masticano sassi. Tenete le venti monete d’oro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平たいパンで死んだ者はおりません。ブラノックの兵など、調子のいい日は石でもかじります。金貨20枚はお手元に。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pão achatado nunca matou ninguém. Os homens de Brannock mastigam pedra num dia bom. Guarde as vinte moedas de ouro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薄饼从没吃死过人。布兰诺克的兵，日子好时连石头都嚼。留着那20金币。"
          }
        }
      }
    },
    "petition.tamsin_oven.r1" : {
      "comment" : "Petition tamsin_oven: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Abend faucht der neue Ofen. Tamsin bäckt einen Laib in Laternenform und lässt Euch die erste Scheibe essen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new oven roars by evening. Tamsin bakes a loaf in the shape of a lantern and makes you eat the first slice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al anochecer el horno nuevo ruge. Tamsin hornea una hogaza con forma de farol y le hace comer la primera rebanada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le soir, le nouveau four ronfle. Tamsin cuit une miche en forme de lanterne et vous fait manger la première tranche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entro sera il forno nuovo ruggisce. Tamsin sforna una pagnotta a forma di lanterna e vi fa mangiare la prima fetta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夕方には、新しいかまどがごうごうと燃える。タムシンはランタンの形のパンを焼き、最初のひと切れを、有無を言わさず食べさせる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À noitinha, o forno novo ruge. Tamsin assa um pão em forma de lanterna e faz você comer a primeira fatia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到傍晚，新炉子呼呼作响。塔姆辛烤了个提灯形状的面包，非要你吃第一片。"
          }
        }
      }
    },
    "petition.tamsin_oven.r2a" : {
      "comment" : "Petition tamsin_oven: choice 2, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram flickt den Ofen mit Eisenbändern und Schweigen. Er funktioniert besser als neu und klingt, wenn er heiß ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram mends the oven with iron bands and silence. It works better than new and rings when it is hot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram arregla el horno con flejes de hierro y silencio. Funciona mejor que nuevo y tintinea cuando se calienta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram répare le four avec des cerclages de fer et du silence. Il marche mieux que neuf et sonne quand il est chaud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram aggiusta il forno con cerchi di ferro e silenzio. Funziona meglio di prima, e quando è caldo tintinna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラムは鉄の帯と沈黙でかまどを直す。新品より調子がよく、熱くなると鐘のように鳴る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram conserta o forno com cintas de ferro e silêncio. Fica melhor que novo e tine quando esquenta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布拉姆用铁箍和沉默修好了炉子。比新的还好用，烧热了还会铮铮作响。"
          }
        }
      }
    },
    "petition.tamsin_oven.r2b" : {
      "comment" : "Petition tamsin_oven: choice 2, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram flickt den Ofen. Mittags explodiert er. Niemand ist verletzt, aber die Küche liegt jetzt größtenteils im Freien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram mends the oven. It explodes at noon. Nobody is hurt, but the kitchen is now mostly outdoors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram arregla el horno. Explota al mediodía. Nadie sale herido, pero ahora la cocina está casi toda al aire libre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram répare le four. Il explose à midi. Personne n’est blessé, mais la cuisine est désormais surtout en plein air."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram aggiusta il forno. A mezzogiorno scoppia. Nessun ferito, ma ora la cucina è quasi tutta all’aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラムがかまどを直す。昼に破裂する。けが人はいないが、台所はいまや半分以上が野外だ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram conserta o forno. Ao meio-dia, ele explode. Ninguém se fere, mas agora a cozinha fica quase toda ao ar livre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布拉姆修好了炉子。中午它炸了。没人受伤，不过厨房如今大半到了露天。"
          }
        }
      }
    },
    "petition.tamsin_oven.r3" : {
      "comment" : "Petition tamsin_oven: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fladenbrot bis zum Frühjahr. Die Wachen nennen es Schildbrot und benutzen es auch so. Tamsin ist nicht erheitert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flat bread till spring. The guards call it shield-bread and use it as such. Tamsin is not amused."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pan de rescoldo hasta la primavera. Los guardias lo llaman pan escudo y lo usan como tal. A Tamsin no le hace gracia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galette jusqu’au printemps. Les gardes l’appellent le pain-bouclier et s’en servent comme tel. Tamsin n’en rit pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pane sotto la cenere fino a primavera. Le guardie lo chiamano pane-scudo e lo usano come tale. Tamsin non lo trova divertente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "春まで平たいパン。衛兵たちは盾パンと呼び、実際に盾として使う。タムシンは面白くない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pão achatado até a primavera. Os guardas o chamam de pão-escudo e o usam como tal. Tamsin não acha graça."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薄饼一直吃到开春。卫兵们管它叫“盾牌饼”，也真拿它当盾牌用。塔姆辛一点也不觉得好笑。"
          }
        }
      }
    },
    "petition.tamsin_oven.text" : {
      "comment" : "Petition tamsin_oven (tamsin): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mein Herr|Meine Herrin}, der Küchenofen ist letzte Nacht glatt durchgebrochen. Das Brot kommt heraus wie Dachziegel, und die Wache sagt das, laut. Ein Maurer will zwanzig Gold. Oder ich backe bis zum Frühjahr auf dem Herd."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the kitchen oven cracked clean through last night. The bread comes out like roof tiles, and the guard says so, loudly. A mason wants twenty gold. Or I bake on the hearth till spring."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, el horno de la cocina se partió de lado a lado anoche. El pan sale como tejas, y la guardia lo dice, bien alto. Un albañil pide veinte monedas de oro. O cuezo en el hogar hasta la primavera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, le four de la cuisine s’est fendu de part en part cette nuit. Le pain en sort comme des tuiles, et la garde le dit, bien fort. Un maçon veut vingt pièces d’or. Sinon, je cuis sur l’âtre jusqu’au printemps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, stanotte il forno della cucina si è spaccato da parte a parte. Il pane esce come tegole, e la guardia lo dice, ad alta voce. Un muratore vuole venti monete d’oro. Oppure cuocio sul focolare fino a primavera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、ゆうべ台所のかまどが真っ二つに割れちまいました。パンが屋根瓦みたいに焼き上がって、衛兵が大声でそう言うんですよ。石工は金貨20枚と言ってます。でなけりゃ、春まで炉で焼くしかありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, o forno da cozinha rachou de lado a lado ontem à noite. O pão sai feito telha, e a guarda diz isso, bem alto. Um pedreiro quer vinte moedas de ouro. Ou eu asso na lareira até a primavera."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大人，厨房的炉子昨夜整个裂穿了。烤出来的面包跟瓦片似的，卫兵们还大声嚷嚷。泥瓦匠要20金币。不然我就只能在灶火上烤，一直烤到开春。"
          }
        }
      }
    },
    "petition.tapestry_aldric.c1" : {
      "comment" : "Petition tapestry_aldric: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hängt ihn im Saal auf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hang it in the hall"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuélguelo en el salón"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendez-la dans la salle"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appendetelo nel salone"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大広間に掛けましょう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendure-a no salão"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就挂在大厅里"
          }
        }
      }
    },
    "petition.tapestry_aldric.c2" : {
      "comment" : "Petition tapestry_aldric: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezahlt sie, dann hängt ihn auf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay her, then hang it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Páguele, y luego cuélguelo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payez la veuve, puis accrochez-la"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagatela, poi appendetelo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代金を払って、掛けましょう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pague a ela e depois pendure"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付她钱，再挂上"
          }
        }
      }
    },
    "petition.tapestry_aldric.c3" : {
      "comment" : "Petition tapestry_aldric: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Saal gehört den Lebenden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hall belongs to the living"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El salón es de los vivos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La salle appartient aux vivants"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il salone appartiene ai vivi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大広間は、生きている者のものです"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O salão é dos vivos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大厅属于活着的人"
          }
        }
      }
    },
    "petition.tapestry_aldric.hint" : {
      "comment" : "Petition tapestry_aldric: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kostet nichts, er ist schön, und er erinnert daran, wer als Erster hinausritt. Hängt ihn auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is free, it is beautiful, and it reminds people who rode out first. Hang it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gratis, es hermoso, y le recuerda a la gente quién salió primero. Cuélguelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle est gratuite, elle est belle, et elle rappelle aux gens qui est parti le premier. Suspendez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È gratis, è bello, e ricorda alla gente chi è partito per primo. Appendetelo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ただで、美しく、誰が先に出ていったかを皆に思い出させます。掛けない理由がございません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É de graça, é bonita e lembra a todos quem cavalgou primeiro. Pendure-a."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要钱，又好看，还能提醒大家是谁最先骑马出城。挂上吧。"
          }
        }
      }
    },
    "petition.tapestry_aldric.r1" : {
      "comment" : "Petition tapestry_aldric: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er hängt nun hinter dem Thron. Im Feuerschein scheint Aldrics Laterne zu flackern, und die Witwe weint leise."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It goes up behind the throne. In the firelight Aldric’s lantern seems to flicker, and the widow weeps quietly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo cuelgan detrás del trono. A la luz del fuego, el farol de Aldric parece parpadear, y la viuda llora en silencio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On l’accroche derrière le trône. À la lueur du feu, la lanterne d’Aldric semble vaciller, et la veuve pleure en silence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene appeso dietro il trono. Alla luce del fuoco la lanterna di Aldric sembra tremolare, e la vedova piange in silenzio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁掛けは城主の座の後ろに掛けられる。炉の火明かりに、アルドリックのランタンが揺らめくように見え、未亡人は静かに泣く。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela vai para trás do trono. À luz do fogo, a lanterna de Aldric parece tremeluzir, e a viúva chora baixinho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挂毯挂在了主座后面。火光里，奥德里克的提灯仿佛在闪动，寡妇悄悄落了泪。"
          }
        }
      }
    },
    "petition.tapestry_aldric.r2" : {
      "comment" : "Petition tapestry_aldric: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie lehnt das Gold dreimal ab und nimmt es beim vierten Mal. Der Saal fühlt sich sofort älter und wärmer an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She refuses the gold three times and takes it the fourth. The hall feels older and warmer at once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechaza el oro tres veces y a la cuarta lo acepta. El salón parece de pronto más antiguo y más cálido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle refuse l’or trois fois et le prend la quatrième. La salle paraît à la fois plus vieille et plus chaude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rifiuta l’oro tre volte e alla quarta lo prende. Il salone sembra d’un tratto più antico e più caldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未亡人は金を三度断り、四度目に受け取る。大広間は、たちまち古びて、温かくなったように感じられる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela recusa o ouro três vezes e aceita na quarta. O salão parece mais antigo e mais quente ao mesmo tempo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她推辞了三次金币，第四次才收下。大厅一下子显得更古老，也更温暖了。"
          }
        }
      }
    },
    "petition.tapestry_aldric.r3" : {
      "comment" : "Petition tapestry_aldric: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie rollt ihn wortlos wieder zusammen. Odile nennt es später die richtige Wahl. Sie klingt nicht überzeugt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She rolls it up again without a word. Odile later calls it the right choice. She does not sound sure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo vuelve a enrollar sin decir nada. Más tarde, Odile dice que fue la decisión correcta. No suena convencida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle la roule de nouveau sans un mot. Plus tard, Odile dit que c’était le bon choix. Elle n’a pas l’air sûre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo arrotola di nuovo senza una parola. Più tardi Odile la definisce la scelta giusta. Non sembra convinta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未亡人は何も言わずに壁掛けを巻き直す。オディールはのちに、それが正しい選択だったと言う。自信のある声ではない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela enrola a tapeçaria de novo, sem uma palavra. Mais tarde, Odile diz que foi a escolha certa. Não parece ter certeza."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她一言不发地把挂毯重新卷起。后来奥黛尔说这么做是对的。她的语气并不肯定。"
          }
        }
      }
    },
    "petition.tapestry_aldric.text" : {
      "comment" : "Petition tapestry_aldric (widow): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, ich habe einen Wandteppich gewebt, Burgherr Aldric auf dem Ritt zum Leuchtfeuer, elf Jahre lang an jedem Abend. Ich möchte, dass er im großen Saal hängt, wo er saß. Ich verlange nichts dafür, nur dass er nicht in die Küche kommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, I wove a tapestry of Lord Aldric riding to the beacon, eleven years of evenings. I would like it to hang in the great hall where he sat. I ask nothing for it, only that it not go in the kitchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, tejí un tapiz de lord Aldric cabalgando hacia la almenara: once años de tardes. Quisiera que colgara en el gran salón, donde él se sentaba. No pido nada por él, solo que no acabe en la cocina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, j’ai tissé une tapisserie du seigneur Aldric chevauchant vers le fanal, onze ans de soirées. J’aimerais qu’elle soit suspendue dans la grande salle, là où il s’asseyait. Je n’en demande rien, sauf qu’elle n’aille pas à la cuisine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, ho tessuto un arazzo di Lord Aldric che cavalca verso il faro, undici anni di serate. Vorrei che fosse appeso nel salone, dove lui sedeva. Non chiedo niente in cambio, solo che non finisca in cucina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、アルドリック様が烽火へ馬で向かうお姿を、壁掛けに織りました。十一年分の夕べをかけて。あの方が座っておられた大広間に、掛けていただきたいのです。代金はいりません。ただ、台所には掛けないでください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, teci uma tapeçaria do Lorde Aldric cavalgando até o farol, onze anos de serões. Eu gostaria que ela ficasse pendurada no salão, onde ele se sentava. Não peço nada por ela, só que não vá para a cozinha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，我用十一年的黄昏织了一幅挂毯，织的是奥德里克大人骑马奔赴烽火。我想让它挂在大厅里他坐过的地方。我什么也不要，只求别挂进厨房。"
          }
        }
      }
    },
    "petition.tavern_brawl.c1" : {
      "comment" : "Petition tavern_brawl: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schützen zahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archers pay"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagan los arqueros"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les archers paient"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagano gli arcieri"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弓兵が払う"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arqueiros pagam"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弓手赔"
          }
        }
      }
    },
    "petition.tavern_brawl.c2" : {
      "comment" : "Petition tavern_brawl: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bauern zahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The farmers pay"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagan los campesinos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paysans paient"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagano i contadini"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "農夫が払う"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os camponeses pagam"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "农夫赔"
          }
        }
      }
    },
    "petition.tavern_brawl.c3" : {
      "comment" : "Petition tavern_brawl: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Haus zahlt, beide Seiten trinken"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The house pays, both sides drink"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga la casa, y que beban todos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maison paie, et tout le monde trinque"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga la casata, e tutti bevono"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城の奢りだ。皆で飲んでくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A casa paga, e todos bebem"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兰腾家出钱，两边喝一杯"
          }
        }
      }
    },
    "petition.tavern_brawl.hint" : {
      "comment" : "Petition tavern_brawl: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schützen haben Sold und nichts, wofür sie ihn ausgeben könnten. Lasst sie zahlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archers have wages and nothing to spend them on. Let them pay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los arqueros tienen paga y nada en qué gastarla. Que paguen ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les archers ont une solde et rien à quoi la dépenser. Qu’ils paient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli arcieri hanno una paga e niente in cui spenderla. Che paghino loro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弓兵には給金があって、使い道がありません。払わせなさいませ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arqueiros têm soldo e nada em que gastá-lo. Que paguem eles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弓手有饷钱，又没处花。让他们赔。"
          }
        }
      }
    },
    "petition.tavern_brawl.r1" : {
      "comment" : "Petition tavern_brawl: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schützen zahlen, beleidigt. In der Nacht schießen sie mit ungewohnter Wut, was Brannock einen Lichtblick nennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archers pay, sulking. That night they shoot with unusual anger, which Brannock calls a silver lining."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los arqueros pagan, enfurruñados. Esa noche disparan con una rabia poco común. Brannock dice que no hay mal que por bien no venga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les archers paient en boudant. Cette nuit-là, ils tirent avec une rage inhabituelle, ce qui, pour Brannock, n’est pas un mal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli arcieri pagano, imbronciati. Quella notte tirano con una rabbia insolita, e Brannock dice che non tutto il male vien per nuocere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弓兵たちはふてくされて払う。その夜、彼らはいつになく怒りをこめて射る。ブラノックはそれを、不幸中の幸いと呼ぶ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arqueiros pagam, emburrados. Naquela noite, atiram com uma raiva fora do comum, o que Brannock considera um mal que veio para bem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弓手们赔了，一肚子不痛快。那一夜他们射得格外狠，布兰诺克说这也算因祸得福。"
          }
        }
      }
    },
    "petition.tavern_brawl.r2" : {
      "comment" : "Petition tavern_brawl: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bauern zahlen und gehen murrend heim. Am nächsten Markttag kosten Eier für Soldaten das Doppelte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The farmers pay and go home muttering. On the next market day, eggs cost soldiers double."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los campesinos pagan y se van a casa refunfuñando. El siguiente día de mercado, los huevos les cuestan el doble a los soldados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paysans paient et rentrent en marmonnant. Au marché suivant, les œufs coûtent le double aux soldats."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I contadini pagano e tornano a casa borbottando. Al mercato successivo, per i soldati le uova costano il doppio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "農夫たちは払い、ぶつぶつ言いながら帰る。次の市の日、兵士に売る卵は倍の値になる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os camponeses pagam e voltam para casa resmungando. No dia de feira seguinte, ovo para soldado custa o dobro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "农夫们赔了钱，嘟囔着回了家。下一个集市日，鸡蛋卖给当兵的就要双倍价钱。"
          }
        }
      }
    },
    "petition.tavern_brawl.r3" : {
      "comment" : "Petition tavern_brawl: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Seiten müssen auf Kosten des Hauses aufeinander trinken. Bei der dritten Runde singen sie dasselbe Lied."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both sides are made to drink to each other on the house’s coin. By the third round they sing the same song."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A unos y otros se les hace brindar entre sí a costa de la casa. A la tercera ronda cantan la misma canción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux camps doivent trinquer l’un à l’autre aux frais de la maison. Au troisième tour, ils chantent la même chanson."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le due parti devono brindare l’una all’altra a spese della casata. Al terzo giro cantano la stessa canzone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双方とも、城の金で互いのために杯を上げさせられる。三杯目には、同じ歌を歌っている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dois lados são obrigados a brindar um ao outro com o dinheiro da casa. Na terceira rodada, já cantam a mesma canção."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两边被迫用兰腾家的钱互相敬酒。到第三巡，他们唱起了同一首歌。"
          }
        }
      }
    },
    "petition.tavern_brawl.text" : {
      "comment" : "Petition tavern_brawl (townsman): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, letzte Nacht haben Eure Schützen meine Schenke zerlegt. Zwei Tische, eine Bank und der gute Spiegel. Sie sagen, ein Bauer habe sie Kerzenlöscher genannt. Die Bauern sagen, die Schützen hätten angefangen. Einer zahlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, last night your archers wrecked my alehouse. Two tables, a bench and the good mirror. They say a farmer called them candle-snuffers. The farmers say the archers started it. Someone pays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, anoche sus arqueros destrozaron mi taberna. Dos mesas, un banco y el espejo bueno. Dicen que un campesino los llamó apagavelas. Los campesinos dicen que empezaron los arqueros. Alguien tiene que pagar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, la nuit dernière, vos archers ont saccagé ma taverne. Deux tables, un banc et le beau miroir. Ils disent qu’un paysan les a traités d’éteignoirs. Les paysans disent que les archers ont commencé. Quelqu’un paiera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, la notte scorsa i vostri arcieri mi hanno distrutto l’osteria. Due tavoli, una panca e lo specchio buono. Dicono che un contadino li ha chiamati spegnimoccoli. I contadini dicono che hanno cominciato gli arcieri. Qualcuno paga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、ゆうべお城の弓兵が、うちの酒場をめちゃくちゃにしました。卓が二つ、長椅子が一つ、それに上等の鏡。農夫に蝋燭消しと呼ばれたと言うんです。農夫たちは、先に手を出したのは弓兵だと。誰かに払ってもらわないと。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, ontem à noite os seus arqueiros destruíram a minha taverna. Duas mesas, um banco e o espelho bom. Dizem que um camponês os chamou de apaga-velas. Os camponeses dizem que os arqueiros começaram. Alguém vai pagar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，昨夜您的弓手砸了我的酒馆。两张桌子、一条长凳，还有那面好镜子。他们说有个农夫骂他们是“熄蜡烛的”。农夫们说是弓手先动的手。总得有人赔。"
          }
        }
      }
    },
    "petition.tax_grumble.c1" : {
      "comment" : "Petition tax_grumble: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brot und Feuerholz für alle"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bread and firewood for all"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pan y leña para todos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du pain et du bois pour tous"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pane e legna per tutti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "皆にパンと薪を"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pão e lenha para todos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面包和柴火，人人有份"
          }
        }
      }
    },
    "petition.tax_grumble.c2" : {
      "comment" : "Petition tax_grumble: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mauern brauchen die Steuern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The walls need the taxes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las murallas necesitan los impuestos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les murailles ont besoin des impôts"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle mura servono le tasse"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城壁には税が要る"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As muralhas precisam dos impostos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城墙需要这些税"
          }
        }
      }
    },
    "petition.tax_grumble.hint" : {
      "comment" : "Petition tax_grumble: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne ich die Schatzkammer einmal, erwarten sie es zweimal. Senkt lieber am Pult die Steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If I open the treasury once, they will expect it twice. Lower the taxes at the lectern instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si abro el tesoro una vez, esperarán que lo abra dos. Mejor baje los impuestos en el atril."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si j’ouvre le trésor une fois, ils l’attendront deux fois. Baissez plutôt les impôts au lutrin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se apro il tesoro una volta, se lo aspetteranno due. Abbassate piuttosto le tasse al leggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度金庫を開ければ、二度目を期待されます。それより、書見台で税をお下げになることです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eu abrir o tesouro uma vez, vão esperar duas. Em vez disso, baixe os impostos no atril."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我开一次府库，他们就会指望第二次。不如去书案把税调低。"
          }
        }
      }
    },
    "petition.tax_grumble.r1" : {
      "comment" : "Petition tax_grumble: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den ganzen Nachmittag rollen Karren mit Brot und Holz durch die Gassen. Am Abend rauchen die Kamine, und die Leute winken wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carts of bread and wood roll through the lanes all afternoon. That evening the chimneys smoke and people wave again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda la tarde ruedan por las calles carros de pan y de leña. Al anochecer humean las chimeneas y la gente vuelve a saludar con la mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout l’après-midi, des charrettes de pain et de bois roulent dans les ruelles. Le soir, les cheminées fument et les gens saluent de nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carri di pane e legna attraversano i vicoli per tutto il pomeriggio. La sera i camini fumano e la gente torna a salutare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "午後いっぱい、パンと薪を積んだ荷車が路地を行き交う。その晩、煙突から煙が上がり、人々はまた手を振るようになる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carroças de pão e lenha rodam pelas vielas a tarde inteira. À noitinha, as chaminés fumegam e o povo volta a acenar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运面包和木柴的车子在巷子里转了一下午。那天傍晚，烟囱冒起了烟，人们又开始挥手了。"
          }
        }
      }
    },
    "petition.tax_grumble.r2" : {
      "comment" : "Petition tax_grumble: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er nickt, ohne zuzustimmen. Beim Hinausgehen begegnet er Odile, die ihn voller Mitgefühl ansieht und sonst nichts tut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He nods without agreeing. On the way out he passes Odile, who gives him a look of perfect sympathy and nothing else."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asiente sin estar de acuerdo. Al salir se cruza con Odile, que le dedica una mirada de perfecta comprensión y nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il hoche la tête sans être d’accord. En sortant, il croise Odile, qui lui adresse un regard plein de compassion, et rien d’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuisce senza essere d’accordo. Uscendo incrocia Odile, che gli rivolge uno sguardo di perfetta comprensione e nient’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "男はうなずくが、納得はしていない。帰りがけにオディールとすれ違う。オディールは同情に満ちた目を向け、それ以上は何もしない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele assente sem concordar. Na saída, cruza com Odile, que lhe lança um olhar de perfeita compaixão e nada mais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他点点头，却并不赞同。出门时他与奥黛尔擦肩而过，她向他投去十足同情的一瞥，此外什么也没做。"
          }
        }
      }
    },
    "petition.tax_grumble.text" : {
      "comment" : "Petition tax_grumble (townsman, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, die Stadt ist müde. Jeden Morgen mehr Steuern, jede Nacht mehr Lärm. Die Leute fragen, ob das Haus nicht einmal die Schatzkammer öffnen könnte, für Brot und Feuerholz, bevor die Ersten gehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the town is tired. Every dawn more taxes, every night more noise. Folk ask whether the house might open the treasury once, for bread and firewood, before people start leaving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, el pueblo está cansado. Cada amanecer, más impuestos; cada noche, más ruido. La gente pregunta si la casa podría abrir el tesoro una vez, para pan y leña, antes de que empiecen a irse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, la ville est fatiguée. Chaque aube, plus d’impôts ; chaque nuit, plus de bruit. Les gens demandent si la maison ne pourrait pas ouvrir le trésor une fois, pour du pain et du bois, avant que les premiers s’en aillent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, il borgo è stanco. Ogni alba più tasse, ogni notte più rumore. La gente chiede se la casata non potrebbe aprire il tesoro una volta, per pane e legna, prima che qualcuno cominci ad andarsene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、町は疲れています。夜明けごとに税が増え、夜ごとに騒ぎが増える。出ていく者が出る前に、お城が一度だけ金庫を開けて、パンと薪を配ってはくださらないかと、皆が言っています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, a cidade está cansada. Toda alvorada, mais impostos; toda noite, mais barulho. O povo pergunta se a casa não poderia abrir o tesouro uma vez, para pão e lenha, antes que as pessoas comecem a ir embora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，镇上累了。每天黎明税更多，每夜动静更大。大家想问，城主家能不能开一回府库，发些面包和柴火，免得有人开始离开。"
          }
        }
      }
    },
    "petition.thief_bread.c1" : {
      "comment" : "Petition thief_bread: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An den Pranger mit ihm"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put him in the stocks"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cepo con él"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez-le au pilori"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettetelo alla gogna"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "さらし台に掛けてくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao pelourinho com ele"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给他上枷"
          }
        }
      }
    },
    "petition.thief_bread.c2" : {
      "comment" : "Petition thief_bread: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er arbeitet es in Eurer Backstube ab"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He works it off in your bakery"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que lo pague trabajando en su panadería"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il travaillera à votre fournil"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripagherà lavorando nel vostro forno"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そちらのパン屋で働いて返させよう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele paga trabalhando na sua padaria"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让他在你的面包坊干活抵债"
          }
        }
      }
    },
    "petition.thief_bread.c3" : {
      "comment" : "Petition thief_bread: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Haus bezahlt das Brot"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The house pays for the bread"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La casa paga el pan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maison paie le pain"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pane lo paga la casata"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パン代は城が払う"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A casa paga o pão"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兰腾家付面包钱"
          }
        }
      }
    },
    "petition.thief_bread.hint" : {
      "comment" : "Petition thief_bread: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei Laibe Gnade für fünf Gold. Billiger kann man sich nicht beliebt machen. Bezahlt das Brot."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three loaves of mercy for five gold. I have never seen a cheaper way to be loved. Pay for the bread."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres hogazas de clemencia por cinco monedas de oro. Nunca he visto una forma más barata de ganarse el cariño. Pague el pan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois miches de clémence pour cinq pièces d’or. Je n’ai jamais vu de façon moins chère de se faire aimer. Payez le pain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre pagnotte di misericordia per cinque monete d’oro. Non ho mai visto un modo più economico di farsi amare. Pagate il pane."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金貨5枚で、パン三つ分の慈悲。これほど安く慕われる方法は、見たことがございません。パン代は城で持ちましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Três pães de misericórdia por cinco moedas de ouro. Nunca vi jeito mais barato de ganhar o amor do povo. Pague o pão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5金币，买三个面包的仁慈。我从没见过更便宜的得人心的法子。替他付面包钱。"
          }
        }
      }
    },
    "petition.thief_bread.r1" : {
      "comment" : "Petition thief_bread: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er steht einen Tag am Pranger. Niemand wirft etwas. Am Abend hat ihm jemand Brot vor die Füße gelegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He stands in the stocks for a day. Nobody throws anything. By evening someone has left bread at his feet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa un día en el cepo. Nadie le tira nada. Al anochecer, alguien le ha dejado pan a los pies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reste un jour au pilori. Personne ne lui lance rien. Le soir, quelqu’un a laissé du pain à ses pieds."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta alla gogna per un giorno. Nessuno gli tira niente. Entro sera qualcuno gli ha lasciato del pane ai piedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少年は一日、さらし台に立つ。誰も何も投げない。夕方には、誰かが足もとにパンを置いている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele passa um dia no pelourinho. Ninguém atira nada. À noitinha, alguém deixou pão aos pés dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他在枷台上站了一天。没人朝他扔东西。到傍晚，有人在他脚边放了面包。"
          }
        }
      }
    },
    "petition.thief_bread.r2" : {
      "comment" : "Petition thief_bread: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie nimmt ihn auf. Er verbrennt das erste Blech und das zweite, und beim zehnten bleibt er für immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She takes him on. He burns the first batch and the second, and by the tenth he is staying for good."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ella lo acoge. Quema la primera hornada y la segunda, y para la décima ya se queda para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle le prend avec elle. Il brûle la première fournée et la deuxième, et à la dixième, il reste pour de bon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lei lo prende con sé. Lui brucia la prima infornata e la seconda, e alla decima resta per sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "女は少年を引き取る。少年は一度目も二度目も焦がし、十度目には、そのまま居ついている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela o aceita. Ele queima a primeira fornada e a segunda, e na décima já ficou de vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她收下了他。他烤糊了第一炉，又烤糊了第二炉，到第十炉时，他就再也没走。"
          }
        }
      }
    },
    "petition.thief_bread.r3" : {
      "comment" : "Petition thief_bread: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr bezahlt die Laibe. Der Junge rennt davon, bevor ihm jemand danken kann, aber am nächsten Morgen sind die Burgstufen gefegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You pay for the loaves. The boy runs before anyone can thank him, but next morning the castle steps are swept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usted paga las hogazas. El muchacho sale corriendo antes de que nadie pueda darle las gracias, pero a la mañana siguiente las escaleras del castillo están barridas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous payez les miches. Le garçon file avant qu’on ait pu le remercier, mais le lendemain matin, les marches du château sont balayées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagate voi le pagnotte. Il ragazzo scappa prima che qualcuno possa ringraziarlo, ma la mattina dopo gli scalini del castello sono spazzati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パン代を払う。少年は誰かに礼を言われる前に駆け去るが、翌朝、城の石段がきれいに掃かれている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você paga os pães. O menino sai correndo antes que alguém lhe agradeça, mas na manhã seguinte os degraus do castelo estão varridos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你付了面包钱。没等人道谢，那男孩就跑了，可第二天早上，城堡的台阶被扫得干干净净。"
          }
        }
      }
    },
    "petition.thief_bread.text" : {
      "comment" : "Petition thief_bread (townswoman): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, ein Junge hat drei Laibe aus meiner Backstube gestohlen, und die Wache hat ihn erwischt. Er ist vielleicht zwölf und sehr mager. Das Gesetz sagt: der Pranger. Ich sage: Das Gesetz hat noch nie Brot gebacken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, a boy stole three loaves from my bakery, and the guard caught him. He is maybe twelve and very thin. The law says the stocks. I say the law has never baked bread."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, un muchacho robó tres hogazas de mi panadería, y la guardia lo atrapó. Tendrá doce años y está muy flaco. La ley dice el cepo. Yo digo que la ley nunca ha hecho pan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, un garçon a volé trois miches dans ma boulangerie, et la garde l’a attrapé. Il a peut-être douze ans et il est très maigre. La loi dit le pilori. Moi, je dis que la loi n’a jamais cuit de pain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, un ragazzo ha rubato tre pagnotte dal mio forno, e la guardia l’ha preso. Avrà dodici anni ed è magrissimo. La legge dice la gogna. Io dico che la legge non ha mai fatto il pane."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、男の子がうちのパン屋からパンを三つ盗んで、衛兵に捕まりました。十二ぐらいで、ひどく痩せています。掟ではさらし台です。でも掟は、パンを焼いたことがありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, um menino roubou três pães da minha padaria, e a guarda o pegou. Ele tem uns doze anos e é muito magro. A lei diz pelourinho. Eu digo que a lei nunca assou um pão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，有个男孩从我的面包坊偷了三个面包，被卫兵抓住了。他也就十二岁，瘦得厉害。按律该上枷。我说，律法可从没烤过面包。"
          }
        }
      }
    },
    "petition.tithe_letters.c1" : {
      "comment" : "Petition tithe_letters: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hängt die Banner auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hang the banners."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuelgue los estandartes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendez les bannières."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appendete gli stendardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旗を掛けてくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendure os estandartes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把旗挂起来。"
          }
        }
      }
    },
    "petition.tithe_letters.c2" : {
      "comment" : "Petition tithe_letters: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hängt keines auf. Wir halten allein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hang none. We hold alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No cuelgue ninguno. Resistimos solos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune. Nous tenons seuls."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno stendardo. Resistiamo da soli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掛けなくていい。我らだけで守る"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não pendure nenhum. Aguentamos sozinhos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一面也不挂。我们独自坚守。"
          }
        }
      }
    },
    "petition.tithe_letters.hint" : {
      "comment" : "Petition tithe_letters: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kahle Wand sagt dem Tal, dass wir allein sind. Schon ein Banner sagt etwas anderes. Hängt sie auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bare wall tells the valley we are alone. Even one banner says otherwise. Hang them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pared desnuda le dice al valle que estamos solos. Un solo estandarte ya dice lo contrario. Cuélguelos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mur nu dit à la vallée que nous sommes seuls. Une seule bannière dit le contraire. Suspendez-les."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una parete spoglia dice alla valle che siamo soli. Anche un solo stendardo dice il contrario. Appendeteli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も掛かっていない壁は、我らが孤立していると谷に告げます。旗一枚でも、そうではないと語ります。すべて掛けましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma parede nua diz ao vale que estamos sozinhos. Até um único estandarte diz o contrário. Pendure-os."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一面空墙告诉河谷，我们孤立无援。哪怕只有一面旗，说的也是另一回事。挂上吧。"
          }
        }
      }
    },
    "petition.tithe_letters.r1" : {
      "comment" : "Petition tithe_letters: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis Mittag hängen sie über den Bänken, weniger als Haken da sind. Odile staubt die leeren Haken trotzdem ab. „Für später“, sagt sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By noon they hang over the benches, fewer than the hooks. Odile dusts the empty hooks all the same. “For later,” she says."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al mediodía cuelgan sobre los bancos, y sobran ganchos. Aun así, Odile les quita el polvo a los vacíos. «Para más adelante», dice."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À midi, elles pendent au-dessus des bancs, moins nombreuses que les crochets. Odile époussette quand même les crochets vides. « Pour plus tard », dit-elle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mezzogiorno pendono sopra le panche, e sono meno dei ganci. Odile spolvera lo stesso i ganci vuoti. «Per dopo», dice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昼までに、旗が長椅子の上に並ぶ。鉤の数よりも少ない。それでもオディールは、空いた鉤のほこりを払う。「後のために」と言う。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao meio-dia, eles pendem sobre os bancos, menos do que os ganchos. Odile tira o pó dos ganchos vazios mesmo assim. “Para depois”, diz ela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到中午，旗帜挂在长凳上方，比钩子少。奥黛尔照样给空钩子掸了灰。“留着以后用。”她说。"
          }
        }
      }
    },
    "petition.tithe_letters.r2" : {
      "comment" : "Petition tithe_letters: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile faltet jedes Banner in seinen alten Falten und legt es in die Truhe. „Allein ist billiger“, sagt sie. „Besser habe ich nicht gesagt.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile folds each banner along its old creases and lays it in the chest. “Alone is cheaper,” she says. “I did not say better.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile dobla cada estandarte por sus viejos pliegues y lo guarda en el arcón. «Solos sale más barato», dice. «No dije mejor.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile plie chaque bannière selon ses vieux plis et la range dans le coffre. « Seuls, c’est moins cher, dit-elle. Je n’ai pas dit mieux. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile piega ogni stendardo lungo le sue vecchie pieghe e lo ripone nella cassa. «Da soli costa meno», dice. «Non ho detto che è meglio.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オディールは旗を一枚ずつ古い折り目どおりにたたみ、櫃にしまう。「自分たちだけのほうが安上がりです」と言う。「良いとは申しておりません」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile dobra cada estandarte pelas dobras antigas e o guarda no baú. “Sozinhos sai mais barato”, diz ela. “Não falei melhor.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "奥黛尔把每面旗沿着旧折痕叠好，放进箱子。“独自更省钱，”她说，“我可没说更好。”"
          }
        }
      }
    },
    "petition.tithe_letters.text" : {
      "comment" : "Petition tithe_letters (odile, story days 16): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mein Herr|Meine Herrin}, die Zehntbriefe sind da. Die Häuser, die noch zahlen, haben ihre Banner mitgeschickt, wie es Brauch ist. Hängt sie im Saal auf, und jeder Bittsteller sieht, wer zu uns steht. Und wer nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the tithe letters are in. The houses that still pay have sent their banners with them, as the custom is. Hang them in the hall, and every petitioner sees who stands with us. And who does not."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, han llegado las cartas del diezmo. Las casas que aún pagan han enviado con ellas sus estandartes, como es costumbre. Cuélguelos en el salón, y cada peticionario verá quién está con nosotros. Y quién no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, les lettres de la dîme sont arrivées. Les maisons qui paient encore ont envoyé leurs bannières avec, comme le veut la coutume. Suspendez-les dans la salle, et chaque requérant verra qui est avec nous. Et qui ne l’est pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, sono arrivate le lettere della decima. Le casate che pagano ancora hanno mandato con esse i loro stendardi, com’è usanza. Appendeteli nel salone, e ogni supplicante vedrà chi sta con noi. E chi no."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、貢ぎの書状が届きました。まだ納めている家々は、慣わしどおり旗を添えてよこしています。大広間に掛ければ、陳情者は誰もが、誰がこちらについているかを目にします。誰がついていないかも。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, as cartas do dízimo chegaram. As casas que ainda pagam mandaram os seus estandartes junto, como manda o costume. Pendure-os no salão, e todo peticionário verá quem está conosco. E quem não está."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大人，贡赋信都到了。仍在纳贡的家族按惯例随信送来了旗帜。把它们挂在大厅里，每个请愿人都能看见谁站在我们这边。谁没有。"
          }
        }
      }
    },
    "petition.tower_request.c1" : {
      "comment" : "Petition tower_request: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr bekommt Euren Turm"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You shall have your tower"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendrá su torre"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous aurez votre tour"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avrete la vostra torre"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "塔は建てよう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você vai ter a sua torre"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "塔给你建"
          }
        }
      }
    },
    "petition.tower_request.c2" : {
      "comment" : "Petition tower_request: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst Licht, dann Pfeile"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light first, then arrows"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero luz, luego flechas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lumière, puis les flèches"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima la luce, poi le frecce"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず灯りだ。矢はその後"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luz primeiro, depois flechas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先点灯，再说箭"
          }
        }
      }
    },
    "petition.tower_request.hint" : {
      "comment" : "Petition tower_request: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wird jede Woche einen Turm verlangen, bis er stirbt. Dieser ist zufällig eine gute Idee. Sagt ja."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He will ask for a tower every week until he dies. This one happens to be a good idea. Say yes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedirá una torre cada semana hasta el día de su muerte. Da la casualidad de que esta es una buena idea. Diga que sí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il réclamera une tour chaque semaine jusqu’à sa mort. Il se trouve que celle-ci est une bonne idée. Dites oui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiederà una torre ogni settimana finché campa. Questa, per caso, è una buona idea. Dite di sì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あの男は死ぬまで毎週、塔をねだるでしょう。今回のは、たまたま良い案です。お受けください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele vai pedir uma torre toda semana até morrer. Esta, por acaso, é uma boa ideia. Diga sim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他会每周要一座塔，直到死。这一座碰巧是个好主意。答应他。"
          }
        }
      }
    },
    "petition.tower_request.r1" : {
      "comment" : "Petition tower_request: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock brummt, was bei ihm fast schon ein Lied ist. Im Hinausgehen tritt er den Pflock am Tor ein wenig gerader."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock grunts, which from him is practically a song. On his way out he kicks the stake by the gate a little straighter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock gruñe, que en él es casi una canción. Al salir, endereza de una patada la estaca junto a la puerta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock grogne, ce qui chez lui vaut presque une chanson. En sortant, il redresse d’un coup de pied le piquet près de la porte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock grugnisce, il che, per lui, è quasi una canzone. Uscendo, raddrizza con un calcio il picchetto vicino alla porta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラノックがうなる。この男にしては、歌も同然だ。出ていきがけに、門の脇の杭を蹴って少しまっすぐにする。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock resmunga, o que, vindo dele, é quase uma canção. Ao sair, chuta a estaca junto ao portão para deixá-la um pouco mais reta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布兰诺克哼了一声，这在他已近乎唱歌。出门时，他把门边那根木桩踢得更正了些。"
          }
        }
      }
    },
    "petition.tower_request.r2" : {
      "comment" : "Petition tower_request: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ein Laternenkrieg also“, murmelt er. Er sagt nicht, dass Ihr falsch liegt. Bis Mittag haben seine Jungs eine Feuerschale für Euch bereit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A war of lamps, then,” he mutters. He does not say you are wrong. By noon his lads have a brazier ready for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Una guerra de faroles, entonces», masculla. No dice que usted se equivoque. Al mediodía, sus muchachos ya le tienen listo un brasero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Une guerre de lampiste, alors », grommelle-t-il. Il ne dit pas que vous avez tort. À midi, ses gars vous ont préparé un brasero."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Una guerra da lampionai, allora», borbotta. Non dice che avete torto. A mezzogiorno i suoi ragazzi vi hanno già preparato un braciere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「灯り番の戦というわけか」とつぶやく。間違っているとは言わない。昼までに、若い連中が篝火を一基用意している。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Uma guerra de lampiões, então”, ele murmura. Não diz que você está {errado|errada}. Ao meio-dia, os rapazes dele já têm um braseiro pronto para você."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“那就是点灯人的仗了。”他嘟囔道。他没说你错。到中午，他的弟兄们已经为你备好了一个火盆。"
          }
        }
      }
    },
    "petition.tower_request.text" : {
      "comment" : "Petition tower_request (brannock, story days 2-3): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}. Feuerschalen halten den Ruß in Schach, aber Licht allein hat noch nie etwas mit Zähnen aufgehalten. Baut einen Bogenturm am Tor und gebt meinen Jungs einen Hochsitz. Den Platz habe ich selbst abgesteckt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Lord|My lady}. Braziers keep the soot honest, but light never stopped anything with teeth. Raise an archer tower by the gate and give my lads a perch to shoot from. I staked the spot myself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Señor|Señora}. Los braseros tienen a raya al hollín, pero la luz nunca ha detenido nada que tenga dientes. Levante una torre de arqueros junto a la puerta y dé a mis muchachos un sitio alto desde donde disparar. Yo mismo marqué el lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}. Les braseros tiennent la suie en respect, mais la lumière n’a jamais arrêté ce qui a des dents. Élevez une tour d’archers près de la porte, donnez à mes gars un perchoir d’où tirer. J’ai planté le piquet moi-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Signore|Signora}. I bracieri tengono a bada la fuliggine, ma la luce non ha mai fermato niente che abbia i denti. Alzate una torre per arcieri vicino alla porta e date ai miei ragazzi un posto da cui tirare. Il punto l’ho picchettato io."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主。篝火があれば、煤どもはおとなしい。だが灯りで、牙のあるものが止まったためしはありません。門の脇に弓兵の塔を建てて、若い連中に射る足場をください。場所には、私が自分で杭を打っておきました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Senhor|Senhora}. Braseiros mantêm a fuligem na linha, mas luz nunca deteve nada que tenha dentes. Erga uma torre de arqueiros junto ao portão e dê aos meus rapazes um poleiro para atirar. Eu mesmo finquei a estaca no lugar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主。火盆能镇住煤影，可光从来挡不住长牙的东西。在门边建一座箭塔，给弟兄们一个射箭的高处。地方我已经亲自打好桩了。"
          }
        }
      }
    },
    "petition.truce_drill.c1" : {
      "comment" : "Petition truce_drill: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drillt sie"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drill them"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instrúyalos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entraînez-les"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addestrateli"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍛えてやってくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treine-os"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操练他们"
          }
        }
      }
    },
    "petition.truce_drill.c2" : {
      "comment" : "Petition truce_drill: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasst die Stadt ruhen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the town rest"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que el pueblo descanse"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez la ville se reposer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasciate riposare il borgo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "町を休ませよう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe a cidade descansar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让镇上歇歇"
          }
        }
      }
    },
    "petition.truce_drill.hint" : {
      "comment" : "Petition truce_drill: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stille ist geliehen. Lasst die Stadt schlafen, solange sie kann; sie braucht die Kraft dringender als Brannock seinen Drill."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The quiet is borrowed. Let the town sleep while it can; it will need the strength more than Brannock needs the drill."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La calma es prestada. Deje dormir al pueblo mientras pueda; necesitará las fuerzas más de lo que Brannock necesita su instrucción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce calme est emprunté. Laissez la ville dormir tant qu’elle le peut ; elle aura plus besoin de ses forces que Brannock de son exercice."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quiete è presa in prestito. Lasciate dormire il borgo finché può: le forze gli serviranno più che a Brannock le esercitazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この静けさは借り物です。眠れるうちに、町は眠らせておくことです。ブラノックの訓練より、町が力を蓄えるほうが大事です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sossego é emprestado. Deixe a cidade dormir enquanto pode; ela vai precisar das forças mais do que Brannock precisa do treino."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这份安静是借来的。趁还能睡，让镇上睡吧；往后用得着力气的地方，比布兰诺克的操练要紧得多。"
          }
        }
      }
    },
    "petition.truce_drill.r1" : {
      "comment" : "Petition truce_drill: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Dämmerung hallt der Schlund von Sehnen und Brannocks Stimme. Zwei der Jungs treffen schon das Scheunentor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By dusk the Throat rings with twanging strings and Brannock’s voice. Two of the lads can already hit the barn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al anochecer, la Garganta resuena de cuerdas tensas y de la voz de Brannock. Dos de los muchachos ya dan en el granero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au crépuscule, la Gorge résonne de cordes qui claquent et de la voix de Brannock. Deux des gars arrivent déjà à toucher la grange."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al crepuscolo la Gola risuona di corde che vibrano e della voce di Brannock. Due dei ragazzi riescono già a centrare il fienile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日暮れには、喉谷に弦の鳴る音とブラノックの声が響く。若い連中のうち二人は、もう納屋の戸に当てられる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao crepúsculo, a Garganta ecoa com o zunido das cordas e a voz de Brannock. Dois dos rapazes já acertam a parede do celeiro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黄昏时，喉谷里回荡着弓弦声和布兰诺克的吼声。有两个小伙子已经能射中谷仓了。"
          }
        }
      }
    },
    "petition.truce_drill.r2" : {
      "comment" : "Petition truce_drill: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Abend lang ist die Taverne voll und die Gassen sind laut. Niemand spricht über den Preis der Stille."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For one evening the tavern is full and the lanes are loud. Nobody mentions the price of the quiet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por una noche la taberna se llena y las calles hacen ruido. Nadie menciona el precio de la calma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un soir, la taverne est pleine et les ruelles bruyantes. Personne ne parle du prix de ce calme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per una sera la taverna è piena e i vicoli sono rumorosi. Nessuno parla del prezzo della quiete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひと晩だけ酒場は満員になり、路地はにぎやかになる。誰も、静けさの値のことは口にしない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por uma noite, a taverna fica cheia e as ruas, barulhentas. Ninguém fala do preço do sossego."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这一晚，酒馆里坐满了人，巷子里热热闹闹。没人提起这份安静的代价。"
          }
        }
      }
    },
    "petition.truce_drill.text" : {
      "comment" : "Petition truce_drill (brannock, follow-up of the herald's truce): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}. Die Düsternis hat letzte Nacht Wort gehalten. Kein einziger Rußling. Noch zwei stille Nächte, erkauft zu einem Preis, den ich nicht nenne. Gebt mir zwanzig Gold und die jungen Hände der Stadt, und ich mache bis zum Ende Schützen aus ihnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Lord|My lady}. The Gloom kept its word last night. Not a sootling. Two quiet nights left, bought at a price I will not name. Give me twenty gold and the town’s young hands, and I make archers of them by the end."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Señor|Señora}. La Penumbra cumplió su palabra anoche. Ni un hollinejo. Quedan dos noches tranquilas, compradas a un precio que no voy a nombrar. Deme veinte monedas de oro y los brazos jóvenes del pueblo, y para el final los habré hecho arqueros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}. La Pénombre a tenu parole la nuit dernière. Pas un fumeron. Encore deux nuits tranquilles, achetées à un prix que je ne nommerai pas. Donnez-moi vingt pièces d’or et les jeunes bras de la ville, et j’en ferai des archers d’ici la fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Signore|Signora}. La notte scorsa la Penombra ha mantenuto la parola. Nemmeno un fuligginello. Restano due notti tranquille, comprate a un prezzo che non nominerò. Datemi venti monete d’oro e le giovani braccia del borgo, e prima della fine ne farò degli arcieri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主。宵闇はゆうべ約束を守りました。煤影一匹出なかった。静かな夜はあと二つ。口にしたくない値で買った夜です。金貨20枚と、町の若い者をください。終わりまでに弓兵に仕立てます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Senhor|Senhora}. A Penumbra cumpriu a palavra ontem à noite. Nem um fuliginho. Restam duas noites tranquilas, compradas a um preço que não vou dizer. Me dê vinte moedas de ouro e os jovens braços da cidade, e até o fim faço deles arqueiros."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主。暗霭昨夜守了信。一只煤影都没有。还剩两个太平夜，代价我不说。给我20金币和镇上的年轻人，到最后，我能把他们练成弓手。"
          }
        }
      }
    },
    "petition.truce_end.c1" : {
      "comment" : "Petition truce_end: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zündet die Kerze an"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light the candle"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encienda la vela"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allumez la chandelle"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accendete la candela"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蝋燭をともしてください"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acenda a vela"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点上蜡烛吧"
          }
        }
      }
    },
    "petition.truce_end.c2" : {
      "comment" : "Petition truce_end: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute Nacht keine Reue"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No regrets tonight"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta noche, nada de remordimientos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de regrets ce soir"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanotte nessun rimpianto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜は悔やまない"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de remorso esta noite"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜不悔"
          }
        }
      }
    },
    "petition.truce_end.hint" : {
      "comment" : "Petition truce_end: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kerze kostet nichts und gesteht alles. Zündet sie an, {mein Herr|meine Herrin}. Ich sehe weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A candle costs nothing and confesses everything. Light it, my {lord|lady}. I will look the other way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vela no cuesta nada y lo confiesa todo. Enciéndala, {mi señor|mi señora}. Yo miraré hacia otro lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une chandelle ne coûte rien et avoue tout. Allumez-la, {monseigneur|madame}. Je regarderai ailleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una candela non costa nulla e confessa tutto. Accendetela, {mio signore|mia signora}. Io guarderò dall’altra parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蝋燭はただのくせに、何もかも白状いたします。おともしください、城主様。わたくしは見ないふりをいたします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma vela não custa nada e confessa tudo. Acenda-a, {meu senhor|minha senhora}. Eu olho para o outro lado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一支蜡烛不花钱，却道尽一切。点吧，大人。我会看向别处。"
          }
        }
      }
    },
    "petition.truce_end.r1" : {
      "comment" : "Petition truce_end: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper stellt eine Kerze abseits der anderen. Die ganze Nacht brennt sie kerzengerade, während sich die übrigen zum Schlund neigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper sets one candle apart from the others. All night it burns straight up, while the rest lean toward the Throat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper pone una vela aparte de las demás. Toda la noche arde derecha, mientras las otras se inclinan hacia la Garganta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper pose une chandelle à l’écart des autres. Toute la nuit, elle brûle bien droit, tandis que les autres penchent vers la Gorge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper mette una candela in disparte dalle altre. Per tutta la notte arde dritta, mentre le altre si piegano verso la Gola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘスパーは蝋燭を一本、ほかから離して立てる。夜通し、それはまっすぐ上に燃え、残りはみな喉谷のほうへ傾く。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper põe uma vela longe das outras. A noite inteira ela arde com a chama reta, enquanto as demais se inclinam para a Garganta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赫斯珀把一支蜡烛和其余的分开放。整整一夜，它笔直地燃着，其余的都偏向喉谷。"
          }
        }
      }
    },
    "petition.truce_end.r2" : {
      "comment" : "Petition truce_end: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wie Ihr wünscht.“ Hesper verneigt sich. Die Flamme bleibt blau bis zum Morgen, und die Stadt schläft, ohne zu wissen, warum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“As you wish.” Hesper bows. The Flame stays blue until dawn, and the town sleeps without knowing why."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Como usted desee.» Hesper se inclina. La Llama sigue azul hasta el alba, y el pueblo duerme sin saber por qué."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Comme vous voudrez. » Hesper s’incline. La Flamme reste bleue jusqu’à l’aube, et la ville dort sans savoir pourquoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Come desiderate.» Hesper si inchina. La Fiamma resta azzurra fino all’alba, e il borgo dorme senza sapere perché."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「お望みのままに」。ヘスパーは一礼する。炎は夜明けまで青いままで、町はわけも知らずに眠る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Como {o senhor|a senhora} desejar.” Hesper se curva. A Chama fica azul até a alvorada, e a cidade dorme sem saber por quê."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“如您所愿。”赫斯珀躬身。圣焰一直蓝到天亮，镇上的人睡得安稳，却不知为何。"
          }
        }
      }
    },
    "petition.truce_end.text" : {
      "comment" : "Petition truce_end (hesper, follow-up of the herald's truce): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die letzte stille Nacht, {Erbe|Erbin} des Hauses. Seit dem Handel brennt die Flamme niedrig und blau, als hielte sie den Atem an. Morgen kommt er selbst. Ich würde heute eine Kerze anzünden für das, was wir bezahlt haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The last quiet night, heir of the house. The Flame has burned low and blue since the bargain, as if it held its breath. Tomorrow he comes himself. I would light a candle tonight for what we paid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La última noche tranquila, {hijo|hija} de la casa. La Llama arde baja y azul desde el trato, como si contuviera el aliento. Mañana viene él en persona. Yo encendería esta noche una vela por lo que pagamos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière nuit tranquille, enfant de la maison. Depuis le pacte, la Flamme brûle bas et bleu, comme si elle retenait son souffle. Demain, il vient lui-même. J’aimerais allumer une chandelle ce soir pour ce que nous avons payé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ultima notte tranquilla, {figlio|figlia} della casa. Dal giorno del patto la Fiamma arde bassa e azzurra, come se trattenesse il respiro. Domani verrà lui in persona. Stanotte accenderei una candela per ciò che abbiamo pagato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後の静かな夜です、家の御子。あの取引以来、炎は低く青く燃えています。息を詰めているかのように。明日は、あの方が自ら来られます。今夜、私たちが払ったもののために、蝋燭を一本ともしたいのです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A última noite tranquila, {filho|filha} da casa. A Chama arde baixa e azul desde o acordo, como se prendesse a respiração. Amanhã ele vem em pessoa. Eu acenderia uma vela esta noite pelo que pagamos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最后一个太平夜了，家族之子。自那桩交易以来，圣焰一直烧得又低又蓝，仿佛屏住了呼吸。明天，他会亲自来。今夜我想为我们付出的代价点一支蜡烛。"
          }
        }
      }
    },
    "petition.varn_levy.c1" : {
      "comment" : "Petition varn_levy: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen. Nehmt die mittlere Linie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome. Take the middle line."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenida. Ocupe la línea central."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenue. Prenez la ligne du milieu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benvenuta. Prendete la linea di mezzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よく来てくれた。中の防衛線へ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bem-vinda. Fique na linha do meio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎。你去守中防线。"
          }
        }
      }
    },
    "petition.varn_levy.c2" : {
      "comment" : "Petition varn_levy: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt Eurem Vater, ich kann zählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell your father I can count."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dígale a su padre que sé contar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites à votre père que je sais compter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dite a vostro padre che so contare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "父上に伝えてくれ。私は数えられる"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga ao seu pai que sei contar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉你父亲，我会算数。"
          }
        }
      }
    },
    "petition.varn_levy.c3" : {
      "comment" : "Petition varn_levy: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst Suppe, dann Mauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soup first, then walls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero sopa, luego murallas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La soupe, puis les murailles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima la zuppa, poi le mura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まずスープだ。城壁はその後"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro sopa, depois muralhas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先喝汤，再修墙。"
          }
        }
      }
    },
    "petition.varn_levy.hint" : {
      "comment" : "Petition varn_levy: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ist zwanzig, und Lord Varn zählt nach, was er uns schickt. Die mittlere Linie, {mein Herr|meine Herrin}. Die äußere soll sie sich verdienen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She is twenty, and Lord Varn counts what he sends us. The middle line, my {lord|lady}. Let her earn the outer one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiene veinte años, y lord Varn cuenta lo que nos manda. La línea central, {mi señor|mi señora}. Que se gane la exterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle a vingt ans, et le seigneur Varn compte ce qu’il nous envoie. La ligne du milieu, {monseigneur|madame}. Qu’elle mérite l’extérieure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha vent’anni, e Lord Varn conta quello che ci manda. La linea di mezzo, {mio signore|mia signora}. Quella esterna se la guadagni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ二十歳ですし、ヴァーン様は送ったものを数える方です。中の防衛線を、城主様。外は、自分で勝ち取らせればよろしいのです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela tem vinte anos, e o Lorde Varn conta o que nos manda. A linha do meio, {meu senhor|minha senhora}. Que ela faça por merecer a externa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她才二十岁，而瓦恩大人会清点他送来的每一个人。中防线，大人。外防线让她自己挣。"
          }
        }
      }
    },
    "petition.varn_levy.r1" : {
      "comment" : "Petition varn_levy: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild sieht zur mittleren Linie, dann zu Euch. „Ein klarer Befehl“, sagt sie. „Damit kann Highcairn arbeiten.“ Bis Mittag steht ihr Aufgebot."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild looks at the middle line, then at you. “A clear order,” she says. “Highcairn can work with that.” By noon her levy is posted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild mira la línea central y luego a usted. «Una orden clara», dice. «Así nos gustan en Highcairn.» Al mediodía, su leva ya ocupa sus puestos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild regarde la ligne du milieu, puis vous. « Un ordre clair, dit-elle. Highcairn s’en accommodera. » À midi, sa levée est en place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild guarda la linea di mezzo, poi voi. «Un ordine chiaro», dice. «Con questo Highcairn può lavorare.» A mezzogiorno le sue milizie sono al loro posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒルドは中の防衛線を見やり、それからこちらを見る。「はっきりした命令です。ハイケアンには、それで十分です」。昼までに、兵は配置についている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild olha para a linha do meio, depois para você. “Uma ordem clara”, diz ela. “Com isso Highcairn sabe trabalhar.” Ao meio-dia, o contingente dela está a postos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "希尔德看看中防线，又看看你。“命令清楚，”她说，“海凯恩认这个。”到中午，她的征召兵已经就位。"
          }
        }
      }
    },
    "petition.varn_levy.r2" : {
      "comment" : "Petition varn_levy: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild schreibt es Wort für Wort auf, im Stehen. „Das gefällt ihm, oder es gefällt ihm nicht.“ Vor der Dämmerung reitet sie damit nach Norden. Das Aufgebot bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild writes it down word for word, standing. “He will like that, or he will not.” She rides north with it before dusk. The levy stays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild lo anota palabra por palabra, de pie. «Le gustará, o no le gustará.» Antes del anochecer parte con ello hacia el norte. La leva se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild le note mot pour mot, debout. « Ça lui plaira, ou pas. » Elle l’emporte vers le nord avant le crépuscule. La levée reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild lo scrive parola per parola, in piedi. «Gli piacerà, oppure no.» Prima del crepuscolo cavalca verso nord con la risposta. Le milizie restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒルドは立ったまま、一言一句を書き留める。「父が気に入るか、気に入らないかです」。日暮れ前に、それを携えて北へ発つ。兵は残る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild anota palavra por palavra, de pé. “Ele vai gostar, ou não vai.” Parte com isso para o norte antes do crepúsculo. O contingente fica."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "希尔德站着，一字不差地记了下来。“他会喜欢，或者不会。”黄昏前，她带着这句话骑马北上。征召兵留下了。"
          }
        }
      }
    },
    "petition.varn_levy.r3" : {
      "comment" : "Petition varn_levy: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin macht die Bergsoldaten satt, ehe jemand fragt, wo sie schlafen. Hild isst im Stehen und sagt dann: „Jetzt die Mauern.“ Sie lächelt beinahe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin feeds the hill soldiers before anyone asks where they sleep. Hild eats standing, then says: “Now the walls.” She is almost smiling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin da de comer a los soldados de la montaña antes de que nadie pregunte dónde dormirán. Hild come de pie y luego dice: «Ahora, las murallas.» Casi sonríe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin nourrit les soldats des hauteurs avant que quiconque demande où ils dormiront. Hild mange debout, puis dit : « Maintenant, les murailles. » Elle sourit presque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin sfama i soldati delle colline prima che qualcuno chieda dove dormiranno. Hild mangia in piedi, poi dice: «Ora le mura.» Sta quasi sorridendo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寝床の話が出るより先に、タムシンが山の兵たちに腹いっぱい食べさせる。ヒルドは立ったまま食べ、それから言う。「では、城壁を」。笑みがこぼれかけている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin alimenta os soldados das colinas antes que alguém pergunte onde vão dormir. Hild come de pé e diz: “Agora, as muralhas.” Ela quase sorri."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "塔姆辛先喂饱了这些山地兵，没人来得及问他们睡哪儿。希尔德站着吃完，然后说：“现在去看城墙。”她几乎笑了。"
          }
        }
      }
    },
    "petition.varn_levy.text" : {
      "comment" : "Petition varn_levy (hildVarn, story days 3-4): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild Varn von Highcairn, {Burgherr|Burgherrin}. Ich bringe das halbe Herbstaufgebot und einen Brief meines Vaters. Die andere Hälfte folgt, schreibt er, sobald {der neue Herr|die neue Herrin} gezeigt hat, dass {er|sie} zählen kann. Für mich bitte ich um eines: einen Platz an der äußeren Linie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild Varn of Highcairn, {Lord|Lady} Lantern. I bring half the autumn levy and my father’s letter. The other half follows, he writes, once the new {lord|lady} has shown a head for counting. For myself I ask one thing: a place on the outer line."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild Varn de Highcairn, {mi señor|mi señora}. Traigo la mitad de la leva de otoño y una carta de mi padre. La otra mitad llegará, escribe, cuando {el nuevo señor|la nueva señora} demuestre que sabe contar. Para mí pido una sola cosa: un puesto en la línea exterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild Varn, de Highcairn, {monseigneur|madame}. J’apporte la moitié de la levée d’automne et une lettre de mon père. L’autre moitié suivra, écrit-il, quand {le nouveau seigneur|la nouvelle dame} aura montré qu’{il|elle} sait compter. Pour moi, je demande une chose : une place sur la ligne extérieure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild Varn di Highcairn, {mio signore|mia signora}. Porto metà delle milizie d’autunno e una lettera di mio padre. L’altra metà seguirà, scrive, quando {il nuovo signore|la nuova signora} avrà mostrato di saper contare. Per me chiedo una cosa sola: un posto sulla linea esterna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハイケアンのヒルド・ヴァーンです、城主様。秋の徴兵の半分と、父の手紙を持ってきました。残り半分は、新しい城主様に数を数える頭があると分かってから送る、と父は書いています。私自身の願いはひとつ。外の防衛線に、持ち場をください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild Varn de Highcairn, {meu senhor|minha senhora}. Trago metade do contingente de outono e uma carta do meu pai. A outra metade vem depois, escreve ele, quando {o novo senhor|a nova senhora} mostrar que tem cabeça para contas. Para mim, peço uma coisa: um lugar na linha externa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海凯恩的希尔德·瓦恩，见过城主大人。我带来了秋季征召兵的一半，还有家父的信。他信里说，等新城主显出会算账的头脑，另一半就到。我自己只求一件事：在外防线上给我一个位置。"
          }
        }
      }
    },
    "petition.varn_ride.c1" : {
      "comment" : "Petition varn_ride: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der letzten Nacht gehen wir beide."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the last night, we both go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras la última noche, iremos {los dos|las dos}."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la dernière nuit, nous irons {tous|toutes} deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo l’ultima notte, andiamo insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後の夜が明けたら、二人で行こう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois da última noite, vamos {nós dois|nós duas}."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最后一夜过后，我们一起去。"
          }
        }
      }
    },
    "petition.varn_ride.c2" : {
      "comment" : "Petition varn_ride: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nein. Ich brauche Euch auf der Mauer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. I need you on the wall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. La necesito en la muralla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non. J’ai besoin de vous sur la muraille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Mi servite sulle mura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "だめだ。城壁にいてほしい"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não. Preciso de você na muralha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不。我需要你守在城墙上。"
          }
        }
      }
    },
    "petition.varn_ride.c3" : {
      "comment" : "Petition varn_ride: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geht. Nehmt eine nummerierte Laterne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go. Take a numbered lantern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaya. Llévese un farol numerado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allez. Prenez une lanterne numérotée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andate. Prendete una lanterna numerata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行ってくれ。番号つきのランタンを"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vá. Leve uma lanterna numerada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去吧。带上一盏编号提灯。"
          }
        }
      }
    },
    "petition.varn_ride.hint" : {
      "comment" : "Petition varn_ride: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Nächte vor der schlimmsten will sie Reiter hinausführen. Schlagt es ihr nicht ab. Vertagt es, und meint es ernst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two nights before the worst one, and she wants to take riders out. Do not refuse her. Postpone her, and mean it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dos noches de la peor, y quiere sacar jinetes. No se lo niegue. Dígale que más adelante, y cúmplalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux nuits avant la pire, et elle veut emmener des cavaliers dehors. Ne refusez pas. Faites-la attendre, et tenez parole."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due notti prima della peggiore, e lei vuole portare fuori dei cavalieri. Non ditele di no. Rimandate la sua partenza, e mantenete la parola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最悪の夜の二晩前に、騎手を連れ出したいと。拒んではなりません。延ばすのです。本気で。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duas noites antes da pior, e ela quer levar cavaleiros para fora. Não recuse. Adie, e que seja para valer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最凶的那一夜前两天，她要带骑手出去。别拒绝她。往后推一推，而且要说话算数。"
          }
        }
      }
    },
    "petition.varn_ride.r1" : {
      "comment" : "Petition varn_ride: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild mustert Euch, wie sie eine Mauer mustert. „Wir beide“, sagt sie. „Ich nehme Euch beim Wort.“ Sie geht zurück an ihre Linie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild studies you the way she studies a wall. “Both of us,” she says. “I will hold you to that.” She goes back to her line."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild {lo|la} estudia como quien estudia una muralla. «{Los dos|Las dos}», dice. «Le tomo la palabra.» Vuelve a su línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild vous détaille comme elle détaille une muraille. « {Tous|Toutes} les deux, dit-elle. Je vous prends au mot. » Elle retourne à sa ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild vi studia come studia un muro. «Insieme», dice. «Vi prendo in parola.» Torna alla sua linea."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒルドは、城壁を見定めるようにこちらを見定める。「二人で」と言う。「その言葉、忘れませんよ」。そして自分の防衛線へ戻っていく。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hild estuda você como estuda uma muralha. “{Nós dois|Nós duas}”, diz ela. “Vou cobrar.” Ela volta para a sua linha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "希尔德打量你，就像打量一堵墙。“我们俩，”她说，“这话我记下了。”她回到了自己的防线上。"
          }
        }
      }
    },
    "petition.varn_ride.r2" : {
      "comment" : "Petition varn_ride: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ein klarer Befehl“, sagt Hild, und mehr nicht. Bei Dämmerung steht sie noch vor dem Horn auf der Mauer, das Gesicht zum Dunkel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A clear order,” says Hild, and that is all. At dusk she is on the wall before the horn, her face to the dark."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Una orden clara», dice Hild, y nada más. Al anochecer ya está en la muralla antes del cuerno, de cara a la oscuridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Un ordre clair », dit Hild, et rien de plus. Au crépuscule, elle est sur la muraille avant le cor, le visage tourné vers l’obscurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Un ordine chiaro», dice Hild, e nient’altro. Al crepuscolo, prima ancora che suoni il corno, è sulle mura, il viso rivolto al buio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「はっきりした命令です」とヒルドは言い、それきりだ。日暮れ、角笛より先に城壁に立ち、闇に顔を向けている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Uma ordem clara”, diz Hild, e é tudo. Ao crepúsculo, ela já está na muralha antes da trompa, de rosto para o escuro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“命令清楚。”希尔德只说了这一句。黄昏时，号角未响，她已站上城墙，面朝黑暗。"
          }
        }
      }
    },
    "petition.varn_ride.r3" : {
      "comment" : "Petition varn_ride: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laterne einundvierzig zieht bei Dämmerung durchs Tor, drei Reiter darunter. Brannock sieht ihr nach, bis sie ein Funke ist und dann keiner mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lantern forty-one goes out through the gate at dusk, three riders under it. Brannock watches until it is a spark, and then is not."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El farol cuarenta y uno sale por la puerta al anochecer, con tres jinetes bajo él. Brannock lo mira hasta que es una chispa, y luego ya no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lanterne quarante et un franchit la porte au crépuscule, trois cavaliers dessous. Brannock la suit des yeux jusqu’à ce qu’elle ne soit qu’une étincelle, puis plus rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lanterna quarantuno esce dalla porta al crepuscolo, con tre cavalieri sotto. Brannock la segue con lo sguardo finché è una scintilla, e poi più niente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日暮れ、41番のランタンが門を出ていく。その下に騎手が3人。ブラノックは、それが火の粉ほどになり、やがて見えなくなるまで見送る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lanterna quarenta e um sai pelo portão ao crepúsculo, com três cavaleiros sob ela. Brannock a observa até virar uma faísca, e depois nem isso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黄昏时，41号提灯出了城门，下面跟着三名骑手。布兰诺克一直望着，直到它成了一点火星，然后什么也没有了。"
          }
        }
      }
    },
    "petition.varn_ride.text" : {
      "comment" : "Petition varn_ride (hildVarn, story days 18): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}. Burgherr Aldric trug mich auf den Schultern, als ich sechs war. Hier reden alle von ihm, und keiner geht nachsehen. Gebt mir zwei Reiter und eine nummerierte Laterne. Ich reite heute Nacht am dunklen Leuchtfeuer vorbei und finde ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Lord|Lady} Lantern. Lord Aldric carried me on his shoulders when I was six. Here everyone speaks of him and nobody goes to look. Give me two riders and a numbered lantern. I will ride out past the dark beacon tonight and find him."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}. Lord Aldric me llevaba a hombros cuando yo tenía seis años. Aquí todos hablan de él y nadie va a buscarlo. Deme dos jinetes y un farol numerado. Esta noche cabalgaré más allá de la almenara apagada y lo encontraré."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}. Le seigneur Aldric me portait sur ses épaules quand j’avais six ans. Ici, tout le monde parle de lui et personne ne va le chercher. Donnez-moi deux cavaliers et une lanterne numérotée. Je chevaucherai cette nuit au-delà du fanal éteint et je le trouverai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}. Lord Aldric mi portava sulle spalle quando avevo sei anni. Qui tutti parlano di lui e nessuno va a cercarlo. Datemi due cavalieri e una lanterna numerata. Stanotte cavalcherò oltre il faro spento e lo troverò."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様。アルドリック様は、私が六つのとき、肩車をしてくださいました。ここでは皆があの方の話をするのに、誰も探しに行かない。騎手を2人と、番号つきのランタンをひとつください。今夜、消えた烽火の先まで馬を駆って、あの方を見つけます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}. O Lorde Aldric me carregou nos ombros quando eu tinha seis anos. Aqui todos falam dele, e ninguém vai procurar. Me dê dois cavaleiros e uma lanterna numerada. Esta noite passo além do farol apagado e o encontro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人。我六岁时，奥德里克大人把我扛在肩上。这里人人都在说他，却没人去找。给我两名骑手和一盏编号提灯。今夜我就骑过熄灭的烽火，把他找回来。"
          }
        }
      }
    },
    "petition.veteran_bow.c1" : {
      "comment" : "Petition veteran_bow: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhestand in Ehren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire with honour"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retírese con honores"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une retraite avec les honneurs"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Congedo con onore"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名誉ある引退を"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aposente-se com honra"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光荣退役"
          }
        }
      }
    },
    "petition.veteran_bow.c2" : {
      "comment" : "Petition veteran_bow: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch eine Saison, Soldat"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One more season, soldier"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una temporada más, soldado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore une saison, soldat"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora una stagione, soldato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もうひと季節、頼む"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais uma temporada, soldado"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再干一季吧，士兵"
          }
        }
      }
    },
    "petition.veteran_bow.c3" : {
      "comment" : "Petition veteran_bow: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werdet unser Ausbilder"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Become our drillmaster"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sea nuestro instructor"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devenez notre maître d’armes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diventate il nostro istruttore"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "教官になってくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seja o nosso instrutor"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来当我们的教头吧"
          }
        }
      }
    },
    "petition.veteran_bow.hint" : {
      "comment" : "Petition veteran_bow: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Schütze sagt, seine Augen ließen nach. Die meisten sagen es vor einer langen Nacht. Noch eine Saison."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every archer says his eyes are going. Most of them say it before a long night. One more season."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los arqueros dicen que les falla la vista. Casi todos lo dicen antes de una noche larga. Una temporada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les archers disent que leurs yeux faiblissent. La plupart le disent avant une longue nuit. Encore une saison."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni arciere dice che gli occhi lo stanno abbandonando. Quasi tutti lo dicono prima di una notte lunga. Ancora una stagione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弓兵は誰でも、目が衰えたと言います。たいていは、長い夜の前に。あとひと季節です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo arqueiro diz que a vista está falhando. A maioria diz isso antes de uma noite longa. Mais uma temporada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个弓手都说自己眼睛不行了。多半是在漫长的一夜之前说的。再干一季。"
          }
        }
      }
    },
    "petition.veteran_bow.r1" : {
      "comment" : "Petition veteran_bow: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er hängt seinen Bogen über die Tür der Taverne. Jeder junge Schütze berührt ihn auf dem Weg zur Mauer, für Glück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He hangs his bow above the tavern door. Every young archer touches it for luck on the way to the wall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuelga su arco sobre la puerta de la taberna. Cada arquero joven lo toca para tener suerte de camino a la muralla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suspend son arc au-dessus de la porte de la taverne. Chaque jeune archer le touche pour se porter chance en montant à la muraille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appende l’arco sopra la porta della taverna. Ogni giovane arciere lo tocca per fortuna, andando alle mura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彼は弓を酒場の戸口の上に掛ける。若い弓兵は誰もが、城壁へ向かう途中で、験担ぎにそれに触れていく。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele pendura o arco sobre a porta da taverna. Todo arqueiro jovem toca nele para dar sorte, a caminho da muralha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他把弓挂在了酒馆门上。每个年轻弓手上城墙时都要摸一摸，图个好运。"
          }
        }
      }
    },
    "petition.veteran_bow.r2" : {
      "comment" : "Petition veteran_bow: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er salutiert, langsam. In der Nacht schießt er gut und beschwert sich den ganzen nächsten Morgen darüber."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He salutes, slowly. That night he shoots well, and complains about it all the next morning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saluda, despacio. Esa noche dispara bien, y se pasa toda la mañana siguiente quejándose de ello."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il salue, lentement. Cette nuit-là, il tire bien, et s’en plaint toute la matinée du lendemain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saluta, lentamente. Quella notte tira bene, e se ne lamenta per tutta la mattina dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彼はゆっくりと敬礼する。その夜は見事に射て、翌朝いっぱい、そのことで文句を言う。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele bate continência, devagar. Naquela noite, atira bem, e reclama disso a manhã seguinte inteira."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他慢慢地敬了个礼。那一夜他射得很好，第二天整个上午都在抱怨这件事。"
          }
        }
      }
    },
    "petition.veteran_bow.r3" : {
      "comment" : "Petition veteran_bow: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er nimmt die jungen Schützen im Morgengrauen mit, jeden Morgen. Nach einer Woche treffen sie, was sie anvisieren, und fürchten ihn mehr als die Düsternis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He takes the young archers out at dawn, every dawn. Within a week they hit what they aim at and fear him more than the Gloom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saca a los arqueros jóvenes al alba, todos los días. En una semana aciertan a lo que apuntan y le temen más que a la Penumbra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il emmène les jeunes archers à l’aube, chaque aube. En une semaine, ils touchent ce qu’ils visent et le craignent plus que la Pénombre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta fuori i giovani arcieri all’alba, ogni alba. In una settimana colpiscono ciò a cui mirano e lo temono più della Penombra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彼は夜明けごとに、若い弓兵たちを連れ出す。一週間で、彼らは狙ったものに当てるようになり、宵闇より彼を恐れるようになる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele leva os arqueiros jovens para fora na alvorada, toda alvorada. Em uma semana, acertam no que miram e o temem mais que à Penumbra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天黎明，他都带年轻弓手出去。不出一周，他们指哪儿射哪儿，怕他胜过怕暗霭。"
          }
        }
      }
    },
    "petition.veteran_bow.text" : {
      "comment" : "Petition veteran_bow (soldier, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}, dreißig Nächte stand ich auf Euren Mauern, und meine Augen sind nicht mehr, was sie waren. Schießen kann ich noch, meistens auf das Richtige. Ich würde meinen Bogen gern an den Nagel hängen. Oder die Jungen lehren, wenn Ihr zahlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, thirty nights I have stood on your walls, and my eyes are not what they were. I can still shoot, mostly at the right things. I would like to hang up my bow. Or teach the young ones, if you pay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Señor|Señora}, treinta noches he estado en sus murallas, y mis ojos ya no son lo que eran. Todavía puedo disparar, casi siempre a lo que toca. Me gustaría colgar el arco. O enseñar a los jóvenes, si me paga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, voilà trente nuits que je monte sur vos murailles, et mes yeux ne sont plus ce qu’ils étaient. Je tire encore, la plupart du temps sur ce qu’il faut. J’aimerais raccrocher mon arc. Ou former les jeunes, si vous payez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Signore|Signora}, sono trenta notti che sto sulle vostre mura, e gli occhi non sono più quelli di una volta. Tiro ancora, per lo più alle cose giuste. Vorrei appendere l’arco al chiodo. Oppure insegnare ai giovani, se pagate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主、この三十夜、城壁に立ってきました。目も昔ほどではありません。まだ弓は引けます。たいていは、狙うべきものを。弓を壁に掛けて、退きたいのです。でなければ、給金をいただけるなら若い者を教えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Senhor|Senhora}, há trinta noites estou nas suas muralhas, e os meus olhos já não são o que eram. Ainda sei atirar, quase sempre nas coisas certas. Gostaria de pendurar o arco. Ou ensinar os mais novos, se me pagar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主，我在您的城墙上站了三十夜，眼睛大不如前了。箭还能射，多半还射得中该射的东西。我想把弓挂起来了。或者教教年轻人，如果您给钱的话。"
          }
        }
      }
    },
    "petition.wall_frost.c1" : {
      "comment" : "Petition wall_frost: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasst die Mauern neu verfugen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-point the walls"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que rejunten las murallas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejointoyer les murailles"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rifate le fughe delle mura"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城壁の目地を直してくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejuntem as muralhas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新勾缝"
          }
        }
      }
    },
    "petition.wall_frost.c2" : {
      "comment" : "Petition wall_frost: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisher hat es gehalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It has held so far"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta ahora ha aguantado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça a tenu jusqu’ici"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finora hanno tenuto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今までは持っている"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até agora aguentou"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到现在都撑住了"
          }
        }
      }
    },
    "petition.wall_frost.hint" : {
      "comment" : "Petition wall_frost: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mauern, die fest aussehen, sind die liebste Lüge der Baumeister. Bezahlt den Mörtel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walls that look sound are a builder’s favourite lie. Pay for the mortar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las murallas que parecen firmes son la mentira favorita de los albañiles. Pague la argamasa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des murailles qui ont l’air solides, c’est le mensonge préféré des bâtisseurs. Payez le mortier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mura che sembrano solide: la bugia preferita dei muratori. Pagate la malta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しっかり見える城壁は、職人のいちばん好きな嘘です。漆喰代は惜しまぬことです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muralha que parece firme é a mentira preferida dos pedreiros. Pague a argamassa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看着结实的墙，是工匠最爱撒的谎。为灰浆付钱。"
          }
        }
      }
    },
    "petition.wall_frost.r1" : {
      "comment" : "Petition wall_frost: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bauleute arbeiten den ganzen kalten Nachmittag. Zur Dämmerung sind die Mauern grau, hässlich und sehr fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The builders work through the cold afternoon. By dusk the walls are grey and ugly and very solid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los albañiles trabajan toda la fría tarde. Al anochecer las murallas están grises, feas y muy firmes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les bâtisseurs travaillent tout l’après-midi dans le froid. Au crépuscule, les murailles sont grises, laides et très solides."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I muratori lavorano per tutto il freddo pomeriggio. Al crepuscolo le mura sono grigie, brutte e solidissime."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "職人たちは寒い午後じゅう働く。日暮れには、城壁は灰色で、不格好で、とても頑丈になっている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pedreiros trabalham a tarde fria inteira. Ao crepúsculo, as muralhas estão cinzentas, feias e muito sólidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工匠们干了整整一个寒冷的下午。黄昏时，城墙灰扑扑的，难看，却非常结实。"
          }
        }
      }
    },
    "petition.wall_frost.r2a" : {
      "comment" : "Petition wall_frost: choice 2, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es hält. Der Handwerker zuckt die Schultern und sagt, ewig halte es nicht, was für alles gilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It holds. The builder shrugs and says it will not hold forever, which is true of everything."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguanta. El albañil se encoge de hombros y dice que no aguantará para siempre, lo cual vale para todo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça tient. Le bâtisseur hausse les épaules et dit que ça ne tiendra pas toujours, ce qui est vrai de tout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tengono. Il muratore alza le spalle e dice che non terranno per sempre, il che vale per tutto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城壁は持つ。職人は肩をすくめ、いつまでも持つわけじゃない、と言う。何についても言えることだ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguenta. O pedreiro dá de ombros e diz que não vai aguentar para sempre, o que vale para tudo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撑住了。工匠耸耸肩，说它总有撑不住的一天。世上哪样东西不是如此。"
          }
        }
      }
    },
    "petition.wall_frost.r2b" : {
      "comment" : "Petition wall_frost: choice 2, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Mitternacht rutscht eine ganze Steinlage von der Mauer, und die Düsternis drängt mit aller Macht an die Lücke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At midnight a whole course of stones slides off the wall, and the Gloom pours at the gap with a will."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A medianoche se desliza de la muralla una hilada entera de piedras, y la Penumbra se lanza con ganas contra el hueco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À minuit, toute une assise de pierres glisse de la muraille, et la Pénombre se rue sur la brèche de toutes ses forces."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mezzanotte un intero filare di pietre scivola giù dalle mura, e la Penombra si getta sulla breccia con foga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "真夜中、石の列がひと並びまるごと城壁から滑り落ち、宵闇がその隙間へ猛然となだれ込む。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À meia-noite, uma fiada inteira de pedras escorrega da muralha, e a Penumbra se lança à brecha com vontade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "半夜，整整一层石块从城墙上滑落，暗霭拼命朝缺口涌来。"
          }
        }
      }
    },
    "petition.wall_frost.text" : {
      "comment" : "Petition wall_frost (builder, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, der Frost ist in den alten Mörtel der Mauern gekrochen. Es sieht fest aus, ist es aber nicht. Fünfzehn Gold, um das Schlimmste neu zu verfugen, bevor die nächste harte Nacht kommt. Oder wir hoffen, dass es hält."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the frost has got into the old mortar of the walls. It looks sound, but it is not. Fifteen gold to re-point the worst of it before the next hard night. Or we hope it holds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, la helada se ha metido en la argamasa vieja de las murallas. Parece firme, pero no lo es. Quince monedas de oro para rejuntar lo peor antes de la próxima noche dura. O esperamos que aguante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, le gel s’est mis dans le vieux mortier des murailles. Ça a l’air solide, mais ça ne l’est pas. Quinze pièces d’or pour rejointoyer le pire avant la prochaine mauvaise nuit. Ou on espère que ça tiendra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, il gelo è entrato nella vecchia malta delle mura. Sembrano solide, ma non lo sono. Quindici monete d’oro per rifare le fughe nei punti peggiori prima della prossima notte dura. Oppure speriamo che tengano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、霜が城壁の古い漆喰に入り込みました。見た目はしっかりしていますが、そうではありません。次のひどい夜の前に、いちばん傷んだところを直すのに金貨15枚。それとも、このまま持ってくれるのを祈りますか。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, a geada entrou na argamassa velha das muralhas. Parece firme, mas não está. Quinze moedas de ouro para rejuntar o pior antes da próxima noite pesada. Ou torcemos para que aguente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，霜钻进了城墙的旧灰浆里。看着结实，其实不然。15金币，能赶在下一个难熬的夜晚前，把最糟的地方重新勾缝。不然，就只能盼着它撑得住。"
          }
        }
      }
    },
    "petition.war_tax.c1" : {
      "comment" : "Petition war_tax: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich setze die Kriegssteuer fest"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I will set the war tax"
          }
        },
        "es" : {
