          }
        }
      }
    },
    "petition.footbridge.c3" : {
      "comment" : "Petition footbridge: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watet noch eine Weile"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wade a while longer"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vadeen un tiempo más"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pataugez encore un peu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guadate ancora un po’"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もうしばらく歩いて渡ってくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atravessem a vau por enquanto"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再蹚一阵子水吧"
          }
        }
      }
    },
    "petition.footbridge.hint" : {
      "comment" : "Petition footbridge: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwanzig Gold für einen Steg jetzt oder vierzig für Wagenräder bis zum Sommer. Lasst ihn flicken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twenty gold for a bridge now, or forty for cart wheels by summer. Mend it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veinte monedas de oro por una pasarela ahora, o cuarenta en ruedas de carro antes del verano. Arréglela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vingt pièces d’or pour une passerelle maintenant, ou quarante pour des roues d’ici l’été. Réparez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venti monete d’oro per una passerella adesso, o quaranta per le ruote dei carri entro l’estate. Fatela riparare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今、橋に金貨20枚か、夏までに車輪に40枚か。直させるべきです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinte moedas de ouro por uma pinguela agora, ou quarenta por rodas de carroça até o verão. Mande consertar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在花20金币修桥，不然到夏天就得花40金币修车轮。修吧。"
          }
        }
      }
    },
    "petition.footbridge.r1" : {
      "comment" : "Petition footbridge: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Abend steht der Steg, ein wenig schief, aber stolz. Die Kinder rennen bis zur Dunkelheit darüber hin und her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By evening the bridge stands, a little crooked but proud. Children run across it until dark."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al anochecer la pasarela está en pie, un poco torcida pero orgullosa. Los niños la cruzan corriendo hasta que oscurece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le soir, la passerelle tient debout, un peu de travers mais fière. Les enfants courent dessus jusqu’à la nuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entro sera la passerella è in piedi, un po’ storta ma fiera. I bambini ci corrono avanti e indietro fino al buio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夕方には橋が立つ。少し曲がっているが、誇らしげだ。子どもたちは暗くなるまで行ったり来たりする。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À noitinha, a pinguela está de pé, um pouco torta mas altiva. As crianças correm por ela até escurecer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傍晚时桥立起来了，有点歪，却很神气。孩子们在上面跑来跑去，直到天黑。"
          }
        }
      }
    },
    "petition.footbridge.r2a" : {
      "comment" : "Petition footbridge: choice 2, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die alten Pfähle ergeben einen soliden Steg. Jemand ritzt „Lanterns Steg“ ins Geländer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The old stakes make a sturdy bridge. Someone carves “Lantern’s crossing” into the rail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las estacas viejas dan una pasarela robusta. Alguien graba «Paso de Lantern» en la baranda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vieux pieux font une passerelle solide. Quelqu’un grave « Pas-de-Lantern » dans la rambarde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I vecchi pali fanno una passerella robusta. Qualcuno incide «Il passo di Lantern» sul parapetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古い杭で、がっしりした橋ができる。誰かが欄干に「ランタンの渡し」と彫る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As estacas velhas dão uma pinguela firme. Alguém entalha “Travessia Lantern” no corrimão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旧桩子搭出了一座结实的桥。有人在栏杆上刻了“兰腾桥”三个字。"
          }
        }
      }
    },
    "petition.footbridge.r2b" : {
      "comment" : "Petition footbridge: choice 2, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die alten Pfähle halten einen Tag. Dann halten sie stattdessen den Bach auf, und eine Kuh ist sehr überrascht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The old stakes hold for a day. Then they hold the brook instead, and a cow is very surprised."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las estacas viejas aguantan un día. Luego lo que retienen es el arroyo, y una vaca se lleva una buena sorpresa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vieux pieux tiennent un jour. Ensuite, ce sont eux qui retiennent le ruisseau, et une vache est très surprise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I vecchi pali tengono per un giorno. Poi tengono il ruscello, invece, e una mucca ne resta molto sorpresa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古い杭は一日もつ。それから橋の代わりに小川をせき止め、牛が一頭、たいそう驚く。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As estacas velhas seguram um dia. Depois passam a segurar o riacho, e uma vaca fica muito surpresa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旧桩子撑了一天。接着，它们拦住的成了溪水，一头牛大为吃惊。"
          }
        }
      }
    },
    "petition.footbridge.r3" : {
      "comment" : "Petition footbridge: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er nickt, krempelt bedeutungsvoll die Hosen hoch und hinterlässt eine Spur nasser Fußabdrücke quer durch den Saal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He nods, rolls up his trousers in a meaningful way, and leaves a trail of wet footprints across the hall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asiente, se arremanga los pantalones con mucha intención y deja un rastro de huellas mojadas por todo el salón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il hoche la tête, retrousse ses chausses d’un air entendu et laisse une traînée d’empreintes mouillées à travers la salle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuisce, si arrotola i calzoni con aria eloquente e lascia una scia di impronte bagnate attraverso il salone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "職人はうなずき、意味ありげに裾をまくり上げ、濡れた足跡を大広間に点々と残して出ていく。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele assente, arregaça as calças de um jeito significativo e deixa um rastro de pegadas molhadas pelo salão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他点点头，意味深长地卷起裤腿，在大厅里留下一串湿脚印。"
          }
        }
      }
    },
    "petition.footbridge.text" : {
      "comment" : "Petition footbridge (builder): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, der Steg über den Bach ist im Frühjahr weggeschwemmt worden. Die Leute waten zum fernen Feld, und diese Woche haben zwei Karren ein Rad verloren. Zwanzig Gold für Bretter und Pflöcke. Den Rest mache ich für Suppe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the footbridge over the brook washed out in the spring. Folk wade to the far field, and two carts lost wheels this week. Twenty gold buys planks and pegs. I do the rest for soup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, la pasarela del arroyo se la llevó el agua en primavera. La gente vadea hasta el campo del fondo, y esta semana dos carros perdieron una rueda. Veinte monedas de oro pagan tablas y clavijas. El resto lo hago yo por un plato de sopa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, la passerelle sur le ruisseau a été emportée au printemps. Les gens passent à gué pour aller au champ du fond, et deux charrettes ont perdu une roue cette semaine. Vingt pièces d’or paient planches et chevilles. Je fais le reste pour de la soupe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, in primavera la piena si è portata via la passerella sul ruscello. La gente guada per andare al campo lontano, e questa settimana due carri hanno perso una ruota. Con venti monete d’oro si comprano assi e pioli. Il resto lo faccio per una zuppa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、小川の渡り橋が春に流されました。皆、遠くの畑まで川を歩いて渡っていて、今週は荷車が二台、車輪をなくしました。金貨20枚で板と杭が買えます。あとの仕事は、スープ一杯で引き受けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, a pinguela sobre o riacho foi levada pela cheia na primavera. O povo atravessa a vau até o campo distante, e duas carroças perderam rodas esta semana. Vinte moedas de ouro compram tábuas e cavilhas. O resto eu faço por sopa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，小溪上的木桥春天被冲走了。大家只能蹚水去远处的田，这周已经有两辆车掉了轮子。20金币能买木板和木钉。剩下的活，管我一碗汤就行。"
          }
        }
      }
    },
    "petition.goat_chapel.c1" : {
      "comment" : "Petition goat_chapel: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neues Altartuch bezahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay for a new altar cloth"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagar un mantel de altar nuevo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payer une nouvelle nappe d’autel"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagare una nuova tovaglia d’altare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい祭壇布の代金を払う"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagar uma toalha de altar nova"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出钱买块新祭坛布"
          }
        }
      }
    },
    "petition.goat_chapel.c2" : {
      "comment" : "Petition goat_chapel: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ziege gehört der Flamme"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goat belongs to the Flame"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cabra pertenece a la Llama"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chèvre appartient à la Flamme"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capra appartiene alla Fiamma"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "山羊は炎のものだ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cabra pertence à Chama"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "山羊归圣焰所有"
          }
        }
      }
    },
    "petition.goat_chapel.c3" : {
      "comment" : "Petition goat_chapel: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ziege geht nach Hause"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goat goes home"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cabra vuelve a casa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chèvre rentre chez elle"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capra torna a casa"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "山羊は家に帰す"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cabra volta para casa"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "山羊回家"
          }
        }
      }
    },
    "petition.goat_chapel.hint" : {
      "comment" : "Petition goat_chapel: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Ziege ist Eigentum, und die Flamme besitzt schon genug. Schickt sie nach Hause."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A goat is property, and the Flame owns quite enough already. Send it home."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cabra es propiedad, y la Llama ya posee bastante. Mándela a casa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une chèvre est un bien, et la Flamme possède déjà bien assez. Renvoyez-la chez elle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una capra è una proprietà, e la Fiamma possiede già abbastanza. Rimandatela a casa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "山羊は財産です。それに炎は、もう十分すぎるほど持っております。家へお帰しを。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma cabra é propriedade, e a Chama já tem posses demais. Mande-a para casa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "山羊是私产，圣焰名下的东西已经够多了。送它回家。"
          }
        }
      }
    },
    "petition.goat_chapel.r1" : {
      "comment" : "Petition goat_chapel: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle gehen zufrieden, bis auf die Ziege, die gerade Geschmack an Stickereien gefunden hatte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone leaves content except the goat, who had grown fond of embroidery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos se van contentos menos la cabra, que le había tomado gusto al bordado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde repart content, sauf la chèvre, qui avait pris goût à la broderie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti se ne vanno contenti, tranne la capra, che si era appena appassionata ai ricami."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "皆が満足して帰る。刺繍の味を覚えかけていた山羊を除いて。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos saem satisfeitos, menos a cabra, que tinha tomado gosto por bordados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人人满意而归，只有那头山羊例外，它刚刚爱上了刺绣。"
          }
        }
      }
    },
    "petition.goat_chapel.r2" : {
      "comment" : "Petition goat_chapel: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ziege bekommt ein Band und eine Ecke der Kapelle. Sie frisst das Band. Hesper nennt das ein Zeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goat gets a ribbon and a corner of the chapel. It eats the ribbon. Hesper calls this a sign."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A la cabra le dan una cinta y un rincón de la capilla. Se come la cinta. Hesper dice que es una señal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chèvre reçoit un ruban et un coin de la chapelle. Elle mange le ruban. Hesper y voit un signe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capra riceve un nastro e un angolo della cappella. Si mangia il nastro. Hesper lo chiama un segno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "山羊は飾り紐と、礼拝堂の片隅をもらう。山羊は紐を食べる。ヘスパーはこれを兆しと呼ぶ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cabra ganha uma fita e um canto da capela. Come a fita. Hesper chama isso de sinal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "山羊得了一条丝带和礼拜堂的一个角落。它把丝带吃了。赫斯珀说这是个征兆。"
          }
        }
      }
    },
    "petition.goat_chapel.r3" : {
      "comment" : "Petition goat_chapel: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ziege trabt heim. Mutter Hesper spricht einen Tag lang nicht mit Euch, was manche bei Hofe einen Segen nennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goat trots home. Mother Hesper does not speak to you for a day, which some at court call a blessing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cabra se va trotando a casa. Madre Hesper no le dirige la palabra en todo un día, cosa que algunos en la corte llaman una bendición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chèvre rentre au trot. Mère Hesper ne vous adresse pas la parole de la journée, ce que certains, à la cour, appellent une bénédiction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capra trotterella a casa. Madre Hesper non vi rivolge la parola per un giorno, cosa che a corte qualcuno chiama una benedizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "山羊はとことこと家へ帰る。マザー・ヘスパーは一日、口をきいてくれない。城の者の中には、それを恵みと呼ぶ者もいる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cabra volta trotando para casa. A Madre Hesper não fala com você por um dia, o que alguns na corte chamam de bênção."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "山羊一路小跑回了家。赫斯珀嬷嬷一整天没跟你说话，城堡里有人说这是福分。"
          }
        }
      }
    },
    "petition.goat_chapel.text" : {
      "comment" : "Petition goat_chapel (farmwife): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, meine Ziege ist in die Kapelle spaziert und hat Mutter Hespers Altartuch gefressen. Sie sagt, die Ziege sei nun heilig und müsse bleiben. Es ist meine einzige Ziege. Sie ist nicht heilig. Sie hat nur Hunger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, my goat wandered into the chapel and ate Mother Hesper’s altar cloth. She says the goat is now holy and must stay. It is my only goat. It is not holy. It is just hungry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, mi cabra se metió en la capilla y se comió el mantel del altar de Madre Hesper. Ella dice que ahora la cabra es santa y debe quedarse. Es mi única cabra. No es santa. Solo tiene hambre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, ma chèvre est entrée dans la chapelle et a mangé la nappe d’autel de Mère Hesper. Elle dit que la chèvre est désormais sacrée et doit rester. C’est ma seule chèvre. Elle n’est pas sacrée. Elle a juste faim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, la mia capra è entrata in cappella e si è mangiata la tovaglia d’altare di Madre Hesper. Lei dice che ora la capra è sacra e deve restare. È la mia unica capra. Non è sacra. Ha solo fame."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、うちの山羊が礼拝堂に迷い込んで、マザー・ヘスパーの祭壇布を食べてしまいました。マザーは、山羊はもう聖なるものになったから置いていけと言います。うちのたった一頭の山羊なんです。聖なるものなんかじゃありません。お腹がすいてただけです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, a minha cabra entrou na capela e comeu a toalha do altar da Madre Hesper. Ela diz que agora a cabra é sagrada e tem de ficar. É a minha única cabra. Ela não é sagrada. Só está com fome."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，我的山羊溜进礼拜堂，把赫斯珀嬷嬷的祭坛布吃了。她说这羊如今是圣物了，必须留下。那是我唯一的一头羊。它不圣。它就是饿了。"
          }
        }
      }
    },
    "petition.guards_on_wall.c1" : {
      "comment" : "Petition guards_on_wall: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt sie auf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Post them"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que suban"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postez-les"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettetele lassù"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立たせてくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponha-os no adarve"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "派他们上去"
          }
        }
      }
    },
    "petition.guards_on_wall.c2" : {
      "comment" : "Petition guards_on_wall: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasst sie tagsüber schlafen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let them sleep by day"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que duerman de día"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez-les dormir le jour"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasciatele dormire di giorno"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昼は寝かせてやってくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe que durmam de dia"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让他们白天睡觉"
          }
        }
      }
    },
    "petition.guards_on_wall.hint" : {
      "comment" : "Petition guards_on_wall: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelangweilte Wachen sind der billigste Trost, den ein Haus kaufen kann. Stellt sie auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bored guards are the cheapest comfort a house can buy. Post them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos guardias aburridos son el consuelo más barato que una casa puede comprar. Mándelos arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des gardes qui s’ennuient, c’est le réconfort le moins cher qu’une maison puisse acheter. Postez-les."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le guardie annoiate sono il conforto più a buon mercato che una casata possa comprare. Mettetele lassù."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退屈した衛兵は、家が買える一番安い安心です。立たせておくに限ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardas entediados são o consolo mais barato que uma casa pode comprar. Ponha-os lá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无聊的卫兵，是一个家族能买到的最便宜的安心。派上去。"
          }
        }
      }
    },
    "petition.guards_on_wall.r1" : {
      "comment" : "Petition guards_on_wall: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Wachen stehen den ganzen Tag glänzend auf dem Wehrgang. Kinder winken ihnen. Sie dürfen nicht zurückwinken und tun es doch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two guards stand on the wall walk all day, gleaming. Children wave at them. They are not allowed to wave back, and do."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos guardias pasan el día en el adarve, relucientes. Los niños los saludan con la mano. Ellos tienen prohibido devolver el saludo, y lo devuelven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux gardes se tiennent toute la journée sur le chemin de ronde, rutilants. Les enfants leur font signe. Ils n’ont pas le droit de répondre, et ils répondent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due guardie stanno sul cammino di ronda tutto il giorno, scintillanti. I bambini le salutano con la mano. Loro non potrebbero rispondere, e rispondono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "二人の衛兵が、一日じゅう歩廊に立って輝いている。子どもたちが手を振る。振り返すのは禁じられているが、振り返す。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dois guardas ficam no adarve o dia todo, reluzindo. As crianças acenam para eles. Eles não podem acenar de volta, e acenam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两名卫兵整天站在城墙步道上，盔甲锃亮。孩子们朝他们挥手。他们不许挥手回应，却还是挥了。"
          }
        }
      }
    },
    "petition.guards_on_wall.r2" : {
      "comment" : "Petition guards_on_wall: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock brummt. „Ausgeruhte Wachen also.“ In der Nacht sind seine Männer hellwach, und die Stadt merkt nichts davon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock grunts. “Rested guards, then.” That night his men are sharp and the town is none the wiser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock gruñe. «Guardias descansados, entonces.» Esa noche sus hombres están bien despiertos, y el pueblo ni se entera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock grogne. « Des gardes reposés, alors. » Cette nuit-là, ses hommes sont vifs, et la ville n’en sait rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock grugnisce. «Guardie riposate, allora.» Quella notte i suoi uomini sono svegli come grilli, e il borgo non se ne accorge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラノックがうなる。「では、休ませた衛兵で」。その夜、部下たちは目が冴え、町は何も知らずにいる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brannock resmunga. “Guardas descansados, então.” Naquela noite, os homens dele estão atentos, e a cidade nem fica sabendo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布兰诺克哼了一声。“那就让他们睡足。”那一夜，他的兵个个精神抖擞，镇上谁也没察觉。"
          }
        }
      }
    },
    "petition.guards_on_wall.text" : {
      "comment" : "Petition guards_on_wall (brannock): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}. Tagsüber steht der Wehrgang leer, und die Stadt schaut auf eine leere Mauer. Gebt mir zwei Wachen da oben, in voller Rüstung, bei Sonne und Regen. Kostet nichts außer ihrer Langeweile. Die Stadt wird besser schlafen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Lord|My lady}. By day the wall walk stands empty, and the town looks up at an empty wall. Give me two guards up there in full kit, sun or rain. Costs nothing but their boredom. The town will sleep better."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Señor|Señora}. De día el adarve está vacío, y el pueblo levanta la vista hacia una muralla vacía. Deme dos guardias allá arriba con todo el equipo, haga sol o llueva. No cuesta nada más que su aburrimiento. El pueblo dormirá mejor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}. Le jour, le chemin de ronde est vide, et la ville lève les yeux vers une muraille vide. Donnez-moi deux gardes là-haut, en équipement complet, par soleil ou par pluie. Ça ne coûte que leur ennui. La ville dormira mieux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Signore|Signora}. Di giorno il cammino di ronda resta vuoto, e il borgo alza gli occhi su mura vuote. Mettetemi lassù due guardie in tenuta completa, col sole o con la pioggia. Non costa niente, a parte la loro noia. Il borgo dormirà meglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主。昼間は城壁の歩廊が空っぽで、町の者は空っぽの城壁を見上げています。完全武装の衛兵を2人、晴れでも雨でも上に置かせてください。かかるのは、連中の退屈だけです。町はよく眠れるようになる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Senhor|Senhora}. De dia o adarve fica vazio, e a cidade olha para uma muralha vazia. Me dê dois guardas lá em cima, de equipamento completo, com sol ou com chuva. Não custa nada além do tédio deles. A cidade vai dormir melhor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主。白天城墙步道空着，镇上的人抬头只看见一道空墙。给我两名卫兵，全副披挂站在上面，晴天雨天都站。不花一文钱，只费他们的耐性。镇上会睡得更好。"
          }
        }
      }
    },
    "petition.haunted_cellar.c1" : {
      "comment" : "Petition haunted_cellar: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
