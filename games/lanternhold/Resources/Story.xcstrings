    "petition.marek_arrows.c3" : {
      "comment" : "Petition marek_arrows: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram soll erst einen prüfen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let Bram test one first"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que Bram pruebe una primero"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que Bram en essaie une d’abord"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima Bram ne provi una"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まずブラムに一本試させる"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram testa uma primeiro"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先让布拉姆试一支"
          }
        }
      }
    },
    "petition.marek_arrows.hint" : {
      "comment" : "Petition marek_arrows: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tausend Pfeile für fünfzehn Gold. So schnell verliert nicht einmal Marek Geld. Kauft, bevor ihm seine Preise wieder einfallen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A thousand arrows for fifteen gold. Even Marek cannot lose money that fast. Buy them before he remembers his prices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mil flechas por quince monedas de oro. Ni siquiera Marek pierde dinero tan deprisa. Cómprelas antes de que se acuerde de sus precios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mille flèches pour quinze pièces d’or. Même Marek ne sait pas perdre de l’argent aussi vite. Achetez-les avant qu’il se souvienne de ses prix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mille frecce per quindici monete d’oro. Nemmeno Marek riesce a perdere soldi così in fretta. Comprate prima che si ricordi i suoi prezzi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "矢千本で金貨15枚。マレクといえど、そんな速さで損はできません。値段を思い出される前に、お買いなさいませ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mil flechas por quinze moedas de ouro. Nem Marek consegue perder dinheiro tão depressa. Compre antes que ele se lembre dos preços."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一千支箭，15金币。就连马雷克也没法赔得这么快。趁他还没想起自己的价钱，买下。"
          }
        }
      }
    },
    "petition.marek_arrows.r1" : {
      "comment" : "Petition marek_arrows: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek zählt die Münzen zweimal und die Pfeile gar nicht. „Ein Vergnügen, Eure Strahlkraft. Wahrlich, ein Vergnügen.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek counts the coins twice and the arrows not at all. “A pleasure, Your Radiance. Truly, a pleasure.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek cuenta las monedas dos veces y las flechas ninguna. «Un placer, Su Resplandor. De verdad, un placer.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek compte les pièces deux fois et les flèches pas du tout. « Un plaisir, Votre Splendeur. Vraiment, un plaisir. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek conta le monete due volte e le frecce nemmeno una. «Un piacere, Vostro Splendore. Davvero, un piacere.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マレクは硬貨を二度数え、矢は一度も数えない。「光栄でございます、まばゆきお方。まことに、光栄で」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek conta as moedas duas vezes e as flechas nenhuma. “Um prazer, Vossa Radiância. Um verdadeiro prazer.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "马雷克把钱数了两遍，箭一支也没数。“荣幸之至，光耀大人。真的，荣幸之至。”"
          }
        }
      }
    },
    "petition.marek_arrows.r2" : {
      "comment" : "Petition marek_arrows: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek verneigt sich so tief, dass seine Feder den Boden fegt. „Euer Verlust, Eure Strahlkraft.“ Aus der Küche schallt Tamsins Lachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek bows so low his feather sweeps the floor. “Your loss, Your Radiance.” From the kitchen comes Tamsin’s laugh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek se inclina tanto que su pluma barre el suelo. «Usted se lo pierde, Su Resplandor.» Desde la cocina llega la risa de Tamsin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek s’incline si bas que sa plume balaie le sol. « C’est vous qui y perdez, Votre Splendeur. » De la cuisine monte le rire de Tamsin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek si inchina così in basso che la sua piuma spazza il pavimento. «Peggio per voi, Vostro Splendore.» Dalla cucina arriva la risata di Tamsin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マレクは羽根飾りが床を掃くほど深く頭を下げる。「惜しいことを、まばゆきお方」。台所から、タムシンの笑い声が響く。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek se curva tanto que a pena do chapéu varre o chão. “O prejuízo é seu, Vossa Radiância.” Da cozinha vem a risada de Tamsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "马雷克深深一躬，帽上的羽毛扫过地面。“是您的损失，光耀大人。”厨房里传来塔姆辛的笑声。"
          }
        }
      }
    },
    "petition.marek_arrows.r3a" : {
      "comment" : "Petition marek_arrows: choice 3, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram biegt den Pfeil zwischen zwei Fingern, und er knickt wie Stroh. Marek findet, blass, zehn Gold zur Wiedergutmachung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram bends the arrow between two fingers and it folds like straw. Marek, pale, finds ten gold to make amends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram dobla la flecha entre dos dedos y esta se pliega como una paja. Marek, pálido, encuentra diez monedas de oro para compensar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram plie la flèche entre deux doigts, et elle se couche comme de la paille. Marek, blême, trouve dix pièces d’or pour se racheter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram prende la freccia tra due dita e quella si piega come un filo di paglia. Marek, pallido, trova dieci monete d’oro per farsi perdonare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラムが指二本で矢を曲げると、藁のように折れる。マレクは青ざめ、詫びに金貨10枚をどうにか工面する。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram verga a flecha entre dois dedos, e ela se dobra feito palha. Marek, pálido, arranja dez moedas de ouro para se redimir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布拉姆两指一弯，那支箭就像稻草一样折了。马雷克脸色发白，凑出10金币赔罪。"
          }
        }
      }
    },
    "petition.marek_arrows.r3b" : {
      "comment" : "Petition marek_arrows: choice 3, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brams Probepfeil fliegt gerade und spaltet einen Pfosten, also kauft Ihr alle. Es war natürlich der einzige gute."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram’s test arrow flies true and splits a post, so you buy the lot. It was, of course, the only good one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La flecha de prueba de Bram vuela recta y parte un poste, así que compra el lote entero. Era, por supuesto, la única buena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La flèche d’essai de Bram vole droit et fend un poteau ; vous achetez donc le lot. C’était, bien sûr, la seule bonne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La freccia di prova di Bram vola dritta e spacca un palo, così comprate tutto il carico. Era, naturalmente, l’unica buona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラムが試した矢はまっすぐ飛び、杭を割る。それで全部買うことになる。もちろん、良いのはあの一本だけだった。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A flecha de teste de Bram voa reta e racha um poste, então você compra o lote todo. Era, claro, a única boa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布拉姆试射的那支箭又准又稳，劈开了一根木桩，于是你全买了下来。当然，那是唯一的一支好箭。"
          }
        }
      }
    },
    "petition.marek_arrows.text" : {
      "comment" : "Petition marek_arrows (marek, story days 6-7): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Strahlkraft! Ein Kahn voller Pfeile kam den Fluss herauf, bestimmt für einen Herrn der Seestädte, der leider ertrunken ist. Tausend Schäfte für fünfzehn Gold! Ich verliere an jedem, aber ich fände keinen Schlaf, wüsste ich Eure Schützen im Mangel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Radiance! A barge of arrows came up the river, meant for a lord of the lake towns who has, sadly, drowned. A thousand shafts for fifteen gold! I lose money on every one, but I could not sleep knowing your archers went short."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Su Resplandor! Una barcaza de flechas subió por el río, destinada a un señor de los pueblos del lago que, por desgracia, se ahogó. ¡Mil astas por quince monedas de oro! Pierdo dinero con cada una, pero no podría dormir sabiendo que a sus arqueros les faltan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Splendeur ! Un chaland de flèches a remonté la rivière, destiné à un seigneur des villes du lac qui, hélas, s’est noyé. Mille flèches pour quinze pièces d’or ! J’y perds sur chacune, mais je ne dormirais pas en sachant vos archers à court."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vostro Splendore! Una chiatta di frecce ha risalito il fiume, destinata a un signore delle città del lago che, ahimè, è annegato. Mille aste per quindici monete d’oro! Ci rimetto su ognuna, ma non dormirei sapendo i vostri arcieri sprovvisti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まばゆきお方！　湖の町々のさる領主様に届くはずだった矢の川船が、川をのぼってまいりました。その方は、悲しいかな、溺れてしまわれまして。矢柄千本が金貨15枚！　一本ごとに損をいたしますが、お抱えの弓兵が矢に事欠くと思うと、夜も眠れませんで。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vossa Radiância! Uma barcaça de flechas subiu o rio, destinada a um senhor das cidades do lago que, infelizmente, se afogou. Mil hastes por quinze moedas de ouro! Perco dinheiro em cada uma, mas eu não dormiria sabendo que os seus arqueiros passam falta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光耀大人！一条驳船载着箭沿河上来，本是给湖畔诸镇一位大人的，可惜他淹死了。一千支箭只要15金币！每卖一支鄙人都要赔钱，可一想到您的弓手缺箭，鄙人就睡不着觉。"
          }
        }
      }
    },
    "petition.marek_oil.c1" : {
      "comment" : "Petition marek_oil: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Fass kaufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy a barrel"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprar un barril"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acheter un tonneau"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprare un barile"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一樽買う"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprar um barril"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "买一桶"
          }
        }
      }
    },
    "petition.marek_oil.c2" : {
      "comment" : "Petition marek_oil: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute nicht, Marek"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not tonight, Marek"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta noche no, Marek"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas ce soir, Marek"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non stasera, Marek"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜はやめておく、マレク"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta noite não, Marek"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今晚不买，马雷克"
          }
        }
      }
    },
    "petition.marek_oil.hint" : {
      "comment" : "Petition marek_oil: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mareks Öl ist entweder großartig oder Wasser mit Ehrgeiz. Mein Kassenbuch kennt den Unterschied nicht. Verzichtet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek’s oil is either brilliant or water with ambitions. My ledger cannot tell the difference. Pass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El aceite de Marek o es una maravilla o es agua con ambiciones. Mi libro de cuentas no nota la diferencia. Déjelo pasar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’huile de Marek est soit merveilleuse, soit de l’eau qui a de l’ambition. Mon registre ne fait pas la différence. Passez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’olio di Marek o è prodigioso o è acqua con ambizioni. Il mio libro dei conti non vede la differenza. Lasciate perdere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マレクの油は、すばらしいものか、野心を抱いた水か、どちらかです。わたくしの帳簿には見分けがつきません。今回は見送りましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O óleo de Marek ou é brilhante ou é água com ambições. O meu livro-caixa não sabe a diferença. Dispense."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "马雷克的油，要么妙不可言，要么就是心比天高的清水。我的账簿分不出来。别买。"
          }
        }
      }
    },
    "petition.marek_oil.r1" : {
      "comment" : "Petition marek_oil: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Öl brennt die ganze Nacht blau in den Gruben, und die Rußlinge, die hineinfallen, klettern nicht wieder heraus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The oil burns blue in the pits all night, and the sootlings that fall in do not climb out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El aceite arde azul en los fosos toda la noche, y los hollinejos que caen dentro no vuelven a salir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’huile brûle bleu dans les fosses toute la nuit, et les fumerons qui y tombent n’en ressortent pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’olio arde azzurro nelle fosse tutta la notte, e i fuligginelli che ci cadono non risalgono più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "油は夜通し杭穴で青く燃え、落ちた煤影は這い上がってこない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O óleo arde azul nos fossos a noite inteira, e os fuliginhos que caem lá dentro não saem mais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "火油在坑里烧了一夜蓝火，掉进去的煤影再没爬出来。"
          }
        }
      }
    },
    "petition.marek_oil.r2" : {
      "comment" : "Petition marek_oil: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek lüftet den Hut. „Dann morgen. Der Preis bleibt derselbe, es sei denn, er steigt.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek tips his hat. “Tomorrow, then. The price will be the same, unless it is higher.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek se toca el sombrero. «Mañana, entonces. El precio será el mismo, a menos que sea más alto.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek soulève son chapeau. « Demain, alors. Le prix sera le même, à moins qu’il ne soit plus haut. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek si tocca il cappello. «Domani, allora. Il prezzo sarà lo stesso, a meno che non sia più alto.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マレクは帽子を傾ける。「では、明日。お値段は同じでございます。上がっていなければ」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek toca o chapéu. “Amanhã, então. O preço será o mesmo, a menos que seja maior.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "马雷克抬了抬帽子。“那就明天。价钱不变，除非涨价。”"
          }
        }
      }
    },
    "petition.marek_oil.text" : {
      "comment" : "Petition marek_oil (marek, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Strahlkraft! Feueröl aus dem Süden, das gute, das blau brennt. Gießt es in die Pfahlgruben, und die Rußlinge leuchten wie Festlaternen. Fünfundzwanzig Gold das Fass. Nur heute. Vermutlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Radiance! Fire oil from the south, the good kind that burns blue. Pour it in the stake pits and the sootlings light up like festival lanterns. Twenty-five gold a barrel. Tonight only. Probably."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Su Resplandor! Aceite de fuego del sur, del bueno, del que arde azul. Viértalo en los fosos de estacas y los hollinejos se encenderán como faroles de fiesta. Veinticinco monedas de oro el barril. Solo esta noche. Probablemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Splendeur ! De l’huile à feu du Sud, la bonne, celle qui brûle bleu. Versez-la dans les fosses à pieux, et les fumerons s’illuminent comme des lanternes de fête. Vingt-cinq pièces d’or le tonneau. Ce soir seulement. Probablement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vostro Splendore! Olio di fuoco dal sud, quello buono che brucia azzurro. Versatelo nelle fosse a pali e i fuligginelli si accendono come lanterne di festa. Venticinque monete d’oro al barile. Solo per stasera. Probabilmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まばゆきお方！　南から来た火油でございます。青く燃える上物。杭穴に注げば、煤影どもが祭りのランタンのように燃え上がります。一樽金貨25枚。今夜限り。おそらくは。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vossa Radiância! Óleo de fogo do sul, do bom, que arde azul. Derrame nos fossos de estacas, e os fuliginhos se acendem feito lanternas de festa. Vinte e cinco moedas de ouro o barril. Só esta noite. Provavelmente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光耀大人！南方来的火油，烧起来是蓝色的上等货。倒进尖桩坑里，煤影就会像节庆的灯笼一样亮起来。一桶25金币。仅限今晚。大概吧。"
          }
        }
      }
    },
    "petition.marek_relic.c1" : {
