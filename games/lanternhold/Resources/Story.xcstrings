    "petition.bard_song.hint" : {
      "comment" : "Petition bard_song: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Lied ist billiger als eine Statue und reist weiter. Bezahlt die Ballade. Behaltet Strophe neun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A song is cheaper than a statue and travels further. Pay for the ballad. Keep verse nine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una canción es más barata que una estatua y viaja más lejos. Pague la balada. Que se quede la estrofa nueve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une chanson coûte moins cher qu’une statue et voyage plus loin. Payez la ballade. Gardez le couplet neuf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una canzone costa meno di una statua e viaggia più lontano. Pagate la ballata. Tenete la strofa nove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌は石像より安く、遠くまで旅をします。歌にお代をお払いなさいませ。九番は残して。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma canção é mais barata que uma estátua e viaja mais longe. Pague a balada. Fique com a estrofe nove."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一首歌比一座石像便宜，传得还远。为歌谣付钱。第九段留着。"
          }
        }
      }
    },
    "petition.bard_song.r1" : {
      "comment" : "Petition bard_song: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zum Wochenende singt das Tal den Refrain. Strophe neun handelt vom geflickten Mantel am hohen Tisch. Sie ist die beliebteste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By the week’s end the valley sings the chorus. Verse nine is about the mended cloak at the high table. It is the favourite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al acabar la semana, el valle entero canta el estribillo. La estrofa nueve trata de que el aro le viene grande. Es la favorita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À la fin de la semaine, toute la vallée chante le refrain. Le couplet neuf dit que le cercle est trop grand. C’est le préféré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entro fine settimana la valle canta il ritornello. La strofa nove dice che il cerchio è troppo grande. È la preferita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週の終わりには、谷じゅうが繰り返しの句を歌っている。九番は、額輪が大きすぎるという歌だ。いちばんの人気である。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No fim da semana, o vale canta o refrão. A estrofe nove fala do aro grande demais. É a preferida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不到周末，整个河谷都在唱副歌。第九段唱的是额环太大。这一段最受欢迎。"
          }
        }
      }
    },
    "petition.bard_song.r2" : {
      "comment" : "Petition bard_song: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Barde singt zehn Strophen, wunderschön. Irgendwie kennt das ganze Tal trotzdem Strophe neun auswendig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bard sings ten verses, beautifully. Somehow the whole valley still knows verse nine by heart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bardo canta diez estrofas, de maravilla. Aun así, de algún modo, todo el valle se sabe de memoria la estrofa nueve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le barde chante dix couplets, magnifiquement. Pourtant, toute la vallée connaît le couplet neuf par cœur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il bardo canta dieci strofe, splendidamente. Eppure tutta la valle sa ancora a memoria la strofa nove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吟遊詩人は十番まで、見事に歌い上げる。それなのに、なぜか谷じゅうが九番をそらで覚えている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bardo canta dez estrofes, lindamente. Mesmo assim, de algum jeito, o vale inteiro sabe a estrofe nove de cor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "诗人唱了十段，唱得很美。不知怎的，整个河谷还是都会背第九段。"
          }
        }
      }
    },
    "petition.bard_song.r3" : {
      "comment" : "Petition bard_song: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Barde verneigt sich mit einem viel zu breiten Lächeln und geht, etwas Neues und ziemlich Eingängiges summend."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bard bows, smiling far too widely, and leaves humming something new and quite catchy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bardo se inclina con una sonrisa demasiado ancha y se marcha tarareando algo nuevo y bastante pegadizo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le barde s’incline avec un sourire bien trop large et s’en va en fredonnant quelque chose de neuf, et d’assez entêtant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il bardo si inchina con un sorriso decisamente troppo largo, e se ne va canticchiando qualcosa di nuovo e piuttosto orecchiabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吟遊詩人はにこやかすぎる笑みで一礼し、何か新しい、やけに耳に残る節を口ずさみながら去っていく。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bardo se curva, com um sorriso largo demais, e vai embora cantarolando uma coisa nova que gruda no ouvido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "诗人鞠了一躬，笑得太过灿烂，哼着一支新的、相当上口的曲子走了。"
          }
        }
      }
    },
    "petition.bard_song.text" : {
      "comment" : "Petition bard_song (bard): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}! Ich habe eine Ballade über {den Burgherrn|die Burgherrin} von Haus Lantern gedichtet, elf Strophen, mit einem Refrain über die Laterne. Für zwanzig Gold singe ich sie in jeder Schenke von hier bis zur Küste. Für vierzig lasse ich Strophe neun weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}! I have composed a ballad of {Lord|Lady} Lantern and the dark beacon, eleven verses, with a chorus about the lantern. For twenty gold I sing it in every tavern from here to the coast. For forty, I leave out verse nine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡{Mi señor|Mi señora}! He compuesto una balada sobre {el farolero que llegó a señor|la farolera que llegó a señora}, once estrofas, con un estribillo sobre el farol. Por veinte monedas de oro la canto en cada taberna de aquí a la costa. Por cuarenta, me salto la estrofa nueve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame} ! J’ai composé une ballade {du lampiste devenu seigneur|de la lampiste devenue dame}, onze couplets, avec un refrain sur la lanterne. Pour vingt pièces d’or, je la chante dans chaque taverne d’ici à la côte. Pour quarante, je saute le couplet neuf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}! Ho composto una ballata {del lampionaio diventato signore|della lampionaia diventata signora}, undici strofe, con un ritornello sulla lanterna. Per venti monete d’oro la canto in ogni taverna da qui alla costa. Per quaranta, tralascio la strofa nove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様！　灯り番から城主になったお方の歌を作りました。十一番まであって、ランタンを歌う繰り返しの句つき。金貨20枚で、ここから沿岸までの酒場という酒場で歌いましょう。40枚なら、九番を抜きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}! Compus uma balada {do acendedor de lampiões que virou senhor|da acendedora de lampiões que virou senhora}, onze estrofes, com um refrão sobre a lanterna. Por vinte moedas de ouro, eu a canto em cada taverna daqui até a costa. Por quarenta, deixo de fora a estrofe nove."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人！我写了一首歌谣，唱点灯人城主，十一段，副歌唱的是提灯。给我20金币，我就从这儿一路唱到海岸，每家酒馆都唱。给40，我就删掉第九段。"
          }
        }
      }
    },
    "petition.barn_fire.c1" : {
