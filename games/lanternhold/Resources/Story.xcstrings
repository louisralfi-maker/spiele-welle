            "value" : "Mandate via i malati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "病人は谷から出してくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mandem os doentes embora"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把病人送走"
          }
        }
      }
    },
    "petition.ash_cough.c3" : {
      "comment" : "Petition ash_cough: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das geht vorüber"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It will pass"
          }
        },
        "es" : {
