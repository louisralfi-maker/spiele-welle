            "value" : "弓比べだけ。賞金はなし"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só arco e flecha, sem prêmio"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只比射箭，不设奖金"
          }
        }
      }
    },
    "petition.ludo_tourney.c3" : {
      "comment" : "Petition ludo_tourney: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
