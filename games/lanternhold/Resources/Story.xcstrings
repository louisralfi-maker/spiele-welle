          }
        }
      }
    },
    "petition.soldiers_pay.c3" : {
      "comment" : "Petition soldiers_pay: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezahlt sie mit Ehren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay them in honours"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagarles con honores"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payez-les en honneurs"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagateli con onorificenze"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名誉で報いよう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pague-os com honrarias"
          }
        },
        "zh-Hans" : {
