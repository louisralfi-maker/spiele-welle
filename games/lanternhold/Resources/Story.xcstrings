      }
    },
    "petition.lantern_night.c2" : {
      "comment" : "Petition lantern_night: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Laterne pro Haus"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One lantern per house"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un farol por casa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une lanterne par maison"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una lanterna per casa"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一軒にランタン一つ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma lanterna por casa"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每户一盏"
          }
        }
      }
    },
    "petition.lantern_night.c3" : {
      "comment" : "Petition lantern_night: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Düsternis würde nur lachen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Gloom would only laugh"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Penumbra solo se reiría"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Pénombre ne ferait qu’en rire"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Penombra riderebbe e basta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宵闇に笑われるだけだ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Penumbra só iria rir"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗霭只会笑"
          }
        }
      }
    },
    "petition.lantern_night.hint" : {
      "comment" : "Petition lantern_night: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Laterne pro Haus zahlt die Stadt, nicht das Haus. Meine liebste Art von Fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One lantern per house costs the town, not the house. My favourite kind of festival."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un farol por casa lo paga el pueblo, no la casa. Mi clase de fiesta favorita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une lanterne par maison, c’est la ville qui paie, pas la maison. Mon genre de fête préféré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una lanterna per casa la paga il borgo, non la casata. Il mio genere di festa preferito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一軒にランタン一つなら、払うのは町で、お城ではありません。わたくしの一番好きな種類の祭りです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma lanterna por casa quem paga é a cidade, não a casa. O meu tipo preferido de festa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每户一盏灯，花的是镇上的钱，不是城主家的。我最喜欢的那种节庆。"
          }
        }
      }
    },
    "petition.lantern_night.r1" : {
      "comment" : "Petition lantern_night: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tal leuchtet wie ein Sternenfeld. Sogar die Schützen auf der Mauer drehen sich um, nur für einen Augenblick."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The valley glows like a field of stars. Even the archers on the wall turn round to look, just for a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El valle brilla como un campo de estrellas. Hasta los arqueros de la muralla se dan la vuelta para mirar, solo un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vallée luit comme un champ d’étoiles. Même les archers sur la muraille se retournent pour regarder, juste un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La valle brilla come un campo di stelle. Perfino gli arcieri sulle mura si voltano a guardare, solo per un istante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "谷は星の野のように輝く。城壁の弓兵たちでさえ振り返って見る。ほんのひととき。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O vale brilha como um campo de estrelas. Até os arqueiros na muralha se viram para olhar, só por um momento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "河谷亮得像一片星野。连城墙上的弓手都转过身来看，只看了一眼。"
          }
        }
      }
    },
    "petition.lantern_night.r2" : {
      "comment" : "Petition lantern_night: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Fenster bekommt ein kleines Licht. Es ist stiller, als Pip wollte, und schöner, als er erwartet hatte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each window gets one small light. It is quieter than Pip wanted and lovelier than he expected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada ventana recibe una lucecita. Es más callado de lo que Pip quería y más hermoso de lo que esperaba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque fenêtre reçoit une petite lumière. C’est plus calme que ce que voulait Pip, et plus beau qu’il ne s’y attendait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni finestra ha una piccola luce. La notte è più quieta di quanto Pip volesse e più bella di quanto si aspettasse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの窓にも小さな灯りがひとつ。ピップの望みより静かで、ピップが思っていたより美しい。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada janela ganha uma luzinha. É mais quieto do que Pip queria e mais bonito do que ele esperava."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每扇窗都亮起一盏小灯。比皮普想要的安静，比他料想的美。"
          }
        }
      }
    },
    "petition.lantern_night.r3" : {
      "comment" : "Petition lantern_night: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Das tut sie immer“, sagt Pip. „Deshalb sollten wir zuerst lachen.“ Er schmollt den Rest des Tages."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“It always does,” says Pip. “That is why we should laugh first.” He sulks for the rest of the day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Siempre se ríe», dice Pip. «Por eso deberíamos reírnos primero.» Se pasa el resto del día enfurruñado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Elle rit toujours, dit Pip. C’est pour ça qu’il faut rire les premiers. » Il boude le reste de la journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Lo fa sempre», dice Pip. «Per questo dovremmo ridere prima noi.» Tiene il broncio per il resto del giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「いつだって笑われておりますとも」とピップは言う。「だからこそ、こちらが先に笑うべきなのです」。その日は一日じゅう、すねている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ela sempre ri”, diz Pip. “Por isso devíamos rir primeiro.” Ele fica emburrado o resto do dia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“它向来都笑，”皮普说，“所以我们得先笑。”他一整天都在生闷气。"
          }
        }
      }
    },
    "petition.lantern_night.text" : {
      "comment" : "Petition lantern_night (pip, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Dochtheit, ich schlage eine Nacht der Laternen vor: Jedes Haus hängt eine ins Fenster, jedes Kind trägt eine durch die Gasse, und wir lachen die Düsternis hinter tausend kleinen Feuern aus. Frech, aber billig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Wickship, I propose a Night of Lanterns: every house hangs one in the window, every child carries one in the lane, and we laugh at the Gloom from behind a thousand small fires. Rude, but cheap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su Mechencia, propongo una Noche de los Faroles: cada casa cuelga uno en la ventana, cada niño lleva uno por la calle, y nos reímos de la Penumbra detrás de mil pequeños fuegos. Descarado, pero barato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Lumignence, je propose une Nuit des lanternes : chaque maison en suspend une à sa fenêtre, chaque enfant en porte une dans la ruelle, et nous rions de la Pénombre derrière mille petits feux. Insolent, mais pas cher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vostra Stoppinenza, propongo una Notte delle Lanterne: ogni casa ne appende una alla finestra, ogni bambino ne porta una per il vicolo, e noi ridiamo in faccia alla Penombra da dietro mille piccoli fuochi. Sfacciato, ma economico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灯心閣下、ランタンの夜をご提案いたします。どの家も窓にひとつ掛け、どの子も路地でひとつ持ち、千の小さな火の陰から宵闇を笑ってやるのです。無礼ですが、安上がりでございます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vossa Paviência, proponho uma Noite das Lanternas: cada casa pendura uma na janela, cada criança leva uma pela viela, e rimos da Penumbra atrás de mil foguinhos. Atrevido, mas barato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灯芯阁下，小的提议办一场提灯之夜：家家窗口挂一盏，每个孩子提一盏走在巷子里，我们躲在千百团小火后面嘲笑暗霭。无礼，但便宜。"
          }
        }
      }
    },
    "petition.last_stand.c1" : {
      "comment" : "Petition last_stand: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wir halten bis zum Morgen.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“We hold until dawn.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Resistiremos hasta el alba.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Nous tiendrons jusqu’à l’aube. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Resisteremo fino all’alba.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「夜明けまで持ちこたえよう」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Vamos aguentar até a alvorada.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“我们坚守到天亮。”"
          }
        }
      }
    },
    "petition.last_stand.c2" : {
      "comment" : "Petition last_stand: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wir holen Burgherr Aldric heim.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“We bring Lord Aldric home.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Traeremos a casa a lord Aldric.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Nous ramènerons le seigneur Aldric. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Riporteremo a casa Lord Aldric.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アルドリック様を連れて帰ろう」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Vamos trazer o Lorde Aldric para casa.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“我们要把奥德里克大人接回家。”"
          }
        }
      }
    },
    "petition.last_stand.c3" : {
      "comment" : "Petition last_stand: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ich habe auch Angst. Ich bleibe.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“I am afraid too. I stay.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Yo no nací para esto.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Je n’ai jamais été {fait|faite} pour cela. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Non doveva toccare a me.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「私は、こんな役目に就くはずではなかった」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Isto nunca foi para mim.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“我本不是为此而生。”"
          }
        }
      }
    },
    "petition.last_stand.hint" : {
      "comment" : "Petition last_stand: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versprecht ihnen den Morgen. Das ist das Einzige, was Euch morgen niemand mehr nehmen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promise them the dawn. It is the one thing nobody can take back from you tomorrow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prométales el alba. Es lo único que mañana nadie podrá quitarle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promettez-leur l’aube. C’est la seule chose que personne ne pourra vous reprendre demain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promettete loro l’alba. È l’unica cosa che domani nessuno potrà più togliervi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜明けを約束なさいませ。明日、誰にも取り上げられない、ただ一つのものです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prometa a eles a alvorada. É a única coisa que ninguém vai poder lhe tirar amanhã."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向他们许诺黎明。明天谁也夺不走您的，就只有这一样。"
          }
        }
      }
    },
    "petition.last_stand.r1" : {
      "comment" : "Petition last_stand: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Brüllen läuft die Mauern entlang und hinab in den Schlund. Irgendwo im Dunkel lauscht etwas."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A roar runs along the walls and down into the Throat. Somewhere in the dark, something listens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rugido recorre las murallas y baja hasta la Garganta. En algún lugar de la oscuridad, algo escucha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une clameur court le long des murailles et descend dans la Gorge. Quelque part dans l’obscurité, quelque chose écoute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un boato corre lungo le mura e giù nella Gola. Da qualche parte, nel buio, qualcosa ascolta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どよめきが城壁を伝い、喉谷へと下りていく。闇のどこかで、何かが耳を澄ませている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um rugido corre pelas muralhas e desce para a Garganta. Em algum lugar no escuro, algo escuta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一阵吼声沿着城墙传开，一直落进喉谷。黑暗中的某处，有什么东西在听。"
          }
        }
      }
    },
    "petition.last_stand.r2" : {
      "comment" : "Petition last_stand: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die alten Soldaten verstummen zuerst. Dann ziehen sie die Schwerter und halten sie hoch, einer nach dem anderen, der Düsternis entgegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The old soldiers fall silent first. Then they draw their swords and hold them up, one by one, toward the Gloom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los viejos soldados son los primeros en callar. Luego desenvainan las espadas y las alzan, uno tras otro, hacia la Penumbra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vieux soldats se taisent les premiers. Puis ils tirent leurs épées et les lèvent, un à un, vers la Pénombre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I vecchi soldati tacciono per primi. Poi sguainano le spade e le levano, uno dopo l’altro, verso la Penombra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古参兵たちがまず黙り込む。それから剣を抜き、一人また一人と、宵闇に向けて掲げる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os velhos soldados se calam primeiro. Depois sacam as espadas e as erguem, um por um, na direção da Penumbra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "老兵们最先沉默。然后他们拔出剑，一个接一个，朝暗霭高高举起。"
          }
        }
      }
    },
    "petition.last_stand.r3" : {
      "comment" : "Petition last_stand: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Moment rührt sich niemand. Dann lacht Brannock. „Die haben wir alle, {Herr|Herrin}. Und hier stehen wir.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For a moment no one moves. Then Brannock laughs. “So are we all, my {lord|lady}. And here we all stand.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por un momento nadie se mueve. Luego Brannock se ríe. «Ninguno de nosotros nació para esto, {señor|señora}. Y aquí estamos.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un instant, personne ne bouge. Puis Brannock rit. « Aucun de nous n’était fait pour ça, {monseigneur|madame}. Et nous voilà quand même. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per un istante nessuno si muove. Poi Brannock ride. «Non doveva toccare a nessuno di noi, {signore|signora}. Eppure eccoci qui.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一瞬、誰も動かない。それからブラノックが笑う。「こんな役目に就くはずだった者など、一人もいませんよ、城主様。それでも、皆ここにいる」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por um momento, ninguém se mexe. Então Brannock ri. “Isto nunca foi para nenhum de nós, {meu senhor|minha senhora}. E aqui estamos mesmo assim.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一时间，谁也没动。然后布兰诺克笑了。“我们谁都不是为此而生的，城主。可我们还是在这儿。”"
          }
        }
      }
    },
    "petition.last_stand.text" : {
      "comment" : "Petition last_stand (brannock, story day 20): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}. Jeder Mann steht auf den Mauern, jede Feuerschale ist gefüllt. Die Jungs hätten gern ein Wort von {ihrem Herrn|ihrer Herrin}, bevor es dunkel wird. Ein kurzes, wenn ich bitten darf. Sie müssen noch Pfeile zählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}. Every man is on the walls, every brazier is stacked. The lads would like a word from their {lord|lady} before the dark. A short one, if you please. They still have arrows to count."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Señor|Señora}. Todos los hombres están en las murallas; todos los braseros, cargados. Los muchachos querrían unas palabras de su {señor|señora} antes de la oscuridad. Breves, si no es molestia. Todavía tienen flechas que contar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}. Tous les hommes sont sur les murailles, chaque brasero est garni. Les gars aimeraient un mot de leur {seigneur|dame} avant le noir. Un mot court, s’il vous plaît. Ils ont encore des flèches à compter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Signore|Signora}. Tutti gli uomini sono sulle mura, ogni braciere è carico. I ragazzi vorrebbero una parola {dal loro signore|dalla loro signora} prima del buio. Breve, se non vi dispiace. Hanno ancora frecce da contare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主。兵は一人残らず城壁に。篝火はすべて薪を積みました。闇が来る前に、若い連中が城主から一言いただきたいと。短めにお願いします。まだ矢を数えねばなりませんので。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}. Todo homem está nas muralhas, todo braseiro está abastecido. Os rapazes gostariam de uma palavra {do senhor deles|da senhora deles} antes do escuro. Uma curta, por favor. Eles ainda têm flechas para contar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主。所有人都上了城墙，每个火盆都堆满了。弟兄们想在天黑前听他们的城主说句话。短一点，劳驾。他们还有箭要数。"
          }
        }
      }
    },
    "petition.lorn_visit.c1" : {
      "comment" : "Petition lorn_visit: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzählt mir von der Glocke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell me about the bell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hábleme de la campana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parlez-moi de la cloche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parlatemi della campana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鐘のことを聞かせてください"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me conte sobre o sino."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请您讲讲那口钟。"
          }
        }
      }
    },
    "petition.lorn_visit.c2" : {
      "comment" : "Petition lorn_visit: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile, seht im Familienbuch nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile, check the family book."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile, mire en el libro de familia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile, vérifiez le livre de famille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile, controllate il libro di famiglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オディール、家系の書を調べてくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile, veja o livro da família."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "奥黛尔，查查家谱。"
          }
        }
      }
    },
    "petition.lorn_visit.c3" : {
      "comment" : "Petition lorn_visit: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dankt ihr und geleitet sie hinaus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank her and see her out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agradézcale y acompáñela a la puerta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remerciez-la et raccompagnez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringraziatela e accompagnatela fuori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "礼を言って、お送りしてくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agradeça a ela e a leve até a porta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "谢过她，送她出去。"
          }
        }
      }
    },
    "petition.lorn_visit.hint" : {
      "comment" : "Petition lorn_visit: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greybell sagt das seit Jahrhunderten und wird dafür ausgelacht. Sie ist über achtzig und kam selbst. Fragt nach der Glocke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greybell has said so for centuries and been laughed at for it. She is past eighty and came herself. Ask about the bell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greybell lo dice desde hace siglos y se ríen de ella por eso. Tiene más de ochenta años y vino en persona. Pregunte por la campana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greybell le dit depuis des siècles, et on en rit. Elle a passé quatre-vingts ans et elle est venue en personne. Interrogez-la sur la cloche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greybell lo dice da secoli e per questo la deridono. Ha passato gli ottanta ed è venuta di persona. Chiedete della campana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グレイベルは何百年もそう言い続けて、笑われてまいりました。八十を過ぎて、自ら来られたのです。お尋ねになるべきは、鐘のことです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greybell diz isso há séculos, e sempre riram dela. Ela passou dos oitenta e veio pessoalmente. Pergunte pelo sino."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "格雷贝尔这么说了几百年，一直被人笑话。她八十多岁了，还亲自来了。问问那口钟。"
          }
        }
      }
    },
    "petition.lorn_visit.r1" : {
      "comment" : "Petition lorn_visit: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie erzählt langsam: eine graue Glocke, ein Riss, fein wie ein Haar, ein Seil, an dem niemand zog. Das Kind mit ihrem Stock kennt es auswendig und hört doch zu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She tells it slowly: a grey bell, a hair-fine crack, a rope nobody pulled. The child with her stick knows it by heart and still listens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo cuenta despacio: una campana gris, una fisura como un cabello, una cuerda de la que nadie tiraba. El niño que le lleva el bastón se lo sabe de memoria y aun así escucha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle raconte lentement : une cloche grise, une fêlure fine comme un cheveu, une corde que nul ne tirait. L’enfant qui porte sa canne la sait par cœur et écoute quand même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La racconta adagio: una campana grigia, una crepa fine come un capello, una corda che nessuno tirava. Il bambino che le porta il bastone la sa a memoria e ascolta lo stesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彼女はゆっくりと語る。灰色の鐘、髪の毛ほどの細いひび、誰も引かない綱。杖を持つ子どもは話をそらで覚えていて、それでも聞き入っている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela conta devagar: um sino cinzento, uma rachadura fina como um fio de cabelo, uma corda que ninguém puxou. A criança com a bengala dela sabe de cor e ainda escuta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她讲得很慢：一口灰钟，一道细如发丝的裂缝，一根没人拉的绳。替她拿手杖的孩子早已背得出来，却仍在听。"
          }
        }
      }
    },
    "petition.lorn_visit.r2" : {
      "comment" : "Petition lorn_visit: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile schlägt das Jahr 412 auf und hält inne. Elf Stummel in der Bindung, sauber geschnitten. „Aha“, sagt Dame Orla. „Ein Messer hat dieses Haus also doch.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile turns to the year 412 and stops. Eleven stubs in the binding, cut clean. “So,” says Dame Orla. “This house does keep a knife.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile busca el año 412 y se detiene. Once muñones de hoja en la costura, cortados a ras. «Vaya», dice Dame Orla. «Así que esta casa sí guarda un cuchillo.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile ouvre à l’année 412 et s’arrête. Onze talons dans la reliure, coupés net. « Tiens, dit Dame Orla. Cette maison garde donc bien un couteau. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile apre all’anno 412 e si ferma. Undici monconi nella rilegatura, tagliati netti. «Ecco», dice Dame Orla. «Un coltello, questa casa, ce l’ha.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オディールは412年のところを開き、手を止める。綴じ目に、十一枚分の切り残し。きれいに切られている。「なるほど」とデイム・オーラ。「この家にも、刃物はあるんだね」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile abre no ano 412 e para. Onze tocos de página na encadernação, cortados rente. “Ora”, diz Dame Orla. “Então esta casa guarda uma faca, afinal.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "奥黛尔翻到412年，停住了。装订处留着十一页残根，切得干干净净。“原来如此，”奥拉女爵说，“这个家族果然留着一把刀。”"
          }
        }
      }
    },
    "petition.lorn_visit.r3" : {
      "comment" : "Petition lorn_visit: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Aldrics Großmutter hat mich auch hinausgeleitet“, sagt sie und steht ohne Hilfe auf. „Sie wurde wenigstens rot.“ Das Kind nimmt den Stock und sieht sich nicht um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Aldric’s grandmother saw me out too,” she says, rising unaided. “She at least blushed.” The child takes the stick and does not look back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«La abuela de Aldric también me acompañó a la puerta», dice, levantándose sin ayuda. «Ella, al menos, se sonrojó.» El niño toma el bastón y no mira atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« La grand-mère d’Aldric aussi m’a raccompagnée », dit-elle en se levant sans aide. « Elle, au moins, a rougi. » L’enfant prend la canne et ne se retourne pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Anche la nonna di Aldric mi ha accompagnata fuori», dice, alzandosi da sola. «Lei almeno è arrossita.» Il bambino prende il bastone e non si volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アルドリックの祖母も、わたしを送り出したよ」と、彼女は誰の手も借りずに立ち上がる。「あの人は、少なくとも赤くなった」。子どもが杖を受け取り、振り返らない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A avó de Aldric também me levou até a porta”, diz ela, levantando-se sem ajuda. “Ela, pelo menos, corou.” A criança pega a bengala e não olha para trás."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“奥德里克的祖母也送过我出门。”她说着，不用人扶便站了起来，“她好歹还脸红了。”孩子拿起手杖，没有回头。"
          }
        }
      }
    },
    "petition.lorn_visit.text" : {
      "comment" : "Petition lorn_visit (orlaLorn, story days 14-15): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzeiht, dass ich sitze, Tapers {Erbe|Erbin}. Orla Lorn von Greybell. Euer Haus kam aus dem Spalt herab, nicht zu ihm hinauf. Meines sah zu. Wir hüten die erste Glocke Eures Saals. Burgherr Edric schickte sie im Dunklen Jahr fort, weil sie läutete, ohne dass eine Hand am Seil war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgive me for sitting, heir of Taper. Orla Lorn of Greybell. Your house came down out of the Cleft, not up to it. Mine watched. We keep your hall’s first bell. Lord Edric sent it away in the Dark Year: it rang with no hand on the rope."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntese, joven Taper, que yo ya estoy sentada. Orla Lorn de Greybell. Su casa bajó de la Grieta, no subió hasta ella. La mía lo vio. Guardamos la primera campana de su salón. Lord Edric la mandó lejos en el Año Oscuro, porque sonaba sin una mano en la cuerda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asseyez-vous, jeune Taper, moi, c’est fait. Orla Lorn, de Greybell. Votre maison est descendue de la Faille, elle n’y est pas montée. La mienne a regardé. Nous gardons la première cloche de votre salle. Le seigneur Edric l’a renvoyée l’Année noire : elle sonnait sans qu’une main tienne la corde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedete, giovane Taper, che io sono già seduta. Orla Lorn di Greybell. La vostra casata è scesa dalla Fenditura, non è salita fin lì. La mia guardava. Noi custodiamo la prima campana del vostro salone. Lord Edric l’ha mandata via nell’Anno Oscuro, perché suonava senza una mano sulla corda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お掛け、若きテイパー。わたしはもう掛けてるよ。グレイベルのオーラ・ロルンだ。あなたの家は裂け目へ上ったんじゃない、裂け目から下りてきたんだ。うちの家は見ていた。この広間の最初の鐘は、うちで預かってる。闇の年に城主エドリックが手放したのさ。綱に誰の手もないのに、鳴ったからね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sente-se, jovem Taper, eu já me sentei. Orla Lorn de Greybell. A sua casa desceu da Fenda, não subiu até ela. A minha viu. Guardamos o primeiro sino do seu salão. O Lorde Edric o mandou embora no Ano Escuro, porque tocava sem mão nenhuma na corda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "坐吧，小泰珀，我已经坐下了。格雷贝尔的奥拉·洛恩。你们家是从裂隙里下来的，不是爬上去的。我们家亲眼看着。你们大厅的第一口钟在我们那儿。埃德里克大人在黑暗之年把它送走了，因为没人拉绳，它自己响了。"
          }
        }
      }
    },
    "petition.ludo_arrives.c1" : {
      "comment" : "Petition ludo_arrives: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen, Ser Ludo"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome, Ser Ludo"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenido, Ser Ludo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenue, Ser Ludo"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benvenuto, Ser Ludo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ようこそ、サー・ルド"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bem-vindo, Ser Ludo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎，卢多爵士"
          }
        }
      }
    },
    "petition.ludo_arrives.c2" : {
      "comment" : "Petition ludo_arrives: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann erschlagt sie heute Nacht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slay it tonight, then"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entonces mátela esta noche"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourfendez-la donc cette nuit"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allora abbattetela stanotte"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "なら、今夜討ち果たしてくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Então mate-a esta noite"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那今夜就去斩了它"
          }
        }
      }
    },
    "petition.ludo_arrives.c3" : {
      "comment" : "Petition ludo_arrives: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Helden haben wir keine Betten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We have no beds for heroes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tenemos camas para héroes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous n’avons pas de lit pour les héros"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non abbiamo letti per gli eroi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英雄に貸す寝床はない"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não temos camas para heróis"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们没有给英雄的床"
          }
        }
      }
    },
    "petition.ludo_arrives.hint" : {
      "comment" : "Petition ludo_arrives: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wird essen wie drei Männer und kämpfen wie ein halber. Aber die Kinder lieben ihn. Gebt ihm zu essen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He will eat like three men and fight like half of one. But the children adore him. Feed him."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comerá como tres hombres y luchará como medio. Pero los niños lo adoran. Dele de comer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mangera comme trois et se battra comme une moitié d’homme. Mais les enfants l’adorent. Nourrissez-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangerà per tre e combatterà per mezzo. Ma i bambini lo adorano. Dategli da mangiare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三人分食べて、半人分しか戦わないでしょう。ですが、子どもたちは夢中です。食べさせておやりなさいませ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele vai comer como três homens e lutar como meio. Mas as crianças o adoram. Dê-lhe de comer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他吃起来顶三个人，打起来只顶半个。可孩子们喜欢他。给他饭吃。"
          }
        }
      }
    },
    "petition.ludo_arrives.r1" : {
      "comment" : "Petition ludo_arrives: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo verneigt sich so tief, dass ihm der Helm herunterfällt. Tamsin bekocht ihn für drei. Die Kinder folgen ihm überallhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo bows so deeply that his helmet falls off. Tamsin feeds him for three. The children follow him everywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo se inclina tanto que se le cae el yelmo. Tamsin le da de comer por tres. Los niños lo siguen a todas partes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo s’incline si bas que son casque tombe. Tamsin le nourrit pour trois. Les enfants le suivent partout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo si inchina così profondamente che gli cade l’elmo. Tamsin cucina per lui come per tre. I bambini lo seguono ovunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サー・ルドが深々と頭を下げると、兜が転げ落ちる。タムシンは三人分を食べさせる。子どもたちは、どこへでも彼についていく。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo se curva tão fundo que o elmo cai. Tamsin cozinha para ele como para três. As crianças o seguem por toda parte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卢多爵士躬身太深，头盔掉了下来。塔姆辛给他做了三人份。他走到哪儿，孩子们就跟到哪儿。"
          }
        }
      }
    },
    "petition.ludo_arrives.r2" : {
      "comment" : "Petition ludo_arrives: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo marschiert zur Dämmerung singend in den Schlund. Im Morgengrauen findet man ihn schlafend in einer Pfahlgrube, unverletzt und unbesiegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo marches into the Throat at dusk, singing. At dawn he is found asleep in a stake pit, unhurt and undefeated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo marcha cantando hacia la Garganta al anochecer. Al alba lo encuentran dormido en un foso de estacas, ileso e invicto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo s’enfonce dans la Gorge au crépuscule, en chantant. À l’aube, on le retrouve endormi dans une fosse à pieux, indemne et invaincu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al crepuscolo Ser Ludo marcia cantando dentro la Gola. All’alba lo trovano addormentato in una fossa a pali, illeso e imbattuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日暮れ、サー・ルドは歌いながら喉谷へ行進していく。夜明け、杭穴の中で眠っているところを見つかる。無傷で、負け知らずのまま。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo entra na Garganta ao crepúsculo, cantando. Na alvorada, é encontrado dormindo num fosso de estacas, ileso e invicto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黄昏时，卢多爵士唱着歌开进了喉谷。黎明时，有人发现他在一个尖桩坑里睡着了，毫发无伤，未尝一败。"
          }
        }
      }
    },
    "petition.ludo_arrives.r3" : {
      "comment" : "Petition ludo_arrives: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo geht mit großer Würde, läuft gegen das Fallgatter und geht noch einmal, mit etwas weniger Würde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo departs with great dignity, walks into the portcullis, and departs again with slightly less."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo se marcha con gran dignidad, se da contra el rastrillo y vuelve a marcharse con algo menos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo s’en va avec une grande dignité, se cogne dans la herse, et repart avec un peu moins."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo se ne va con grande dignità, va a sbattere contro la saracinesca, e se ne va di nuovo con un po’ meno dignità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サー・ルドは威厳たっぷりに立ち去り、落とし格子にぶつかり、威厳を少し減らして、もう一度立ち去る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo parte com grande dignidade, dá de cara com a grade levadiça e parte de novo com um pouco menos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卢多爵士无比庄严地告辞，一头撞上吊闸，然后再次告辞，庄严少了几分。"
          }
        }
      }
    },
    "petition.ludo_arrives.text" : {
      "comment" : "Petition ludo_arrives (serLudo): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seid gegrüßt, {edler Herr|edle Herrin}! Ich bin Ser Ludo von den Sieben Hügeln, Bezwinger des Lindwurms von Brackwasser, beinahe. Ich bin gekommen, um Eure Düsternis eigenhändig zu erschlagen. Ich bitte nur um ein Bett, ein Mahl und Hilfe mit diesem Helm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hail, good my {lord|lady}! I am Ser Ludo of the Seven Hills, slayer of the Wyrm of Brackwater, very nearly. I have come to slay your Gloom single-handed. I ask only a bed, a meal, and help with this helmet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Salud, {mi noble señor|mi noble señora}! Soy Ser Ludo de las Siete Colinas, vencedor de la Sierpe de Aguasalobres, o casi. He venido a acabar con su Penumbra sin ayuda de nadie. Solo pido una cama, una comida y que me ayuden con este yelmo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut à vous, {mon bon seigneur|ma bonne dame} ! Je suis Ser Ludo des Sept Collines, pourfendeur de la Guivre des Eaux-Saumâtres, ou presque. Je suis venu pourfendre votre Pénombre à moi seul. Je ne demande qu’un lit, un repas, et un peu d’aide avec ce casque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salute a voi, {mio nobile signore|mia nobile signora}! Sono Ser Ludo delle Sette Colline, uccisore del Vermo di Acquasalmastra, o quasi. Sono venuto ad abbattere da solo la vostra Penombra. Chiedo soltanto un letto, un pasto e un aiuto con quest’elmo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お初にお目にかかります、気高き城主殿！　わたくしは七つ丘のサー・ルド、汽水沼の大蛇をあと一歩で討ち取った者ですぞ。宵闇を、この手ひとつで討ち果たしに参りました。望みはただ、寝床と食事と、この兜を何とかする手助けのみ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve, {meu nobre senhor|minha nobre senhora}! Sou Ser Ludo das Sete Colinas, matador da Serpe de Águas Salobras, ou quase. Vim matar a sua Penumbra com as próprias mãos. Peço apenas uma cama, uma refeição e ajuda com este elmo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幸会，尊贵的大人！本骑士乃七丘的卢多爵士，咸水沼巨蟒的屠戮者——差一点就是了。本骑士前来，要单枪匹马斩除您的暗霭。只求一张床、一顿饭，再请人帮本骑士弄弄这顶头盔。"
          }
        }
      }
    },
    "petition.ludo_old.c1" : {
      "comment" : "Petition ludo_old: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufhängen, und ein Mahl für den Helden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hang it, and feast the hero"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colgarlo, y un banquete para el héroe"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suspendre, et fêter le héros"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appenderlo, e un banchetto per l’eroe"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掛けよう。英雄に祝宴を"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendure, e festa para o herói"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挂上，再设宴款待英雄"
          }
        }
      }
    },
    "petition.ludo_old.c2" : {
      "comment" : "Petition ludo_old: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufhängen, aber kein Mahl"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hang it, hold the feast"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colgarlo, pero sin banquete"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suspendre, sans festin"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appenderlo, ma niente banchetto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掛けよう。祝宴はなしだ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendure, mas sem banquete"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挂上，宴席就免了"
          }
        }
      }
    },
    "petition.ludo_old.c3" : {
      "comment" : "Petition ludo_old: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist das ein Ziegenzahn?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is that a goat’s tooth?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eso es un diente de cabra?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est une dent de chèvre ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quello è un dente di capra?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それは山羊の歯では？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso é um dente de cabra?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是山羊牙吧？"
          }
        }
      }
    },
    "petition.ludo_old.hint" : {
      "comment" : "Petition ludo_old: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist ein Ziegenzahn. Aber die Geschichte kostet nichts, und die Kinder werden sie lieben. Hängt ihn auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is a goat’s tooth. But the story is free, and the children will love it. Hang it up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es un diente de cabra. Pero la historia es gratis, y a los niños les encantará. Cuélguelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est une dent de chèvre. Mais l’histoire est gratuite, et les enfants l’adoreront. Suspendez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È un dente di capra. Ma la storia è gratis, e i bambini la adoreranno. Appendetelo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "山羊の歯です。ですが話はただですし、子どもたちは大喜びするでしょう。お掛けなさいませ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É um dente de cabra. Mas a história é de graça, e as crianças vão adorar. Pendure-o."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那是山羊牙。不过故事不要钱，孩子们会喜欢的。挂上吧。"
          }
        }
      }
    },
    "petition.ludo_old.r1" : {
      "comment" : "Petition ludo_old: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zahn hängt über dem Herd. Ser Ludo erzählt die Geschichte jeden Abend, und der Drache wird jedes Mal größer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tooth hangs above the hearth. Ser Ludo tells the tale every night, and the dragon grows larger each time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El diente cuelga sobre el hogar. Ser Ludo cuenta la historia cada noche, y el dragón crece cada vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dent pend au-dessus de l’âtre. Ser Ludo raconte l’histoire chaque soir, et le dragon grandit à chaque fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dente pende sopra il focolare. Ser Ludo racconta la storia ogni sera, e il drago diventa ogni volta più grande."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "牙は炉の上に掛けられる。サー・ルドは毎晩その話をし、竜は話すたびに大きくなる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dente fica pendurado acima da lareira. Ser Ludo conta a história toda noite, e o dragão fica maior a cada vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "牙齿挂在了炉火上方。卢多爵士每晚都讲这个故事，那条龙每讲一次就大一圈。"
          }
        }
      }
    },
    "petition.ludo_old.r2" : {
      "comment" : "Petition ludo_old: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo ist trotzdem entzückt. Bis zum Wochenende hat der Drache drei Köpfe und schuldet ihm Geld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo is delighted all the same. By the week’s end the dragon has three heads and owes him money."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo está encantado de todos modos. Al acabar la semana, el dragón tiene tres cabezas y le debe dinero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo est ravi quand même. À la fin de la semaine, le dragon a trois têtes et lui doit de l’argent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo è entusiasta lo stesso. Entro fine settimana il drago ha tre teste e gli deve dei soldi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それでもサー・ルドは大喜びだ。週の終わりには、竜の首は三つになり、竜は彼に借金をしている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo fica encantado mesmo assim. No fim da semana, o dragão tem três cabeças e lhe deve dinheiro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卢多爵士照样乐不可支。不到周末，那条龙已经长了三个头，还欠了他钱。"
          }
        }
      }
    },
    "petition.ludo_old.r3" : {
      "comment" : "Petition ludo_old: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo richtet sich zu voller Größe auf, die nicht beträchtlich ist. „Es war eine sehr große Ziege.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo draws himself up to his full height, which is not much. “It was a very large goat.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo se yergue en toda su estatura, que no es mucha. «Era una cabra muy grande.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo se redresse de toute sa hauteur, ce qui n’est pas grand-chose. « C’était une très grosse chèvre. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo si drizza in tutta la sua statura, che non è molta. «Era una capra molto grossa.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サー・ルドは精いっぱい背筋を伸ばす。大した高さではない。「それはそれは大きな山羊だったのですぞ」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo se empertiga até a sua altura máxima, que não é grande coisa. “Era uma cabra muito grande.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卢多爵士把腰板挺到最直，个子也没高出多少。“那是一头非常大的山羊。”"
          }
        }
      }
    },
    "petition.ludo_old.text" : {
      "comment" : "Petition ludo_old (serLudo, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seid gegrüßt, {edler Herr|edle Herrin}! Ser Ludo kehrt zurück, älter und ein klein wenig weiser. Ich bringe Euch einen Zahn des Großen Drachen des Nordens, erschlagen von meiner eigenen Hand. Ich bitte nur, ihn in Eurem Saal aufzuhängen und jeden Abend die Geschichte zu erzählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hail, good my {lord|lady}! Ser Ludo returns, older and very slightly wiser. I bring you a tooth of the Great Dragon of the North, slain by my own hand. I ask only to hang it in your hall and tell the story nightly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Salud, {mi noble señor|mi noble señora}! Vuelve Ser Ludo, más viejo y un poquito más sabio. Le traigo un diente del Gran Dragón del Norte, muerto por mi propia mano. Solo pido colgarlo en su salón y contar la historia cada noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut à vous, {mon bon seigneur|ma bonne dame} ! Ser Ludo est de retour, plus vieux et très légèrement plus sage. Je vous apporte une dent du Grand Dragon du Nord, terrassé de ma propre main. Je ne demande qu’à la suspendre dans votre salle et à raconter l’histoire chaque soir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salute a voi, {mio nobile signore|mia nobile signora}! Ser Ludo ritorna, più vecchio e un tantino più saggio. Vi porto un dente del Grande Drago del Nord, ucciso di mia mano. Chiedo soltanto di appenderlo nel vostro salone e di raccontarne la storia ogni sera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはこれは、気高き城主殿！　サー・ルド、ただいま帰還いたしましたぞ。年を重ね、ほんのわずかに賢くなって。北の大竜の牙をお持ちしました。わたくし自らの手で討ち取ったもの。望みはただ、これを大広間に掛け、毎晩その話をすることのみ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve, {meu nobre senhor|minha nobre senhora}! Ser Ludo retorna, mais velho e um tantinho mais sábio. Trago um dente do Grande Dragão do Norte, abatido por minha própria mão. Peço apenas para pendurá-lo no seu salão e contar a história todas as noites."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "又见面了，尊贵的大人！卢多爵士回来了，老了些，也稍稍聪明了那么一点。本骑士为您带来北方巨龙的一颗牙，乃本骑士亲手所斩。只求把它挂在您的大厅里，每晚讲一遍这个故事。"
          }
        }
      }
    },
    "petition.ludo_returns.c1" : {
      "comment" : "Petition ludo_returns: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die große Laterne bezahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fund the great lantern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagar el gran farol"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Financer la grande lanterne"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanziare la grande lanterna"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きなランタンの費用を出す"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagar a grande lanterna"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出钱造大提灯"
          }
        }
      }
    },
    "petition.ludo_returns.c2" : {
      "comment" : "Petition ludo_returns: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte geht heim, Ser Ludo"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please go home, Ser Ludo"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, vuelva a casa, Ser Ludo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De grâce, rentrez chez vous, Ser Ludo"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi prego, tornate a casa, Ser Ludo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どうか故郷へ帰ってくれ、サー・ルド"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vá para casa, por favor, Ser Ludo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请回家吧，卢多爵士"
          }
        }
      }
    },
    "petition.ludo_returns.hint" : {
      "comment" : "Petition ludo_returns: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zehn Gold, um einen Narren zu beschäftigen und die Stadt zum Lachen zu bringen. Ich habe schon Schlimmeres ausgegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten gold to keep a fool busy and the town laughing. I have spent worse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diez monedas de oro para tener ocupado a un iluminado y al pueblo riendo. He gastado peor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dix pièces d’or pour occuper un illuminé et faire rire la ville. J’ai dépensé pire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieci monete d’oro per tenere occupato un matto e far ridere il borgo. Ho speso di peggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金貨10枚で、愚か者をひとり忙しくさせ、町を笑わせておけるのです。もっとひどい使い道をしたこともございます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dez moedas de ouro para manter um tolo ocupado e a cidade rindo. Já gastei com coisa pior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10金币，让一个傻瓜有事可做，让全镇有笑可乐。我花过更冤的钱。"
          }
        }
      }
    },
    "petition.ludo_returns.r1a" : {
      "comment" : "Petition ludo_returns: choice 1, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo schwenkt die ganze Nacht seine Laterne am Rand des Nebels. Zu allgemeinem Erstaunen stieben die Rußlinge davon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo waves his lantern at the edge of the fog all night. To everyone’s astonishment, the sootlings scatter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo agita su farol al borde de la niebla toda la noche. Para asombro de todos, los hollinejos se dispersan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo agite sa lanterne au bord du brouillard toute la nuit. À la stupeur générale, les fumerons se dispersent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo agita la sua lanterna al margine della nebbia per tutta la notte. Con stupore di tutti, i fuligginelli si disperdono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サー・ルドは夜通し、霧の際でランタンを振り回す。皆が驚いたことに、煤影が散っていく。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo agita a lanterna na beira da névoa a noite toda. Para espanto geral, os fuliginhos se dispersam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卢多爵士在雾的边缘挥了一整夜提灯。出乎所有人意料，煤影四散而逃。"
          }
        }
      }
    },
    "petition.ludo_returns.r1b" : {
      "comment" : "Petition ludo_returns: choice 1, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binnen Minuten brennt sein Federbusch. Er schwenkt die Laterne trotzdem weiter. So hat die Stadt noch nie gelacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Within minutes his plume is on fire. He keeps waving the lantern anyway. The town has never laughed so much."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pocos minutos se le prende fuego al penacho. Aun así, sigue agitando el farol. El pueblo nunca se ha reído tanto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En quelques minutes, son panache prend feu. Il continue quand même d’agiter la lanterne. La ville n’a jamais tant ri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In pochi minuti il suo pennacchio prende fuoco. Lui continua ad agitare la lanterna lo stesso. Il borgo non ha mai riso tanto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "たちまち兜の羽根飾りに火がつく。それでも彼はランタンを振り続ける。町がこれほど笑ったことはない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em poucos minutos, o penacho dele pega fogo. Ele continua agitando a lanterna assim mesmo. A cidade nunca riu tanto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没几分钟，他的盔缨就着了火。他照样挥着提灯。镇上从没笑得这么厉害过。"
          }
        }
      }
    },
    "petition.ludo_returns.r2" : {
      "comment" : "Petition ludo_returns: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er geht im Morgengrauen, den Helm unter dem Arm, und verspricht, mit einem Drachen wiederzukommen. Niemand weiß, ob das eine Drohung ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He leaves at dawn, helmet under his arm, promising to return with a dragon. Nobody can tell whether it is a threat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se marcha al alba, con el yelmo bajo el brazo, prometiendo volver con un dragón. Nadie sabe si es una amenaza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il part à l’aube, le casque sous le bras, en promettant de revenir avec un dragon. Personne ne sait dire si c’est une menace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte all’alba, l’elmo sottobraccio, promettendo di tornare con un drago. Nessuno sa dire se sia una minaccia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜明け、彼は兜を小脇に抱えて去っていく。竜を連れて戻ると約束して。脅しなのかどうか、誰にも分からない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele parte na alvorada, elmo debaixo do braço, prometendo voltar com um dragão. Ninguém sabe dizer se é uma ameaça."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他黎明时离开，头盔夹在腋下，许诺会带一条龙回来。没人说得清这算不算威胁。"
          }
        }
      }
    },
    "petition.ludo_returns.text" : {
      "comment" : "Petition ludo_returns (serLudo, follow-up of ludo_arrives): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Edler Herr|Edle Herrin}! Ich habe die Düsternis aus nächster Nähe studiert, aus einer Pfahlgrube heraus. Ich habe einen Plan: eine große Laterne an einer Stange, getragen von einem tapferen Ritter. Mir. Ich brauche zehn Gold für Öl und eine längere Stange."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good my {lord|lady}! I have studied the Gloom from very close, from inside a stake pit. I have a plan: a great lantern on a pole, carried by a brave knight. Me. I need ten gold of oil and a longer pole."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡{Mi noble señor|Mi noble señora}! He estudiado la Penumbra desde muy cerca, desde dentro de un foso de estacas. Tengo un plan: un gran farol en una pértiga, llevado por un valiente caballero. Yo. Necesito diez monedas de oro de aceite y una pértiga más larga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mon bon seigneur|Ma bonne dame} ! J’ai étudié la Pénombre de très près, depuis le fond d’une fosse à pieux. J’ai un plan : une grande lanterne au bout d’une perche, portée par un brave chevalier. Moi. Il me faut dix pièces d’or d’huile et une perche plus longue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio nobile signore|Mia nobile signora}! Ho studiato la Penombra da molto vicino, dall’interno di una fossa a pali. Ho un piano: una grande lanterna su una pertica, portata da un cavaliere valoroso. Me. Mi servono dieci monete d’oro d’olio e una pertica più lunga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気高き城主殿！　宵闇を、ごく間近から研究いたしましたぞ。杭穴の中から。策がございます。竿の先に大きなランタン、それを担ぐは勇敢なる騎士。わたくしです。油代に金貨10枚と、もっと長い竿をいただきたい。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu nobre senhor|Minha nobre senhora}! Estudei a Penumbra de muito perto, de dentro de um fosso de estacas. Tenho um plano: uma grande lanterna numa vara, carregada por um cavaleiro valente. Eu. Preciso de dez moedas de ouro de óleo e de uma vara mais comprida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尊贵的大人！本骑士已从极近处研究过暗霭——从一个尖桩坑里。本骑士有个计划：一盏挂在长杆上的大提灯，由一位勇敢的骑士扛着。就是本骑士。需要10金币的灯油，外加一根更长的杆子。"
          }
        }
      }
    },
    "petition.ludo_tourney.c1" : {
      "comment" : "Petition ludo_tourney: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltet das Turnier ab"
          }
        },
        "en" : {
