          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mandate Madre Hesper"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘスパーを遣わそう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mandem a Madre Hesper"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "派赫斯珀嬷嬷去"
          }
        }
      }
    },
    "petition.haunted_cellar.c3" : {
      "comment" : "Petition haunted_cellar: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratten. Kauft eine Katze."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rats. Buy a cat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratas. Cómprese un gato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des rats. Achetez un chat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topi. Comprate un gatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼠だ。猫を飼うといい"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratos. Arranje um gato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是老鼠。买只猫吧。"
          }
        }
      }
    },
    "petition.haunted_cellar.hint" : {
      "comment" : "Petition haunted_cellar: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratten flüstern nicht. Ich auch nicht, wenn es um Dinge der Flamme geht. Schickt Mutter Hesper."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rats do not whisper. Neither do I, about matters of the Flame. Send Mother Hesper."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ratas no susurran. Yo tampoco, en asuntos de la Llama. Mande a Madre Hesper."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rats ne chuchotent pas. Moi non plus, quand il s’agit de la Flamme. Envoyez Mère Hesper."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I topi non sussurrano. E nemmeno io, quando si tratta di cose della Fiamma. Mandate Madre Hesper."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼠はささやきません。炎にかかわることなら、わたくしも声を潜めはいたしません。ここはヘスパーの出番です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rato não sussurra. Eu também não, quando o assunto é a Chama. Mande a Madre Hesper."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "老鼠不会说悄悄话。圣焰的事，我也从不说悄悄话。派赫斯珀嬷嬷去。"
          }
        }
      }
    },
    "petition.haunted_cellar.r1a" : {
      "comment" : "Petition haunted_cellar: choice 1, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wachen finden ihren Bruder, seit dem Frühjahr als verloren gezählt, hinter den Fässern. Er kam im Morgengrauen durchs Schlundtor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The guards find her brother, counted lost in spring, sitting behind the barrels. He came in by the Throat gate at dawn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los guardias encuentran detrás de los barriles a su hermano, dado por perdido en primavera. Entró al alba por la puerta de la Garganta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les gardes trouvent son frère, compté parmi les perdus au printemps, assis derrière les tonneaux. Il est entré par la porte de la Gorge à l’aube."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le guardie trovano suo fratello, contato tra i perduti in primavera, seduto dietro le botti. È entrato all’alba dalla porta della Gola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "衛兵たちは、樽の陰に座っている彼女の兄を見つける。春に、失われた者として数えられた兄だ。夜明けに喉谷の門から入ってきたのだという。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os guardas encontram o irmão dela, dado como perdido na primavera, sentado atrás dos barris. Ele entrou pelo portão da Garganta na alvorada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卫兵们在酒桶后面找到了她那位春天就被记作未归的兄弟。他是黎明时从喉谷门进来的。"
          }
        }
      }
    },
    "petition.haunted_cellar.r1b" : {
      "comment" : "Petition haunted_cellar: choice 1, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wachen finden eine Decke, eine kalte Lampe und niemanden. In dieser Nacht kommt der Nebel weiter als je zuvor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The guards find a blanket, a cold lamp and nobody. That night the fog comes further than ever."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los guardias encuentran una manta, una lámpara fría y a nadie. Esa noche la niebla llega más lejos que nunca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les gardes trouvent une couverture, une lampe froide, et personne. Cette nuit-là, le brouillard vient plus loin que jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le guardie trovano una coperta, una lampada fredda e nessuno. Quella notte la nebbia si spinge più lontano che mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "衛兵が見つけたのは、毛布が一枚と、火の消えた灯りがひとつ。人はいない。その夜、霧はかつてなく遠くまで来る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os guardas encontram um cobertor, uma lamparina fria e ninguém. Naquela noite, a névoa chega mais longe do que nunca."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卫兵们只找到一条毯子、一盏冷灯，没有人。那一夜，雾比以往任何时候都来得更远。"
          }
        }
      }
    },
    "petition.haunted_cellar.r2" : {
      "comment" : "Petition haunted_cellar: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper geht allein hinunter und kommt mit dem Bruder der Frau herauf, seit dem Frühjahr als verloren gezählt. Er sagt nur: „Eine blaue Tür.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper goes down alone and comes up with the woman’s brother, counted lost in spring. All he says is: “A blue door.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper baja sola y sube con el hermano de la mujer, dado por perdido en primavera. Lo único que dice es: «Una puerta azul.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper descend seule et remonte avec le frère de la femme, compté parmi les perdus au printemps. Il dit seulement : « Une porte bleue. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper scende da sola e risale con il fratello della donna, contato tra i perduti in primavera. Dice soltanto: «Una porta blu.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘスパーはひとりで下りていき、女の兄を連れて上がってくる。春に、失われた者として数えられた兄だ。彼が口にするのは、ひと言だけ。「青い扉」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper desce sozinha e sobe com o irmão da mulher, dado como perdido na primavera. Tudo o que ele diz é: “Uma porta azul.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赫斯珀独自下去，上来时带着那女人的兄弟，春天就被记作未归的那一个。他只说了一句：“一扇蓝门。”"
          }
        }
      }
    },
    "petition.haunted_cellar.r3" : {
      "comment" : "Petition haunted_cellar: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin leiht ihr die Küchenkatze. Die Katze geht hinunter, kommt sehr schnell wieder herauf und weigert sich, darüber zu reden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin lends her the kitchen cat. The cat goes down, comes up very fast, and refuses to discuss it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin le presta el gato de la cocina. El gato baja, sube muy deprisa y se niega a hablar del asunto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin lui prête le chat de la cuisine. Le chat descend, remonte très vite et refuse d’en parler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin le presta il gatto della cucina. Il gatto scende, risale molto in fretta, e si rifiuta di parlarne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タムシンが台所の猫を貸す。猫は下りていき、ものすごい速さで上がってきて、そのことについては話そうとしない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamsin empresta a ela o gato da cozinha. O gato desce, sobe muito depressa e se recusa a falar do assunto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "塔姆辛把厨房的猫借给了她。猫下去了，又飞快地蹿了上来，对此事拒不置评。"
          }
        }
      }
    },
    "petition.haunted_cellar.text" : {
      "comment" : "Petition haunted_cellar (townswoman): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, nachts kratzt etwas in meinem Keller, und die Kerzen dort unten gehen von selbst aus. Mein Mann sagt, Ratten. Ratten flüstern nicht. Ich will Soldaten, oder einen Priester, oder beides."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, something scratches in my cellar at night, and the candles down there go out by themselves. My husband says rats. Rats do not whisper. I want soldiers, or a priest, or both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, algo rasca en mi sótano por las noches, y las velas de allá abajo se apagan solas. Mi marido dice que son ratas. Las ratas no susurran. Quiero soldados, o un sacerdote, o las dos cosas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, quelque chose gratte dans ma cave la nuit, et les chandelles, en bas, s’éteignent toutes seules. Mon mari dit que ce sont des rats. Les rats ne chuchotent pas. Je veux des soldats, ou un prêtre, ou les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, di notte qualcosa gratta nella mia cantina, e laggiù le candele si spengono da sole. Mio marito dice che sono topi. I topi non sussurrano. Voglio dei soldati, o un prete, o tutti e due."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、夜になると、うちの地下室で何かが引っかく音がして、下の蝋燭がひとりでに消えるんです。夫は鼠だと言います。鼠はささやいたりしません。兵隊さんか、司祭様か、両方をお願いします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, alguma coisa arranha no meu porão à noite, e as velas lá embaixo se apagam sozinhas. O meu marido diz que são ratos. Rato não sussurra. Quero soldados, ou um sacerdote, ou os dois."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，我家地窖里夜里有东西在挠，下面的蜡烛自己就灭了。我丈夫说是老鼠。老鼠可不会说悄悄话。我要士兵，或者祭司，或者都要。"
          }
        }
      }
    },
    "petition.herald_alone.c1" : {
      "comment" : "Petition herald_alone: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Öl ausgießen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour out the oil"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derramar el aceite"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verser l’huile"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versare l’olio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "油を注ぐ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derramar o óleo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "倒出灯油"
          }
        }
      }
    },
    "petition.herald_alone.c2" : {
      "comment" : "Petition herald_alone: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keinen Tropfen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not a single drop"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni una sola gota"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas une seule goutte"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neanche una goccia"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一滴たりとも渡さない"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem uma única gota"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一滴也不给"
          }
        }
      }
    },
    "petition.herald_alone.hint" : {
      "comment" : "Petition herald_alone: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Dunkel zu bezahlen ist, wie einen Streuner zu füttern. Er kommt wieder und bringt Freunde mit. Keinen Tropfen, {mein Herr|meine Herrin}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paying the dark is like feeding a stray. It comes back, and it brings friends. Not a drop, my {lord|lady}."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagarle a la oscuridad es como dar de comer a un perro callejero. Vuelve, y trae amigos. Ni una gota, {mi señor|mi señora}."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payer l’obscurité, c’est comme nourrir un chien errant. Il revient, et il amène ses amis. Pas une goutte, {monseigneur|madame}."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagare il buio è come sfamare un randagio. Torna, e porta gli amici. Neanche una goccia, {mio signore|mia signora}."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "闇に払うのは、野良犬に餌をやるようなもの。また来ますし、仲間も連れてきます。一滴もなりません、城主様。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagar o escuro é como alimentar um vira-lata. Ele volta, e traz os amigos. Nem uma gota, {meu senhor|minha senhora}."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给黑暗付钱，就像喂野狗。它会回来，还会带上同伴。一滴也别给，大人。"
          }
        }
      }
    },
    "petition.herald_alone.r1" : {
      "comment" : "Petition herald_alone: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Dämmerung fließt Lampenöl für sechzig Gold über den Grund des Schlunds. Im Morgengrauen ist jede Rußspur fort. Den Wachen gefällt die Stille nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At dusk sixty gold of lamp oil runs out over the Throat’s floor. At dawn every soot track is gone. The guards dislike the quiet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al anochecer, aceite por valor de sesenta monedas de oro corre por el fondo de la Garganta. Al alba no queda ni una huella de hollín. A los guardias no les gusta la calma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au crépuscule, soixante pièces d’or d’huile à lampe coulent sur le fond de la Gorge. À l’aube, toutes les traces de suie ont disparu. Les gardes n’aiment pas ce silence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al crepuscolo sessanta monete d’oro di olio da lampada si spargono sul fondo della Gola. All’alba ogni traccia di fuliggine è sparita. Alle guardie quella quiete non piace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日暮れに、金貨60枚分の灯油が喉谷の底へ流れていく。夜明けには、煤の足跡がひとつ残らず消えている。衛兵たちは、その静けさを嫌う。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao crepúsculo, sessenta moedas de ouro em óleo escorrem pelo fundo da Garganta. Na alvorada, não resta um só rastro de fuligem. Os guardas não gostam do silêncio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黄昏时，价值60金币的灯油流过喉谷底。黎明时，所有煤灰足迹都不见了。卫兵们不喜欢这份安静。"
          }
        }
      }
    },
    "petition.herald_alone.r2" : {
      "comment" : "Petition herald_alone: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Dann holt er es sich aus der Asche“, sagt der Herold. Im Staub des Saals hinterlässt er keine Fußspuren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Then he will take it from the ashes,” says the herald. In the dust of the hall he leaves no footprints."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Entonces lo tomará de las cenizas», dice el heraldo. En el polvo del salón no deja huellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Alors il se paiera sur les cendres », dit le héraut. Dans la poussière de la salle, il ne laisse aucune empreinte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Allora se lo prenderà dalle ceneri», dice l’araldo. Nella polvere del salone non lascia impronte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ならば王は、灰の中から取り立てられましょう」と伝令は言う。大広間のほこりに、その足跡はひとつも残らない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Então ele vai tirá-lo das cinzas”, diz o arauto. Na poeira do salão, ele não deixa pegadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“那他就从灰烬里去取。”传令官说。大厅的尘土上，他没有留下一个脚印。"
          }
        }
      }
    },
    "petition.herald_alone.text" : {
      "comment" : "Petition herald_alone (herald, story day 17): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der König unter der Düsternis grüßt {den Erben des Diebes an seinem|die Erbin des Diebes an ihrem} geliehenen Feuer. Die graue Laterne ist nicht hier, sieht er. Also verlangt er Geringeres: Lampenöl für sechzig Gold, bei Dämmerung im Schlund ausgegossen. Gießt es aus, und Eure Stadt schläft drei Nächte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The King beneath the Gloom greets the heir of the thief by {his|her} borrowed fire. The grey lantern is not here, he sees. So he asks less: sixty gold of lamp oil, poured on the Throat’s floor at dusk. Pour it, and your town sleeps three nights."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Rey bajo la Penumbra saluda {al farolero|a la farolera}. Ve que la mujer del farol gris no está aquí. Así que pide menos: aceite de lámpara por valor de sesenta monedas de oro, derramado al anochecer en el fondo de la Garganta. Derrámelo, y su pueblo dormirá tres noches."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Roi sous la Pénombre salue {le|la} lampiste. La femme à la lanterne grise n’est pas ici, il le voit. Il demande donc moins : soixante pièces d’or d’huile à lampe, versées au fond de la Gorge au crépuscule. Versez-la, et votre ville dormira trois nuits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Re sotto la Penombra saluta {il lampionaio|la lampionaia}. La donna con la lanterna grigia non è qui, egli vede. Perciò chiede meno: olio da lampada per sessanta monete d’oro, versato sul fondo della Gola al crepuscolo. Versatelo, e il vostro borgo dormirà tre notti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宵闇の下の王より、灯り番にご挨拶申し上げます。灰色のランタンの女はここにはおらぬと、王はお見通しです。ゆえに、望みは控えめに。金貨60枚分の灯油を、日暮れに喉谷の底へ注ぐこと。注げば、そちらの町は三晩眠れましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rei sob a Penumbra saúda {o acendedor de lampiões|a acendedora de lampiões}. A mulher da lanterna cinzenta não está aqui, ele vê. Então pede menos: sessenta moedas de ouro em óleo de lamparina, derramado no fundo da Garganta ao crepúsculo. Derrame, e a sua cidade dorme três noites."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗霭之下的王，向点灯人致意。他看见，那个提灰灯的女人不在这里。所以他要得少些：价值60金币的灯油，黄昏时倒在喉谷底。倒了它，您的小镇便可安睡三夜。"
          }
        }
      }
    },
    "petition.herald_demand.c1" : {
      "comment" : "Petition herald_demand: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nehmt sie mit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take her"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llévesela"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez-la"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portatela via"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連れていけばいい"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve-a"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把她带走"
          }
        }
      }
    },
    "petition.herald_demand.c2" : {
      "comment" : "Petition herald_demand: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie bleibt. Sagt ihm das."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She stays. Tell him so."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ella se queda. Dígaselo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle reste. Dites-le-lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lei resta. Diteglielo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彼女は残る。そう伝えてくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela fica. Diga isso a ele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她留下。就这样告诉他。"
          }
        }
      }
    },
    "petition.herald_demand.c3" : {
      "comment" : "Petition herald_demand: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll er es doch versuchen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell him to come and try"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que venga a intentarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu’il vienne donc essayer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Che venga a provarci"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来てみるがいい、と伝えてくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que ele venha tentar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "叫他自己来试试"
          }
        }
      }
    },
    "petition.herald_demand.hint" : {
      "comment" : "Petition herald_demand: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Haus, das seine Gäste ausliefert, hat bald keine mehr. Und wenn er sie will, brauchen wir sie. Lehnt ab. Höflich, wenn es sein muss."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A house that hands over its guests soon has none. And if he wants her, we need her. Refuse him. Politely, if you must."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una casa que entrega a sus huéspedes pronto se queda sin ellos. Y si él la quiere, es que la necesitamos. Niéguese. Con cortesía, si hace falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une maison qui livre ses hôtes n’en a bientôt plus. Et s’il la veut, c’est que nous avons besoin d’elle. Refusez. Poliment, s’il le faut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una casata che consegna i suoi ospiti presto non ne ha più. E se lui la vuole, a noi serve. Rifiutate. Con garbo, se proprio dovete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客人を差し出す家には、じきに客が来なくなります。それに、あちらが欲しがるのなら、こちらにも入り用なのです。お断りなさいませ。必要なら、丁重に。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma casa que entrega os seus hóspedes logo não tem mais nenhum. E, se ele a quer, precisamos dela. Recuse. Com educação, se for preciso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交出客人的家族，很快就不会再有客人。何况他想要她，我们就更需要她。拒绝他。非要客气，就客气地拒绝。"
          }
        }
      }
    },
    "petition.herald_demand.r1" : {
      "comment" : "Petition herald_demand: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren erhebt sich, bevor jemand sie berühren kann. Sie nimmt ihre graue Laterne ab, geht neben dem Herold hinaus und blickt nicht zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren rises before anyone can touch her. She takes down her grey lantern, walks out beside the herald and does not look back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren se levanta antes de que nadie pueda tocarla. Descuelga su farol gris, sale junto al heraldo y no mira atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren se lève avant que quiconque puisse la toucher. Elle décroche sa lanterne grise, sort aux côtés du héraut et ne se retourne pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren si alza prima che qualcuno possa toccarla. Stacca la sua lanterna grigia, esce accanto all’araldo e non si volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰かが触れるより先に、セレンが立ち上がる。灰色のランタンを下ろし、伝令と並んで出ていき、振り返らない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren se levanta antes que alguém possa tocá-la. Tira a lanterna cinzenta do gancho, sai ao lado do arauto e não olha para trás."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没等任何人碰到她，塞伦已经站起身。她取下灰提灯，与传令官并肩走了出去，没有回头。"
          }
        }
      }
    },
    "petition.herald_demand.r2" : {
      "comment" : "Petition herald_demand: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die kalten Augen des Herolds ruhen lange auf Euch. „Er wird sich an {den Erben|die Erbin} des Diebes erinnern.“ In dieser Nacht drängt die Düsternis härter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The herald’s cold eyes rest on you a long moment. “He will remember the heir of the thief.” That night the Gloom comes harder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ojos fríos del heraldo se posan en usted un largo momento. «Él recordará {al farolero|a la farolera}.» Esa noche la Penumbra aprieta más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les yeux froids du héraut s’attardent longuement sur vous. « Il se souviendra {du|de la} lampiste. » Cette nuit-là, la Pénombre frappe plus fort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli occhi freddi dell’araldo restano a lungo su di voi. «Egli si ricorderà {del lampionaio|della lampionaia}.» Quella notte la Penombra preme più forte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伝令の冷たい目が、長いあいだこちらに留まる。「王は灯り番を覚えておかれましょう」。その夜、宵闇はいっそう激しく押し寄せる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os olhos frios do arauto pousam em você por um longo momento. “Ele vai se lembrar {do acendedor de lampiões|da acendedora de lampiões}.” Naquela noite a Penumbra vem com mais força."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "传令官冰冷的目光在你身上停了许久。“他会记住这个点灯人。”那一夜，暗霭攻得更凶了。"
          }
        }
      }
    },
    "petition.herald_demand.r3" : {
      "comment" : "Petition herald_demand: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip lacht zuerst, dann die Wachen, dann der ganze Saal. Der Herold geht schweigend. In dieser Nacht kommt die Düsternis mit aller Wucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip laughs first, then the guards, then the whole hall. The herald leaves in silence. That night the Gloom comes hard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero ríe Pip, luego los guardias, luego todo el salón. El heraldo se marcha en silencio. Esa noche la Penumbra llega con fuerza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip rit le premier, puis les gardes, puis toute la salle. Le héraut sort en silence. Cette nuit-là, la Pénombre frappe fort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip ride per primo, poi le guardie, poi tutto il salone. L’araldo se ne va in silenzio. Quella notte la Penombra arriva con tutta la sua forza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初にピップが笑い、次に衛兵が、それから大広間じゅうが笑う。伝令は黙って去る。その夜、宵闇は容赦なく押し寄せる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip ri primeiro, depois os guardas, depois o salão inteiro. O arauto sai em silêncio. Naquela noite a Penumbra vem com força."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "皮普先笑了，接着是卫兵，然后是整个大厅。传令官默默离去。那一夜，暗霭来势汹汹。"
          }
        }
      }
    },
    "petition.herald_demand.text" : {
      "comment" : "Petition herald_demand (herald, story day 17): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der König unter der Düsternis grüßt {den Erben des Diebes an seinem|die Erbin des Diebes an ihrem} geliehenen Feuer. Er will nur die Frau mit der grauen Laterne. Gebt sie mir, und drei Nächte lang wird Euer Städtchen schlafen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The King beneath the Gloom greets the heir of the thief by {his|her} borrowed fire. He wants only the woman with the grey lantern. Give her to me, and for three nights your little town will sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Rey bajo la Penumbra saluda {al farolero|a la farolera} en su silla prestada. Solo quiere a la mujer del farol gris. Entréguemela, y durante tres noches su pueblecito dormirá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Roi sous la Pénombre salue {le|la} lampiste sur son siège d’emprunt. Il ne veut que la femme à la lanterne grise. Donnez-la-moi, et trois nuits durant, votre petite ville dormira."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Re sotto la Penombra saluta {il lampionaio|la lampionaia} sulla sua sedia presa in prestito. Egli vuole soltanto la donna con la lanterna grigia. Datela a me, e per tre notti il vostro piccolo borgo dormirà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宵闇の下の王より、借り物の椅子に座る灯り番に、ご挨拶申し上げます。王がお望みなのは、灰色のランタンの女ただひとり。あれをお渡しくだされば、三晩のあいだ、そちらの小さな町は眠れましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rei sob a Penumbra saúda {o acendedor de lampiões|a acendedora de lampiões} na cadeira que lhe emprestaram. Ele quer apenas a mulher da lanterna cinzenta. Entregue-a a mim, e por três noites a sua cidadezinha vai dormir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗霭之下的王，向坐在借来椅子上的点灯人致意。他只要那个提灰灯的女人。把她交给我，您的小镇便可安睡三夜。"
          }
        }
      }
    },
    "petition.hesper_bowl.c1" : {
      "comment" : "Petition hesper_bowl: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schale kaufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy the bowl"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprar el cuenco"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acheter la coupe"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprare la coppa"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供物皿を買う"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprar a bacia"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "买下祭钵"
          }
        }
      }
    },
    "petition.hesper_bowl.c2" : {
      "comment" : "Petition hesper_bowl: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Flamme brennt gut genug"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Flame burns well enough"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Llama arde bastante bien"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Flamme brûle bien assez"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Fiamma arde già abbastanza"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "炎は、今のままで十分燃えています"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Chama já arde o bastante"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圣焰烧得够好了"
          }
        }
      }
    },
    "petition.hesper_bowl.hint" : {
      "comment" : "Petition hesper_bowl: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreißig Gold für ein Lied bei Sonnenaufgang. Die Flamme brannte vor der Schale und wird es auch danach tun. Behaltet das Gold."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thirty gold for a song at sunrise. The Flame burned before the bowl and will after it. Keep the gold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treinta monedas de oro por una canción al amanecer. La Llama ardía antes del cuenco y arderá después. Guárdese el oro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente pièces d’or pour un chant au lever du soleil. La Flamme brûlait avant la coupe et brûlera après. Gardez l’or."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenta monete d’oro per un canto all’alba. La Fiamma ardeva prima della coppa e arderà dopo. Tenete l’oro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日の出の歌一曲に金貨30枚。炎は皿より前から燃えておりましたし、後も燃えます。金はお手元に。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinta moedas de ouro por uma canção ao nascer do sol. A Chama ardia antes da bacia e vai arder depois dela. Guarde o ouro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30金币，换日出时的一首歌。祭钵之前圣焰就在燃烧，之后也会。留着金子吧。"
          }
        }
      }
    },
    "petition.hesper_bowl.r1" : {
      "comment" : "Petition hesper_bowl: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Morgengrauen glänzt die neue Schale auf dem Altar, und Hesper singt den alten Segen über das Tal. Sogar Brannock nimmt den Helm ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At dawn the new bowl gleams on the altar, and Hesper sings the old blessing over the valley. Even Brannock takes off his helmet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al alba el cuenco nuevo reluce en el altar, y Hesper canta la vieja bendición sobre el valle. Hasta Brannock se quita el yelmo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À l’aube, la nouvelle coupe brille sur l’autel, et Hesper chante l’ancienne bénédiction sur la vallée. Même Brannock ôte son casque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All’alba la coppa nuova brilla sull’altare, e Hesper canta l’antica benedizione sulla valle. Perfino Brannock si toglie l’elmo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜明け、新しい皿が祭壇に輝き、ヘスパーが谷の上に古い祝福を歌う。ブラノックでさえ兜を脱ぐ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na alvorada, a bacia nova reluz no altar, e Hesper canta a velha bênção sobre o vale. Até Brannock tira o elmo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黎明时，新祭钵在祭坛上闪闪发亮，赫斯珀为河谷唱起古老的祝祷。连布兰诺克都摘下了头盔。"
          }
        }
      }
    },
    "petition.hesper_bowl.r2" : {
      "comment" : "Petition hesper_bowl: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper verneigt sich. „Sie brennt“, stimmt sie zu. „Das ist nicht dasselbe wie segnen.“ Sie erwähnt es nicht wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper bows. “It burns,” she agrees. “That is not the same as blessing.” She does not mention it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper se inclina. «Arde», concede. «No es lo mismo que bendecir.» No vuelve a mencionarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper s’incline. « Elle brûle, admet-elle. Ce n’est pas la même chose que bénir. » Elle n’en reparle plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper si inchina. «Arde», ammette. «Non è la stessa cosa che benedire.» Non ne parla più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘスパーは一礼する。「燃えてはいます」と認める。「祝福するのとは、同じではありません」。二度とその話はしない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper se curva. “Arde”, concorda. “Mas arder não é o mesmo que abençoar.” Ela não volta a falar disso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赫斯珀躬身。“它在燃烧，”她承认，“可燃烧不等于祝福。”此后她再没提起。"
          }
        }
      }
    },
    "petition.hesper_bowl.text" : {
      "comment" : "Petition hesper_bowl (hesper): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Erbe|Erbin} des Hauses, die alte Opferschale der Flamme ist in der Kälte gesprungen. Eine neue aus Bronze kostet dreißig Gold. Mit ihr kann die Kapelle das Tal an jedem Morgen segnen, wie in Aldrics Wacht. Ohne sie brennt die Flamme nur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heir of the house, the Flame’s old offering bowl cracked in the cold. A new one in bronze costs thirty gold. With it, the chapel can bless the valley at every dawn, as it did in Aldric’s watch. Without it, the Flame only burns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Hijo|Hija} de la casa, el viejo cuenco de ofrendas de la Llama se rajó con el frío. Uno nuevo de bronce cuesta treinta monedas de oro. Con él, la capilla puede bendecir el valle cada amanecer, como en la vigilia de Aldric. Sin él, la Llama solo arde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfant de la maison, la vieille coupe d’offrande de la Flamme s’est fendue dans le froid. Une neuve, en bronze, coûte trente pièces d’or. Avec elle, la chapelle peut bénir la vallée à chaque aube, comme sous la veille d’Aldric. Sans elle, la Flamme ne fait que brûler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Figlio|Figlia} della casa, l’antica coppa delle offerte della Fiamma si è incrinata col freddo. Una nuova di bronzo costa trenta monete d’oro. Con essa la cappella può benedire la valle a ogni alba, come ai tempi di Aldric. Senza, la Fiamma arde e basta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家の御子、炎の古い供物皿が、寒さで割れました。青銅の新しいものは金貨30枚。それがあれば、アルドリック様の代のように、礼拝堂は毎朝谷を祝福できます。なければ、炎はただ燃えるだけです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Filho|Filha} da casa, a velha bacia de oferendas da Chama rachou com o frio. Uma nova, de bronze, custa trinta moedas de ouro. Com ela, a capela pode abençoar o vale a cada alvorada, como fazia na vigília de Aldric. Sem ela, a Chama apenas arde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族之子，圣焰的旧祭钵在严寒中裂了。新铸一只青铜的要30金币。有了它，礼拜堂便能每日黎明为河谷祈福，一如奥德里克大人守城之时。没有它，圣焰便只是燃烧。"
          }
        }
      }
    },
    "petition.hesper_giant.c1" : {
      "comment" : "Petition hesper_giant: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltet die Wache allein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the vigil alone"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vele usted sola"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez la veillée seule"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vegliate da sola"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "祈りは、お一人でお願いします"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça a vigília sozinha"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您独自守夜吧"
          }
        }
      }
    },
    "petition.hesper_giant.c2" : {
      "comment" : "Petition hesper_giant: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruft die Stadt in die Kapelle"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Call the town to the chapel"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llame al pueblo a la capilla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appelez la ville à la chapelle"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiamate il borgo in cappella"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "町の皆を礼拝堂に集めてください"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chame a cidade à capela"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把全镇召到礼拜堂"
          }
        }
      }
    },
    "petition.hesper_giant.c3" : {
      "comment" : "Petition hesper_giant: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht der Stadt keine Angst"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not frighten the town"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No asuste al pueblo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’effrayez pas la ville"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non spaventate il borgo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "町を怖がらせないでください"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não assuste a cidade"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别吓着镇上的人"
          }
        }
      }
    },
    "petition.hesper_giant.hint" : {
      "comment" : "Petition hesper_giant: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Flamme hat sich schon geirrt, aber nie in einer solchen Nacht. Lasst sie wachen und spart die Kerzen für später."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Flame has been wrong before, never on a night like this. Let her keep her vigil, and save the candles for later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Llama se ha equivocado antes, nunca en una noche así. Déjela velar, y guarde las velas para después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Flamme s’est déjà trompée, jamais une nuit comme celle-ci. Laissez-la veiller, et gardez les chandelles pour plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Fiamma si è già sbagliata, mai in una notte come questa. Lasciatela vegliare, e tenete le candele per dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "炎が外れたことはございます。ですが、こんな夜に外れたことはありません。祈りはあの方お一人にお任せして、蝋燭は後のために取っておきましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Chama já se enganou antes, nunca numa noite como esta. Deixe que ela vele, e guarde as velas para depois."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圣焰从前也错过，但从没在这样的夜里错过。让她守夜吧，蜡烛留着以后用。"
          }
        }
      }
    },
    "petition.hesper_giant.r1" : {
      "comment" : "Petition hesper_giant: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie verneigt sich und kehrt zur Flamme zurück. Die ganze Nacht rührt sich ihr Schatten nicht, nicht einmal, als der Boden zu beben beginnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She bows and returns to the Flame. All night her shadow does not move, not even when the ground begins to shake."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se inclina y vuelve junto a la Llama. En toda la noche su sombra no se mueve, ni siquiera cuando el suelo empieza a temblar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle s’incline et retourne auprès de la Flamme. De toute la nuit, son ombre ne bouge pas, pas même quand le sol se met à trembler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si inchina e torna alla Fiamma. Per tutta la notte la sua ombra non si muove, nemmeno quando la terra comincia a tremare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘスパーは一礼して炎のもとへ戻る。夜通し、その影は動かない。大地が揺れ始めても。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela se curva e volta para a Chama. A noite inteira a sombra dela não se move, nem quando o chão começa a tremer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她躬身行礼，回到圣焰旁。整整一夜，她的影子一动不动，连大地开始震动时也没有。"
          }
        }
      }
    },
    "petition.hesper_giant.r2" : {
      "comment" : "Petition hesper_giant: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zur Dämmerung ist die Kapelle übervoll. Hundert Kerzen brennen vor dem Altar, und einen Abend lang hat niemand im Tal Angst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By dusk the chapel overflows. A hundred candles burn before the altar, and for one evening nobody in the valley is afraid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al anochecer la capilla rebosa. Cien velas arden ante el altar, y por una noche nadie en el valle tiene miedo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au crépuscule, la chapelle déborde. Cent chandelles brûlent devant l’autel, et pour un soir, personne dans la vallée n’a peur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al crepuscolo la cappella trabocca. Cento candele ardono davanti all’altare, e per una sera nessuno nella valle ha paura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日暮れには礼拝堂があふれる。祭壇の前に百本の蝋燭がともり、ひと晩だけ、谷の誰もおびえずにいる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao crepúsculo, a capela transborda. Cem velas ardem diante do altar, e por uma noite ninguém no vale tem medo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黄昏时，礼拜堂里挤得满满当当。祭坛前燃着上百支蜡烛，这一晚，河谷里没有一个人害怕。"
          }
        }
      }
    },
    "petition.hesper_giant.r3" : {
      "comment" : "Petition hesper_giant: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie senkt den Blick. „Wie Ihr sagt.“ Als in der Nacht der Boden bebt, erfährt die Stadt es vom Boden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She lowers her eyes. “As you say.” That night, when the ground shakes, the town hears of it from the ground."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja la mirada. «Como usted diga.» Esa noche, cuando tiembla el suelo, el pueblo se entera por el suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle baisse les yeux. « Comme vous voudrez. » Cette nuit-là, quand le sol tremble, la ville l’apprend par le sol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbassa gli occhi. «Come dite voi.» Quella notte, quando la terra trema, il borgo lo viene a sapere dalla terra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘスパーは目を伏せる。「仰せのままに」。その夜、大地が揺れたとき、町はそれを大地から知る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela baixa os olhos. “Como {o senhor|a senhora} quiser.” Naquela noite, quando o chão treme, a cidade fica sabendo pelo próprio chão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她垂下眼。“就依您。”那一夜大地震动时，镇上是从大地那里得知的。"
          }
        }
      }
    },
    "petition.hesper_giant.text" : {
      "comment" : "Petition hesper_giant (hesper, story day 10): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Flamme brannte im Morgengrauen schwarz, {Erbe|Erbin} des Hauses, drei Atemzüge lang. Das tat sie schon einmal, in der Nacht, als die äußere Linie fiel, in Burgherrin Ysmays Wacht. Heute Nacht geht etwas Schweres durch die Düsternis. Lasst mich Wache halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Flame burned black at dawn, heir of the house, for the space of three breaths. It did that once before, the night the outer line fell, in Lady Ysmay’s watch. Something heavy walks in the Gloom tonight. Let me keep a vigil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Llama ardió negra al alba, {hijo|hija} de la casa, lo que duran tres respiraciones. Ya lo hizo una vez, la noche en que cayó la línea exterior, en la vigilia de lady Ysmay. Esta noche algo pesado camina por la Penumbra. Déjeme velar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Flamme est devenue noire à l’aube, enfant de la maison, le temps de trois souffles. Elle l’a fait une fois déjà, la nuit où la ligne extérieure est tombée, sous la veille de dame Ysmay. Quelque chose de lourd marche dans la Pénombre cette nuit. Laissez-moi tenir une veillée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All’alba la Fiamma è arsa nera, {figlio|figlia} della casa, per il tempo di tre respiri. Era già successo una volta, la notte in cui cadde la linea esterna, ai tempi di Lady Ysmay. Stanotte qualcosa di pesante cammina nella Penombra. Lasciatemi vegliare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜明けに、炎が黒く燃えました、家の御子。三つ息をするあいだ。以前にも一度ありました。イズメイ様の代、外の防衛線が落ちた夜のことです。今夜、何か重いものが宵闇を歩きます。夜通しの祈りを捧げさせてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Chama ardeu negra na alvorada, {filho|filha} da casa, pelo tempo de três respirações. Fez isso uma vez antes, na noite em que a linha externa caiu, na vigília de Lady Ysmay. Algo pesado anda pela Penumbra esta noite. Deixe-me velar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黎明时，圣焰烧成了黑色，家族之子，足有三次呼吸那么久。它从前这样过一次，就在外防线失守的那一夜，伊斯梅大人守城之时。今夜有沉重的东西在暗霭中行走。请让我守夜。"
          }
        }
      }
    },
    "petition.keep_window.c1" : {
      "comment" : "Petition keep_window: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pflegt den Brauch"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the custom"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga la costumbre"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprenez la coutume"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprendete l’usanza"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慣わしを守りましょう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter o costume"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重拾这个规矩"
          }
        }
      }
    },
    "petition.keep_window.c2" : {
      "comment" : "Petition keep_window: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir brauchen jedes Licht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We need every light"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitamos toda la luz"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nous faut toutes les lumières"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci serve ogni luce"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灯りは一つ残らず要ります"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisamos de cada luz"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们需要每一盏灯"
          }
        }
      }
    },
    "petition.keep_window.hint" : {
      "comment" : "Petition keep_window: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bräuche kosten nichts, und Soldaten merken sich, wer sie pflegt. Pflegt ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Customs cost nothing, and soldiers notice who keeps them. Keep it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las costumbres no cuestan nada, y los soldados se fijan en quién las mantiene. Manténgala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les coutumes ne coûtent rien, et les soldats remarquent qui les respecte. Reprenez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le usanze non costano niente, e i soldati notano chi le rispetta. Riprendetela."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慣わしに金はかかりません。そして兵は、誰がそれを守るかを見ております。お守りになるべきです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costumes não custam nada, e os soldados reparam em quem os mantém. Mantenha-o."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "规矩不花钱，而士兵会记住是谁守着规矩。守着吧。"
          }
        }
      }
    },
    "petition.keep_window.r1" : {
      "comment" : "Petition keep_window: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Nacht bleibt ein Fenster des Bergfrieds dunkel. Auf den Mauern blicken die Schützen hinauf und stehen ein wenig gerader."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That night one window of the keep stays dark. On the walls, the archers glance up at it, and stand a little straighter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa noche, una ventana de la torre del homenaje se queda a oscuras. En las murallas, los arqueros la miran de reojo y se yerguen un poco más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette nuit-là, une fenêtre du donjon reste sombre. Sur les murailles, les archers lèvent les yeux vers elle et se tiennent un peu plus droits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quella notte una finestra del mastio resta buia. Sulle mura gli arcieri alzano lo sguardo, e si raddrizzano un poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その夜、主塔の窓がひとつ暗いままになる。城壁の上で、弓兵たちはそれを見上げ、少し背筋を伸ばす。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naquela noite, uma janela da torre de menagem fica às escuras. Nas muralhas, os arqueiros olham para ela e se aprumam um pouco mais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那一夜，主堡有一扇窗黑着。城墙上的弓手抬头看了一眼，站得更直了些。"
          }
        }
      }
    },
    "petition.keep_window.r2" : {
      "comment" : "Petition keep_window: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper neigt den Kopf. „Zuerst die Lebenden also.“ Nachts strahlt der Bergfried, und niemand erwähnt den alten Brauch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper inclines her head. “The living first, then.” The keep blazes at night, and nobody mentions the old custom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper inclina la cabeza. «Primero los vivos, entonces.» De noche la torre del homenaje resplandece, y nadie menciona la vieja costumbre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper incline la tête. « Les vivants d’abord, donc. » La nuit, le donjon flamboie, et personne ne parle de la vieille coutume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper china il capo. «Prima i vivi, allora.» Di notte il mastio risplende, e nessuno nomina la vecchia usanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘスパーは首を傾ける。「では、生きている者が先ですね」。夜、主塔は煌々と輝き、古い慣わしを口にする者はいない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper inclina a cabeça. “Os vivos primeiro, então.” A torre de menagem resplandece à noite, e ninguém menciona o velho costume."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赫斯珀微微低头。“那就先顾活人。”夜里主堡灯火通明，再没人提起那条老规矩。"
          }
        }
      }
    },
    "petition.keep_window.text" : {
      "comment" : "Petition keep_window (hesper): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Erbe|Erbin} des Hauses, nach der Zählung bleibt für jede Laterne, die nicht heimkommt, ihr Haken in der Kapelle ein Jahr leer und ein Fenster des Bergfrieds dunkel, damit der Schlund sieht, dass wir uns erinnern. Der Brauch endete mit Aldric. Pflegen wir ihn wieder?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heir of the house, by the Count a lantern that does not come back leaves its hook in the chapel empty for a year, and one keep window dark, so the Throat can see we remember. The custom lapsed with Aldric. Shall we keep it again?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Hijo|Hija} de la casa, según el Recuento, un farol que no vuelve deja vacío su gancho en la capilla durante un año, y a oscuras una ventana de la torre del homenaje, para que la Garganta vea que recordamos. La costumbre se perdió con Aldric. ¿La retomamos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfant de la maison, selon le Compte, une lanterne qui ne revient pas laisse son crochet vide à la chapelle pendant un an, et une fenêtre du donjon éteinte, pour que la Gorge voie que nous nous souvenons. La coutume s’est perdue avec Aldric. La reprendrons-nous ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Figlio|Figlia} della casa, secondo la Conta una lanterna che non torna lascia vuoto per un anno il suo gancio in cappella, e buia una finestra del mastio, perché la Gola veda che ricordiamo. L’usanza si è persa con Aldric. La riprendiamo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家の御子、灯数えの定めでは、戻らなかったランタンの鉤は一年のあいだ礼拝堂で空けておき、主塔の窓をひとつ暗くしておきます。我らが忘れていないことを、喉谷に見せるために。この慣わしは、アルドリック様とともに途絶えました。もう一度、守りましょうか。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Filho|Filha} da casa, pela Contagem, uma lanterna que não volta deixa o seu gancho vazio na capela por um ano, e uma janela da torre de menagem às escuras, para que a Garganta veja que nos lembramos. O costume se perdeu com Aldric. Vamos retomá-lo?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族之子，按数灯的规矩，一盏提灯没有回来，它在礼拜堂里的钩子就要空一年，主堡也要有一扇窗黑着，好让喉谷看见我们没有忘记。奥德里克走后，这规矩就断了。我们要重拾它吗？"
          }
        }
      }
    },
    "petition.lantern_lanes.c1" : {
      "comment" : "Petition lantern_lanes: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erleuchtet die Gassen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light the lanes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iluminar las calles"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éclairez les ruelles"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illuminate i vicoli"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路地に灯りをともそう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iluminem as vielas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把巷子点亮"
          }
        }
      }
    },
    "petition.lantern_lanes.c2" : {
      "comment" : "Petition lantern_lanes: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tragt Eure eigene Laterne"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carry your own lantern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que cada cual lleve su farol"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portez votre propre lanterne"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portatevi la vostra lanterna"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランタンは各自で持ってくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carregue a sua própria lanterna"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自己的灯自己提"
          }
        }
      }
    },
    "petition.lantern_lanes.hint" : {
      "comment" : "Petition lantern_lanes: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Ein Burgherr|Eine Burgherrin} von Haus Lantern, {der|die} Laternen verweigert. Die Barden würden das nie vergessen. Erleuchtet die Gassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A {Lord|Lady} Lantern who refuses lanterns. The bards would never let it go. Light the lanes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Un señor farolero|Una señora farolera} que rechaza faroles. Los bardos no lo olvidarían jamás. Ilumine las calles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Un lampiste devenu seigneur|Une lampiste devenue dame} qui refuse des lanternes. Les bardes n’en finiraient jamais. Éclairez les ruelles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Un lampionaio fatto signore|Una lampionaia fatta signora} che rifiuta le lanterne. I bardi ci camperebbero per anni. Illuminate i vicoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランタンを拒む灯り番の城主。吟遊詩人たちが、いつまでも放っておきません。路地に灯りを。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Um acendedor de lampiões feito senhor|Uma acendedora de lampiões feita senhora} que recusa lanternas. Os bardos nunca deixariam passar. Ilumine as vielas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点灯人出身的城主不肯挂灯。吟游诗人能把这事唱上一辈子。把巷子点亮。"
          }
        }
      }
    },
    "petition.lantern_lanes.r1" : {
      "comment" : "Petition lantern_lanes: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An diesem Abend zündet Ihr die erste mit der Flamme des Hauses an. Die ganze Gasse jubelt, und Euch fällt fast der Stab aus der Hand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That evening you light the first one from the house’s own flame. The whole lane cheers, and you nearly drop the staff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al caer la tarde enciende el primero con sus propias manos, por costumbre. Toda la calle aplaude, y a usted casi se le cae la pértiga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce soir-là, vous allumez la première vous-même, par habitude. Toute la ruelle applaudit, et la perche manque de vous échapper."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quella sera accendete voi la prima, per abitudine. Tutto il vicolo applaude, e per poco non vi cade la pertica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その晩、いつもの癖で、最初の一つを自分の手で灯す。路地じゅうが歓声を上げ、危うく竿を取り落としそうになる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naquela noite, você acende a primeira com as próprias mãos, por hábito. A viela inteira aplaude, e você quase deixa cair a vara."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那天傍晚，你出于习惯，亲手点亮了第一盏。整条巷子欢呼起来，你差点把钩竿掉了。"
          }
        }
      }
    },
    "petition.lantern_lanes.r2" : {
      "comment" : "Petition lantern_lanes: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er verneigt sich. Bis zum Wochenende verkauft jedes Haus kleine Laternen, zu Preisen, auf die Odile stolz wäre."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He bows. By the week’s end every house sells little lanterns, at prices that make Odile proud of them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se inclina. Al acabar la semana, cada casa vende farolitos, a precios de los que Odile estaría orgullosa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’incline. À la fin de la semaine, chaque maison vend de petites lanternes, à des prix dont Odile serait fière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si inchina. Entro fine settimana ogni casa vende lanternine, a prezzi di cui Odile andrebbe fiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "男は一礼する。週の終わりには、どの家も小さなランタンを売っている。オディールが誇りに思いそうな値段で。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele se curva. No fim da semana, cada casa vende lanterninhas, a preços que dariam orgulho a Odile."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他鞠了一躬。不到周末，家家户户都卖起了小提灯，那价钱连奥黛尔都要引以为傲。"
          }
        }
      }
    },
    "petition.lantern_lanes.text" : {
      "comment" : "Petition lantern_lanes (townsman): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, die Gassen hinter dem Markt sind nach der Dämmerung schwarz wie ein Kamin. Die Leute stolpern, die Diebe nicht. Fünfzehn Gold, und an jeder Ecke hängt eine Laterne. Gerade Ihr wisst doch, was eine Laterne wert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the lanes behind the market are black as a chimney after dusk. Folk trip, thieves don’t. Fifteen gold hangs a lantern on every corner. You of all people know what a lantern is worth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, las calles detrás del mercado están negras como una chimenea al anochecer. La gente tropieza; los ladrones, no. Con quince monedas de oro se cuelga un farol en cada esquina. Usted, mejor que nadie, sabe lo que vale un farol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, les ruelles derrière le marché sont noires comme une cheminée après le crépuscule. Les gens trébuchent, les voleurs non. Quinze pièces d’or, et une lanterne pend à chaque coin. Vous, mieux que personne, savez ce que vaut une lanterne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, i vicoli dietro il mercato dopo il crepuscolo sono neri come un camino. La gente inciampa, i ladri no. Con quindici monete d’oro si appende una lanterna a ogni angolo. Voi, più di chiunque, sapete quanto vale una lanterna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、市場の裏の路地は、日暮れを過ぎると煙突の中みたいに真っ暗です。皆はつまずくのに、泥棒はつまずかない。金貨15枚で、角という角にランタンが掛けられます。ランタンの値打ちなら、誰よりご存じのはずでしょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, as vielas atrás do mercado ficam pretas feito chaminé depois do crepúsculo. O povo tropeça, os ladrões não. Quinze moedas de ouro penduram uma lanterna em cada esquina. Ninguém sabe melhor do que {o senhor|a senhora} quanto vale uma lanterna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，集市后头的巷子一到黄昏就黑得像烟囱。行人绊跟头，小偷可不会。15金币就能在每个拐角挂一盏提灯。提灯值多少，您比谁都清楚。"
          }
        }
      }
    },
    "petition.lantern_night.c1" : {
      "comment" : "Petition lantern_night: choice 1.",
      "extractionState" : "manual",
