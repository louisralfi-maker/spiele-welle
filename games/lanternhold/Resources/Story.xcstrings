    },
    "petition.soldiers_pay.hint" : {
      "comment" : "Petition soldiers_pay: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bänder sind billiger als Kupfer und halten länger. Gebt ihnen Ehren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ribbons are cheaper than coppers and last longer. Give them honours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cintas son más baratas que los cobres y duran más. Deles honores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rubans coûtent moins cher que les sous et durent plus longtemps. Donnez-leur des honneurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nastri costano meno del rame e durano di più. Date loro onorificenze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勲章の綬は銅貨より安く、長持ちいたします。名誉で報いるのがよろしいかと。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitas são mais baratas que tostões e duram mais. Dê-lhes honrarias."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绶带比铜板便宜，还更经用。给他们荣誉吧。"
          }
        }
      }
    },
    "petition.soldiers_pay.r1" : {
      "comment" : "Petition soldiers_pay: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachricht erreicht die Mauern vor dem Soldaten. In der Nacht singen die Schützen im Dienst, schlecht, aber laut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The news reaches the walls before the soldier does. That night the archers sing on duty, badly but loudly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La noticia llega a las murallas antes que el soldado. Esa noche los arqueros cantan durante la guardia, mal pero fuerte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle atteint les murailles avant le soldat. Cette nuit-là, les archers chantent pendant leur garde, mal mais fort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La notizia arriva sulle mura prima del soldato. Quella notte gli arcieri cantano di guardia, male ma forte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知らせは、兵より先に城壁へ届く。その夜、弓兵たちは持ち場で歌う。下手だが、声は大きい。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A notícia chega às muralhas antes do soldado. Naquela noite, os arqueiros cantam em serviço, mal mas alto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消息比那名士兵先一步传到了城墙。那一夜，弓手们站着岗唱起歌来，唱得难听，可嗓门很大。"
          }
        }
      }
    },
    "petition.soldiers_pay.r2a" : {
      "comment" : "Petition soldiers_pay: choice 2, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie murren und bleiben. Soldaten murren immer. Daran erkennt man, dass sie noch leben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They grumble and stay. Soldiers always grumble. It is how you know they are still alive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refunfuñan y se quedan. Los soldados siempre refunfuñan. Así se sabe que siguen vivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils grognent et restent. Les soldats grognent toujours. C’est à ça qu’on sait qu’ils sont encore en vie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brontolano e restano. I soldati brontolano sempre. È così che si capisce che sono ancora vivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彼らはぼやきながらも残る。兵はいつもぼやく。それが、まだ生きている証だ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles resmungam e ficam. Soldado sempre resmunga. É assim que se sabe que ainda está vivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们嘟囔着，还是留下了。当兵的总在嘟囔。听见嘟囔，你就知道他们还活着。"
          }
        }
      }
    },
    "petition.soldiers_pay.r2b" : {
      "comment" : "Petition soldiers_pay: choice 2, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einer legt seinen Bogen nieder und geht heim auf sein Feld. Zwei andere denken laut darüber nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One of them lays down his bow and walks home to his field. Two others think about it loudly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno de ellos deja el arco y se vuelve a su campo. Otros dos se lo piensan en voz alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’un d’eux pose son arc et rentre à son champ. Deux autres y réfléchissent à voix haute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno di loro posa l’arco e torna a casa, al suo campo. Altri due ci pensano ad alta voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一人が弓を置き、自分の畑へ帰っていく。ほかに二人、どうしようかと聞こえよがしに考えている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um deles depõe o arco e volta a pé para a lavoura. Outros dois pensam nisso em voz alta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一个放下弓，走回了自家的田里。另外两个大声琢磨着要不要也走。"
          }
        }
      }
    },
    "petition.soldiers_pay.r3" : {
      "comment" : "Petition soldiers_pay: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Schütze bekommt ein Band mit einer kleinen goldenen Laterne. Sie beschweren sich und tragen es dann jeden Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each archer gets a ribbon with a little gold lantern. They complain, then wear them every day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada arquero recibe una cinta con un farolito de oro. Se quejan, y luego la llevan todos los días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque archer reçoit un ruban orné d’une petite lanterne dorée. Ils râlent, puis le portent tous les jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni arciere riceve un nastro con una piccola lanterna d’oro. Si lamentano, poi lo portano tutti i giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弓兵一人ひとりに、小さな金のランタンのついた綬が渡される。皆、文句を言い、それから毎日つけている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada arqueiro ganha uma fita com uma lanterninha de ouro. Eles reclamam, e depois usam a fita todo dia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个弓手都得了一条绶带，上面挂着一盏小小的金提灯。他们抱怨了一番，后来天天戴着。"
          }
        }
      }
    },
    "petition.soldiers_pay.text" : {
      "comment" : "Petition soldiers_pay (soldier): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}, wir Schützen stehen jede Nacht auf den Mauern, für den Lohn einer Gänsemagd. Die Jungs wollen zwei Kupfer mehr pro Nacht. Keiner traute sich, es dem Hauptmann zu sagen, also schickten sie mich. Ich habe den kürzeren Halm gezogen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, we archers stand on the walls every night for the pay of a goose-girl. The lads want two more coppers a night. Nobody dared say it to the captain, so they sent me. I drew the short straw."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Señor|Señora}, los arqueros estamos en las murallas cada noche por la paga de una pastora de gansos. Los muchachos quieren dos cobres más por noche. Nadie se atrevió a decírselo al capitán, así que me mandaron a mí. Me tocó la paja más corta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, nous, les archers, montons sur les murailles chaque nuit pour la paie d’une gardeuse d’oies. Les gars veulent deux sous de plus par nuit. Personne n’a osé le dire au capitaine, alors ils m’ont envoyé. J’ai tiré la courte paille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Signore|Signora}, noi arcieri stiamo sulle mura ogni notte per la paga di una guardiana d’oche. I ragazzi vogliono due soldi in più a notte. Nessuno ha osato dirlo al capitano, così hanno mandato me. Ho pescato la pagliuzza più corta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主、我ら弓兵は毎晩城壁に立っていますが、給金は鵞鳥番の娘並みです。若い連中は、ひと晩あたり銅貨2枚の上乗せを望んでいます。隊長に言える者がいないので、私がよこされました。貧乏くじを引いたんです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Senhor|Senhora}, nós, arqueiros, ficamos nas muralhas toda noite pelo salário de uma pastora de gansos. Os rapazes querem dois tostões a mais por noite. Ninguém teve coragem de dizer isso ao capitão, então me mandaram. Fiquei com o palito mais curto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主，我们弓手夜夜站在城墙上，拿的却是放鹅丫头的工钱。弟兄们想每夜多要两个铜板。谁都不敢跟队长说，就派了我来。我抽中了短签。"
          }
        }
      }
    },
    "petition.statue_market.c1" : {
      "comment" : "Petition statue_market: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Statue, unbedingt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A statue, by all means"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una estatua, por supuesto"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une statue, bien sûr"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una statua, senz’altro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぜひ、像を"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma estátua, sem dúvida"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当然要立一座"
          }
        }
      }
    },
    "petition.statue_market.c2" : {
      "comment" : "Petition statue_market: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebt dem Heiligen Aldrics Gesicht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give the saint Lord Aldric’s face"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que el santo tenga la cara de lord Aldric"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez au saint le visage d’Aldric"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Date al santo il volto di Lord Aldric"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聖人にアルドリック様の顔を"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deem ao santo o rosto do Lorde Aldric"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让圣人长着奥德里克大人的脸"
          }
        }
      }
    },
    "petition.statue_market.c3" : {
      "comment" : "Petition statue_market: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Marmor kommt in die Mauern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The marble goes into the walls"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mármol va a las murallas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le marbre ira dans les murailles"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il marmo va nelle mura"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大理石は城壁に使う"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mármore vai para as muralhas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大理石砌进城墙"
          }
        }
      }
    },
    "petition.statue_market.hint" : {
      "comment" : "Petition statue_market: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vierzig Gold für einen steinernen Heiligen, während die Lebenden Mauern brauchen. Steckt den Marmor in die Mauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forty gold for a stone saint while the living need walls. Put the marble in the walls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuarenta monedas de oro por un santo de piedra mientras los vivos necesitan murallas. Ponga el mármol en las murallas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quarante pièces d’or pour un saint de pierre, quand les vivants ont besoin de murailles. Mettez le marbre dans les murailles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quaranta monete d’oro per un santo di pietra, mentre i vivi hanno bisogno di mura. Mettete il marmo nelle mura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生きている者に城壁が要るときに、石の聖人に金貨40枚。大理石は、城壁に回しましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quarenta moedas de ouro por um santo de pedra, enquanto os vivos precisam de muralhas. Ponha o mármore nas muralhas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活人还缺城墙，却花40金币去买一尊石头圣人。把大理石砌进城墙。"
          }
        }
      }
    },
    "petition.statue_market.r1" : {
      "comment" : "Petition statue_market: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binnen einer Woche steht sie. Die Nase stimmt nicht, die Laterne schon, und die Tauben sind sofort einverstanden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It goes up within the week. The nose is wrong, the lantern is right, and the pigeons approve at once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una semana ya está en pie. La nariz no se parece, el farol sí, y las palomas dan su aprobación al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On la dresse dans la semaine. Le nez est raté, la lanterne réussie, et les pigeons approuvent aussitôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In una settimana è in piedi. Il naso è sbagliato, la lanterna è giusta, e i piccioni approvano subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一週間のうちに像が立つ。鼻は違うが、ランタンは合っている。鳩たちはすぐに気に入る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fica pronta em uma semana. O nariz está errado, a lanterna está certa, e os pombos aprovam na hora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一周之内石像就立起来了。鼻子不对，提灯倒对，鸽子当场就认可了。"
          }
        }
      }
    },
    "petition.statue_market.r2" : {
      "comment" : "Petition statue_market: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sankt Taper erhebt sich in Marmor mit Aldrics Gesicht, die Laterne in der Hand. Die Alten legen ihm jeden Morgen Blumen zu Füßen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saint Taper rises in marble with Aldric’s face, lantern in hand. Old folk leave flowers at his feet every morning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "San Taper se alza en mármol con la cara de Aldric, farol en mano. Los viejos le dejan flores a los pies cada mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saint Taper s’élève dans le marbre avec le visage d’Aldric, lanterne en main. Les vieux déposent des fleurs à ses pieds chaque matin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "San Taper si leva nel marmo col volto di Aldric, la lanterna in mano. I vecchi gli lasciano fiori ai piedi ogni mattina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルドリックの顔をした聖テイパーが、ランタンを手に大理石でそびえる。年寄りたちは毎朝、その足もとに花を供える。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "São Taper se ergue em mármore com o rosto de Aldric, lanterna na mão. Os velhos deixam flores aos pés dele toda manhã."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大理石的圣泰珀立了起来，长着奥德里克的脸，手里提着灯。老人们每天早上都在他脚下放花。"
          }
        }
      }
    },
    "petition.statue_market.r3" : {
      "comment" : "Petition statue_market: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Edelmann verneigt sich steif. Der Marmor wandert in die mittlere Linie, wo ihn vor allem der Ruß bewundern wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The noble bows stiffly. The marble goes into the middle line, where it will be admired mostly by soot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El hidalgo se inclina con rigidez. El mármol va a parar a la línea central, donde lo admirará sobre todo el hollín."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le gentilhomme s’incline avec raideur. Le marbre part dans la ligne du milieu, où il sera surtout admiré par la suie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nobile si inchina rigido. Il marmo finisce nella linea di mezzo, dove lo ammirerà soprattutto la fuliggine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貴族はこわばった礼をする。大理石は中の防衛線に収まり、もっぱら煤に愛でられることになる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nobre se curva, rígido. O mármore vai para a linha do meio, onde será admirado sobretudo pela fuligem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那位贵族僵硬地鞠了一躬。大理石砌进了中防线，在那里欣赏它的，多半只有煤影。"
          }
        }
      }
    },
    "petition.statue_market.text" : {
      "comment" : "Petition statue_market (noble): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, die Gilde der Steinmetze möchte Eure Wacht mit einer Statue auf dem Marktplatz ehren. Statuen von Burgherren sind für die Toten, also: Sankt Taper, die Laterne erhoben, in weißem Marmor. Sie bitten nur, dass das Haus den Marmor bezahlt. Vierzig Gold."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the guild of masons wishes to honour your watch with a statue on the market square. Statues of lords are for the dead, so: Saint Taper, lantern raised, in white marble. They ask only that the house buys the marble. Forty gold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, el gremio de canteros desea honrar su vigilia con una estatua en la plaza del mercado. Las estatuas de señores son para los muertos, así que: san Taper, farol en alto, en mármol blanco. Solo piden que la casa compre el mármol. Cuarenta monedas de oro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, la guilde des tailleurs de pierre souhaite honorer votre veille d’une statue sur la place du marché. Les statues de seigneurs sont pour les morts, alors : saint Taper, lanterne levée, en marbre blanc. Ils demandent seulement que la maison achète le marbre. Quarante pièces d’or."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, la corporazione degli scalpellini desidera onorarvi con una statua sulla piazza del mercato. Le statue dei signori sono per i morti, dunque: san Taper, lanterna alzata, in marmo bianco. Chiedono solo che la casata paghi il marmo. Quaranta monete d’oro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、石工組合が城主様の代を称えて、市場の広場に像を建てたいと申しております。城主の像は亡き方のためのもの。ですので、ランタンを掲げた聖テイパーを、白い大理石で。お城には、大理石を買っていただくだけでよいと。金貨40枚です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, a guilda dos canteiros deseja honrar a sua vigília com uma estátua na praça do mercado. Estátuas de senhores são para os mortos, então: são Taper, de lanterna erguida, em mármore branco. Pedem apenas que a casa compre o mármore. Quarenta moedas de ouro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，石匠行会想在集市广场立一座石像，纪念您守城的岁月。可城主的像是给死人立的，所以：圣泰珀，高举提灯，白色大理石。他们只求城主家出钱买大理石。40金币。"
          }
        }
      }
    },
    "petition.stranger_gate.c1" : {
      "comment" : "Petition stranger_gate: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet das Tor"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the gate"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abran la puerta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez la porte"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprite la porta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "門を開けよう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abram o portão"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开门"
          }
        }
      }
    },
    "petition.stranger_gate.c2" : {
      "comment" : "Petition stranger_gate: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tor bleibt zu"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the gate shut"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La puerta sigue cerrada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La porte reste fermée"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La porta resta chiusa"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "門は閉じたままだ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O portão fica fechado"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "门不开"
          }
        }
      }
    },
    "petition.stranger_gate.hint" : {
      "comment" : "Petition stranger_gate: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie stand im Morgengrauen am Schlundtor, auf der Seite, von der niemand kommt. Spionin oder Geschenk. Spione sind drinnen billiger. Öffnet das Tor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She stood at the Throat gate at dawn, the side nobody comes from. A spy or a gift. Spies are cheaper inside. Open the gate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estaba al alba en la puerta de la Garganta, del lado por donde no viene nadie. Una espía o un regalo. Las espías salen más baratas dentro. Abra la puerta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle se tenait à la porte de la Gorge à l’aube, du côté d’où personne ne vient. Une espionne ou un cadeau. Les espions coûtent moins cher à l’intérieur. Ouvrez la porte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si è presentata all’alba alla porta della Gola, dal lato da cui non viene nessuno. Una spia o un dono. Le spie costano meno dentro. Aprite la porta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あの女は夜明けに喉谷の門に立っておりました。誰も来るはずのない側に。間者か、贈り物か。間者なら、中に置くほうが安くつきます。開門を。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela estava no portão da Garganta na alvorada, do lado de onde ninguém vem. Espiã ou presente. Espiões saem mais baratos do lado de dentro. Abra o portão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她黎明时站在喉谷门外，那一侧从没有人来。是奸细，还是礼物。奸细嘛，放在里面更省钱。开门吧。"
          }
        }
      }
    },
    "petition.stranger_gate.r1" : {
      "comment" : "Petition stranger_gate: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wortlos tritt sie ein und hängt die graue Laterne in die hinterste Ecke des Saals. Das Herdfeuer neigt sich von ihr weg, nur ein wenig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She steps in without a word and hangs the grey lantern in the hall’s far corner. The hearth fire leans away from it, just a little."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra sin una palabra y cuelga el farol gris en el rincón más apartado del salón. El fuego del hogar se aparta de él, solo un poco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle entre sans un mot et suspend la lanterne grise dans le coin le plus reculé de la salle. Le feu de l’âtre s’en écarte, à peine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra senza una parola e appende la lanterna grigia nell’angolo più lontano del salone. Il fuoco del focolare se ne scosta, appena un poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "女は何も言わずに入り、灰色のランタンを大広間の奥の隅に掛ける。炉の火が、それから身を引く。ほんの少しだけ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela entra sem uma palavra e pendura a lanterna cinzenta no canto mais distante do salão. O fogo da lareira se inclina para longe dela, só um pouco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她一言不发地走进来，把灰提灯挂在大厅最远的角落。炉火朝反方向偏了偏，只偏了一点。"
          }
        }
      }
    },
    "petition.stranger_gate.r2" : {
      "comment" : "Petition stranger_gate: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie nickt, als hätte sie damit gerechnet. Beim Horn ist das graue Licht vor dem Tor verschwunden, und die Nacht kommt ein wenig kälter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She nods, as if she had counted on it. At the horn the grey light is gone from the gate, and the night comes on a little colder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asiente, como si contara con ello. Al toque del cuerno, la luz gris ya no está ante la puerta, y la noche llega un poco más fría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle hoche la tête, comme si elle s’y attendait. Au cor, la lumière grise a quitté la porte, et la nuit tombe un peu plus froide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuisce, come se ci avesse contato. Al suono del corno la luce grigia è sparita dalla porta, e la notte arriva un po’ più fredda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "女はうなずく。初めから当てにしていたかのように。角笛が鳴るころ、門の前の灰色の光は消え、夜はいつもより少し冷たくやって来る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela assente, como se contasse com isso. Ao toque da trompa, a luz cinzenta já sumiu do portão, e a noite chega um pouco mais fria."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她点点头，仿佛早料到了。号角响时，门外的灰光已经不见，夜来得冷了一些。"
          }
        }
      }
    },
    "petition.stranger_gate.text" : {
      "comment" : "Petition stranger_gate (seren, story days 4-5): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich komme vom Rand der Düsternis, mit dieser Laterne. Sie brennt grau und wärmt nicht, also verlangt es nicht von ihr. Die Nacht ist nah, und da draußen kennt das Dunkel meinen Namen. Öffnet Euer Tor, Lantern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have walked from the edge of the Gloom with this lantern. It burns grey and gives no warmth, so do not ask it to. Night is close, and out there the dark knows my name. Open your gate, Lantern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He caminado desde el borde de la Penumbra con este farol. Arde gris y no da calor, así que no se lo pida. La noche está cerca, y allá fuera la oscuridad sabe mi nombre. Abra su puerta, {farolero|farolera}."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai marché depuis la lisière de la Pénombre avec cette lanterne. Elle brûle d’un feu gris et ne chauffe pas, alors ne le lui demandez pas. La nuit est proche, et là-dehors, l’obscurité connaît mon nom. Ouvrez votre porte, lampiste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengo dal confine della Penombra con questa lanterna. Arde grigia e non scalda, quindi non chiedeteglielo. La notte è vicina, e là fuori il buio conosce il mio nome. Aprite la vostra porta, {lampionaio|lampionaia}."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このランタンを持って、宵闇の縁から歩いてきました。灰色に燃え、温もりはありません。ですから、それを求めないでください。夜は近く、向こうでは闇が私の名を知っています。門を開けてください、灯り番。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vim da beira da Penumbra com esta lanterna. Ela arde cinzenta e não aquece, então não peça isso a ela. A noite está perto, e lá fora o escuro sabe o meu nome. Abra o seu portão, {acendedor de lampiões|acendedora de lampiões}."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我提着这盏灯，从暗霭的边缘走来。它燃着灰光，不暖人，也别指望它暖人。夜近了，外面的黑暗知道我的名字。打开您的门吧，点灯人。"
          }
        }
      }
    },
    "petition.tamsin_oven.c1" : {
      "comment" : "Petition tamsin_oven: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
