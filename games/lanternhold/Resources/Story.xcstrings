    "petition.watch_feast.hint" : {
      "comment" : "Petition watch_feast: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kleines Fest hält sie fröhlich. Ein großes hält sie fröhlich und mich wach. Ein kleines."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A small feast keeps them merry. A large one keeps them merry and me awake. A small one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fiesta pequeña los mantiene alegres. Una grande los mantiene alegres y a mí despierta. Una pequeña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une petite fête les garde joyeux. Une grande les garde joyeux, et moi éveillée. Une petite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una festa piccola li tiene allegri. Una grande li tiene allegri e tiene sveglia me. Una piccola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さな祭りなら、皆が陽気になります。大きな祭りなら、皆が陽気になり、わたくしが眠れなくなります。小さいほうを。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma festa pequena os mantém alegres. Uma grande os mantém alegres e a mim acordada. Uma pequena."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小宴让他们快活。大宴让他们快活，也让我睡不着。小宴。"
          }
        }
      }
    },
    "petition.watch_feast.r1" : {
      "comment" : "Petition watch_feast: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Feuer auf dem Platz sieht man bis in die fernen Berge. Die Stadt tanzt, und für eine Nacht wirkt das Dunkel klein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bonfire on the square is seen from the far mountains. The town dances, and for one night the dark seems small."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hoguera de la plaza se ve desde las montañas lejanas. El pueblo baila, y por una noche la oscuridad parece pequeña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le feu de joie sur la place se voit depuis les montagnes lointaines. La ville danse, et pour une nuit, l’obscurité paraît petite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il falò sulla piazza si vede dalle montagne lontane. Il borgo balla, e per una notte il buio sembra piccolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広場の焚き火は、遠くの山々からも見える。町は踊り、ひと晩だけ、闇が小さく見える。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fogueira da praça é vista das montanhas distantes. A cidade dança, e por uma noite o escuro parece pequeno."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "广场上的篝火，远山上都看得见。镇上的人跳起舞来，这一夜，黑暗显得很小。"
          }
        }
      }
    },
    "petition.watch_feast.r2" : {
      "comment" : "Petition watch_feast: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brot, ein Feuer und drei Fiedler, die zwei Lieder kennen. Es genügt. Es ist sogar ziemlich schön."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bread, a fire and three fiddlers who know two songs. It is enough. It is, in fact, rather lovely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pan, una hoguera y tres violinistas que saben dos canciones. Basta. De hecho, es bastante bonito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du pain, un feu et trois vielleux qui connaissent deux chansons. Cela suffit. C’est même plutôt charmant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pane, un fuoco e tre suonatori di viella che conoscono due canzoni. Basta così. Anzi, è piuttosto bello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パンと火と、二曲しか知らない楽師が三人。それで十分だ。実のところ、なかなかすてきだ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pão, uma fogueira e três rabequeiros que sabem duas canções. É o bastante. É até bem bonito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面包、一堆火，还有三个只会两首曲子的提琴手。这就够了。说实在的，还挺美。"
          }
        }
      }
    },
    "petition.watch_feast.r3" : {
      "comment" : "Petition watch_feast: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stadt nickt und geht früh heim. Der Platz bleibt dunkel, und jemand schreibt „Wann?“ an den Brunnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The town nods and goes home early. The square stays dark, and someone writes “When?” on the well."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pueblo asiente y se va pronto a casa. La plaza sigue a oscuras, y alguien escribe «¿Cuándo?» en el pozo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ville acquiesce et rentre tôt. La place reste sombre, et quelqu’un écrit « Quand ? » sur le puits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il borgo annuisce e va a letto presto. La piazza resta buia, e qualcuno scrive «Quando?» sul pozzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "町はうなずき、早々に帰っていく。広場は暗いままで、誰かが井戸に「いつ？」と書く。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cidade assente e vai para casa cedo. A praça fica escura, e alguém escreve “Quando?” no poço."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "镇上的人点点头，早早回了家。广场一直黑着，有人在井上写了个“何时？”。"
          }
        }
      }
    },
    "petition.watch_feast.text" : {
      "comment" : "Petition watch_feast (townswoman, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, die Stadt möchte ein Fest der Langen Wacht feiern, für jede Nacht, die die Mauern gehalten haben. Brot, ein Feuer auf dem Platz, Tanz. Wir hätten gern den Segen des Hauses und, nun ja, seinen Geldbeutel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the town wants a Feast of the Long Watch, for every night the walls have held. Bread, a bonfire on the square. We would like the house’s blessing and, well, the house’s purse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, el pueblo quiere una fiesta de la Larga Vigilia, por cada noche que han aguantado las murallas. Pan, una hoguera en la plaza. Querríamos la bendición de la casa y, bueno, la bolsa de la casa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, la ville voudrait une fête de la Longue Veille, pour chaque nuit où les murailles ont tenu. Du pain, un feu de joie sur la place. Nous aimerions la bénédiction de la maison et, ma foi, la bourse de la maison."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, il borgo vuole una festa della Lunga Veglia, per ogni notte in cui le mura hanno retto. Pane, un falò sulla piazza. Vorremmo la benedizione della casata e, insomma, la borsa della casata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、町は長き見張りの祭りを開きたいと申しております。城壁が持ちこたえた夜の一つひとつのために。パンと、広場の大きな焚き火。お城のご祝福と、それから、その、お城のお財布をいただければと。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, a cidade quer uma festa da Longa Vigília, por cada noite em que as muralhas aguentaram. Pão, uma fogueira na praça. Gostaríamos da bênção da casa e, bem, da bolsa da casa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，镇上想办一场守望节，为城墙守住的每一个夜晚。有面包，广场上再点一堆篝火。我们想求城主家的祝福，还有……嗯，城主家的钱袋。"
          }
        }
      }
    },
    "petition.wedding_feast.c1" : {
      "comment" : "Petition wedding_feast: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zelt und den Wein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tent and the wine"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tienda y el vino"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tente et le vin"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tenda e il vino"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天幕とぶどう酒を"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tenda e o vinho"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帐篷和酒都给"
          }
        }
      }
    },
    "petition.wedding_feast.c2" : {
      "comment" : "Petition wedding_feast: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur das Zelt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the tent"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo la tienda"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tente seulement"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo la tenda"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天幕だけ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só a tenda"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只借帐篷"
          }
        }
      }
    },
    "petition.wedding_feast.c3" : {
      "comment" : "Petition wedding_feast: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Feste, solange die Düsternis kommt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No feasts while the Gloom comes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de fiestas mientras venga la Penumbra"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de fêtes tant que vient la Pénombre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente feste mentre viene la Penombra"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宵闇が来るあいだ、祝宴はなしだ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de festa enquanto vier a Penumbra"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗霭当前，不办宴席"
          }
        }
      }
    },
    "petition.wedding_feast.hint" : {
      "comment" : "Petition wedding_feast: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Hochzeit ist ein Fest, das die Stadt selbst bezahlt. Leiht das Zelt, behaltet den Wein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A wedding is a festival the town pays for itself. Lend the tent, keep the wine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una boda es una fiesta que el pueblo se paga solo. Preste la tienda, guárdese el vino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mariage est une fête que la ville se paie elle-même. Prêtez la tente, gardez le vin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un matrimonio è una festa che il borgo si paga da sé. Prestate la tenda, tenetevi il vino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "婚礼は、町が自腹で開く祭りです。天幕はお貸しして、ぶどう酒はお手元に。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um casamento é uma festa que a cidade paga sozinha. Empreste a tenda, fique com o vinho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "婚礼是镇上自掏腰包的节庆。帐篷借给他们，酒就免了。"
          }
        }
      }
    },
    "petition.wedding_feast.r1" : {
      "comment" : "Petition wedding_feast: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zelt steht gestreift und stolz auf dem Platz. Getanzt wird bis zum Horn, manche sagen, noch darüber hinaus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tent goes up striped and proud on the square. The dancing lasts until the horn, and some say past it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tienda a rayas se alza, orgullosa, en la plaza. El baile dura hasta el cuerno, y hay quien dice que más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tente se dresse, rayée et fière, sur la place. On danse jusqu’au cor, et certains disent au-delà."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tenda si alza a strisce, fiera, sulla piazza. Si balla fino al suono del corno, e c’è chi dice anche dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広場に縞模様の天幕が誇らしげに立つ。踊りは角笛まで続き、その後もと言う者もいる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tenda sobe listrada e altiva na praça. A dança vai até a trompa, e há quem diga que passou dela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条纹帐篷神气地立在广场上。舞一直跳到号角响起，有人说还不止。"
          }
        }
      }
    },
    "petition.wedding_feast.r2" : {
      "comment" : "Petition wedding_feast: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie bringen ihren eigenen Wein mit, der furchtbar ist, und niemanden stört es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They bring their own wine, which is terrible, and nobody minds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traen su propio vino, que es malísimo, y a nadie le importa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils apportent leur propre vin, qui est affreux, et personne ne s’en soucie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si portano il loro vino, che è tremendo, e a nessuno importa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "皆はぶどう酒を持ち寄る。ひどい味だが、誰も気にしない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles trazem o próprio vinho, que é horrível, e ninguém se importa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们自带了酒，难喝得很，可谁也不在乎。"
          }
        }
      }
    },
    "petition.wedding_feast.r3" : {
      "comment" : "Petition wedding_feast: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hochzeit findet trotzdem statt, leise, in einer Scheune. Die Brautmutter wechselt die Straßenseite, wenn Ihr vorbeikommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wedding happens anyway, quietly, in a barn. The bride’s mother crosses the street when you pass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La boda se celebra igual, sin ruido, en un granero. La madre de la novia cruza la calle cuando usted pasa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mariage a lieu quand même, sans bruit, dans une grange. La mère de la mariée traverse la rue quand vous passez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il matrimonio si fa lo stesso, in sordina, in un fienile. La madre della sposa attraversa la strada quando passate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "婚礼はそれでも開かれる。ひっそりと、納屋で。花嫁の母は、すれ違いそうになると道の反対側へ渡る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O casamento acontece mesmo assim, em silêncio, num celeiro. A mãe da noiva atravessa a rua quando você passa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "婚礼还是办了，悄悄地，在一座谷仓里。你经过时，新娘的母亲走到了街对面。"
          }
        }
      }
    },
    "petition.wedding_feast.text" : {
      "comment" : "Petition wedding_feast (townswoman): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, meine Tochter heiratet zum Vollmond den Sohn des Müllers. Das ganze Tal kommt, und genau das ist das Problem. Leiht uns das Haus das Festzelt? Und vielleicht eine Kleinigkeit für den Wein?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, my daughter marries the miller’s son at the full moon. The whole valley is coming, which is the trouble. Would the house lend us the festival tent? And perhaps a little something for the wine?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, mi hija se casa con el hijo del molinero en la luna llena. Viene todo el valle, y ese es el problema. ¿Nos prestaría la casa la tienda de las fiestas? ¿Y quizá algo para el vino?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, ma fille épouse le fils du meunier à la pleine lune. Toute la vallée vient, et c’est bien là le problème. La maison nous prêterait-elle la tente des fêtes ? Et peut-être un petit quelque chose pour le vin ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, mia figlia sposa il figlio del mugnaio alla luna piena. Viene tutta la valle, ed è proprio questo il guaio. La casata ci presterebbe la tenda delle feste? E magari qualcosina per il vino?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、満月の晩に、娘が粉屋の息子に嫁ぎます。谷じゅうが来るんですが、それが困りもので。お城の祭りの天幕を貸していただけませんか。それと、できればぶどう酒代を少しばかり。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, a minha filha se casa com o filho do moleiro na lua cheia. O vale inteiro vem, e esse é o problema. A casa nos emprestaria a tenda de festa? E talvez uma ajudinha para o vinho?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，我女儿月圆那天要嫁给磨坊主的儿子。整个河谷的人都要来，麻烦就在这儿。城主家能把节庆帐篷借给我们吗？或许，再赏一点酒钱？"
          }
        }
      }
    },
    "petition.well_dispute.c1" : {
      "comment" : "Petition well_dispute: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen gerechten Preis festsetzen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a fair price"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fijar un precio justo"
          }
        },
        "fr" : {
