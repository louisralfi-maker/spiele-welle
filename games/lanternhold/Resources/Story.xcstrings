    "petition.war_tax.c3" : {
      "comment" : "Petition war_tax: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stadt zahlt genug"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The town pays enough"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
