          "stringUnit" : {
            "state" : "translated",
            "value" : "定个公道价"
          }
        }
      }
    },
    "petition.well_dispute.c2" : {
      "comment" : "Petition well_dispute: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Brunnen doch reparieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fix the well after all"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arreglar el pozo, después de todo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réparer le puits, finalement"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riparare il pozzo, dopotutto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やはり井戸を直そう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consertar o poço, afinal"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还是把井修了"
          }
        }
      }
    },
    "petition.well_dispute.hint" : {
      "comment" : "Petition well_dispute: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repariert den Brunnen, dann verdurstet der Streit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fix the well, and the quarrel dies of thirst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arregle el pozo, y la disputa se morirá de sed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réparez le puits, et la querelle mourra de soif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riparate il pozzo, e la lite morirà di sete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "井戸を直せば、諍いのほうが干からびます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserte o poço, e a briga morre de sede."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修好井，争吵自然渴死。"
          }
        }
      }
    },
    "petition.well_dispute.r1a" : {
      "comment" : "Petition well_dispute: choice 1, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Preis hält. Die Brisks murren, die anderen trinken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The price holds. The Brisks grumble, the rest drink."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El precio se mantiene. Los Brisk refunfuñan; los demás beben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le prix tient. Les Brisk grognent, les autres boivent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il prezzo regge. I Brisk brontolano, gli altri bevono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値は守られる。ブリスク家はぼやき、ほかの者は水を飲む。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O preço se mantém. Os Brisk resmungam, os outros bebem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "价钱定住了。布里斯克一家嘟嘟囔囔，其他人总算喝上了水。"
          }
        }
      }
    },
    "petition.well_dispute.r1b" : {
      "comment" : "Petition well_dispute: choice 1, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Brisks verstecken ihre Kessel. Bei Einbruch der Nacht hat niemand Wasser, und alle geben Euch die Schuld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Brisks hide their kettles. By nightfall nobody has water and everybody blames you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Brisk esconden sus calderos. Al caer la noche nadie tiene agua y todos le echan la culpa a usted."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Brisk cachent leurs chaudrons. À la nuit tombée, personne n’a d’eau, et tout le monde vous en veut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Brisk nascondono i paioli. Al calar della notte nessuno ha acqua e tutti danno la colpa a voi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブリスク家が湯沸かしを隠す。日が暮れるころには誰も水がなく、皆があなたのせいにする。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Brisk escondem as chaleiras. Ao cair da noite, ninguém tem água, e todo mundo culpa você."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布里斯克一家把水壶藏了起来。到天黑，谁也没水喝，人人都怪你。"
          }
        }
      }
    },
    "petition.well_dispute.r2" : {
      "comment" : "Petition well_dispute: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Maurer grinst über das zusätzliche Gold. Die Kessel der Brisks werden kalt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The mason grins at the extra gold. The Brisks’ kettles go cold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El albañil sonríe ante el oro extra. Los calderos de los Brisk se enfrían."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le maçon sourit devant cet or inattendu. Les chaudrons des Brisk refroidissent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il muratore sorride all’oro in più. I paioli dei Brisk si raffreddano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "余分な金に、石工がにやりとする。ブリスク家の湯沸かしは冷えていく。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pedreiro sorri com o ouro extra. As chaleiras dos Brisk esfriam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多拿了金币，泥瓦匠咧嘴直笑。布里斯克家的水壶凉了。"
          }
        }
      }
    },
    "petition.well_dispute.text" : {
      "comment" : "Petition well_dispute (townsman, follow-up of well_repair): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit der Brunnen verdorben ist, verkauft Familie Brisk abgekochtes Wasser, einen Kupfer pro Becher. Die anderen Familien wollen sie auspeitschen lassen. Ich will nur einen gerechten Preis, {Burgherr|Burgherrin}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Since the well went bad, the Brisk family sells boiled water at a copper a cup. The other families want them flogged. I only want a fair price, my {lord|lady}."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde que se estropeó el pozo, la familia Brisk vende agua hervida a un cobre la taza. Las otras familias quieren que los azoten. Yo solo quiero un precio justo, {mi señor|mi señora}."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depuis que le puits est gâté, la famille Brisk vend de l’eau bouillie un sou la tasse. Les autres familles veulent les faire fouetter. Moi, je veux seulement un prix juste, {monseigneur|madame}."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da quando il pozzo si è guastato, la famiglia Brisk vende acqua bollita a un soldo la tazza. Le altre famiglie vogliono farli frustare. Io voglio solo un prezzo giusto, {mio signore|mia signora}."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "井戸が悪くなってから、ブリスク家が湯冷ましを一杯銅貨1枚で売っています。ほかの家は、鞭打ちにしろと言っています。私はただ、まっとうな値段にしてほしいだけです、城主様。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde que o poço estragou, a família Brisk vende água fervida a um tostão o copo. As outras famílias querem que eles sejam açoitados. Eu só quero um preço justo, {meu senhor|minha senhora}."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "井坏了以后，布里斯克一家卖起了开水，一个铜板一杯。别的人家要抽他们鞭子。我只求个公道价，城主大人。"
          }
        }
      }
    },
    "petition.well_repair.c1" : {
      "comment" : "Petition well_repair: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Maurer bezahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay the mason"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagar al albañil"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payer le maçon"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagare il muratore"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "石工に払う"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagar o pedreiro"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付钱给泥瓦匠"
          }
        }
      }
    },
    "petition.well_repair.c2" : {
      "comment" : "Petition well_repair: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sollen sie das Wasser abkochen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let them boil the water"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que hiervan el agua"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu’ils fassent bouillir l’eau"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Che facciano bollire l’acqua"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水は沸かして飲めばいい"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que fervam a água"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "叫他们把水煮开喝"
          }
        }
      }
    },
    "petition.well_repair.hint" : {
      "comment" : "Petition well_repair: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünfzehn Gold für sauberes Wasser sind billiger als eine kranke Stadt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fifteen gold for clean water is cheaper than a sick town."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quince monedas de oro por agua limpia salen más baratas que un pueblo enfermo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quinze pièces d’or pour une eau propre, c’est moins cher qu’une ville malade."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quindici monete d’oro per l’acqua pulita costano meno di un borgo malato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "きれいな水に金貨15枚。町が病むより安くつきます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quinze moedas de ouro por água limpa saem mais barato que uma cidade doente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15金币买干净的水，比一个病倒的小镇便宜。"
          }
        }
      }
    },
    "petition.well_repair.r1" : {
      "comment" : "Petition well_repair: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Abend kommt der Eimer klar herauf. Jemand hat eine Blume ans Seil gebunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By evening the bucket comes up clear. Someone has tied a flower to the rope."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al anochecer el balde sube con agua clara. Alguien ha atado una flor a la cuerda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le soir, le seau remonte une eau claire. Quelqu’un a noué une fleur à la corde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entro sera il secchio risale limpido. Qualcuno ha legato un fiore alla corda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夕方には、澄んだ水が桶で上がってくる。誰かが綱に花を一輪結んでいる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À noitinha, o balde sobe limpo. Alguém amarrou uma flor na corda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到傍晚，桶里打上来的水清清亮亮。有人在井绳上系了一朵花。"
          }
        }
      }
    },
    "petition.well_repair.r2" : {
      "comment" : "Petition well_repair: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie nickt steif. Abkochen, sagt sie, werde sie den Ersten, dem das Feuerholz ausgeht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She nods stiffly. Boiling, she says, is what she will do to whoever runs out of firewood first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asiente con rigidez. Hervir, dice, es lo que hará con el primero que se quede sin leña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle hoche la tête, raide. Elle fera bouillir, dit-elle : à commencer par le premier qui manquera de bois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuisce rigida. Bollito, dice, finirà il primo che resta senza legna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "女はこわばった顔でうなずく。沸かすなら、真っ先に薪を切らした者を釜茹でにしてやる、と言う。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela assente, rígida. Ferver, diz ela, é o que vai fazer com o primeiro que ficar sem lenha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她僵硬地点点头。她说，谁先用光柴火，她就先把谁下锅煮了。"
          }
        }
      }
    },
    "petition.well_repair.text" : {
      "comment" : "Petition well_repair (townswoman): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Marktbrunnen ist wieder grün. Die Kinder trinken aus dem Bach, und der Bach schmeckt nach Ziege. Fünfzehn Gold bezahlen einen Maurer, ein Seil und einen neuen Eimer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The market well has gone green again. The children drink from the brook, and the brook tastes of goat. Fifteen gold buys a mason, a rope and a new bucket."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pozo del mercado se ha vuelto a poner verde. Los niños beben del arroyo, y el arroyo sabe a cabra. Quince monedas de oro pagan un albañil, una cuerda y un balde nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le puits du marché a de nouveau verdi. Les enfants boivent au ruisseau, et le ruisseau a un goût de chèvre. Quinze pièces d’or paient un maçon, une corde et un seau neuf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pozzo del mercato è di nuovo verde. I bambini bevono dal ruscello, e il ruscello sa di capra. Con quindici monete d’oro si pagano un muratore, una corda e un secchio nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市場の井戸が、また緑色になりました。子どもたちは小川の水を飲んでいますが、小川は山羊の味がします。金貨15枚あれば、石工と綱と新しい桶が手に入ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O poço do mercado ficou verde de novo. As crianças bebem do riacho, e o riacho tem gosto de cabra. Quinze moedas de ouro pagam um pedreiro, uma corda e um balde novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集市那口井又绿了。孩子们只好喝小溪里的水，溪水一股羊膻味。15金币能雇一个泥瓦匠，买一根绳子和一只新桶。"
          }
        }
      }
    },
    "petition.widow_garden.c1" : {
      "comment" : "Petition widow_garden: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blumen und Bohnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flowers and beans"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flores y habas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des fleurs et des fèves"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiori e fagioli"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "花と豆を植えましょう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flores e feijões"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "种花和豆子"
          }
        }
      }
    },
    "petition.widow_garden.c2" : {
      "comment" : "Petition widow_garden: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Garten mit Heilkräutern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A garden of healing herbs"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un huerto de hierbas medicinales"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jardin de simples"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un orto di erbe medicinali"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "薬草の畑にしましょう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
