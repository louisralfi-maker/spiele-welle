    "petition.plough_harvest.c2" : {
      "comment" : "Petition plough_harvest: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Erntefest für alle"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A harvest feast for all"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fiesta de la cosecha para todos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fête des moissons pour tous"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una festa del raccolto per tutti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "皆で収穫の祭りを"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma festa da colheita para todos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为大家办丰收宴"
          }
        }
      }
    },
    "petition.plough_harvest.c3" : {
      "comment" : "Petition plough_harvest: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behaltet alles, Ihr habt es verdient"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it all, you earned it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quédeselo todo, se lo ha ganado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez tout, vous l’avez mérité"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenete tutto, ve lo siete meritato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部取っておいてくれ。自分の稼ぎだろう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique com tudo, você mereceu"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全留着吧，这是你挣的"
          }
        }
      }
    },
    "petition.plough_harvest.hint" : {
      "comment" : "Petition plough_harvest: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine halbe Ernte füllt die Schatzkammer für einen Tag. Ein Fest füllt die Stadt für einen Monat. Das sehe sogar ich. Feiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half a harvest fills the treasury for a day. A feast fills the town for a month. Even I can see it. Feast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media cosecha llena el tesoro un día. Una fiesta llena al pueblo un mes. Hasta yo lo veo. Fiesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une demi-récolte remplit le trésor pour un jour. Une fête remplit la ville pour un mois. Même moi, je le vois. La fête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezzo raccolto riempie il tesoro per un giorno. Una festa riempie il borgo per un mese. Persino io lo vedo. Fate festa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "半分の収穫で金庫が満ちるのは一日。祭りで町が満ちるのはひと月。わたくしにも分かります。祭りです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meia colheita enche o tesouro por um dia. Uma festa enche a cidade por um mês. Até eu enxergo isso. Festa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "半份收成能让府库满一天。一场宴席能让全镇饱一个月。连我都看得明白。办宴席。"
          }
        }
      }
    },
    "petition.plough_harvest.r1" : {
      "comment" : "Petition plough_harvest: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Säcke gehen auf den Markt, die Münzen in die Schatzkammer. Er wirkt stolz und ein wenig enttäuscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sacks go to market and the coin to the treasury. He looks proud, and a little disappointed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sacos van al mercado y las monedas al tesoro. Él parece orgulloso, y un poco decepcionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sacs partent au marché et les pièces au trésor. Il a l’air fier, et un peu déçu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I sacchi vanno al mercato e le monete nel tesoro. Lui sembra orgoglioso, e un po’ deluso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "袋は市場へ、硬貨は金庫へ。農夫は誇らしげで、少しがっかりしている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os sacos vão para o mercado, e as moedas para o tesouro. Ele parece orgulhoso, e um pouco decepcionado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粮袋送去集市，钱进了府库。他看上去很自豪，又有点失望。"
          }
        }
      }
    },
    "petition.plough_harvest.r2" : {
      "comment" : "Petition plough_harvest: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das gestreifte Zelt steht auf dem Platz, und das Brot ist zur Dämmerung noch warm. Jemand tanzt mit Brannock. Kurz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The striped tent goes up on the square, and the bread is still warm at dusk. Somebody dances with Brannock. Briefly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tienda a rayas se levanta en la plaza, y al anochecer el pan todavía está caliente. Alguien baila con Brannock. Brevemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tente rayée se dresse sur la place, et le pain est encore chaud au crépuscule. Quelqu’un danse avec Brannock. Brièvement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tenda a strisce si alza sulla piazza, e al crepuscolo il pane è ancora caldo. Qualcuno balla con Brannock. Per poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広場に縞模様の天幕が立ち、日暮れになってもパンはまだ温かい。誰かがブラノックと踊る。ほんの少しだけ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tenda listrada sobe na praça, e o pão ainda está quente ao crepúsculo. Alguém dança com Brannock. Por pouco tempo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条纹帐篷在广场上搭了起来，到黄昏面包还是热的。有人拉着布兰诺克跳了支舞。很短。"
          }
        }
      }
    },
    "petition.plough_harvest.r3" : {
      "comment" : "Petition plough_harvest: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er starrt, dann lacht er, dann umarmt er versehentlich die nächste Wache. Die Wache umarmt ihn seltsamerweise zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He stares, then laughs, then hugs the nearest guard by mistake. The guard, oddly, hugs back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda mirando, luego se ríe, luego abraza por error al guardia más cercano. El guardia, curiosamente, le devuelve el abrazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reste bouche bée, puis rit, puis serre dans ses bras le garde le plus proche, par erreur. Le garde, bizarrement, lui rend son étreinte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi fissa, poi ride, poi abbraccia per sbaglio la guardia più vicina. La guardia, stranamente, ricambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "農夫は目を丸くし、それから笑い、それから間違えて近くの衛兵に抱きつく。衛兵は、なぜか抱き返す。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele encara, depois ri, depois abraça o guarda mais próximo por engano. O guarda, estranhamente, retribui o abraço."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他愣住，接着大笑，然后错抱住了离他最近的卫兵。奇怪的是，卫兵也抱住了他。"
          }
        }
      }
    },
    "petition.plough_harvest.text" : {
      "comment" : "Petition plough_harvest (farmer): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, erinnert Ihr Euch an den Pflug, den Ihr gesegnet habt? Das lange Feld trug doppelt! Die ersten Säcke stehen am Tor. Die Hälfte für das Haus, dachte ich, es sei denn, das Haus gönnt der Stadt lieber ein Fest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, remember the plough you blessed? The long field gave double! I brought the first sacks to the gate. Half for the house, I thought, unless the house would rather the town had a feast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, ¿se acuerda del arado que bendijo? ¡El campo largo dio el doble! Traje los primeros sacos a la puerta. La mitad para la casa, pensé, a menos que la casa prefiera darle una fiesta al pueblo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, vous vous souvenez de la charrue que vous avez bénie ? Le long champ a donné le double ! J’ai apporté les premiers sacs à la porte. La moitié pour la maison, je me suis dit, à moins que la maison préfère offrir une fête à la ville."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, vi ricordate l’aratro che avete benedetto? Il campo lungo ha reso il doppio! Ho portato i primi sacchi alla porta. Metà per la casata, pensavo, a meno che la casata non preferisca offrire una festa al borgo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、祝福していただいた鋤を覚えておいでですか。長い畑が倍も実りました！　最初の袋を門まで運んでまいりました。半分はお城に、と思いましたが、町にご馳走を振る舞うほうがよろしければ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, lembra do arado que abençoou? O campo grande deu o dobro! Trouxe os primeiros sacos até o portão. Metade para a casa, pensei, a não ser que a casa prefira que a cidade tenha uma festa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，还记得您祝福过的那把犁吗？那块长田收成翻了一倍！头几袋我已经送到城门口了。我想着一半归城主家，除非城主家更愿意让镇上办一场宴席。"
          }
        }
      }
    },
    "petition.quack_amulets.c1" : {
      "comment" : "Petition quack_amulets: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben und besteuern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licence him, and tax it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darle licencia, y cobrarle impuestos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser et taxer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedere la licenza, e tassarla"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許す。ただし税は取る"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licença, e com imposto"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准他卖，照章征税"
          }
        }
      }
    },
    "petition.quack_amulets.c2" : {
      "comment" : "Petition quack_amulets: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jagt ihn aus dem Tal"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run him out of the valley"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échenlo del valle"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chassez-le de la vallée"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cacciatelo dalla valle"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "谷から追い出してくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expulsem-no do vale"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把他赶出河谷"
          }
        }
      }
    },
    "petition.quack_amulets.c3" : {
      "comment" : "Petition quack_amulets: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutter Hesper soll urteilen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let Mother Hesper judge him"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que lo juzgue Madre Hesper"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que Mère Hesper le juge"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Che lo giudichi Madre Hesper"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘスパーに裁いてもらおう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que a Madre Hesper o julgue"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让赫斯珀嬷嬷来评判"
          }
        }
      }
    },
    "petition.quack_amulets.hint" : {
      "comment" : "Petition quack_amulets: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Betrug, der die Leute schlafen lässt und anständig besteuert wird, heißt Regierung. Erlaubt es ihm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fraud that helps people sleep, taxed at a fair rate, is called a government. Licence him."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fraude que ayuda a dormir a la gente y paga sus impuestos se llama gobierno. Dele la licencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une escroquerie qui aide les gens à dormir, imposée à un taux honnête, ça s’appelle un gouvernement. Accordez-lui la licence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una truffa che aiuta la gente a dormire, tassata con giudizio, si chiama governo. Dategli la licenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人を眠らせ、適正に課税されるいかさまは、政と呼ばれます。お許しなさいませ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma fraude que ajuda o povo a dormir, taxada a um preço justo, se chama governo. Dê a licença."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能让人睡好觉、又照章纳税的骗局，就叫官府。准了他。"
          }
        }
      }
    },
    "petition.quack_amulets.r1" : {
      "comment" : "Petition quack_amulets: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Abend trägt die halbe Stadt ein Blechamulett. Sicherer ist niemand, alle schlafen besser, und die Schatzkammer ist voller."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By evening half the town wears a tin amulet. Nobody is safer, everybody sleeps better, and the treasury is up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al anochecer, medio pueblo lleva un amuleto de hojalata. Nadie está más a salvo, todos duermen mejor y el tesoro ha subido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le soir, la moitié de la ville porte une amulette en fer-blanc. Personne n’est plus en sécurité, tout le monde dort mieux, et le trésor s’est rempli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entro sera mezzo borgo porta un amuleto di latta. Nessuno è più al sicuro, tutti dormono meglio, e il tesoro cresce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夕方には、町の半分が錫のお守りを下げている。誰ひとり安全にはなっていないが、皆よく眠れ、金庫は潤う。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À noitinha, meia cidade usa um amuleto de lata. Ninguém está mais seguro, todo mundo dorme melhor, e o tesouro engorda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到傍晚，半个镇子的人都戴上了锡护身符。谁也没更安全，人人睡得更香，府库也鼓了。"
          }
        }
      }
    },
    "petition.quack_amulets.r2" : {
      "comment" : "Petition quack_amulets: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er geht in Eile und verliert dabei Amulette. Die Kinder sammeln sie und tauschen sie gegen Murmeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He leaves in a hurry, dropping amulets. The children collect them and trade them for marbles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se marcha a toda prisa, perdiendo amuletos. Los niños los recogen y los cambian por canicas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il part en hâte, en semant des amulettes. Les enfants les ramassent et les échangent contre des billes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ne va di corsa, perdendo amuleti per strada. I bambini li raccolgono e li scambiano con le biglie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "男は大慌てで去り、お守りをぽろぽろ落としていく。子どもたちがそれを拾い集め、ビー玉と交換する。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele sai às pressas, deixando cair amuletos. As crianças os recolhem e trocam por bolinhas de gude."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他匆匆离去，一路掉护身符。孩子们捡起来，拿去换弹珠。"
          }
        }
      }
    },
    "petition.quack_amulets.r3a" : {
      "comment" : "Petition quack_amulets: choice 3, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper hält ein Amulett in die Flamme. Es schmilzt zu einer Pfütze aus Blech, und die Menge lacht ihn aus dem Tal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper holds an amulet to the Flame. It melts into a puddle of tin, and the crowd laughs him out of the valley."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper acerca un amuleto a la Llama. Se derrite en un charquito de hojalata, y la gente lo echa del valle a carcajadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper approche une amulette de la Flamme. Elle fond en une flaque de fer-blanc, et la foule le chasse de la vallée sous les rires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper accosta un amuleto alla Fiamma. Si scioglie in una pozza di latta, e la folla lo caccia dalla valle a risate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘスパーがお守りを一つ、炎にかざす。それは溶けて錫の水たまりになり、男は群衆の笑い声に追われて谷を出ていく。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper aproxima um amuleto da Chama. Ele derrete numa poça de lata, e a multidão o expulsa do vale às gargalhadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赫斯珀把一枚护身符凑近圣焰。它化成了一摊锡水，人群哄笑着把他赶出了河谷。"
          }
        }
      }
    },
    "petition.quack_amulets.r3b" : {
      "comment" : "Petition quack_amulets: choice 3, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper hält ein Amulett in die Flamme, die golden auflodert. Sie runzelt die Stirn und schweigt. Bis Mittag ist er ausverkauft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper holds an amulet to the Flame, which flares up gold. She frowns and says nothing. He sells out by noon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper acerca un amuleto a la Llama, que se aviva dorada. Frunce el ceño y no dice nada. Al mediodía él lo ha vendido todo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper approche une amulette de la Flamme, qui jette un éclat doré. Elle fronce les sourcils et ne dit rien. À midi, il a tout vendu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper accosta un amuleto alla Fiamma, che divampa d’oro. Aggrotta la fronte e non dice nulla. A mezzogiorno lui ha venduto tutto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘスパーがお守りを一つ炎にかざすと、炎は金色に燃え上がる。彼女は眉をひそめ、何も言わない。男は昼までに売り切る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper aproxima um amuleto da Chama, que se ergue dourada. Ela franze a testa e não diz nada. Ao meio-dia, ele já vendeu tudo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赫斯珀把一枚护身符凑近圣焰，焰光腾地变成了金色。她皱起眉，一言不发。不到中午，他的货就卖光了。"
          }
        }
      }
    },
    "petition.quack_amulets.text" : {
      "comment" : "Petition quack_amulets (merchant): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Gnädigster Burgherr|Gnädigste Burgherrin}, ich verkaufe Amulette der Flamme, jedes gegen die Düsternis gesegnet, zwei Kupfer das Stück. Die Priesterin nennt mich einen Betrüger. Ich nenne es Glauben zum fairen Preis. Ich bitte um Eure Erlaubnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most gracious {lord|lady}, I sell amulets of the Flame, each blessed against the Gloom, two coppers apiece. The priestess calls me a fraud. I call it faith at a fair price. I ask your licence to trade."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Generosísimo señor|Generosísima señora}, vendo amuletos de la Llama, todos bendecidos contra la Penumbra, a dos cobres cada uno. La sacerdotisa dice que soy un farsante. Yo lo llamo fe a precio justo. Pido su licencia para comerciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Très {gracieux seigneur|gracieuse dame}, je vends des amulettes de la Flamme, chacune bénie contre la Pénombre, deux sous pièce. La prêtresse me traite d’escroc. Moi, j’appelle ça la foi à juste prix. Je vous demande licence de commercer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Magnanimo signore|Magnanima signora}, vendo amuleti della Fiamma, ciascuno benedetto contro la Penombra, due soldi l’uno. La sacerdotessa mi chiama impostore. Io la chiamo fede a prezzo onesto. Chiedo la vostra licenza per commerciare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いとも慈悲深き城主様、私は炎のお守りを商っております。どれも宵闇よけの祝福つき、一つ銅貨2枚。司祭様は私をいかさま師と呼びます。私は、まっとうな値の信心と呼んでおります。商いのお許しをいただきたく。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu mui gracioso senhor|Minha mui graciosa senhora}, vendo amuletos da Chama, cada um abençoado contra a Penumbra, a dois tostões a peça. A sacerdotisa me chama de charlatão. Eu chamo de fé a preço justo. Peço a sua licença para comerciar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最仁慈的城主大人，我卖圣焰护身符，每一枚都受过祝福，能抵挡暗霭，两个铜板一枚。女祭司说我是骗子。我说这是公道价的信仰。恳请您准许我做买卖。"
          }
        }
      }
    },
    "petition.refugees_gate.c1" : {
      "comment" : "Petition refugees_gate: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasst alle herein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let them all in"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que entren todos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites-les tous entrer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fateli entrare tutti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "皆、中へ入れよう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixem todos entrar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让他们都进来"
          }
        }
      }
    },
    "petition.refugees_gate.c2" : {
      "comment" : "Petition refugees_gate: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Kinder und die Alten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the children and the old"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los niños y los ancianos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement les enfants et les vieux"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo i bambini e i vecchi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "子どもと年寄りだけだ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só as crianças e os velhos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只让孩子和老人进来"
          }
        }
      }
    },
    "petition.refugees_gate.c3" : {
      "comment" : "Petition refugees_gate: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt sie fort"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn them away"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que se vayan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renvoyez-les"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mandateli via"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追い返してくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mandem-nos embora"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让他们走"
          }
        }
      }
    },
    "petition.refugees_gate.hint" : {
      "comment" : "Petition refugees_gate: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sechs Mäuler eine Woche vor dem Ende, und keine einzige Mauer dafür. Die Talstraße ist offen. Ich weiß, wie das klingt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Six mouths a week before the end, and not one wall to show for them. The valley road is open. I know how that sounds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seis bocas a una semana del final, y ni una muralla a cambio. El camino del valle está abierto. Ya sé cómo suena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Six bouches une semaine avant la fin, et pas une muraille en échange. La route de la vallée est ouverte. Je sais, c’est dur à entendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei bocche a una settimana dalla fine, e nemmeno un muro in cambio. La strada della valle è aperta. So che effetto fa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終わりまで一週間というときに、口が6つ。城壁はひとつも増えません。谷の道は開いております。どう聞こえるかは、承知しております。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seis bocas a uma semana do fim, e nem uma muralha a mais por causa delas. A estrada do vale está aberta. Eu sei como isso soa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终局前一周多出六张嘴，却换不来一堵墙。河谷的路是通的。我知道这话有多难听。"
          }
        }
      }
    },
    "petition.refugees_gate.r1" : {
      "comment" : "Petition refugees_gate: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schweigend kommen sie durch das Tor, dann alle auf einmal unter Tränen. Tamsin schöpft schon Suppe, bevor jemand sie darum bittet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They come through the gate in silence, then all at once in tears. Tamsin is ladling soup before anyone asks her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cruzan la puerta en silencio y, de pronto, todos rompen a llorar. Tamsin ya está sirviendo sopa sin que nadie se lo pida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils passent la porte en silence, puis fondent tous en larmes d’un coup. Tamsin sert la soupe avant que quiconque le lui demande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passano la porta in silenzio, poi tutti insieme scoppiano in lacrime. Tamsin sta già versando la zuppa prima che qualcuno glielo chieda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彼らは黙って門をくぐり、それからいっせいに泣き崩れる。誰に言われるより先に、タムシンがもうスープをよそっている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passam pelo portão em silêncio, depois todos de uma vez, aos prantos. Tamsin já serve sopa antes que alguém peça."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们默默走进城门，随即一齐哭了出来。没人吩咐，塔姆辛已经在舀汤了。"
          }
        }
      }
    },
    "petition.refugees_gate.r2" : {
      "comment" : "Petition refugees_gate: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei treten ein. Drei gehen wortlos den Weg zurück, den sie kamen. Im Saal sieht niemand den anderen an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three walk in. Three turn back the way they came without a word. Nobody in the hall looks at anybody else."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entran tres. Los otros tres vuelven por donde vinieron, sin una palabra. En el salón nadie mira a nadie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois entrent. Trois repartent par où ils sont venus, sans un mot. Dans la salle, personne ne regarde personne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre entrano. Tre tornano indietro per la strada da cui sono venuti, senza una parola. Nel salone nessuno guarda in faccia nessuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3人が入る。残る3人は何も言わずに、来た道を引き返す。大広間の誰も、互いの顔を見ない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Três entram. Três voltam pelo caminho de onde vieram, sem uma palavra. No salão, ninguém olha para ninguém."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三个人走了进来。另外三个一言不发，原路折返。大厅里谁也不看谁。"
          }
        }
      }
    },
    "petition.refugees_gate.r3" : {
      "comment" : "Petition refugees_gate: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie gehen zurück, wie sie gekommen sind. Die Wache am Tor bittet um frühe Ablösung und sagt nicht, warum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They go back the way they came. The guard on the gate asks to be relieved early and does not say why."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelven por donde vinieron. El guardia de la puerta pide el relevo antes de tiempo y no dice por qué."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils repartent par où ils sont venus. Le garde de la porte demande à être relevé plus tôt et ne dit pas pourquoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tornano da dove sono venuti. La guardia alla porta chiede il cambio in anticipo e non dice perché."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彼らは来た道を戻っていく。門の衛兵は早めの交代を願い出て、理由は言わない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles voltam por onde vieram. O guarda do portão pede para ser rendido mais cedo e não diz por quê."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们原路返回。城门的卫兵要求提早换岗，也不说为什么。"
          }
        }
      }
    },
    "petition.refugees_gate.text" : {
      "comment" : "Petition refugees_gate (refugee, story days 13-14): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir kommen aus Beaconfoot, dem Weiler der Hüter an der Mündung des Schlunds, dem ersten, den die Düsternis fraß. Sechs sind wir noch. Neun Nächte versteckten wir uns in seinen Höhlen, die Kleinen im Arm. Wir können graben, flicken, kochen, kämpfen. Wir bitten um ein Dach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We come from Beaconfoot, the keepers’ hamlet at the Throat’s mouth, the first the Gloom ate. Six of us are left. We hid nine nights in the Throat’s caves, carrying the little ones. We can dig, mend, cook and fight. We ask for a roof."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venimos de Beaconfoot, la aldea de los guardianes en la boca de la Garganta, la primera que se tragó la Penumbra. Quedamos seis. Nos escondimos nueve noches en las cuevas de la Garganta, cargando a los pequeños. Sabemos cavar, remendar, cocinar y luchar. Pedimos un techo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous venons de Beaconfoot, le hameau des gardiens à la bouche de la Gorge, le premier que la Pénombre a dévoré. Nous ne sommes plus que six. Nous avons passé neuf nuits cachés dans ses grottes, à porter les petits. Nous savons creuser, réparer, cuisiner, nous battre. Nous demandons un toit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veniamo da Beaconfoot, il villaggio dei custodi alla bocca della Gola, il primo che la Penombra ha divorato. Siamo rimasti in sei. Ci siamo nascosti nove notti nelle grotte della Gola, con i piccoli in braccio. Sappiamo scavare, rammendare, cucinare e combattere. Chiediamo un tetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私たちはビーコンフットから来ました。喉谷の口にある守り手たちの村、宵闇に最初に呑まれた村です。残ったのは6人。小さい子を抱えて、喉谷の洞穴に9晩隠れていました。土も掘れますし、繕い物も、料理も、戦いもできます。屋根をひとつ、お願いします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viemos de Beaconfoot, o povoado dos guardiões na boca da Garganta, o primeiro que a Penumbra devorou. Restamos seis. Nos escondemos nove noites nas cavernas da Garganta, carregando os pequenos. Sabemos cavar, consertar, cozinhar e lutar. Pedimos um teto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们来自比肯富特，喉谷口守护人的小村，暗霭吞掉的第一个村子。我们只剩六个人了。我们抱着孩子，在喉谷的山洞里躲了九夜。我们会挖土、修补、做饭，也会打仗。我们只求一片屋顶。"
          }
        }
      }
    },
    "petition.scarecrow.c1" : {
      "comment" : "Petition scarecrow: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behaltet sie"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quédenselo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez-le"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenetelo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残しておいていいよ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podem ficar com ele"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留着吧"
          }
        }
      }
    },
    "petition.scarecrow.c2" : {
      "comment" : "Petition scarecrow: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebt ihr lieber einen Stirnreif"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give it a circlet instead"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejor pónganle un aro"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez-lui plutôt un cercle"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettetegli piuttosto un cerchio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代わりに額輪をかぶせてごらん"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deem um aro a ele, então"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给它换上一个额环"
          }
        }
      }
    },
    "petition.scarecrow.c3" : {
      "comment" : "Petition scarecrow: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauptmann Brannock hat recht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captain Brannock is right"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El capitán Brannock tiene razón"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le capitaine Brannock a raison"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il capitano Brannock ha ragione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隊長の言うとおりだよ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O capitão Brannock tem razão"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布兰诺克队长说得对"
          }
        }
      }
    },
    "petition.scarecrow.hint" : {
      "comment" : "Petition scarecrow: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie verscheucht Krähen und ärgert Brannock. Ich sehe keinen Nachteil. Behaltet sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It frightens crows and annoys Brannock. I fail to see a downside. Keep it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espanta cuervos y fastidia a Brannock. No le veo ninguna desventaja. Que se lo queden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il effraie les corneilles et agace Brannock. Je ne vois pas d’inconvénient. Gardez-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spaventa le cornacchie e irrita Brannock. Non vedo svantaggi. Tenetelo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烏を追い払い、ブラノックを苛立たせる。悪い点が見当たりません。お残しなさいませ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assusta os corvos e irrita Brannock. Não vejo desvantagem. Fiquem com ele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它能吓跑乌鸦，还能气着布兰诺克。我看不出有什么坏处。留着吧。"
          }
        }
      }
    },
    "petition.scarecrow.r1" : {
      "comment" : "Petition scarecrow: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vogelscheuche bewacht das ferne Feld. Brannock macht jeden Tag einen großen Bogen um sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scarecrow guards the far field. Brannock walks a long way round it, every single day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El espantapájaros vigila el campo del fondo. Brannock da un gran rodeo para evitarlo, todos los días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’épouvantail garde le champ du fond. Brannock fait un grand détour, tous les jours sans exception."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spaventapasseri fa la guardia al campo lontano. Brannock gli gira alla larga, tutti i santi giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "案山子は遠くの畑を守っている。ブラノックは毎日欠かさず、ずいぶん遠回りしてその脇を通る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O espantalho guarda o campo distante. Brannock dá uma volta enorme em torno dele, todo santo dia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稻草人守着远处的田。布兰诺克每天都要绕一大圈避开它。"
          }
        }
      }
    },
    "petition.scarecrow.r2" : {
      "comment" : "Petition scarecrow: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt sieht sie aus wie Ihr. Die Krähen haben überhaupt keine Angst. Die Kinder sagen, das liegt daran, dass die Krähen Euch mögen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now it looks like you. The crows are not scared at all. The children say it is because the crows like you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora se parece a usted. Los cuervos no le tienen ningún miedo. Los niños dicen que es porque usted les cae bien a los cuervos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenant, il vous ressemble. Les corneilles n’ont pas peur du tout. Les enfants disent que c’est parce que les corneilles vous aiment bien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora somiglia a voi. Le cornacchie non hanno nessuna paura. I bambini dicono che è perché le cornacchie vi vogliono bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今度はあなたそっくりだ。烏はまるで怖がらない。烏が城主様を好きだからだ、と子どもたちは言う。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora ele se parece com você. Os corvos não têm medo nenhum. As crianças dizem que é porque os corvos gostam de você."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在它像你了。乌鸦一点也不怕。孩子们说，那是因为乌鸦喜欢你。"
          }
        }
      }
    },
    "petition.scarecrow.r3" : {
      "comment" : "Petition scarecrow: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vogelscheuche kommt weg, der Eimer zurück an den Brunnen. Irgendwo beschließt ein Kind, niemals Soldat zu werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scarecrow comes down and the bucket goes back to the well. Somewhere a child decides never to be a soldier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El espantapájaros se desmonta y el balde vuelve al pozo. En algún lugar, un niño decide que nunca será soldado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’épouvantail est démonté et le seau retourne au puits. Quelque part, un enfant décide de ne jamais devenir soldat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spaventapasseri viene tolto e il secchio torna al pozzo. Da qualche parte un bambino decide che non farà mai il soldato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "案山子は取り壊され、桶は井戸に戻る。どこかで一人の子どもが、兵士には決してなるまいと心に決める。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O espantalho é desmontado, e o balde volta para o poço. Em algum lugar, uma criança decide nunca ser soldado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稻草人拆了，水桶回到了井边。某处，一个孩子决定这辈子都不当兵了。"
          }
        }
      }
    },
    "petition.scarecrow.text" : {
      "comment" : "Petition scarecrow (child): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, wir haben eine Vogelscheuche fürs ferne Feld gebaut und sie wie Hauptmann Brannock aussehen lassen, mit einem Eimer als Helm, weil nichts gruseliger ist. Er sagt, sie muss weg. Dürfen wir sie behalten? Bitte?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, we built a scarecrow for the far field and made it look like Captain Brannock, with a bucket for a helmet, because nothing is scarier. He says it must come down. Can we keep it? Please?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, hicimos un espantapájaros para el campo del fondo y le pusimos la cara del capitán Brannock, con un balde de yelmo, porque no hay nada que dé más miedo. Él dice que hay que quitarlo. ¿Podemos quedárnoslo? ¿Por favor?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, on a fait un épouvantail pour le champ du fond, et on lui a donné l’air du capitaine Brannock, avec un seau pour casque, parce que rien ne fait plus peur. Il dit qu’il faut l’enlever. On peut le garder ? S’il vous plaît ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, abbiamo fatto uno spaventapasseri per il campo lontano e l’abbiamo fatto uguale al capitano Brannock, con un secchio per elmo, perché non c’è niente di più spaventoso. Lui dice che va tolto. Possiamo tenerlo? Per favore?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、遠くの畑に案山子を作ったの。ブラノック隊長そっくりにして、兜の代わりに桶をかぶせたんだ。あれより怖いものはないから。隊長は取り壊せって言うの。残しておいてもいい？　お願い！"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, a gente fez um espantalho para o campo distante e deixou ele igualzinho ao capitão Brannock, com um balde de elmo, porque não existe nada mais assustador. Ele diz que tem de tirar. A gente pode ficar com ele? Por favor?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，我们给远处的田扎了个稻草人，把它扮成布兰诺克队长的样子，拿水桶当头盔，因为没什么比他更吓人了。他说必须拆掉。我们能留着吗？求您了！"
          }
        }
      }
    },
    "petition.scout_report.c1" : {
      "comment" : "Petition scout_report: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Pech kaufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy the pitch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprar la brea"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acheter la poix"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprare la pece"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀝青を買う"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprar o piche"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "买沥青"
          }
        }
      }
    },
    "petition.scout_report.c2" : {
      "comment" : "Petition scout_report: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdoppelt lieber die Wache"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double the watch instead"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejor doblar la guardia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doublez plutôt la garde"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raddoppiate piuttosto la guardia"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代わりに見張りを倍にしてくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melhor dobrar a guarda"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不如加倍岗哨"
          }
        }
      }
    },
    "petition.scout_report.c3" : {
      "comment" : "Petition scout_report: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Späher sehen überall Schatten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scouts see shadows everywhere"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los exploradores ven sombras en todas partes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éclaireurs voient des ombres partout"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli esploratori vedono ombre ovunque"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "斥候には何でも影に見える"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batedores veem sombras por toda parte"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "斥候看哪儿都是影子"
          }
        }
      }
    },
    "petition.scout_report.hint" : {
      "comment" : "Petition scout_report: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwanzig Gold Pech gegen zwei Unholde. Brannock würde das Doppelte zahlen. Kauft es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twenty gold of pitch against two brutes. Brannock would pay double. Buy it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veinte monedas de oro de brea contra dos bestias. Brannock pagaría el doble. Cómprela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vingt pièces d’or de poix contre deux brutes. Brannock paierait le double. Achetez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venti monete d’oro di pece contro due bruti. Brannock pagherebbe il doppio. Compratela."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灰鬼二体に、瀝青で金貨20枚。ブラノックなら倍払うでしょう。買いです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinte moedas de ouro de piche contra dois brutamontes. Brannock pagaria o dobro. Compre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20金币的沥青，对付两个灰蛮。布兰诺克愿意出双倍。买吧。"
          }
        }
      }
    },
    "petition.scout_report.r1" : {
      "comment" : "Petition scout_report: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Nacht brennen die Pfahlgruben wie Lampen, und zwei große Gestalten kehren rauchend in den Nebel zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That night the stake pits burn like lamps, and two great shapes turn back into the fog, smoking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa noche los fosos de estacas arden como lámparas, y dos grandes siluetas vuelven humeando a la niebla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette nuit-là, les fosses à pieux brûlent comme des lampes, et deux grandes formes repartent dans le brouillard en fumant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quella notte le fosse a pali ardono come lampade, e due grandi sagome tornano fumanti nella nebbia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その夜、杭穴は灯火のように燃え、大きな影が二つ、煙を上げながら霧の中へ引き返していく。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naquela noite, os fossos de estacas ardem como lampiões, e duas formas enormes voltam para a névoa, fumegando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那一夜，尖桩坑烧得像一盏盏灯，两个庞大的身影冒着烟退回了雾里。"
          }
        }
      }
    },
    "petition.scout_report.r2" : {
      "comment" : "Petition scout_report: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wache wird verdoppelt und ist um Mitternacht müde. Die Unholde kommen trotzdem, aber wenigstens sieht sie jeder kommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The watch is doubled and tired by midnight. The brutes come anyway, but at least everyone sees them coming."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La guardia se dobla y a medianoche ya está cansada. Las bestias vienen igual, pero al menos todos las ven venir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La garde est doublée, et fourbue à minuit. Les brutes viennent quand même, mais au moins, tout le monde les voit venir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La guardia viene raddoppiata, e a mezzanotte è stanca. I bruti arrivano lo stesso, ma almeno tutti li vedono arrivare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見張りは倍になり、真夜中には疲れ果てている。それでも灰鬼は来るが、少なくとも誰もがその姿を見る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A guarda é dobrada e está exausta à meia-noite. Os brutamontes vêm mesmo assim, mas pelo menos todo mundo os vê chegando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "岗哨加了倍，不到半夜就都累了。灰蛮还是来了，不过至少大家都看见它们来了。"
          }
        }
      }
    },
    "petition.scout_report.r3" : {
      "comment" : "Petition scout_report: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Späher salutiert und geht. Im Morgengrauen lehnt eine Rampe aus Geröll an der äußeren Linie, mannshoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scout salutes and goes. At dawn a ramp of scree leans against the outer line, as high as a man."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El explorador saluda y se va. Al alba, una rampa de cascajo se apoya en la línea exterior, alta como un hombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’éclaireur salue et s’en va. À l’aube, une rampe d’éboulis haute comme un homme s’appuie contre la ligne extérieure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’esploratore saluta e se ne va. All’alba una rampa di pietrisco alta come un uomo è appoggiata alla linea esterna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "斥候は敬礼して去る。夜明け、人の背丈ほどの瓦礫の坂が、外の防衛線に寄りかかっている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O batedor saúda e sai. Na alvorada, uma rampa de cascalho se apoia na linha externa, da altura de um homem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "斥候敬了个礼，走了。黎明时，一道碎石坡道斜靠在外防线上，有一人高。"
          }
        }
      }
    },
    "petition.scout_report.text" : {
      "comment" : "Petition scout_report (soldier): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}, ich bin letzte Nacht bis an den Nebel geschlichen. Unholde, mindestens drei, die Geröll an die äußere Linie schichten wie eine Rampe. Ein Fass Pech auf den Pfählen würde sie verbrennen. Pech kostet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, I crept to the edge of the fog last night. Brutes, three at least, piling scree against the outer line like a ramp. A barrel of pitch on the stakes would burn them. Pitch costs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Señor|Señora}, anoche me arrastré hasta el borde de la niebla. Bestias, tres por lo menos, amontonando cascajo contra la línea exterior como una rampa. Un barril de brea sobre las estacas las quemaría. La brea cuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, je me suis glissé jusqu’au bord du brouillard la nuit dernière. Des brutes, trois au moins, qui entassent des éboulis contre la ligne extérieure comme une rampe. Un tonneau de poix sur les pieux les brûlerait. La poix, ça coûte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Signore|Signora}, la notte scorsa sono strisciato fino al margine della nebbia. Bruti, almeno tre, che ammucchiano pietrisco contro la linea esterna come una rampa. Un barile di pece sui pali li brucerebbe. La pece costa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主、ゆうべ霧の際まで忍んでいきました。灰鬼が少なくとも三体、外の防衛線に瓦礫を積み上げています。坂道みたいに。杭に瀝青を一樽まけば、焼き払えます。瀝青には金がかかりますが。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Senhor|Senhora}, ontem à noite rastejei até a beira da névoa. Brutamontes, três pelo menos, empilhando cascalho contra a linha externa feito uma rampa. Um barril de piche nas estacas os queimaria. Piche custa caro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主，昨夜我摸到了雾边。灰蛮，至少三个，在往外防线上堆碎石，像在搭坡道。往尖桩上浇一桶沥青，就能烧了它们。沥青要花钱。"
          }
        }
      }
    },
    "petition.seren_at_gate.c1" : {
      "comment" : "Petition seren_at_gate: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diesmal öffne ich"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the gate this time"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta vez abro la puerta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette fois, j’ouvre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stavolta aprite la porta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今度は門を開けよう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desta vez, eu abro"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这次开门"
          }
        }
      }
    },
    "petition.seren_at_gate.c2" : {
      "comment" : "Petition seren_at_gate: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt den Rest von dort"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say the rest from there"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga el resto desde ahí"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites le reste d’où vous êtes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dite il resto da lì"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続きはそこから話してくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga o resto daí mesmo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其余的，就在那儿说吧"
          }
        }
      }
    },
    "petition.seren_at_gate.hint" : {
      "comment" : "Petition seren_at_gate: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie kam zurück, nachdem wir ihr die Tür vor der Nase zugeschlagen haben. Entweder ist sie verrückt, oder wir brauchen sie. Vermutlich beides. Lasst sie herein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She came back after we shut the door in her face. Either she is mad or we need her. Both, I expect. Let her in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volvió después de que le diéramos con la puerta en las narices. O está loca o la necesitamos. Las dos cosas, supongo. Déjela entrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle est revenue après qu’on lui a fermé la porte au nez. Ou elle est folle, ou nous avons besoin d’elle. Les deux, j’imagine. Faites-la entrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È tornata dopo che le abbiamo chiuso la porta in faccia. O è pazza o abbiamo bisogno di lei. Tutte e due, immagino. Fatela entrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "門前払いを食わせたのに、戻ってきたのです。正気でないか、こちらに入り用か。おそらく両方でしょう。お入れなさいませ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela voltou depois que batemos a porta na cara dela. Ou é louca, ou precisamos dela. As duas coisas, imagino. Deixe-a entrar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们当着她的面关了门，她又回来了。她要么疯了，要么我们需要她。我猜两者都是。让她进来。"
          }
        }
      }
    },
    "petition.seren_at_gate.r1" : {
      "comment" : "Petition seren_at_gate: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie tritt ein, als wäre sie nie fort gewesen, und hängt ihre graue Laterne in die hinterste Ecke des Saals. „Danke“, sagt sie. Einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She walks in as if she had never left and hangs her grey lantern in the hall’s far corner. “Thank you,” she says. Once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra como si nunca se hubiera ido y cuelga su farol gris en el rincón más apartado del salón. «Gracias», dice. Una sola vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle entre comme si elle n’était jamais partie et suspend sa lanterne grise dans le coin le plus reculé de la salle. « Merci », dit-elle. Une fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra come se non se ne fosse mai andata e appende la sua lanterna grigia nell’angolo più lontano del salone. «Grazie», dice. Una volta sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セレンは一度も去らなかったかのように入ってきて、灰色のランタンを大広間の奥の隅に掛ける。「ありがとうございます」と言う。一度だけ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela entra como se nunca tivesse partido e pendura a lanterna cinzenta no canto mais distante do salão. “Obrigada”, diz ela. Uma vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她走进来，仿佛从未离开，把灰提灯挂在大厅最远的角落。“谢谢。”她说。只说了一次。"
          }
        }
      }
    },
    "petition.seren_at_gate.r2" : {
      "comment" : "Petition seren_at_gate: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Haltet ihn im Licht, bis er fällt“, ruft sie. „Ich warte am Rand des Dunkels.“ Dann ist das graue Licht fort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Hold him in the light until he falls,” she calls. “I will wait at the edge of the dark.” Then the grey light is gone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Manténgalo en la luz hasta que caiga», grita. «Esperaré al borde de la oscuridad.» Luego la luz gris desaparece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Gardez-le dans la lumière jusqu’à ce qu’il tombe, lance-t-elle. J’attendrai à la lisière de l’obscurité. » Puis la lumière grise disparaît."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Tenetelo nella luce finché non cade», grida. «Aspetterò sul limitare del buio.» Poi la luce grigia scompare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「あの人が倒れるまで、光の中に留めてください」と、セレンが呼ばわる。「私は闇の縁で待っています」。そして灰色の光は消える。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Mantenha-o na luz até ele cair”, diz ela em voz alta. “Vou esperar na beira do escuro.” Então a luz cinzenta some."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“让他留在光里，直到他倒下，”她喊道，“我会在黑暗的边缘等候。”随后，灰光消失了。"
          }
        }
      }
    },
    "petition.seren_at_gate.text" : {
      "comment" : "Petition seren_at_gate (seren, story days 15-16): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr habt Euer Tor verschlossen gehalten, Lantern. Ich verüble es Euch nicht. Aber hört dies durch das Tor: Aldric ist nicht gefallen. Das Dunkel hat ihn nicht getötet. Es hat ihn gekrönt. Nur im Licht des Großen Leuchtfeuers ist er verwundbar. Ich bin Seren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You kept your gate shut, Lantern. I do not blame you. But hear this through it: Aldric did not fall. The dark did not kill him. It crowned him. Only in the Great Beacon’s light can he be hurt. I am Seren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantuvo su puerta cerrada, {farolero|farolera}. No se lo reprocho. Pero escuche esto, puerta de por medio: Aldric no cayó. La oscuridad no lo mató. Lo coronó. Solo a la luz de la Gran Almenara se le puede herir. Soy Seren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez gardé votre porte fermée, lampiste. Je ne vous en veux pas. Mais écoutez ceci à travers elle : Aldric n’est pas tombé. L’obscurité ne l’a pas tué. Elle l’a couronné. Seule la lumière du Grand Fanal peut le blesser. Je suis Seren."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avete tenuto chiusa la vostra porta, {lampionaio|lampionaia}. Non ve ne faccio una colpa. Ma ascoltatemi, anche con la porta di mezzo: Aldric non è caduto. Il buio non l’ha ucciso. L’ha incoronato. Solo nella luce del Grande Faro lo si può ferire. Io sono Seren."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "門を閉ざしたままでしたね、灯り番。責めはしません。でも、門越しに聞いてください。アルドリックは倒れていません。闇はあの人を殺さなかった。冠を戴かせたのです。大烽火の光の中でしか、あの人を傷つけることはできません。私はセレン。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manteve o seu portão fechado, {acendedor de lampiões|acendedora de lampiões}. Não guardo rancor. Mas ouça isto daí mesmo, pelo portão: Aldric não caiu. O escuro não o matou. O escuro o coroou. Só na luz do Grande Farol ele pode ser ferido. Eu sou Seren."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您一直关着门，点灯人。我不怪您。但请隔着门听好：奥德里克没有倒下。黑暗没有杀死他。它为他戴上了王冠。只有在大烽火的光里，他才会受伤。我是塞伦。"
          }
        }
      }
    },
    "petition.seren_reveal.c1" : {
      "comment" : "Petition seren_reveal: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann holen wir ihn heim"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then we bring him home"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entonces lo traeremos a casa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alors, nous le ramènerons"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allora lo riportiamo a casa"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "なら、連れて帰ろう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Então vamos trazê-lo para casa"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那我们就接他回家"
          }
        }
      }
    },
    "petition.seren_reveal.c2" : {
      "comment" : "Petition seren_reveal: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt der Stadt die Wahrheit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell the town the truth"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntele la verdad al pueblo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites la vérité à la ville"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dite al borgo la verità"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "町に本当のことを伝えてくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conte a verdade à cidade"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把真相告诉镇上"
          }
        }
      }
    },
    "petition.seren_reveal.c3" : {
      "comment" : "Petition seren_reveal: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warum erst jetzt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why tell me only now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Por qué me lo dice solo ahora?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi seulement maintenant ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perché me lo dite solo ora?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "なぜ今になって話す？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por que me contar só agora?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为什么现在才告诉我？"
          }
        }
      }
    },
    "petition.seren_reveal.hint" : {
      "comment" : "Petition seren_reveal: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich weiß nicht, wie man einen Burgherrn begräbt, der noch herumläuft. Ihn heimzuholen klingt ordentlicher. Versprecht es ihr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have no idea how to bury a lord who is still walking. Bringing him home sounds tidier. Promise her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tengo la menor idea de cómo se entierra a un señor que sigue caminando. Traerlo a casa suena más ordenado. Prométaselo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne sais pas du tout comment on enterre un seigneur qui marche encore. Le ramener paraît plus propre. Promettez-le-lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ho idea di come si seppellisca un signore che va ancora in giro. Riportarlo a casa mi pare più ordinato. Promettetelo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ歩き回っている城主の葬り方など、見当もつきません。連れ帰るほうが、まだ片づきがよさそうです。約束してさしあげるのがよろしいかと。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não faço ideia de como enterrar um senhor que ainda anda por aí. Trazê-lo para casa parece mais arrumado. Prometa a ela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一位还在走动的城主，我不知道该怎么下葬。把他接回家，听起来利落些。答应她吧。"
          }
        }
      }
    },
    "petition.seren_reveal.r1" : {
      "comment" : "Petition seren_reveal: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren sieht Euch lange an. „Haltet ihn im Licht, bis er fällt. Dann findet meine Laterne, was von ihm übrig ist.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren looks at you for a long time. “Hold him in the light until he falls. Then my lantern can find what is left of him.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren le sostiene la mirada largo rato. «Manténgalo en la luz hasta que caiga. Entonces mi farol podrá encontrar lo que quede de él.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren vous regarde longuement. « Gardez-le dans la lumière jusqu’à ce qu’il tombe. Alors ma lanterne pourra retrouver ce qui reste de lui. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren vi guarda a lungo. «Tenetelo nella luce finché non cade. Allora la mia lanterna potrà trovare ciò che resta di lui.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セレンは長いあいだ、こちらを見つめる。「あの人が倒れるまで、光の中に留めてください。そうすれば、私のランタンが、あの人の残ったものを見つけられる」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seren olha para você por um longo tempo. “Mantenha-o na luz até ele cair. Então a minha lanterna poderá encontrar o que restar dele.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "塞伦久久地看着你。“让他留在光里，直到他倒下。那时，我的提灯就能找到他还剩下的那一部分。”"
          }
        }
      }
    },
    "petition.seren_reveal.r2a" : {
      "comment" : "Petition seren_reveal: choice 2, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachricht läuft durchs Tal wie Feuer durchs Stroh. Die Alten weinen, und jemand hängt Aldrics Farben an die Mühle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The news runs through the valley like fire through straw. Old folk weep, and someone hangs Aldric’s colours from the mill."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La noticia recorre el valle como fuego en la paja. Los viejos lloran, y alguien cuelga los colores de Aldric en el molino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nouvelle court dans la vallée comme le feu dans la paille. Les vieux pleurent, et quelqu’un suspend les couleurs d’Aldric au moulin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La notizia corre per la valle come fuoco nella paglia. I vecchi piangono, e qualcuno appende i colori di Aldric al mulino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知らせは、藁に火がつくように谷を駆けめぐる。年寄りたちは泣き、誰かが水車小屋にアルドリックの旗印を掲げる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A notícia corre pelo vale como fogo em palha. Os velhos choram, e alguém pendura as cores de Aldric no moinho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消息在河谷里传开，像火烧干草。老人们落泪，有人把奥德里克的旗帜挂上了磨坊。"
          }
        }
      }
    },
    "petition.seren_reveal.r2b" : {
      "comment" : "Petition seren_reveal: choice 2, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Abend weiß die Stadt, dass ihr alter Herr die Düsternis anführt. Die Türen werden früh verriegelt, und in der Taverne singt niemand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By evening the town knows its old lord leads the Gloom. Doors are barred early, and nobody sings at the tavern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al anochecer, el pueblo sabe que su antiguo señor guía a la Penumbra. Las puertas se atrancan temprano, y nadie canta en la taberna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le soir, la ville sait que son ancien seigneur mène la Pénombre. On barre les portes tôt, et personne ne chante à la taverne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entro sera il borgo sa che il suo vecchio signore guida la Penombra. Le porte si sprangano presto, e alla taverna nessuno canta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夕方には、昔の城主が宵闇を率いていると町じゅうが知る。戸は早々に閂を下ろされ、酒場では誰も歌わない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À noitinha, a cidade sabe que o antigo senhor comanda a Penumbra. As portas são trancadas cedo, e ninguém canta na taverna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到傍晚，全镇都知道了，他们的老城主正率领着暗霭。家家早早闩门，酒馆里没人唱歌。"
          }
        }
      }
    },
    "petition.seren_reveal.r3" : {
      "comment" : "Petition seren_reveal: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Weil Ihr mir vor einer Woche nicht geglaubt hättet“, sagt Seren. „Und jetzt habt Ihr Mauern, die ihn halten können.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Because a week ago you would not have believed me,” says Seren. “And now you have walls worth holding him with.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Porque hace una semana no me habría creído», dice Seren. «Y ahora tiene murallas capaces de contenerlo.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Parce qu’il y a une semaine, vous ne m’auriez pas crue, dit Seren. Et maintenant, vous avez des murailles capables de le retenir. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Perché una settimana fa non mi avreste creduto», dice Seren. «E ora avete mura degne di trattenerlo.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「一週間前なら、信じてくださらなかったでしょう」とセレンは言う。「それに今なら、あの人を食い止められるだけの城壁がある」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Porque há uma semana não teria acreditado em mim”, diz Seren. “E agora tem muralhas capazes de segurá-lo.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“因为一周前，您不会信我，”塞伦说，“而如今，您有了困得住他的城墙。”"
          }
        }
      }
    },
    "petition.seren_reveal.text" : {
      "comment" : "Petition seren_reveal (seren, story days 15-16): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mein Name ist Seren. Ich hütete das Große Leuchtfeuer, bis es erlosch, und ritt mit Aldric, um es neu zu entzünden. Er ist nicht gefallen, Lantern. Das Dunkel hat ihn nicht getötet. Es hat ihn gekrönt. Nur im Licht des Leuchtfeuers ist er verwundbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My name is Seren. I kept the Great Beacon until it went dark, and I rode with Aldric to light it again. He did not fall, Lantern. The dark did not kill him. It crowned him. Only in the beacon’s light can he be hurt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me llamo Seren. Guardé la Gran Almenara hasta que se apagó, y cabalgué con Aldric para volver a encenderla. Él no cayó, {farolero|farolera}. La oscuridad no lo mató. Lo coronó. Solo a la luz de la almenara se le puede herir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je m’appelle Seren. J’ai gardé le Grand Fanal jusqu’à ce qu’il s’éteigne, et j’ai chevauché avec Aldric pour le rallumer. Il n’est pas tombé, lampiste. L’obscurité ne l’a pas tué. Elle l’a couronné. Seule la lumière du fanal peut le blesser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi chiamo Seren. Ho custodito il Grande Faro finché non si è spento, e ho cavalcato con Aldric per riaccenderlo. Lui non è caduto, {lampionaio|lampionaia}. Il buio non l’ha ucciso. L’ha incoronato. Solo nella luce del faro lo si può ferire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私の名はセレン。大烽火が消えるまで、その守り手でした。そしてアルドリックとともに、もう一度灯しに出たのです。あの人は倒れてはいません、灯り番。闇はあの人を殺さなかった。冠を戴かせたのです。烽火の光の中でしか、あの人を傷つけることはできません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meu nome é Seren. Guardei o Grande Farol até ele se apagar, e cavalguei com Aldric para reacendê-lo. Ele não caiu, {acendedor de lampiões|acendedora de lampiões}. O escuro não o matou. O escuro o coroou. Só na luz do farol ele pode ser ferido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我叫塞伦。我曾守护大烽火，直到它熄灭；我随奥德里克出城，去重新点燃它。他没有倒下，点灯人。黑暗没有杀死他。它为他戴上了王冠。只有在烽火的光里，他才会受伤。"
          }
        }
      }
    },
    "petition.seren_watch.c1" : {
      "comment" : "Petition seren_watch: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nehmt einen Platz auf der Mauer"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a place on the wall"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocupe un puesto en la muralla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez place sur la muraille"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendete posto sulle mura"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城壁に立ってくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tome um lugar na muralha"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去城墙上找个位置吧"
          }
        }
      }
    },
    "petition.seren_watch.c2" : {
      "comment" : "Petition seren_watch: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt am Herd"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay by the hearth"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quédese junto al hogar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez près de l’âtre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restate accanto al focolare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "炉のそばにいてくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique junto à lareira"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待在炉火边"
          }
        }
      }
    },
    "petition.seren_watch.hint" : {
      "comment" : "Petition seren_watch: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wollte sie uns verraten, wäre die Mauer ein schlechter Ort dafür. Zu viele Schützen. Lasst sie wachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If she meant to betray us, the wall is a poor place for it. Too many archers. Let her watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si quisiera traicionarnos, la muralla sería un mal sitio para hacerlo. Demasiados arqueros. Déjela vigilar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si elle voulait nous trahir, la muraille serait un mauvais endroit pour ça. Trop d’archers. Laissez-la veiller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se volesse tradirci, le mura sarebbero un pessimo posto per farlo. Troppi arcieri. Lasciatela fare la guardia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裏切るつもりなら、城壁は向いていない場所です。弓兵が多すぎます。見張りくらい、させておきましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ela quisesse nos trair, a muralha seria um mau lugar para isso. Arqueiros demais. Deixe-a vigiar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她若有心背叛，城墙可不是好地方。弓手太多了。让她守望吧。"
          }
        }
      }
    },
    "petition.seren_watch.r1" : {
      "comment" : "Petition seren_watch: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ganze Nacht steht sie auf der Mauer und sagt hier und da ein Wort. Wohin sie zeigt, kommen die Hunde, und die Schützen warten schon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All night she stands on the wall, saying a word here and there. Where she points, the hounds come, and the archers wait."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda la noche está en la muralla, diciendo una palabra aquí y otra allá. Donde ella señala, llegan los sabuesos, y los arqueros ya esperan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute la nuit, elle se tient sur la muraille et lâche un mot ici ou là. Là où elle montre du doigt, les chiens arrivent, et les archers les attendent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per tutta la notte sta sulle mura, dicendo una parola qua e là. Dove indica lei arrivano i segugi, e gli arcieri li aspettano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜通し、セレンは城壁に立ち、ときおりひと言を発する。彼女が指さす所に影犬が来て、弓兵はもう待ち構えている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A noite inteira ela fica na muralha, dizendo uma palavra aqui e outra ali. Para onde ela aponta, os cães vêm, e os arqueiros esperam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她在城墙上站了一整夜，偶尔说上一两句。她指向哪里，影犬就从哪里来，而弓手早已候着。"
          }
        }
      }
    },
    "petition.seren_watch.r2" : {
      "comment" : "Petition seren_watch: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie neigt den Kopf und kehrt in ihre Ecke zurück. Die graue Laterne brennt die ganze Nacht und scheint den Schlund zu beobachten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She inclines her head and goes back to her corner. The grey lantern burns all night, and seems to watch the Throat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclina la cabeza y vuelve a su rincón. El farol gris arde toda la noche, y parece vigilar la Garganta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle incline la tête et retourne dans son coin. La lanterne grise brûle toute la nuit et semble surveiller la Gorge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "China il capo e torna nel suo angolo. La lanterna grigia arde tutta la notte, e sembra sorvegliare la Gola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セレンは首を傾けて、自分の隅へ戻る。灰色のランタンは夜通し燃え、喉谷を見張っているように見える。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela inclina a cabeça e volta para o seu canto. A lanterna cinzenta arde a noite inteira e parece vigiar a Garganta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她微微低头，回到了自己的角落。灰提灯燃了一整夜，似乎在注视着喉谷。"
          }
        }
      }
    },
    "petition.seren_watch.text" : {
      "comment" : "Petition seren_watch (seren): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasst mich heute Nacht auf der Mauer stehen, Lantern. Ich weiß, wie sich das Dunkel bewegt, bevor es sich bewegt. Ich kann Euren Schützen sagen, wohin sie sehen müssen. Einen Bogen rühre ich nicht an. Ich will nur nützlich sein in diesem Haus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let me stand on the wall tonight, Lantern. I know how the dark moves before it moves. I can tell your archers where to look. I will not touch a bow. I only want to be useful in this house."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjeme estar en la muralla esta noche, {farolero|farolera}. Sé cómo se mueve la oscuridad antes de que se mueva. Puedo decirles a sus arqueros adónde mirar. No tocaré un arco. Solo quiero ser útil en esta casa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez-moi me tenir sur la muraille cette nuit, lampiste. Je sais comment l’obscurité bouge avant qu’elle bouge. Je peux dire à vos archers où regarder. Je ne toucherai pas à un arc. Je veux seulement être utile dans cette maison."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasciatemi stare sulle mura stanotte, {lampionaio|lampionaia}. So come si muove il buio prima che si muova. Posso dire ai vostri arcieri dove guardare. Non toccherò un arco. Voglio solo rendermi utile in questa casa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜、城壁に立たせてください、灯り番。闇が動く前に、どう動くかが分かるのです。弓兵に、どこを見ればいいか教えられます。弓には触れません。ただ、この家の役に立ちたいのです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe-me ficar na muralha esta noite, {acendedor de lampiões|acendedora de lampiões}. Sei como o escuro se move antes de se mover. Posso dizer aos seus arqueiros para onde olhar. Não vou tocar num arco. Só quero ser útil nesta casa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜让我上城墙吧，点灯人。黑暗还没动，我就知道它要怎么动。我可以告诉您的弓手往哪儿看。我不碰弓。我只想在这个家里派上用场。"
          }
        }
      }
    },
    "petition.soldiers_pay.c1" : {
      "comment" : "Petition soldiers_pay: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhöht ihren Sold"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raise their pay"
          }
        },
        "es" : {
