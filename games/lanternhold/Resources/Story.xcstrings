    "petition.chronicle.hint" : {
      "comment" : "Petition chronicle: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin natürlich voreingenommen. Ich habe außerdem recht. Bezahlt das Papier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am biased, of course. I am also right. Pay for the paper."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No soy imparcial, claro. También tengo razón. Pague el papel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je suis partiale, bien sûr. J’ai aussi raison. Payez le papier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono di parte, naturalmente. Ho anche ragione. Pagate la carta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もちろん、わたくしは身びいきです。そして、正しくもあります。紙代をお払いなさいませ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sou suspeita para falar, é claro. Também tenho razão. Pague o papel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我当然有私心。我也说得对。为纸付钱吧。"
          }
        }
      }
    },
    "petition.chronicle.r1" : {
      "comment" : "Petition chronicle: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schreiber schlägt das alte Buch auf, um es fortzuführen, und findet elf Stummel, wo Burgherr Edric Seiten herausschnitt. Odile beginnt auf einer frischen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scribe opens the old book to carry on from it and finds eleven stubs where Lord Edric cut pages. Odile begins on a clean one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El escribano abre el libro viejo para continuarlo y encuentra once muñones donde lord Edric cortó páginas. Odile empieza en una hoja en blanco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scribe ouvre le vieux livre pour en reprendre le fil et trouve onze talons là où le seigneur Edric a coupé des pages. Odile commence sur une page vierge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo scrivano apre il vecchio libro per continuarlo e trova undici monconi dove Lord Edric ha tagliato le pagine. Odile ricomincia da una pulita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書記は続きを書こうと古い本を開き、城主エドリックが切り取った跡、十一枚分の切り残しを見つける。オディールは真新しい一枚から書き始める。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O escrivão abre o livro antigo para continuá-lo e encontra onze tocos de página onde o Lorde Edric cortou folhas. Odile começa numa página limpa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "书记员翻开旧书想接着写，却发现了城主埃德里克割去书页后留下的十一页残根。奥黛尔从新的一页写起。"
          }
        }
      }
    },
    "petition.chronicle.r2" : {
      "comment" : "Petition chronicle: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Die Geschichte hat die Angewohnheit, nicht zu warten“, sagt Odile und schreibt es trotzdem auf, auf die Rückseite einer Steuerrolle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“History has a way of not waiting,” says Odile, and writes it down anyway, on the back of a tax roll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«La historia tiene la costumbre de no esperar», dice Odile, y aun así lo anota, en el reverso de un registro de impuestos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« L’histoire a une fâcheuse tendance à ne pas attendre », dit Odile, et elle le note quand même, au dos d’un rôle d’impôts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«La storia ha il vizio di non aspettare», dice Odile, e lo scrive lo stesso, sul retro di un registro delle tasse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「歴史というのは、待ってくれないものでございます」とオディールは言い、それでも書き留める。税の台帳の裏に。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“A história tem o costume de não esperar”, diz Odile, e anota assim mesmo, no verso de um rol de impostos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“历史向来不等人。”奥黛尔说，还是把这句记了下来，写在一张税册的背面。"
          }
        }
      }
    },
    "petition.chronicle.text" : {
      "comment" : "Petition chronicle (odile, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mein Herr|Meine Herrin}, jemand sollte die Lange Wacht aufschreiben: jede gehaltene Nacht, jeden verlorenen Namen, jeden Narrenwitz. Ich melde mich freiwillig, mit Schreiber, Tinte und gutem Papier. Zwanzig Gold. Geschichte ist nicht billig, aber sie hält."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, someone should write down the Long Watch: every night held, every name lost, every fool’s joke. I volunteer, with a scribe, ink and good paper. Twenty gold. History is not cheap, but it lasts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, alguien debería dejar por escrito la Larga Vigilia: cada noche resistida, cada nombre perdido, cada chiste de bufón. Me ofrezco, con un escribano, tinta y buen papel. Veinte monedas de oro. La historia no es barata, pero dura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, quelqu’un devrait consigner la Longue Veille : chaque nuit tenue, chaque nom perdu, chaque plaisanterie du bouffon. Je me porte volontaire, avec un scribe, de l’encre et du bon papier. Vingt pièces d’or. L’histoire coûte cher, mais elle dure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, qualcuno dovrebbe mettere per iscritto la Lunga Veglia: ogni notte tenuta, ogni nome perduto, ogni battuta del giullare. Mi offro io, con uno scrivano, inchiostro e buona carta. Venti monete d’oro. La storia non costa poco, ma dura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、長き見張りを誰かが書き残すべきです。持ちこたえた夜の一つひとつ、失われた名の一つひとつ、道化の冗談の一つひとつを。わたくしが引き受けます。書記と、墨と、良い紙をつけて。金貨20枚。歴史は安くありませんが、長持ちいたします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, alguém deveria registrar a Longa Vigília: cada noite em que aguentamos, cada nome perdido, cada piada de bobo. Eu me ofereço, com um escrivão, tinta e papel bom. Vinte moedas de ouro. História não é barata, mas dura."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大人，总该有人把漫长守望记下来：守住的每一夜，失去的每一个名字，弄臣的每一个笑话。我自告奋勇，只要一名书记员、墨水和好纸。20金币。历史不便宜，但能传下去。"
          }
        }
      }
    },
    "petition.crow_plague.c1" : {
      "comment" : "Petition crow_plague: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brennt die Stoppeln ab"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burn the stubble"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queme el rastrojo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brûlez le chaume"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruciate le stoppie"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刈り株を焼いてくれ"
          }
        },
        "pt-BR" : {
