          }
        }
      }
    },
    "petition.miller_hoard.c3" : {
      "comment" : "Petition miller_hoard: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder setzt seinen eigenen Preis"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A man may set his own price"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada cual pone su precio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun est libre de fixer son prix"
          }
        },
        "it" : {
