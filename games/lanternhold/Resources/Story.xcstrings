    "petition.marek_relic.hint" : {
      "comment" : "Petition marek_relic: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist ein Huhn. Ein weitgereistes Huhn, aber ein Huhn. Nein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is a chicken. A well-travelled chicken, but a chicken. No."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es un pollo. Un pollo muy viajado, pero un pollo. No."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est un poulet. Un poulet qui a beaucoup voyagé, mais un poulet. Non."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È un pollo. Un pollo che ha viaggiato molto, ma un pollo. No."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鶏です。ずいぶん旅をした鶏ですが、鶏です。なりません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É uma galinha. Uma galinha muito viajada, mas uma galinha. Não."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那是鸡。一只见过世面的鸡，但终归是鸡。不买。"
          }
        }
      }
    },
    "petition.marek_relic.r1" : {
      "comment" : "Petition marek_relic: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Reliquie kommt in die Kapelle, und Pilger kommen aus dem Nachbartal. Hesper nennt sie einen Hühnerknochen und zündet trotzdem eine Kerze an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The relic goes up in the chapel and pilgrims come from the next valley. Hesper calls it a chicken bone and lights a candle anyway."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reliquia se instala en la capilla y llegan peregrinos del valle vecino. Hesper dice que es un hueso de pollo y aun así le enciende una vela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La relique est exposée dans la chapelle, et des pèlerins viennent de la vallée voisine. Hesper l’appelle un os de poulet et allume quand même une chandelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reliquia viene esposta in cappella e arrivano pellegrini dalla valle accanto. Hesper la chiama osso di pollo e accende comunque una candela."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聖遺物は礼拝堂に納められ、隣の谷から巡礼がやって来る。ヘスパーはそれを鶏の骨と呼び、それでも蝋燭をともす。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A relíquia vai para a capela, e peregrinos vêm do vale vizinho. Hesper a chama de osso de galinha e acende uma vela mesmo assim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圣骨供进了礼拜堂，邻谷的朝圣者纷纷前来。赫斯珀管它叫鸡骨头，还是给它点了一支蜡烛。"
          }
        }
      }
    },
    "petition.marek_relic.r2" : {
      "comment" : "Petition marek_relic: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper wirft einen Blick darauf: Huhn. Marek, unerschüttert, bietet ihn für fünf Gold als Suppenknochen an. Tamsin kauft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper takes one look: chicken. Marek, unshaken, offers it as a soup bone for five gold. Tamsin buys it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper le echa un vistazo: pollo. Marek, impertérrito, lo ofrece como hueso para caldo por cinco monedas de oro. Tamsin lo compra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper y jette un œil : poulet. Marek, imperturbable, la propose comme os à soupe pour cinq pièces d’or. Tamsin l’achète."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper le dà un’occhiata: pollo. Marek, imperturbabile, la offre come osso da brodo per cinque monete d’oro. Tamsin la compra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘスパーはひと目で言う。鶏。マレクは動じず、スープの出汁をとる骨として金貨5枚で売りに出す。タムシンが買う。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesper dá uma olhada: galinha. Marek, impassível, oferece o osso para sopa por cinco moedas de ouro. Tamsin compra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赫斯珀只看了一眼：鸡。马雷克面不改色，改口以5金币当汤骨卖。塔姆辛买下了。"
          }
        }
      }
    },
    "petition.marek_relic.r3" : {
      "comment" : "Petition marek_relic: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek schnappt nach Luft, die Hand auf dem Herzen, bis in die Seele verletzt. Bis Mittag hat er sich erholt und will Pip einen seltenen Kiesel verkaufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek gasps, hand on heart, wounded to the soul. He recovers by lunch and tries to sell Pip a rare pebble."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek ahoga un grito, la mano en el pecho, herido en el alma. A la hora de comer ya se ha repuesto e intenta venderle a Pip un guijarro rarísimo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek suffoque, la main sur le cœur, blessé jusqu’à l’âme. Il s’en remet avant midi et tente de vendre à Pip un caillou rare."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek trasale, la mano sul cuore, ferito nell’anima. Per pranzo si è ripreso e cerca di vendere a Pip un sassolino raro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マレクは息をのみ、胸に手を当てる。魂の底まで傷ついたのだ。昼までには立ち直り、ピップに珍しい小石を売りつけようとしている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek arqueja, mão no peito, ferido até a alma. Recupera-se até o almoço e tenta vender a Pip um seixo raro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "马雷克倒抽一口气，手按胸口，伤透了心。到午饭时他就缓过来了，还想卖给皮普一块稀世卵石。"
          }
        }
      }
    },
    "petition.marek_relic.text" : {
      "comment" : "Petition marek_relic (marek): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Strahlkraft, seht: ein Fingerknochen des heiligen Taper, der die Flamme entfachte, gesegnet und beglaubigt. Die Kapelle wäre geehrt. Vierzig Gold, eine Kleinigkeit für einen Heiligen. Die Urkunde habe ich eigenhändig verfasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Radiance, behold: a fingerbone of Saint Taper, who kindled the Flame, blessed and certified. The chapel would be honoured. Forty gold, a trifle for a saint. The certificate is in my own hand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su Resplandor, contemple: un hueso del dedo de san Taper, el primer farolero, bendecido y certificado. La capilla se sentiría honrada. Cuarenta monedas de oro, una nadería para un santo. El certificado es de mi puño y letra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Splendeur, voyez : un os du doigt de saint Taper, le premier lampiste, béni et certifié. La chapelle en serait honorée. Quarante pièces d’or, une bagatelle pour un saint. Le certificat est de ma propre main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vostro Splendore, ammirate: una falange di san Taper, il primo lampionaio, benedetta e certificata. La cappella ne sarebbe onorata. Quaranta monete d’oro, una sciocchezza per un santo. Il certificato l’ho scritto di mio pugno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まばゆきお方、ご覧ください。最初の灯り番、聖テイパーの指の骨でございます。祝福済み、証明書つき。礼拝堂の誉れとなりましょう。金貨40枚、聖人様にしては、はした金。証明書は、わたくしが自ら書きました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vossa Radiância, contemple: um osso do dedo de são Taper, o primeiro acendedor de lampiões, abençoado e autenticado. A capela ficaria honrada. Quarenta moedas de ouro, uma ninharia por um santo. O certificado é de meu próprio punho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光耀大人，请看：圣泰珀的一截指骨，他是第一位点灯人，此骨已受祝福，并经认证。礼拜堂必将因之增光。40金币，对一位圣人不过是九牛一毛。证书是鄙人亲笔所写。"
          }
        }
      }
    },
    "petition.marek_spyglass.c1" : {
      "comment" : "Petition marek_spyglass: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fernrohr kaufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy the spyglass"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprar el catalejo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acheter la longue-vue"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprare il cannocchiale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠眼鏡を買う"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprar a luneta"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "买下望远镜"
          }
        }
      }
    },
    "petition.marek_spyglass.c2" : {
      "comment" : "Petition marek_spyglass: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Geschäfte mehr, Marek"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No more deals, Marek"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se acabaron los tratos, Marek"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus d’affaires, Marek"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta affari, Marek"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう取引はなしだ、マレク"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chega de negócios, Marek"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不做买卖了，马雷克"
          }
        }
      }
    },
    "petition.marek_spyglass.hint" : {
      "comment" : "Petition marek_spyglass: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek schwört, es sei ehrlich, und genau deshalb zähle ich hinterher meine Finger. Lehnt ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek swears it is honest, which is how I know to count my fingers afterwards. Decline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek jura que es legítimo, y por eso sé que luego tendré que contarme los dedos. Dígale que no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek jure qu’elle est honnête : c’est ainsi que je sais qu’il faudra recompter mes doigts. Refusez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek giura che è onesto, ed è così che so di dovermi contare le dita, dopo. Rifiutate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マレクは本物だと誓っております。だからこそ、あとで指の数を確かめねばなりません。お断りを。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek jura que é legítima, e é assim que eu sei que devo contar os dedos depois. Recuse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "马雷克发誓说它是真的，所以我事后得数数手指头还在不在。回绝他。"
          }
        }
      }
    },
    "petition.marek_spyglass.r1a" : {
      "comment" : "Petition marek_spyglass: choice 1, it went well.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist ehrlich. In der Nacht sieht der Ausguck die Hunde sich sammeln, und die Schützen sind bereit, bevor sie losrennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is honest. That night the lookout sees the hounds gather, and the archers are ready before they run."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es legítimo. Esa noche el vigía ve reunirse a los sabuesos, y los arqueros están listos antes de que echen a correr."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle est honnête. Cette nuit-là, la vigie voit les chiens se rassembler, et les archers sont prêts avant qu’ils s’élancent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È onesto. Quella notte la vedetta vede i segugi radunarsi, e gli arcieri sono pronti prima che partano all’assalto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本物だった。その夜、見張りは影犬が群れ集まるのを見つけ、弓兵は犬が駆け出す前に構えている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É legítima. Naquela noite, o vigia vê os cães se reunindo, e os arqueiros estão prontos antes que eles corram."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它是真的。那一夜，瞭望哨看见影犬聚集，弓手在它们冲出之前就已准备好。"
          }
        }
      }
    },
    "petition.marek_spyglass.r1b" : {
      "comment" : "Petition marek_spyglass: choice 1, it went badly.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fernrohr zeigt alles auf dem Kopf. Brannock sagt, es sei hervorragend, um Fledermäuse zu beobachten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The spyglass shows everything upside down. Brannock says it is very good for watching bats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El catalejo lo muestra todo al revés. Brannock dice que es estupendo para observar murciélagos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La longue-vue montre tout à l’envers. Brannock dit qu’elle est excellente pour observer les chauves-souris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cannocchiale mostra tutto capovolto. Brannock dice che è ottimo per osservare i pipistrelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠眼鏡は何もかも逆さまに映す。ブラノックいわく、蝙蝠を眺めるにはもってこいだそうだ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A luneta mostra tudo de cabeça para baixo. Brannock diz que é ótima para observar morcegos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "望远镜里什么都是倒着的。布兰诺克说，拿来看蝙蝠倒是很好。"
          }
        }
      }
    },
    "petition.marek_spyglass.r2" : {
      "comment" : "Petition marek_spyglass: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek seufzt. „Eines Tages verkaufe ich Euch etwas Ehrliches, Eure Strahlkraft, und Ihr werdet mir nicht glauben.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek sighs. “One day I shall sell you something honest, Your Radiance, and you will not believe me.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek suspira. «Un día le venderé algo legítimo, Su Resplandor, y no me lo creerá.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek soupire. « Un jour, je vous vendrai quelque chose d’honnête, Votre Splendeur, et vous ne me croirez pas. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek sospira. «Un giorno vi venderò qualcosa di onesto, Vostro Splendore, e voi non mi crederete.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マレクはため息をつく。「いつか本物をお売りしても、まばゆきお方は信じてくださらないのでしょうな」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek suspira. “Um dia vou lhe vender algo legítimo, Vossa Radiância, e não vai acreditar em mim.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "马雷克叹了口气。“总有一天，鄙人会卖给您一件真货，光耀大人，到时候您可不会信。”"
          }
        }
      }
    },
    "petition.marek_spyglass.text" : {
      "comment" : "Petition marek_spyglass (marek): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Strahlkraft, ein Fernrohr von der Küste, Messing und ehrlich. Von Eurem höchsten Turm sähen Eure Schützen den Ruß eine Meile weit kommen. Dreißig Gold. Und es ist ehrlich. Ich bestehe darauf. Dieses ist ehrlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Radiance, a spyglass from the coast, brass and true. From your tallest tower your archers would see the soot coming a mile off. Thirty gold. And it is honest. I insist. This one is honest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su Resplandor, un catalejo de la costa, de latón y legítimo. Desde su torre más alta, sus arqueros verían venir el hollín a una legua. Treinta monedas de oro. Y es legítimo. Insisto. Este es legítimo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Splendeur, une longue-vue de la côte, en laiton, et fidèle. Du haut de votre plus grande tour, vos archers verraient venir la suie à une lieue. Trente pièces d’or. Et elle est honnête. J’insiste. Celle-ci est honnête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vostro Splendore, un cannocchiale dalla costa, ottone e onesto. Dalla vostra torre più alta i vostri arcieri vedrebbero arrivare la fuliggine a un miglio di distanza. Trenta monete d’oro. Ed è onesto. Insisto. Questo è onesto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まばゆきお方、沿岸渡りの遠眼鏡でございます。真鍮製で、本物。一番高い塔からなら、弓兵の皆さまは、はるか遠くから煤が来るのを見通せましょう。金貨30枚。しかも本物でございます。断言いたします。これは本物です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vossa Radiância, uma luneta da costa, de latão e legítima. Da sua torre mais alta, os seus arqueiros veriam a fuligem chegando a uma milha de distância. Trinta moedas de ouro. E é legítima. Eu insisto. Esta é legítima."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光耀大人，一架来自海岸的望远镜，黄铜的，货真价实。从您最高的塔上，您的弓手隔着一里地就能看见煤影来袭。30金币。而且它是真的。鄙人坚持。这一架是真的。"
          }
        }
      }
    },
    "petition.marek_stall.c1" : {
      "comment" : "Petition marek_stall: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Karren darf bleiben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the cart stay"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que el carro se quede"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La charrette peut rester"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il carro può restare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "荷車は置いていい"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carroça pode ficar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "货车可以留下"
          }
        }
      }
    },
    "petition.marek_stall.c2" : {
      "comment" : "Petition marek_stall: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder dritte Tag genügt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every third day is plenty"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno de cada tres días basta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jour sur trois suffit"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un giorno ogni tre basta e avanza"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三日に一度で十分だ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cada três dias já basta"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每三天一回就够了"
          }
        }
      }
    },
    "petition.marek_stall.hint" : {
      "comment" : "Petition marek_stall: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek jeden Tag heißt Mareks Preise jeden Tag. Lasst ihn trotzdem bleiben. Die Wachen mögen ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek every day means Marek’s prices every day. Let him stay anyway. The guards like him."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek cada día significa los precios de Marek cada día. Déjelo quedarse de todos modos. Los guardias lo aprecian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek tous les jours, ce sont les prix de Marek tous les jours. Laissez-le rester quand même. Les gardes l’aiment bien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek tutti i giorni significa i prezzi di Marek tutti i giorni. Lasciatelo restare lo stesso. Alle guardie piace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日マレクがいるということは、毎日マレクの値段だということ。それでもお置きなさいませ。衛兵たちが気に入っております。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek todo dia significa os preços de Marek todo dia. Deixe-o ficar mesmo assim. Os guardas gostam dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天天有马雷克，就是天天有马雷克的价钱。还是让他留下吧。卫兵们喜欢他。"
          }
        }
      }
    },
    "petition.marek_stall.r1" : {
      "comment" : "Petition marek_stall: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein gestreiftes Sonnendach wird Teil des Burghofs. Binnen einer Woche schulden ihm die Wachen Geld, und er kennt jedes Geheimnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "His striped awning becomes part of the courtyard. Within a week the guards owe him money and he knows every secret."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su toldo a rayas pasa a formar parte del patio de armas. En una semana los guardias le deben dinero y él conoce todos los secretos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son auvent rayé fait bientôt partie de la cour. En une semaine, les gardes lui doivent de l’argent et il connaît tous les secrets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua tenda a strisce diventa parte del cortile. Nel giro di una settimana le guardie gli devono soldi e lui conosce ogni segreto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "縞模様の日よけが、中庭の一部になる。一週間もしないうちに、衛兵たちは彼に借金をこしらえ、彼はあらゆる秘密を知っている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O toldo listrado dele vira parte do pátio. Em uma semana, os guardas lhe devem dinheiro, e ele conhece todos os segredos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他那条纹遮篷成了庭院的一部分。不出一周，卫兵们都欠了他钱，而他知道了每一桩秘密。"
          }
        }
      }
    },
    "petition.marek_stall.r2" : {
      "comment" : "Petition marek_stall: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek verneigt sich schwungvoll. „Dann werde ich Euch jeden dritten Tag schrecklich vermissen.“ Traurig sieht er nicht aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek bows with a flourish. “Then every third day I shall miss you terribly.” He does not look sad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek se inclina con una floritura. «Entonces, uno de cada tres días {lo|la} echaré terriblemente de menos.» No parece triste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek s’incline avec un grand geste. « Alors, un jour sur trois, vous me manquerez terriblement. » Il n’a pas l’air triste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek si inchina con uno svolazzo. «Allora ogni tre giorni sentirò terribilmente la vostra mancanza.» Non sembra triste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マレクは大仰に一礼する。「では三日に一度、恋しくてたまらなくなりましょう」。悲しそうには見えない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek se curva com um floreio. “Então, a cada três dias, sentirei terrivelmente a sua falta.” Ele não parece triste."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "马雷克夸张地一躬。“那鄙人就每三天想您一回，想得要命。”他看上去可一点也不难过。"
          }
        }
      }
    },
    "petition.marek_stall.text" : {
      "comment" : "Petition marek_stall (marek): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Strahlkraft, meine alten Knochen sind der Flussstraße müde. Lasst meinen Karren jeden Tag in Eurem Burghof stehen, nicht nur jeden dritten. Miete? Zehn Gold sofort und die besten Preise im Tal, für immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Radiance, my old bones are tired of the river road. Let my cart stand in your courtyard every day, not just every third. Rent? Ten gold now, and the best prices in the valley for ever."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su Resplandor, mis viejos huesos están cansados del camino del río. Deje que mi carro se quede en su patio de armas todos los días, no solo uno de cada tres. ¿El alquiler? Diez monedas de oro ahora, y los mejores precios del valle para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Splendeur, mes vieux os sont las de la route de la rivière. Laissez ma charrette dans votre cour tous les jours, pas seulement un jour sur trois. Un loyer ? Dix pièces d’or tout de suite, et les meilleurs prix de la vallée pour toujours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vostro Splendore, le mie vecchie ossa sono stanche della strada del fiume. Lasciate che il mio carro stia nel vostro cortile tutti i giorni, non solo uno ogni tre. L’affitto? Dieci monete d’oro subito, e i prezzi migliori della valle per sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まばゆきお方、この老骨は川沿いの道に疲れ果てました。三日に一度ではなく、毎日、お城の中庭に荷車を置かせていただけませんか。場所代？　今すぐ金貨10枚、そして谷いちばんの値を、末永く。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vossa Radiância, os meus velhos ossos estão cansados da estrada do rio. Deixe a minha carroça ficar no seu pátio todo dia, não só a cada três. Aluguel? Dez moedas de ouro agora, e os melhores preços do vale para sempre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光耀大人，鄙人这把老骨头走腻了河边的路。让鄙人的货车天天停在您的庭院里吧，不只是每三天一回。租金？现付10金币，外加全河谷最低的价钱，永远有效。"
          }
        }
      }
    },
    "petition.market_stall.c1" : {
      "comment" : "Petition market_stall: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkauft ihm die Erlaubnis"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sell him the licence"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venderle la licencia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vendez-lui la licence"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vendetegli la licenza"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可を売ろう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venda a licença a ele"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卖给他执照"
          }
        }
      }
    },
    "petition.market_stall.c2" : {
      "comment" : "Petition market_stall: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schützt die Weber"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protect the weavers"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteger a los tejedores"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protégez les tisserands"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteggete i tessitori"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機織りたちを守る"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protejam os tecelões"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "护着织工"
          }
        }
      }
    },
    "petition.market_stall.hint" : {
      "comment" : "Petition market_stall: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreißig Gold für ein Sonnendach. Die Weber werden murren, aber sie murren in allen Farben. Verkauft die Erlaubnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thirty gold for an awning. The weavers will grumble, but they grumble in every colour. Sell the licence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treinta monedas de oro por un toldo. Los tejedores refunfuñarán, pero refunfuñan de todos los colores. Véndale la licencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trente pièces d’or pour un auvent. Les tisserands grogneront, mais ils grognent dans toutes les couleurs. Vendez la licence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenta monete d’oro per una tenda. I tessitori brontoleranno, ma brontolano in tutti i colori. Vendete la licenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日よけ一枚に金貨30枚。機織りたちはぼやくでしょうが、あの者たちは、どんな色にでもぼやきます。許可はお売りになればよろしい。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinta moedas de ouro por um toldo. Os tecelões vão resmungar, mas resmungam em todas as cores. Venda a licença."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30金币换一块遮篷。织工们会嘟囔，可他们嘟囔起来五颜六色。卖给他执照。"
          }
        }
      }
    },
    "petition.market_stall.r1" : {
      "comment" : "Petition market_stall: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein gestreiftes Sonnendach steht bald am Brunnen. Die Weber starren über den Platz, dann kommen sie herüber und kaufen Blau."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "His striped awning goes up beside the well. The weavers glare across the square, then come over to buy blue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su toldo a rayas se alza junto al pozo. Los tejedores lo fulminan con la mirada desde el otro lado de la plaza, y luego se acercan a comprar azul."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son auvent rayé se dresse près du puits. Les tisserands le fusillent du regard depuis l’autre bout de la place, puis viennent acheter du bleu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua tenda a strisce si alza accanto al pozzo. I tessitori lo fulminano con lo sguardo dall’altro capo della piazza, poi vengono a comprare il blu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "井戸の脇に、縞模様の日よけが立つ。機織りたちは広場の向こうからにらみつけ、それから青を買いにやって来る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O toldo listrado dele sobe ao lado do poço. Os tecelões fecham a cara do outro lado da praça, depois vêm comprar azul."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他的条纹遮篷在井边支了起来。织工们隔着广场瞪眼，后来还是过去买了蓝的。"
          }
        }
      }
    },
    "petition.market_stall.r2" : {
      "comment" : "Petition market_stall: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er packt seine Bänder und zieht an die Küste. Die Weber schicken Euch einen Schal, im selben Grau wie immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He packs his ribbons and leaves for the coast. The weavers send you a scarf, in the same grey as always."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recoge sus cintas y se marcha a la costa. Los tejedores le envían una bufanda, del mismo gris de siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il remballe ses rubans et part pour la côte. Les tisserands vous envoient une écharpe, du même gris que d’habitude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impacchetta i nastri e parte per la costa. I tessitori vi mandano una sciarpa, del solito grigio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "商人は飾り紐をまとめて、沿岸へ去る。機織りたちから襟巻きが届く。いつもと同じ灰色の。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele embrulha as fitas e parte para a costa. Os tecelões mandam para você um cachecol, no mesmo cinza de sempre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他收拾起丝带，去了海岸。织工们送你一条围巾，还是那种一成不变的灰色。"
          }
        }
      }
    },
    "petition.market_stall.text" : {
      "comment" : "Petition market_stall (merchant): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, ich verkaufe Farben und Bänder aus dem Süden. Ich hätte gern einen Stand auf Eurem Markt und biete dreißig Gold für die Erlaubnis. Eure Weber sagen, ich ruiniere sie. Das sagen Eure Weber auch über den Regen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, I sell dyes and ribbons from the south. I would like a stall on your market and offer thirty gold for the licence. Your weavers say I will ruin them. Your weavers also say that about rain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, vendo tintes y cintas del sur. Quisiera un puesto en su mercado y ofrezco treinta monedas de oro por la licencia. Sus tejedores dicen que los arruinaré. Sus tejedores también dicen eso de la lluvia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, je vends des teintures et des rubans du Sud. J’aimerais un étal sur votre marché et j’offre trente pièces d’or pour la licence. Vos tisserands disent que je vais les ruiner. Vos tisserands disent la même chose de la pluie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, vendo tinture e nastri del sud. Vorrei un banco al vostro mercato e offro trenta monete d’oro per la licenza. I vostri tessitori dicono che li rovinerò. I vostri tessitori lo dicono anche della pioggia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、私は南方の染料と飾り紐を商っております。市場に店を出させていただきたく、許可料として金貨30枚をお納めします。町の機織りたちは、私のせいで食いっぱぐれると申します。雨が降っても、同じことを申しますが。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, vendo tinturas e fitas do sul. Gostaria de uma banca no seu mercado e ofereço trinta moedas de ouro pela licença. Os seus tecelões dizem que vou arruiná-los. Os seus tecelões também dizem isso da chuva."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，我卖南方来的染料和丝带。我想在您的集市上摆个摊，愿出30金币买执照。您的织工说我会让他们破产。您的织工说下雨也会让他们破产。"
          }
        }
      }
    },
    "petition.mill_wheel.c1" : {
      "comment" : "Petition mill_wheel: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flickt das Rad"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mend the wheel"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arregle la rueda"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réparez la roue"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riparate la ruota"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水車を直してくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserte a roda"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修水轮"
          }
        }
      }
    },
    "petition.mill_wheel.c2" : {
      "comment" : "Petition mill_wheel: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahlt eine Weile von Hand"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grind by hand a while"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muelan a mano un tiempo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moulez à la main, pour l’instant"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macinate a mano per un po’"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しばらく手で挽いてくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moam à mão por um tempo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先用手磨一阵"
          }
        }
      }
    },
    "petition.mill_wheel.hint" : {
      "comment" : "Petition mill_wheel: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünfzehn Gold oder eine Stadt mit lahmen Armen und kurzer Lunte. Flickt das Rad."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fifteen gold or a town with sore arms and short tempers. Mend the wheel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quince monedas de oro, o un pueblo con los brazos doloridos y la mecha corta. Arregle la rueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quinze pièces d’or, ou une ville aux bras douloureux et aux nerfs à vif. Réparez la roue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quindici monete d’oro, o un borgo con le braccia indolenzite e la miccia corta. Riparate la ruota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金貨15枚か、腕が痛くて気の短い町か。水車は直すに限ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quinze moedas de ouro, ou uma cidade de braços doloridos e pavio curto. Conserte a roda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15金币，或者一个胳膊酸痛、脾气暴躁的小镇。修水轮。"
          }
        }
      }
    },
    "petition.mill_wheel.r1" : {
      "comment" : "Petition mill_wheel: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am nächsten Morgen dreht und knarrt das Rad zufrieden. Der Bäcker schickt den ersten Laib aus dem neuen Mehl hinauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By the next morning the wheel turns and creaks happily. The baker sends up the first loaf from the new flour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A la mañana siguiente la rueda gira y cruje feliz. El panadero sube la primera hogaza de la harina nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lendemain matin, la roue tourne et grince joyeusement. Le boulanger fait monter la première miche de la nouvelle farine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mattina dopo la ruota gira e cigola contenta. Il fornaio manda su la prima pagnotta della farina nuova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翌朝には水車が回り、楽しげにきしむ。パン屋が、新しい粉で焼いた最初のパンを届けてくる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na manhã seguinte, a roda gira e range, feliz. O padeiro manda o primeiro pão da farinha nova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第二天早上，水轮转了起来，吱吱呀呀，快活得很。面包师送来了新面粉烤的第一个面包。"
          }
        }
      }
    },
    "petition.mill_wheel.r2" : {
      "comment" : "Petition mill_wheel: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stadt mahlt von Hand und schimpft im Takt. Ein Arbeitslied entsteht. Es ist nicht schmeichelhaft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The town grinds by hand and complains in rhythm. A work song is born. It is not flattering."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pueblo muele a mano y se queja al compás. Nace una canción de trabajo. No es halagadora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ville moud à la main et se plaint en cadence. Une chanson de travail est née. Elle n’est pas flatteuse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il borgo macina a mano e si lamenta a tempo. Nasce un canto di lavoro. Non è lusinghiero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "町は手で粉を挽き、調子を合わせて文句を言う。仕事歌がひとつ生まれる。褒め言葉ではない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cidade mói à mão e reclama no ritmo. Nasce uma canção de trabalho. Não é lisonjeira."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "镇上用手推磨，边磨边骂，骂出了节拍。一首劳动号子就此诞生。可不是什么好话。"
          }
        }
      }
    },
    "petition.mill_wheel.text" : {
      "comment" : "Petition mill_wheel (builder, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, das Mühlrad ist im Frost gesprungen. Ohne es mahlt die Stadt von Hand, und die Leute werden schon unhöflich. Fünfzehn Gold für neue Schaufeln. Bis morgen dreht es sich wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the mill wheel cracked in the frost. Without it the town grinds by hand, and folk are already rude about it. Fifteen gold for new paddles. I can have it turning by tomorrow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, la rueda del molino se rajó con la helada. Sin ella el pueblo muele a mano, y la gente ya anda de malos modos. Quince monedas de oro por palas nuevas. Mañana la tendré girando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, la roue du moulin s’est fendue avec le gel. Sans elle, la ville moud à la main, et les gens en sont déjà à jurer. Quinze pièces d’or pour de nouvelles aubes. Je peux la faire tourner dès demain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, la ruota del mulino si è spaccata col gelo. Senza, il borgo macina a mano, e la gente comincia già a diventare sgarbata. Quindici monete d’oro per pale nuove. Domani la faccio girare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、水車が霜で割れました。あれがないと、町は手で粉を挽くしかなく、皆もう口が悪くなっています。新しい羽根板に金貨15枚。明日までには回してみせます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, a roda do moinho rachou com a geada. Sem ela, a cidade mói à mão, e o povo já está perdendo a educação. Quinze moedas de ouro por pás novas. Amanhã ela já está girando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，磨坊的水轮冻裂了。没有它，镇上只能用手磨，大家已经开始骂骂咧咧了。15金币换新桨板。明天就能让它转起来。"
          }
        }
      }
    },
    "petition.miller_hoard.c1" : {
      "comment" : "Petition miller_hoard: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Mühle per Befehl"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the mill by order"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que abra el molino, por orden mía"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites ouvrir le moulin"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprite il mulino per ordine mio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命令で水車小屋を開けさせる"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abram o moinho por ordem minha"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下令开磨坊"
          }
        }
      }
    },
    "petition.miller_hoard.c2" : {
      "comment" : "Petition miller_hoard: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
