{
  "sourceLanguage" : "en",
  "strings" : {
    "ending.speech_aldric" : {
      "comment" : "Dawn report after night 20 held: quotes the speech the king gave at the last stand.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wir holen Burgherr Aldric heim“, habt Ihr ihnen gesagt. Auf der Mauer vergaß es keiner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“We bring Lord Aldric home,” you told them. Nobody on the wall forgot it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Traeremos a casa a lord Aldric», les dijo. Nadie en la muralla lo olvidó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Nous ramènerons le seigneur Aldric », leur avez-vous dit. Sur les murailles, personne ne l’a oublié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Riporteremo a casa Lord Aldric», avete detto loro. Sulle mura nessuno l’ha dimenticato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アルドリック様を連れて帰ろう」と、あなたは皆に告げた。城壁の上の誰ひとり、その言葉を忘れなかった。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Vamos trazer o Lorde Aldric para casa”, você disse a eles. Ninguém nas muralhas esqueceu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“我们要把奥德里克大人接回家。”你这样告诉他们。城墙上没有一个人忘记。"
          }
        }
      }
    },
    "ending.speech_dawn" : {
      "comment" : "Dawn report after night 20 held: quotes the speech the king gave at the last stand.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wir halten bis zum Morgen“, habt Ihr ihnen gesagt. Und sie hielten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“We hold until dawn,” you told them. And they held."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Resistiremos hasta el alba», les dijo. Y resistieron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Nous tiendrons jusqu’à l’aube », leur avez-vous dit. Et ils ont tenu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Resisteremo fino all’alba», avete detto loro. E hanno resistito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「夜明けまで持ちこたえよう」と、あなたは皆に告げた。そして皆、持ちこたえた。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Vamos aguentar até a alvorada”, você disse a eles. E eles aguentaram."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“我们坚守到天亮。”你这样告诉他们。他们守住了。"
          }
        }
      }
    },
    "ending.speech_honest" : {
      "comment" : "Dawn report after night 20 held: quotes the speech the king gave at the last stand.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ich habe auch Angst. Ich bleibe“, habt Ihr ihnen gesagt. Sie blieben bei Euch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“I am afraid too. I stay,” you told them. They stayed with you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Yo no nací para esto», les dijo. Aun así, {lo|la} siguieron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Je n’ai jamais été {fait|faite} pour cela », leur avez-vous dit. Ils vous ont {suivi|suivie} malgré tout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Non doveva toccare a me», avete detto loro. Vi hanno seguito lo stesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「私は、こんな役目に就くはずではなかった」と、あなたは皆に告げた。それでも皆、ついてきた。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Isto nunca foi para mim”, você disse a eles. E eles foram com você mesmo assim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“我本不是为此而生。”你这样告诉他们。他们依然追随了你。"
          }
        }
      }
    },
    "line.bard_returned" : {
      "comment" : "Court talk: bard.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küche, Wäsche, warmes Brot, eine Treppe, eine blaue Tür. Ich sammle, was die Heimgekehrten sagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitchen, washing, warm bread, a stair, a blue door. I collect what the Returned say."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cocina, ropa tendida, pan caliente, una escalera, una puerta azul. Colecciono lo que dicen los Retornados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuisine, lessive, pain chaud, un escalier, une porte bleue. Je recueille ce que disent les Revenants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cucina, bucato, pane caldo, una scala, una porta blu. Raccolgo ciò che dicono i Ritornati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台所、洗濯物、温かいパン、階段、青い扉。私は戻り人の言葉を集めているのです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cozinha, roupa lavada, pão quente, uma escada, uma porta azul. Coleciono o que os Retornados dizem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "厨房、晾着的衣裳、热面包、一段楼梯、一扇蓝门。我收集归来者说的话。"
          }
        }
      }
    },
    "line.bard_rhyme" : {
      "comment" : "Court talk: bard.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich reime „Laterne“ auf „Ferne“. Die Kritiker hassen es. Das Publikum weint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I rhyme “lantern” with “anthem”. Critics hate it. Audiences weep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimo «farol» con «corazón». La crítica lo detesta. El público llora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je fais rimer « lanterne » avec « terne ». Les critiques détestent. Le public pleure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faccio rimare «lanterna» con «inverno». I critici lo detestano. Il pubblico piange."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私は「ランタン」に「爛漫」で韻を踏みます。批評家は嫌がります。聴衆は泣きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimo “lanterna” com “eterna”. Os críticos odeiam. O público chora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我拿“提灯”去押“永恒”。评论家恨透了。听众却哭了。"
          }
        }
      }
    },
    "line.bard_song_line" : {
      "comment" : "Court talk: bard.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Haus braucht ein Lied, {Burgherr|Burgherrin}. Die meisten ein besseres, als sie verdienen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every house needs a song, my {lord|lady}. Most need a better one than they deserve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda casa necesita una canción, {mi señor|mi señora}. Casi todas, una mejor de la que merecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute maison a besoin d’une chanson, {monseigneur|madame}. La plupart, d’une meilleure qu’elles ne le méritent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni casata ha bisogno di una canzone, {mio signore|mia signora}. Quasi tutte, di una migliore di quella che meritano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの家にも歌が要るのです、城主様。たいていの家には、その家にふさわしい以上の歌が。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda casa precisa de uma canção, {meu senhor|minha senhora}. A maioria, de uma melhor do que merece."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个家族都需要一首歌，城主大人。大多数家族，都配不上它们需要的那首。"
          }
        }
      }
    },
    "line.bram_arrows" : {
      "comment" : "Court talk: bram.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfeile. Mehr Pfeile. Fragt mich morgen wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrows. More arrows. Ask me again tomorrow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flechas. Más flechas. Pregúnteme otra vez mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des flèches. Encore des flèches. Redemandez-moi demain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frecce. Altre frecce. Richiedetemelo domani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "矢。もっと矢。明日また聞いてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flechas. Mais flechas. Pergunte de novo amanhã."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "箭。还是箭。明天再问。"
          }
        }
      }
    },
    "line.bram_arrows_refused" : {
      "comment" : "Court talk: bram (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr habt Mareks Pfeile weggeschickt. Gut. Meine fliegen gerade."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You sent Marek’s arrows away. Good. Mine fly straight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devolvió las flechas de Marek. Bien. Las mías vuelan derecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez renvoyé les flèches de Marek. Bien. Les miennes volent droit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avete rimandato indietro le frecce di Marek. Bene. Le mie volano dritte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マレクの矢を突き返しましたね。よかった。私の矢はまっすぐ飛ぶ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mandou embora as flechas de Marek. Bom. As minhas voam reto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您把马雷克的箭退了。好。我的箭飞得直。"
          }
        }
      }
    },
    "line.bram_beacon" : {
      "comment" : "Court talk: bram.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schale fürs Leuchtfeuer. Viel Eisen. Schaffe ich. Brauche danach Schlaf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The beacon bowl. Big iron. I can do it. Need sleep after."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cuenco de la almenara. Mucho hierro. Puedo. Luego, a dormir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vasque du fanal. Beaucoup de fer. Je peux. Faudra dormir après."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La coppa del faro. Tanto ferro. Ce la faccio. Poi dormo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烽火の火皿。鉄がたくさん要る。やれます。終わったら、寝かせてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bacia do farol. Muito ferro. Dou conta. Depois, preciso dormir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烽火的火钵。大块铁。能打。打完要睡。"
          }
        }
      }
    },
    "line.bram_bell_hint" : {
      "comment" : "Court talk: bram, a hint about bell_for_arrows.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frage heute wegen der Glocke. Frage nicht gern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Going to ask about the bell today. Won’t like asking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy pido lo de la campana. No me gusta pedir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vais demander pour la cloche aujourd’hui. Aime pas demander."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi chiedo della campana. Chiedere non mi piace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日、鐘のことで伺います。気は進みません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vou pedir pelo sino hoje. Não gosto de pedir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天要问钟的事。不想问。"
          }
        }
      }
    },
    "line.bram_endless" : {
      "comment" : "Court talk: bram.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch da. Hämmere noch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still here. Still hammering."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigo aquí. Sigo martillando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours là. Toujours au marteau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora qui. Ancora a martellare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだいます。まだ打ってます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda aqui. Ainda martelando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还在。还在打铁。"
          }
        }
      }
    },
    "line.bram_first" : {
      "comment" : "Court talk: bram.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hm. {Neuer Herr|Neue Herrin}. Braucht Ihr was geschmiedet, fragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hm. New {lord|lady}. Need anything forged, ask."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mm. {Nuevo señor|Nueva señora}. Si necesita algo forjado, pida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hm. {Nouveau seigneur|Nouvelle dame}. Besoin d’une pièce forgée, demandez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mh. {Nuovo signore|Nuova signora}. Serve qualcosa di forgiato, chiedete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ん。新しい城主様。打つ物があれば、言ってください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hum. {Novo senhor|Nova senhora}. Precisando forjar algo, é só pedir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嗯。新城主。要打什么，说。"
          }
        }
      }
    },
    "line.bram_giant" : {
      "comment" : "Court talk: bram.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Großer Brocken heute Nacht. Alles zweimal geschärft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Big one tonight. Sharpened everything twice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno grande esta noche. Afilé todo dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gros, cette nuit. Tout aiguisé deux fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roba grossa stanotte. Ho affilato tutto due volte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜はでかいのが来る。全部、二度研ぎました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coisa grande hoje à noite. Afiei tudo duas vezes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜来个大的。全都磨了两遍。"
          }
        }
      }
    },
    "line.bram_lanterns" : {
      "comment" : "Court talk: bram.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neun Laternen heute früh vom Stein geholt. Scharniere auf der falschen Seite. Nicht unsere Arbeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nine lanterns off the stone this morning. Hinges on the wrong side. Not our work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nueve faroles recogidos de la piedra esta mañana. Bisagras del lado equivocado. No es trabajo nuestro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuf lanternes ramassées sur la pierre ce matin. Charnières du mauvais côté. Pas notre travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nove lanterne raccolte stamattina sulla pietra. Cardini dal lato sbagliato. Non è lavoro nostro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今朝、岩場からランタンを九つ拾いました。蝶番が逆についてる。うちの仕事じゃない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nove lanternas tiradas da pedra hoje cedo. Dobradiças do lado errado. Não é trabalho nosso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "九盏提灯，今早从石头上捡的。铰链装反了。不是咱们的活。"
          }
        }
      }
    },
    "line.bram_reforged" : {
      "comment" : "Court talk: bram.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vierzig gute Pfeile. Aus Mareks Schrott. Nicht schlecht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forty good arrows. From Marek’s rubbish. Not bad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuarenta flechas buenas. De la basura de Marek. Nada mal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quarante bonnes flèches. Avec la camelote de Marek. Pas mal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quaranta frecce buone. Dalla robaccia di Marek. Niente male."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "良い矢が四十本。マレクのがらくたから。悪くない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quarenta flechas boas. Da sucata de Marek. Nada mal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "四十支好箭。马雷克的破烂改的。还行。"
          }
        }
      }
    },
    "line.bram_test_hint" : {
      "comment" : "Court talk: bram, a hint about marek_arrows.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mareks Pfeile. Lasst mich erst einen sehen. Nur einen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek’s arrows. Let me see one first. Just one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las flechas de Marek. Déjeme ver una primero. Solo una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les flèches de Marek. Laissez-m’en voir une d’abord. Une seule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le frecce di Marek. Prima fatemene vedere una. Una sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マレクの矢。先に一本見せてもらいます。一本だけ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flechas de Marek. Deixe eu ver uma antes. Só uma."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "马雷克的箭。先给我看一支。就一支。"
          }
        }
      }
    },
    "line.brannock_after_giant" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ding war größer als das Torhaus, und wir sind noch hier. Denkt daran, wenn es schlimm wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That thing was taller than the gatehouse, and we are still here. Remember that when it gets bad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa cosa era más alta que la torre de entrada, y seguimos aquí. Recuérdelo cuando vengan mal dadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette chose était plus haute que le châtelet, et nous sommes toujours là. Souvenez-vous-en quand ça tournera mal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quella cosa era più alta del torrione d’ingresso, e noi siamo ancora qui. Ricordatevelo quando si mette male."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あいつは門楼より背が高かった。それでも我々はここにいる。苦しくなったら、それを思い出してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquela coisa era mais alta que a torre do portão, e nós ainda estamos aqui. Lembre-se disso quando apertar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那东西比门楼还高，可我们还在。情况坏的时候，记住这个。"
          }
        }
      }
    },
    "line.brannock_endless" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Nacht zähle ich die Jungs auf der Mauer. Jeden Morgen zähle ich sie wieder. Das ist der ganze Beruf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every night I count the lads on the wall. Every dawn I count them again. That is the whole job."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada noche cuento a los muchachos en la muralla. Cada amanecer los vuelvo a contar. En eso consiste el oficio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque nuit, je compte les gars sur la muraille. Chaque aube, je les recompte. C’est tout le métier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni notte conto i ragazzi sulle mura. Ogni alba li riconto. Il mestiere è tutto qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎晩、城壁の若い連中を数えます。毎朝、もう一度数える。仕事はそれで全部です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda noite eu conto os rapazes na muralha. Toda alvorada eu conto de novo. O serviço é só isso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每夜我数城墙上的弟兄。每个黎明再数一遍。这差事就这么多。"
          }
        }
      }
    },
    "line.brannock_first" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Torhaus hält, {Herr|Herrin}. Feuerschalen ans Tor, eine Pfahlgrube davor. Dann reden wir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatehouse holds, {lord|my lady}. Braziers by the gate, a stake pit in front. Then we talk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La torre de entrada aguanta, {señor|señora}. Braseros junto a la puerta, un foso de estacas delante. Luego hablamos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le châtelet tient, {monseigneur|madame}. Des braseros à la porte, une fosse à pieux devant. Ensuite on parle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il torrione d’ingresso tiene, {signore|signora}. Bracieri alla porta, una fossa a pali davanti. Poi parliamo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "門楼は持ちます、城主。門の脇に篝火、その前に杭穴。話はそれからです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A torre do portão aguenta, {senhor|senhora}. Braseiros junto ao portão, um fosso de estacas na frente. Depois conversamos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "门楼守得住，城主。门边放火盆，门前挖尖桩坑。然后再说。"
          }
        }
      }
    },
    "line.brannock_gerald" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Jungs halten bei Dämmerung am Schlundtor noch nach Gerald Ausschau. Ich habe es ihnen nicht verboten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lads still look for Gerald at the Throat gate at dusk. I have not told them to stop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al anochecer, los muchachos todavía buscan a Gerald en la puerta de la Garganta. No les he dicho que lo dejen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les gars cherchent encore Gerald à la porte de la Gorge, au crépuscule. Je ne leur ai pas dit d’arrêter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al crepuscolo i ragazzi cercano ancora Gerald alla porta della Gola. Non gli ho detto di smettere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若い連中は今も、日暮れになると喉谷の門でジェラルドを探します。やめろとは言っていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os rapazes ainda procuram Gerald no portão da Garganta ao crepúsculo. Não mandei parar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黄昏时，弟兄们还在喉谷门那儿找杰拉尔德。我没叫他们别找。"
          }
        }
      }
    },
    "line.brannock_giant" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Späher sagen, der Boden im Nebel bebt wie eine Trommel. Heute Nacht kommt etwas Großes. Jeder Mann auf die Mauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scouts say the ground in the fog shakes like a drum. Something big tonight. Every man on the walls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los exploradores dicen que el suelo retumba en la niebla como un tambor. Algo grande viene esta noche. Todos a las murallas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éclaireurs disent que le sol tremble dans le brouillard comme un tambour. Quelque chose de gros, cette nuit. Tous aux murailles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli esploratori dicono che nella nebbia il terreno trema come un tamburo. Stanotte arriva qualcosa di grosso. Tutti sulle mura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "斥候の話では、霧の中で地面が太鼓のように揺れるそうです。今夜は何かでかいのが来る。全員、城壁へ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os batedores dizem que o chão na névoa treme feito tambor. Algo grande esta noite. Todo homem nas muralhas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "斥候说，雾里的地面震得像鼓。今夜有大家伙。所有人上城墙。"
          }
        }
      }
    },
    "line.brannock_guest" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euer Gast steht nachts auf den Zinnen und friert nie. Mir gefällt das nicht. Den Jungs schon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your guest stands on the battlements at night and never shivers. I do not like it. The lads do."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su huésped pasa la noche en las almenas y nunca tiembla de frío. No me gusta. A los muchachos sí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre invitée se tient sur les créneaux la nuit et ne frissonne jamais. Ça ne me plaît pas. Aux gars, si."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vostra ospite sta sui merli di notte e non trema mai. A me non piace. Ai ragazzi sì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客人は夜、胸壁に立って、まるで震えない。私は気に入りません。若い連中は気に入っている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua hóspede fica nas ameias à noite e nunca treme de frio. Não gosto disso. Os rapazes gostam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您那位客人夜里站在城垛上，从不发抖。我不喜欢。弟兄们喜欢。"
          }
        }
      }
    },
    "line.brannock_hounds" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bald kommen Hunde. Schnell, und sie springen über Palisaden. Stein hält sie auf. Merkt Euch das."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hounds come soon. Fast, and they leap palisades. Stone stops them. Remember that."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronto vendrán los sabuesos. Rápidos, y saltan empalizadas. La piedra los detiene. Recuérdelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chiens arrivent bientôt. Rapides, et ils sautent les palissades. La pierre les arrête. Retenez ça."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presto arrivano i segugi. Veloci, e saltano le palizzate. La pietra li ferma. Ricordatevelo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "じきに影犬が来ます。速いうえに、柵を跳び越える。石なら止まります。覚えておいてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logo vêm os cães. Rápidos, e saltam paliçadas. Pedra os detém. Lembre-se disso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影犬快来了。跑得快，能跳过木栅。石头挡得住。记住。"
          }
        }
      }
    },
    "line.brannock_last" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was auch aus dem Nebel kommt, {Herr|Herrin}, ich bin froh, dass da oben Eure Laterne hängt und nicht meine."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whatever comes out of the fog, {lord|my lady}, I am glad it is your lantern up there and not mine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salga lo que salga de la niebla, {señor|señora}, me alegra que el farol de allá arriba sea el suyo y no el mío."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quoi qu’il sorte du brouillard, {monseigneur|madame}, je suis content que ce soit votre lanterne là-haut, et pas la mienne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualunque cosa esca dalla nebbia, {signore|signora}, sono contento che lassù ci sia la vostra lanterna e non la mia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "霧から何が出てこようと、城主、あの上に掛かっているのが私のでなく城主のランタンで、よかったと思っています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seja o que for que saia da névoa, {senhor|senhora}, fico contente que lá em cima esteja a sua lanterna, e não a minha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不管雾里出来什么，城主，我庆幸挂在上头的是您的提灯，不是我的。"
          }
        }
      }
    },
    "line.brannock_last_hint" : {
      "comment" : "Court talk: brannock, a hint about last_stand.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Jungs wollen ein Wort von Euch, {Herr|Herrin}. Am Thron. Haltet es kurz, sie zählen Pfeile."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lads want a word from you, {lord|my lady}. At the throne. Keep it short, they are counting arrows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los muchachos quieren unas palabras suyas, {señor|señora}. En el trono. Que sean breves: están contando flechas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les gars veulent un mot de vous, {monseigneur|madame}. Au trône. Faites court, ils comptent les flèches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I ragazzi vogliono una parola da voi, {signore|signora}. Al trono. Siate breve, stanno contando le frecce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若い連中が、城主から一言ほしいそうです。城主の座で。手短に。矢を数えている最中なので。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os rapazes querem uma palavra sua, {senhor|senhora}. No trono. Seja breve, eles estão contando flechas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弟兄们想听您说句话，城主。在主座前。说短点，他们在数箭。"
          }
        }
      }
    },
    "line.brannock_light" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst Licht, sagtet Ihr. Schön. Aber Licht schießt nicht zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light first, you said. Fine. But light does not shoot back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero la luz, dijo. Bien. Pero la luz no dispara flechas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lumière d’abord, vous avez dit. Soit. Mais la lumière ne riposte pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima la luce, avete detto. Va bene. Ma la luce non scocca frecce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず灯り、とおっしゃった。結構です。ただ、灯りは撃ち返してくれません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luz primeiro, foi o que disse. Muito bem. Mas luz não revida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您说先点灯。行。可光不会放箭。"
          }
        }
      }
    },
    "line.brannock_pole" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Stange. Nein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That pole. No."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa pértiga. No."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette perche. Non."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quella pertica. No."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あの竿。……いや。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquela vara. Não."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那根杆子。不。"
          }
        }
      }
    },
    "line.brannock_promised" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr habt mir einen Turm versprochen. Ich habe schon ausgesucht, welche Jungs zuerst hinaufdürfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You promised me a tower. I have already picked which lads go up first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me prometió una torre. Ya elegí qué muchachos suben primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous m’avez promis une tour. J’ai déjà choisi quels gars monteront les premiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi avete promesso una torre. Ho già scelto quali ragazzi salgono per primi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "塔をくださると約束されました。最初に登る若い連中は、もう選んであります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me prometeu uma torre. Já escolhi quais rapazes sobem primeiro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您答应过我一座塔。哪几个弟兄先上去，我已经挑好了。"
          }
        }
      }
    },
    "line.brannock_refused" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr habt dem Herold nein gesagt. Gut. Ich hätte ihm Schlimmeres gesagt, aber es ist Euer Saal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You told the herald no. Good. I would have told him worse, but it is your hall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dijo que no al heraldo. Bien. Yo le habría dicho algo peor, pero el salón es suyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez dit non au héraut. Bien. Je lui aurais dit pire, mais c’est votre salle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avete detto di no all’araldo. Bene. Io gli avrei detto di peggio, ma il salone è vostro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伝令をはねつけましたね。結構です。私ならもっとひどく言ってやったが、ここは城主の広間ですから。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse não ao arauto. Bom. Eu teria dito coisa pior, mas o salão é seu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您对传令官说了不。好。换我会说得更难听，可这是您的大厅。"
          }
        }
      }
    },
    "line.brannock_runner" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euer kleines Lampenkind hat letzte Nacht vier Feuerschalen neu entzündet. Schneller als meine Männer. Sagt es ihnen nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your little lamp-runner relit four braziers last night. Faster than my men. Do not tell them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su pequeño recadero de las lámparas volvió a encender cuatro braseros anoche. Más rápido que mis hombres. No se lo diga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre petit porte-lampe a rallumé quatre braseros la nuit dernière. Plus vite que mes hommes. Ne leur dites pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vostro piccolo portalampade ha riacceso quattro bracieri la notte scorsa. Più svelto dei miei uomini. Non diteglielo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あの灯り運びの子が、ゆうべ篝火を四つ灯し直しました。うちの兵より速い。連中には内緒に。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu pequeno carregador de lampiões reacendeu quatro braseiros ontem à noite. Mais rápido que os meus homens. Não conte a eles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您那个送灯的孩子昨夜重新点亮了四个火盆。比我的兵快。别告诉他们。"
          }
        }
      }
    },
    "line.brannock_scarecrow" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem fernen Feld steht eine Vogelscheuche mit meinem Gesicht. Die Krähen haben mehr Respekt vor ihr als die Rekruten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is a scarecrow in the far field wearing my face. The crows respect it more than the recruits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el campo del fondo hay un espantapájaros con mi cara. Los cuervos lo respetan más que los reclutas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a, dans le champ du fond, un épouvantail qui a ma tête. Les corneilles le respectent plus que les recrues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel campo lontano c’è uno spaventapasseri con la mia faccia. Le cornacchie lo rispettano più delle reclute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠くの畑に、私の顔をした案山子が立っています。烏どものほうが、新兵よりよほどあれを敬っている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem um espantalho no campo mais distante com a minha cara. Os corvos o respeitam mais que os recrutas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远处田里立着个稻草人，长着我的脸。鸦群比新兵还把它当回事。"
          }
        }
      }
    },
    "line.brannock_sergeant" : {
      "comment" : "Court talk: brannock, a hint about old_sergeant.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Saal fragt ein alter Feldwebel nach einem Speer. Schnarcht auf Wache. Der beste Mann, den ich je hatte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is an old sergeant in the hall asking for a spear. Snores on watch. Best man I ever had."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un viejo sargento en el salón que pide una lanza. Ronca en la guardia. El mejor hombre que he tenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a dans la salle un vieux sergent qui demande une lance. Ronfle pendant la garde. Le meilleur homme que j’aie jamais eu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel salone c’è un vecchio sergente che chiede una lancia. Russa quando è di guardia. Il miglior uomo che abbia mai avuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大広間に、槍をくれという古参の軍曹がいます。見張り中にいびきをかく。私の持った最高の部下です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem um velho sargento no salão pedindo uma lança. Ronca de guarda. O melhor homem que já tive."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大厅里有个老军士要一杆长矛。站岗打呼噜。我带过的最好的兵。"
          }
        }
      }
    },
    "line.brannock_speech_aldric" : {
      "comment" : "Court talk: brannock (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Alten schärfen ihre Schwerter für Aldric. Nicht um ihn zu töten. Um ihn heimzuholen. Eure Worte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The old hands sharpen their swords for Aldric. Not to kill him. To bring him home. Your words."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los veteranos afilan sus espadas por Aldric. No para matarlo. Para traerlo a casa. Palabras suyas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les anciens aiguisent leurs épées pour Aldric. Pas pour le tuer. Pour le ramener. Vos mots."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I veterani affilano le spade per Aldric. Non per ucciderlo. Per riportarlo a casa. Parole vostre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古参の連中が、アルドリック様のために剣を研いでいます。斬るためじゃない。連れ帰るために。城主のお言葉です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os veteranos afiam as espadas por Aldric. Não para matá-lo. Para trazê-lo para casa. Palavras suas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "老兵们在为奥德里克磨剑。不是去杀他。是接他回家。您的话。"
          }
        }
      }
    },
    "line.brannock_speech_dawn" : {
      "comment" : "Court talk: brannock (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wir halten bis zum Morgen.“ Kurz. Den Jungs gefiel es. Jetzt sagen sie es sich gegenseitig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“We hold until dawn.” Short. The lads liked it. They are saying it to each other now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Resistiremos hasta el alba.» Breve. A los muchachos les gustó. Ahora se lo dicen unos a otros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Nous tiendrons jusqu’à l’aube. » Court. Les gars ont aimé. Maintenant, ils se le répètent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Resisteremo fino all’alba.» Breve. Ai ragazzi è piaciuta. Adesso se la ripetono tra loro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「夜明けまで持ちこたえよう」。短くていい。連中も気に入って、今では互いに言い合っています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Vamos aguentar até a alvorada.” Curto. Os rapazes gostaram. Agora repetem isso uns para os outros."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“我们坚守到天亮。”短。弟兄们喜欢。现在他们互相说着这句话。"
          }
        }
      }
    },
    "line.brannock_speech_honest" : {
      "comment" : "Court talk: brannock (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch Angst, sagtet Ihr. Und Ihr bleibt. Dem trauen die Jungs mehr als jedem Stirnreif."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afraid, you said, and staying. The lads trust that more than any circlet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que no nació para esto, dijo. Los muchachos se fían más de eso que de cualquier aro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamais {fait|faite} pour ça, vous avez dit. Les gars s’y fient plus qu’à n’importe quel cercle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Non doveva toccare a me», avete detto. I ragazzi ci credono più che a qualunque cerchio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんな役目に就くはずではなかった、とおっしゃった。連中は、どんな額輪よりその言葉を信じます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto nunca foi para mim, foi o que disse. Os rapazes confiam mais nisso do que em qualquer aro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您说，本不是为此而生。弟兄们信这句，胜过信任何额环。"
          }
        }
      }
    },
    "line.brannock_tax_hint" : {
      "comment" : "Court talk: brannock, a hint about war_tax.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute bitte ich um Gold, {Herr|Herrin}. Es wird Euch nicht gefallen. Mir auch nicht. Den Mauern ist das egal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today I ask for gold, {lord|my lady}. You will not like it. I do not like it either. Walls do not care."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy pido oro, {señor|señora}. No le va a gustar. A mí tampoco. A las murallas les da igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd’hui, je demande de l’or, {monseigneur|madame}. Ça ne va pas vous plaire. À moi non plus. Les murailles s’en moquent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi vi chiedo oro, {signore|signora}. Non vi piacerà. Non piace nemmeno a me. Alle mura non importa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は金を願い出ます、城主。お気に召さないでしょう。私も気に入らない。城壁は気にしません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoje eu peço ouro, {senhor|senhora}. Não vai gostar. Eu também não gosto. As muralhas não ligam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天我要钱，城主。您不会喜欢。我也不喜欢。城墙不管这些。"
          }
        }
      }
    },
    "line.brannock_tower_hint" : {
      "comment" : "Court talk: brannock, a hint about tower_request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe heute eine Bitte für die Audienz, {Herr|Herrin}. Es geht um Pfeile. Und einen Turm. Vor allem den Turm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have a request for the audience today, {lord|my lady}. About arrows. And a tower. Mostly the tower."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy tengo una petición para la audiencia, {señor|señora}. Sobre flechas. Y una torre. Sobre todo la torre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai une requête pour l’audience aujourd’hui, {monseigneur|madame}. Pour des flèches. Et une tour. Surtout la tour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi ho una richiesta per l’udienza, {signore|signora}. Riguarda le frecce. E una torre. Soprattutto la torre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の謁見で願いがあります、城主。矢のことです。それと塔。主に塔です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenho um pedido para a audiência de hoje, {senhor|senhora}. Sobre flechas. E uma torre. Principalmente a torre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天接见，我有个请求，城主。关于箭。还有一座塔。主要是塔。"
          }
        }
      }
    },
    "line.brannock_walls" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst Mauern, dann Lieder. So werden alte Soldaten alt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walls first, songs later. That is how old soldiers get to be old."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero murallas, canciones después. Así llegan a viejos los soldados viejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’abord les murailles, les chansons ensuite. C’est comme ça que les vieux soldats deviennent vieux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima le mura, poi le canzoni. È così che i vecchi soldati diventano vecchi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城壁が先、歌は後。兵が年寄りになれるのは、そうするからです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro muralhas, depois canções. É assim que soldado velho chega a velho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先筑墙，后唱歌。老兵就是这样活到老的。"
          }
        }
      }
    },
    "line.brannock_window" : {
      "comment" : "Court talk: brannock.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das dunkle Fenster im Bergfried. Die Jungs schauen vor der Wache hinauf. Danke, {Herr|Herrin}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dark window in the keep. The lads look up at it before the watch. Thank you, {lord|my lady}."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana oscura de la torre del homenaje. Los muchachos la miran antes de la guardia. Gracias, {señor|señora}."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre sombre du donjon. Les gars lèvent les yeux vers elle avant la garde. Merci, {monseigneur|madame}."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La finestra buia nel mastio. I ragazzi la guardano prima del turno di guardia. Grazie, {signore|signora}."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主塔の暗い窓。若い連中は見張りの前に、あれを見上げます。ありがとうございます、城主。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A janela escura na torre de menagem. Os rapazes olham para ela antes do turno. Obrigado, {senhor|senhora}."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主堡那扇黑着的窗。弟兄们站岗前都抬头看一眼。谢谢您，城主。"
          }
        }
      }
    },
    "line.calder_statues" : {
      "comment" : "Court talk: ebbaCalder.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vierzig Burgherren in Eurem Buch. Sechzig Statuen, ehe der Nebel beginnt. Einer von uns irrt sich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forty lords in your book. Sixty statues before the fog. One of us is wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuarenta señores en su libro. Sesenta estatuas antes de la niebla. Uno de los dos se equivoca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quarante seigneurs dans votre livre. Soixante statues avant le brouillard. L’un de nous se trompe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quaranta signori nel vostro libro. Sessanta statue prima della nebbia. Uno di noi si sbaglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家系の書には城主が四十人。霧の手前には石像が六十体。私たちのどちらかが間違っています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quarenta senhores no seu livro. Sessenta estátuas antes da névoa. Um de nós está errado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的家谱里有四十位城主。雾线之前立着六十座石像。我们当中，有一方错了。"
          }
        }
      }
    },
    "line.envoy_lanterns" : {
      "comment" : "Court talk: envoy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Saltgate treiben das ganze Jahr graue Laternen an. Kein Lichtzieher von uns hat sie gemacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grey lanterns wash up at Saltgate all year. No chandler of ours made them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el año llegan faroles grises a la orilla de Saltgate. No los hizo ningún cerero de los nuestros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des lanternes grises s’échouent à Saltgate toute l’année. Aucun lanternier de chez nous ne les a faites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Saltgate il mare porta a riva lanterne grigie tutto l’anno. Non le ha fatte nessuno dei nostri candelai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソルトゲートには一年じゅう、灰色のランタンが流れ着きます。うちの職人が作ったものではないのです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lanternas cinzentas dão na praia em Saltgate o ano inteiro. Nenhum artesão nosso as fez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "索尔特盖特一年到头都有灰提灯被冲上岸。不是我们那儿哪个灯烛匠做的。"
          }
        }
      }
    },
    "line.envoy_lighthouse" : {
      "comment" : "Court talk: envoy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unser Leuchtturm brennt die ganze Nacht, {Lord|Lady} Lantern. Die Dinge im Wasser klettern ihm schon entgegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our lighthouse burns all night, {Lord|Lady} Lantern. The things in the water have started climbing toward it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuestro faro arde toda la noche, {lord|lady} Lantern. Las cosas del agua han empezado a trepar hacia él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notre phare brûle toute la nuit, {seigneur|dame} Lantern. Les choses de l’eau ont commencé à grimper vers lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nostro faro arde tutta la notte, {Lord|Lady} Lantern. Le cose nell’acqua hanno cominciato a salire verso di lui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我らの灯台は夜通し燃えております、ランタン様。水の中のものたちが、灯台へ這い上がり始めました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nosso farol arde a noite inteira, {Lorde|Lady} Lantern. As coisas na água começaram a subir na direção dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们的灯塔彻夜燃烧，兰腾大人。水里的东西已经开始朝它爬了。"
          }
        }
      }
    },
    "line.envoy_sea" : {
      "comment" : "Court talk: envoy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An der Küste blicken unsere Mauern aufs Meer. Ihr habt nur eine Tür. Ich beneide Euch um die eine Front."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the coast our walls face the sea. Here you face one door. I envy you your single front."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la costa, nuestras murallas miran al mar. Aquí usted tiene una sola puerta. Le envidio ese único frente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur la côte, nos murailles font face à la mer. Ici, vous faites face à une seule porte. Je vous envie ce front unique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulla costa le nostre mura guardano il mare. Qui voi avete una porta sola. Vi invidio il vostro unico fronte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿岸では、我らの城壁は海に向いております。こちらが向き合うのは扉ひとつ。守る正面がひとつきりとは、うらやましい。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na costa, as nossas muralhas dão para o mar. Aqui, enfrenta uma porta só. Invejo essa sua frente única."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在海岸，我们的城墙面朝大海。在这里，您只需面对一扇门。我羡慕您只有一道战线。"
          }
        }
      }
    },
    "line.envoy_thanks" : {
      "comment" : "Court talk: envoy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Küste erinnert sich an Eure Hilfe, {Lord|Lady} {lord}. Meine Herrin hat einen Wachturm nach Euch benannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The coast remembers your help, {Lord|Lady} {lord}. My lady has named a watchtower after you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La costa recuerda su ayuda, {lord|lady} {lord}. Mi señora ha bautizado una atalaya con el nombre {del farolero|de la farolera}."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La côte se souvient de votre aide, {seigneur|dame} {lord}. Madame a donné à une tour de guet le nom {du lampiste|de la lampiste}."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La costa ricorda il vostro aiuto, {Lord|Lady} {lord}. La mia signora ha dato a una torre di guardia il nome {del lampionaio|della lampionaia}."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿岸は、ご助力を忘れません、{lord}様。我が主は、物見櫓のひとつに灯り番の名をつけました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A costa se lembra da sua ajuda, {Lorde|Lady} {lord}. A minha senhora batizou uma torre de vigia em honra {do acendedor de lampiões|da acendedora de lampiões}."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海岸记得您的援手，{lord}大人。我家主人以点灯人之名，命名了一座瞭望塔。"
          }
        }
      }
    },
    "line.herald_fire" : {
      "comment" : "Court talk: herald.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euer Feuer ist sehr klein, {Erbe|Erbin} des Diebes. Er hat größere erlöschen sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your fire is very small, heir of the thief. He has watched larger ones go out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su fuego es muy pequeño, {farolero|farolera}. Él ha visto apagarse otros más grandes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre feu est bien petit, lampiste. Il en a vu de plus grands s’éteindre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vostro fuoco è molto piccolo, {lampionaio|lampionaia}. Egli ne ha visti spegnersi di più grandi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お手元の火は、ずいぶんと小さいものでございますな、灯り番。我が王は、もっと大きな火が消えるのを見てこられました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu fogo é muito pequeno, {acendedor de lampiões|acendedora de lampiões}. Ele já viu maiores se apagarem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的火太小了，点灯人。吾王见过更大的火熄灭。"
          }
        }
      }
    },
    "line.herald_throne" : {
      "comment" : "Court talk: herald.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der König unter der Düsternis erinnert sich an dieses Feuer. Es brannte in seinem Saal, tausend Jahre vor Eurem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The King beneath the Gloom remembers this fire. He remembers it in his own hall, a thousand years before yours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Rey bajo la Penumbra recuerda este salón. Recuerda el trono. Recuerda que fue suyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Roi sous la Pénombre se souvient de cette salle. Il se souvient du trône. Il se souvient qu’il était le sien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Re sotto la Penombra ricorda questo salone. Ricorda il trono. Ricorda che era suo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宵闇の下の王は、この広間を覚えておいでです。あの座を覚えておいでです。それがご自分のものであったことを、覚えておいでです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rei sob a Penumbra se lembra deste salão. Lembra-se do trono. Lembra-se de que era dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗霭之下的王记得这座大厅。他记得那主座。他记得，那曾是他的。"
          }
        }
      }
    },
    "line.hesper_beacon" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Leuchtfeuer und die Flamme sind verwandt, {Erbe|Erbin} des Hauses. Ein Feuer, vor langer Zeit in zwei Schalen entzündet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The beacon and the Flame are kin, heir of the house. One fire, lit long ago in two bowls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La almenara y la Llama son parientes, {hijo|hija} de la casa. Un solo fuego, encendido hace mucho en dos cuencos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fanal et la Flamme sont parents, enfant de la maison. Un seul feu, allumé jadis dans deux vasques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faro e la Fiamma sono parenti, {figlio|figlia} della casa. Un solo fuoco, acceso tanto tempo fa in due coppe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烽火と炎は血縁なのですよ、家の御子。遠い昔、二つの火皿に灯された、一つの火です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O farol e a Chama são parentes, {filho|filha} da casa. Um só fogo, aceso há muito tempo em duas bacias."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烽火与圣焰本是同源，家族之子。很久以前，同一团火点在了两只钵中。"
          }
        }
      }
    },
    "line.hesper_bell" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kapelle hat jetzt keine Stimme, {Erbe|Erbin} des Hauses. Ich schlage im Morgengrauen auf einen Topf. Die Flamme tut, als merke sie nichts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chapel has no voice now, heir of the house. I ring a pot at dawn. The Flame pretends not to notice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capilla se ha quedado sin voz, {hijo|hija} de la casa. Al alba golpeo una olla. La Llama finge no darse cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chapelle n’a plus de voix, enfant de la maison. Je frappe une marmite à l’aube. La Flamme fait semblant de ne rien remarquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora la cappella non ha più voce, {figlio|figlia} della casa. All’alba batto su una pentola. La Fiamma finge di non accorgersene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "礼拝堂は声を失いました、家の御子。夜明けには鍋を叩いています。炎は気づかぬふりをしてくれます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A capela está sem voz agora, {filho|filha} da casa. Bato numa panela na alvorada. A Chama finge não perceber."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "礼拜堂如今没了声音，家族之子。黎明时我敲一口锅。圣焰装作没听见。"
          }
        }
      }
    },
    "line.hesper_blessed" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich segne das Tal jetzt an jedem Morgen. Ob es hilft, weiß ich nicht. Das Tal scheint es zu glauben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I bless the valley each dawn now. I cannot say whether it helps. The valley seems to think so."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora bendigo el valle cada amanecer. No sabría decir si sirve de algo. El valle parece creer que sí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bénis la vallée chaque matin, désormais. Je ne saurais dire si cela aide. La vallée semble le croire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora benedico la valle ogni alba. Non so dire se serva. La valle sembra crederlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今は毎朝、谷を祝福しています。効き目があるのかは分かりません。谷のほうは、あると思っているようですが。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora abençoo o vale a cada alvorada. Não sei dizer se ajuda. O vale parece achar que sim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如今我每日黎明为河谷祈福。有没有用，我说不上。河谷似乎觉得有用。"
          }
        }
      }
    },
    "line.hesper_endless" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Flamme hat Burgherren und Mauern überdauert. Sie wird auch die Lange Wacht überdauern. Das würde ich gern sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Flame has outlived lords and walls. It will outlive the Long Watch. I would like to see that."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Llama ha sobrevivido a señores y murallas. Sobrevivirá a la Larga Vigilia. Me gustaría verlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Flamme a survécu aux seigneurs et aux murailles. Elle survivra à la Longue Veille. J’aimerais voir cela."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Fiamma è sopravvissuta a signori e mura. Sopravvivrà alla Lunga Veglia. Mi piacerebbe vederlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "炎は城主たちよりも、城壁よりも長く生きてきました。長き見張りよりも長く生きるでしょう。それを見届けたいものです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Chama sobreviveu a senhores e a muralhas. Vai sobreviver à Longa Vigília. Eu gostaria de ver isso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圣焰送走了一代代城主、一道道城墙。它也将熬过漫长守望。我倒想亲眼看看。"
          }
        }
      }
    },
    "line.hesper_first" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen, {Erbe|Erbin} des Hauses. Die Flamme brennt seit tausend Jahren in diesem Haus. Seid bitte nicht {derjenige|diejenige}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome, heir of the house. The Flame has burned in this house for a thousand years. Please do not be the one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Bienvenido|Bienvenida}, {hijo|hija} de la casa. La Llama arde en este salón desde hace mil años. No sea usted {el primero|la primera}."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenue, enfant de la maison. La Flamme brûle dans cette salle depuis mille ans. Ne soyez pas {celui-là|celle-là}, je vous prie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Benvenuto, figlio|Benvenuta, figlia} della casa. La Fiamma arde in questo salone da mille anni. Vi prego, non siate voi {quello|quella}."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ようこそ、家の御子。炎はこの広間で千年燃えてきました。どうか、それを絶やすお方にはなられませんよう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Bem-vindo, filho da casa|Bem-vinda, filha da casa}. A Chama arde neste salão há mil anos. Por favor, não seja {o primeiro|a primeira}."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎，家族之子。圣焰在这大厅里燃了一千年。可别让它断在您手里。"
          }
        }
      }
    },
    "line.hesper_flame" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Flamme erinnert sich an jeden Burgherrn. Vor allem an die, die sie erlöschen ließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Flame remembers every lord. Mostly the ones who let it go out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Llama recuerda a cada señor. Sobre todo a los que la dejaron apagarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Flamme se souvient de chaque seigneur. Surtout de ceux qui l’ont laissée s’éteindre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Fiamma ricorda ogni signore. Soprattutto quelli che l’hanno lasciata spegnere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "炎は、歴代の城主をみな覚えています。とりわけ、炎を絶やした方々を。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Chama se lembra de cada senhor. Sobretudo dos que a deixaram apagar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圣焰记得每一位城主。尤其是那些让它熄灭的。"
          }
        }
      }
    },
    "line.hesper_giant_hint" : {
      "comment" : "Court talk: hesper, a hint about hesper_giant.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich muss Euch heute am Thron sprechen, {Erbe|Erbin} des Hauses. Die Flamme hat mir im Morgengrauen etwas gezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I must speak with you at the throne today, heir of the house. The Flame showed me something at dawn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy debo hablar con usted en el trono, {hijo|hija} de la casa. La Llama me mostró algo al alba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je dois vous parler au trône aujourd’hui, enfant de la maison. La Flamme m’a montré quelque chose à l’aube."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi devo parlarvi al trono, {figlio|figlia} della casa. All’alba la Fiamma mi ha mostrato qualcosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日、城主の座でお話ししなければなりません、家の御子。夜明けに、炎が私に何かを見せたのです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preciso lhe falar no trono hoje, {filho|filha} da casa. A Chama me mostrou algo na alvorada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天我须在主座前与您一谈，家族之子。黎明时，圣焰让我看见了一些东西。"
          }
        }
      }
    },
    "line.hesper_goat" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die heilige Ziege hat heute Morgen ein Gesangbuch gefressen. Ich nehme es als Kritik."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The holy goat ate a hymnal this morning. I choose to take it as a review."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cabra santa se comió un himnario esta mañana. Prefiero tomarlo como una crítica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chèvre sacrée a mangé un livre de cantiques ce matin. Je choisis d’y voir une critique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stamattina la capra sacra si è mangiata un innario. Scelgo di prenderla come una critica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聖なる山羊が、今朝、聖歌集を食べました。批評として受け取ることにします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cabra sagrada comeu um hinário hoje de manhã. Prefiro entender isso como uma crítica."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那头圣羊今早吃了一本赞美诗集。我权当是它的评语。"
          }
        }
      }
    },
    "line.hesper_gone" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit sie fort ist, neigt sich die Flamme zum Schlund, als suche sie nach ihr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Flame leans toward the Throat since she left, as if it were looking for her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde que ella se fue, la Llama se inclina hacia la Garganta, como si la buscara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depuis son départ, la Flamme penche vers la Gorge, comme si elle la cherchait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da quando lei se n’è andata, la Fiamma si piega verso la Gola, come se la cercasse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あの方が去ってから、炎は喉谷のほうへ傾いています。あの方を探しているかのように。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde que ela partiu, a Chama se inclina para a Garganta, como se a procurasse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自她走后，圣焰便偏向喉谷，仿佛在寻她。"
          }
        }
      }
    },
    "line.hesper_hunger" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Düsternis ist kein Geschöpf, {Erbe|Erbin} des Hauses. Sie ist ein Hunger. Die Kreaturen sind nur ihre Zähne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Gloom is not a creature, heir of the house. It is a hunger. The creatures are only its teeth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Penumbra no es una criatura, {hijo|hija} de la casa. Es un hambre. Las criaturas son solo sus dientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Pénombre n’est pas une créature, enfant de la maison. C’est une faim. Les créatures n’en sont que les dents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Penombra non è una creatura, {figlio|figlia} della casa. È una fame. Le creature sono solo i suoi denti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宵闇は生き物ではありません、家の御子。飢えです。影の者たちは、その歯にすぎません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Penumbra não é uma criatura, {filho|filha} da casa. É uma fome. As criaturas são só os dentes dela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗霭不是什么生灵，家族之子。它是一种饥饿。那些影人不过是它的牙齿。"
          }
        }
      }
    },
    "line.hesper_lantern" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Laterne brennt grau, weil sie in der Düsternis brannte. Ein Licht, das zurückkam. Ich hielt das nicht für möglich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her lantern burns grey because it burned in the Gloom. A light that came back. I did not think one could."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su farol arde gris porque ardió en la Penumbra. Una luz que volvió. No creía que eso fuera posible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa lanterne brûle d’un feu gris parce qu’elle a brûlé dans la Pénombre. Une lumière revenue. Je ne le croyais pas possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua lanterna arde grigia perché ha arso nella Penombra. Una luce che è tornata. Non credevo fosse possibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あの方のランタンが灰色に燃えるのは、宵闇の中で燃えたからです。戻ってきた灯り。そんなことがあり得るとは、思っていませんでした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lanterna dela arde cinzenta porque ardeu na Penumbra. Uma luz que voltou. Eu não achava que isso fosse possível."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她的提灯燃成灰色，因为它在暗霭里燃烧过。一束去而复返的光。我从没想过会有这样的光。"
          }
        }
      }
    },
    "line.hesper_night20" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute Nacht brennt die Flamme für jeden von ihnen, {Erbe|Erbin} des Hauses. Auch für ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonight the Flame burns for every one of them, heir of the house. For him too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta noche la Llama arde por cada uno de ellos, {hijo|hija} de la casa. También por él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette nuit, la Flamme brûle pour chacun d’eux, enfant de la maison. Pour lui aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanotte la Fiamma arde per ognuno di loro, {figlio|figlia} della casa. Anche per lui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜、炎はその一人ひとりのために燃えます、家の御子。あの方のためにも。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta noite a Chama arde por cada um deles, {filho|filha} da casa. Por ele também."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜圣焰为他们每一个燃烧，家族之子。也为他。"
          }
        }
      }
    },
    "line.hesper_relic" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilger knien vor Mareks Hühnerknochen. Die Flamme stört das nicht. Glaube findet seinen eigenen Weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilgrims kneel before Marek’s chicken bone. The Flame does not mind. Faith finds its own way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los peregrinos se arrodillan ante el hueso de pollo de Marek. A la Llama no le importa. La fe encuentra su camino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des pèlerins s’agenouillent devant l’os de poulet de Marek. La Flamme ne s’en offense pas. La foi trouve son chemin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pellegrini si inginocchiano davanti all’osso di pollo di Marek. La Fiamma non se ne cura. La fede trova la sua strada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "巡礼たちが、マレクの鶏の骨の前にひざまずいています。炎は気にしません。信心は、自分で道を見つけるものです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peregrinos se ajoelham diante do osso de galinha de Marek. A Chama não se importa. A fé encontra o próprio caminho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝圣者跪拜马雷克的鸡骨头。圣焰并不介意。信仰自有其路。"
          }
        }
      }
    },
    "line.hesper_truce_hint" : {
      "comment" : "Court talk: hesper, a hint about truce_end.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommt zum Thron, {Erbe|Erbin} des Hauses. Seit dem Handel ist die Flamme blau. Ich möchte darüber sprechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come to the throne, heir of the house. The Flame has been blue since the bargain. I want to speak of it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venga al trono, {hijo|hija} de la casa. La Llama está azul desde el trato. Quiero hablarle de ello."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venez au trône, enfant de la maison. La Flamme est bleue depuis le pacte. Je veux vous en parler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venite al trono, {figlio|figlia} della casa. Dal giorno del patto la Fiamma arde azzurra. Voglio parlarne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主の座へおいでなさい、家の御子。あの取引以来、炎が青いのです。そのことをお話ししたい。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venha ao trono, {filho|filha} da casa. A Chama está azul desde o acordo. Quero falar disso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请到主座来，家族之子。自那桩交易以来，圣焰一直是蓝色的。我想谈谈此事。"
          }
        }
      }
    },
    "line.hesper_unwarned" : {
      "comment" : "Court talk: hesper (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stadt erfuhr vom Riesen durch ihre bebenden Böden. Nächstes Mal fragen sie zuerst mich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The town learned of the giant from its own shaking floors. They will ask me first next time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pueblo supo del gigante cuando le temblaron los suelos. La próxima vez me preguntarán primero a mí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ville a appris la venue du géant quand ses planchers se sont mis à trembler. La prochaine fois, c’est à moi qu’elle demandera d’abord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il borgo ha saputo del gigante dai propri pavimenti che tremavano. La prossima volta chiederanno prima a me."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "町の人々は、足元の床が揺れて初めて巨人を知りました。次は、まず私に尋ねに来るでしょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cidade soube do gigante pelo próprio chão tremendo. Da próxima vez, vão perguntar primeiro a mim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "镇上是从自家震动的地板得知巨人来了的。下一回，他们会先来问我。"
          }
        }
      }
    },
    "line.hesper_vigil" : {
      "comment" : "Court talk: hesper (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich hielt die Wache. Der Boden bebte, die Flamme nicht. Denkt daran, wenn der Nächste kommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I kept the vigil. The ground shook, and the Flame did not. Remember that when the next one comes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasé la noche en vela. El suelo tembló; la Llama, no. Recuérdelo cuando venga el siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai tenu la veillée. Le sol a tremblé, la Flamme non. Souvenez-vous-en quand viendra le prochain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho tenuto la veglia. La terra ha tremato, la Fiamma no. Ricordatevelo quando verrà il prossimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜通しの祈りを捧げました。大地は揺れ、炎は揺れませんでした。次のものが来たら、それを思い出しなさい。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantive a vigília. O chão tremeu, e a Chama não. Lembre-se disso quando vier o próximo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我守了夜。大地震动，圣焰未动。下一个来时，请记住这一点。"
          }
        }
      }
    },
    "line.hesper_west" : {
      "comment" : "Court talk: hesper.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Dämmerung neigt sich die Flamme nach Westen. Ich rede mir nicht mehr ein, es sei der Luftzug."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At dusk the Flame leans west. I have stopped telling myself it is the draught."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al anochecer, la Llama se inclina hacia el oeste. Ya no me digo que es la corriente de aire."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au crépuscule, la Flamme penche vers l’ouest. J’ai cessé de me dire que c’est le courant d’air."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al crepuscolo la Fiamma si piega a ovest. Ho smesso di dirmi che è la corrente d’aria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日暮れになると、炎は西へ傾きます。すきま風のせいだと自分に言い聞かせるのは、もうやめました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao crepúsculo, a Chama se inclina para o oeste. Parei de dizer a mim mesma que é a corrente de ar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黄昏时，圣焰偏向西方。我已不再骗自己说那是穿堂风。"
          }
        }
      }
    },
    "line.hild_father" : {
      "comment" : "Court talk: hildVarn.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vater sagt, eine Mauer ist so gut wie der, der sie im Morgengrauen zählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Father says a wall is as good as whoever counts it at dawn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi padre dice que una muralla vale lo que vale quien la cuenta al alba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Père dit qu’une muraille vaut ce que vaut celui qui la compte à l’aube."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mio padre dice che le mura valgono quanto chi le conta all’alba."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "父が言うには、城壁の値打ちは、夜明けにそれを数える者しだいだそうです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meu pai diz que uma muralha vale o que vale quem a conta na alvorada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "父亲说，城墙有多牢，全看黎明时清点它的那个人。"
          }
        }
      }
    },
    "line.ludo_goose" : {
      "comment" : "Court talk: serLudo.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe vieles erschlagen, {edler Herr|edle Herrin}. Vor allem Zeit. Aber auch einmal eine sehr große Gans."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have slain many things, good my {lord|lady}. Mostly time. But also, once, a very large goose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He matado muchas cosas, {mi noble señor|mi noble señora}. Sobre todo el tiempo. Pero también, una vez, un ganso enorme."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai tué bien des choses, {mon bon seigneur|ma bonne dame}. Le temps, surtout. Mais aussi, une fois, une oie énorme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho ammazzato molte cose, {mio nobile signore|mia nobile signora}. Soprattutto il tempo. Ma anche, una volta, un’oca molto grossa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数多のものを討ち果たしてまいりましたぞ、気高き城主殿。たいていは退屈を。ですが一度だけ、とてつもなく大きな鵞鳥を。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já matei muita coisa, {meu nobre senhor|minha nobre senhora}. Sobretudo o tempo. Mas também, uma vez, um ganso enorme."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本骑士杀过许多东西，尊贵的大人。杀得最多的是时间。不过也有一回，杀了一只极大的鹅。"
          }
        }
      }
    },
    "line.ludo_helmet" : {
      "comment" : "Court talk: serLudo.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mein Helm ist ein Erbstück. Mein Großvater war ein viel größerer Mann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My helmet is an heirloom. My grandfather was a much larger man."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi yelmo es herencia de familia. Mi abuelo era un hombre mucho más grande."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mon casque est un héritage. Mon grand-père était bien plus grand que moi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mio elmo è un cimelio di famiglia. Mio nonno era un uomo molto più grosso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この兜は家宝ですぞ。祖父は、わたくしよりずっと大柄な男でしてな。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O meu elmo é uma herança de família. O meu avô era um homem muito maior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本骑士的头盔是传家宝。家祖父的块头可大多了。"
          }
        }
      }
    },
    "line.ludo_walls" : {
      "comment" : "Court talk: serLudo.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Mut, {edler Herr|edle Herrin}! Ich habe Eure Mauern geprüft. Hervorragende Mauern. Ich bin gegen zwei gelaufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Courage, good my {lord|lady}! I have inspected your walls. Excellent walls. I walked into two of them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Valor, {mi noble señor|mi noble señora}! He inspeccionado sus murallas. Excelentes murallas. Me di contra dos de ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Courage, {mon bon seigneur|ma bonne dame} ! J’ai inspecté vos murailles. D’excellentes murailles. Je me suis cogné dans deux d’entre elles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coraggio, {mio nobile signore|mia nobile signora}! Ho ispezionato le vostre mura. Mura eccellenti. Due le ho prese in pieno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勇気を、気高き城主殿！　城壁を検分いたしました。見事な城壁ですぞ。わたくし、そのうち二つに正面からぶつかりました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coragem, {meu nobre senhor|minha nobre senhora}! Inspecionei as suas muralhas. Muralhas excelentes. Dei de cara com duas delas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼓起勇气来，尊贵的大人！本骑士巡视过您的城墙了。好墙！本骑士撞上了其中两堵。"
          }
        }
      }
    },
    "line.marek_arrows_hint" : {
      "comment" : "Court talk: marek, a hint about marek_arrows.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute habe ich ein Angebot, so gut, dass es mir wehtut. Fragt jeden. Fragt den Herrn, für den es bestimmt war. Ach. Nun ja."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today I have a bargain so good it hurts me to offer it. Ask anyone. Ask the lord it was meant for. Ah. Well."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy tengo una ganga tan buena que me duele ofrecerla. Pregunte a cualquiera. Pregúntele al señor al que iba destinada. Ah. En fin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd’hui, j’ai une affaire si belle qu’il m’en coûte de la proposer. Demandez à qui vous voudrez. Au seigneur à qui elle était destinée. Ah. Enfin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi ho un affare così buono che offrirlo mi fa male. Chiedete a chiunque. Chiedete al signore a cui era destinato. Ah. Be’."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本日は、お勧めするのも胸が痛むほどの掘り出し物がございます。どなたにでもお尋ねを。本来お納めするはずだった城主様にでも。……ああ。いえ、その。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoje tenho uma pechincha tão boa que me dói oferecê-la. Pergunte a qualquer um. Pergunte ao senhor a quem se destinava. Ah. Bem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日鄙人有桩买卖，划算得叫鄙人心疼。您尽管去问。问问它原本的买主，那位大人……啊。唉，罢了。"
          }
        }
      }
    },
    "line.marek_bargain" : {
      "comment" : "Court talk: marek.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles hat seinen Preis, Eure Strahlkraft. Heute ist meiner sehr vernünftig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything has a price, Your Radiance. Today mine is very reasonable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo tiene un precio, Su Resplandor. Hoy el mío es muy razonable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout a un prix, Votre Splendeur. Aujourd’hui, le mien est très raisonnable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ha un prezzo, Vostro Splendore. Oggi il mio è molto ragionevole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何事にも値はございます、まばゆきお方。本日のわたくしの値は、実に良心的でして。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo tem o seu preço, Vossa Radiância. Hoje o meu é muito razoável."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "万物皆有价，光耀大人。鄙人今日的价，公道得很。"
          }
        }
      }
    },
    "line.marek_caught" : {
      "comment" : "Court talk: marek.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euer Schmied hat sehr kräftige Finger, Eure Strahlkraft. Ich bewundere ihn künftig aus der Ferne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your smith has very strong fingers, Your Radiance. I have decided to admire him from a distance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su herrero tiene unos dedos muy fuertes, Su Resplandor. He decidido admirarlo de lejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre forgeron a une poigne redoutable, Votre Splendeur. J’ai décidé de l’admirer de loin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vostro fabbro ha dita molto forti, Vostro Splendore. Ho deciso di ammirarlo da lontano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お抱えの鍛冶屋は、たいそう指のお強い方で、まばゆきお方。今後は遠くから感服申し上げることにいたしました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu ferreiro tem dedos muito fortes, Vossa Radiância. Resolvi admirá-lo de longe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的铁匠手指劲儿可真大，光耀大人。鄙人决定从远处仰慕他。"
          }
        }
      }
    },
    "line.marek_coast" : {
      "comment" : "Court talk: marek.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Küstenstraße ist nass in letzter Zeit. Das Meer kriecht sie hinauf. Schlecht fürs Geschäft, gut für Boote."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The coast road is wet these days. The sea is creeping up it. Bad for business, good for boats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El camino de la costa anda mojado estos días. El mar va subiendo por él. Malo para el negocio, bueno para los barcos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La route de la côte est humide, ces temps-ci. La mer y grimpe peu à peu. Mauvais pour le commerce, bon pour les bateaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La strada della costa è bagnata, di questi tempi. Il mare la sta risalendo. Male per gli affari, bene per le barche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近ごろ沿岸の道は濡れておりまして。海がじわじわ這い上がってくるのです。商売には悪く、舟には良い。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A estrada da costa anda molhada. O mar vem subindo por ela. Ruim para os negócios, bom para os barcos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近来海岸路湿得很。海水顺着路往上爬。对生意不好，对船倒好。"
          }
        }
      }
    },
    "line.marek_endless" : {
      "comment" : "Court talk: marek.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tal, das nie fällt, ist ein Markt, der nie schließt. Ich trinke auf Eure Mauern, Eure Strahlkraft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A valley that never falls is a market that never closes. I drink to your walls, Your Radiance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un valle que nunca cae es un mercado que nunca cierra. Brindo por sus murallas, Su Resplandor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une vallée qui ne tombe jamais est un marché qui ne ferme jamais. Je bois à vos murailles, Votre Splendeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una valle che non cade mai è un mercato che non chiude mai. Brindo alle vostre mura, Vostro Splendore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "落ちることのない谷は、閉まることのない市場。城壁に乾杯いたします、まばゆきお方。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um vale que nunca cai é um mercado que nunca fecha. Brindo às suas muralhas, Vossa Radiância."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永不陷落的河谷，就是永不关门的集市。鄙人敬您的城墙一杯，光耀大人。"
          }
        }
      }
    },
    "line.marek_gloom" : {
      "comment" : "Court talk: marek.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Düsternis ist schlecht fürs Geschäft, Eure Strahlkraft. Im Krieg kauft keiner Sonnenschirme. Ich habe es versucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Gloom is terrible for trade, Your Radiance. Nobody buys a parasol in a war. I have tried."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Penumbra es terrible para el comercio, Su Resplandor. Nadie compra una sombrilla en tiempos de guerra. Lo he intentado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Pénombre est terrible pour le commerce, Votre Splendeur. Personne n’achète d’ombrelle en temps de guerre. J’ai essayé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Penombra è pessima per il commercio, Vostro Splendore. In guerra nessuno compra un parasole. Ci ho provato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宵闇は商売の大敵でございます、まばゆきお方。戦の最中に日傘を買う方はおりません。試しましたとも。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Penumbra é péssima para o comércio, Vossa Radiância. Ninguém compra sombrinha em tempo de guerra. Eu tentei."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗霭对买卖坏透了，光耀大人。打仗的时候，没人买阳伞。鄙人试过。"
          }
        }
      }
    },
    "line.marek_letters" : {
      "comment" : "Court talk: marek.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goldenacre schreibt an alle, Eure Strahlkraft. Ich trage die Briefe nur aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goldenacre writes to everyone, Your Radiance. I only carry the letters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goldenacre le escribe a todo el mundo, Su Resplandor. Yo solo llevo las cartas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goldenacre écrit à tout le monde, Votre Splendeur. Moi, je ne fais que porter les lettres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goldenacre scrive a tutti, Vostro Splendore. Io porto soltanto le lettere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴールデンエーカーは誰にでも手紙を書かれます、まばゆきお方。わたくしは運ぶだけでございます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goldenacre escreve para todo mundo, Vossa Radiância. Eu só levo as cartas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戈尔登埃克给谁都写信，光耀大人。鄙人只管送信。"
          }
        }
      }
    },
    "line.marek_spyglass_hint" : {
      "comment" : "Court talk: marek, a hint about marek_spyglass.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute etwas Besonderes. Messing. Ehrlich. Ich weiß, ich sage immer ehrlich. Diesmal meine ich das Messing."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something special today. Brass. Honest. I know I always say honest. This time I mean the brass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy, algo especial. Latón legítimo. Ya sé que siempre digo «legítimo». Esta vez me refiero al latón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose de spécial aujourd’hui. Du laiton. Honnête. Je sais, je dis toujours « honnête ». Cette fois, c’est le laiton qui l’est."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi qualcosa di speciale. Ottone. Onesto. Lo so, dico sempre onesto. Stavolta parlo dell’ottone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本日は特別な品を。真鍮でございます。本物です。ええ、わたくしはいつも本物と申しますが。今回は真鍮が本物なのです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo especial hoje. Latão. Legítimo. Eu sei, sempre digo “legítimo”. Desta vez falo do latão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日有件稀罕物。黄铜的。真的。鄙人知道，鄙人回回都说“真的”。这回，真的是黄铜。"
          }
        }
      }
    },
    "line.marek_stays" : {
      "comment" : "Court talk: marek.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Tag in Eurem Burghof! Die Wachen schulden mir elf Gold. Ich war nie glücklicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every day in your courtyard! The guards owe me eleven gold. I have never been happier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Todos los días en su patio de armas! Los guardias me deben once monedas de oro. Nunca he sido tan feliz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les jours dans votre cour ! Les gardes me doivent onze pièces d’or. Je n’ai jamais été aussi heureux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni giorno nel vostro cortile! Le guardie mi devono undici monete d’oro. Non sono mai stato così felice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日こちらの中庭で商いを！　衛兵の皆さまには金貨11枚の貸しがございます。これほど幸せだったことはございません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo dia no seu pátio! Os guardas me devem onze moedas de ouro. Nunca fui tão feliz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天天待在您的庭院里！卫兵们欠鄙人十一枚金币。鄙人从没这么快活过。"
          }
        }
      }
    },
    "line.odile_aldric" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommt Aldric heim, muss ich ihm seinen Stirnreif zurückgeben. Ich habe den Papierkram liebgewonnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If Aldric comes home, I must give him back his circlet. I have grown rather fond of the paperwork."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si Aldric vuelve a casa, tendré que devolverle su aro. Le he tomado bastante cariño al papeleo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si Aldric revient, je devrai lui rendre son cercle. J’ai fini par m’attacher à la paperasse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se Aldric torna a casa, dovrò rendergli il cerchio. Mi sono piuttosto affezionata alle scartoffie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルドリック様がお戻りになれば、額輪をお返ししなければなりません。書類仕事に、いささか愛着がわいてまいりましたのに。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se Aldric voltar, terei de lhe devolver o aro. Acabei me afeiçoando à papelada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "奥德里克若是回来，我就得把额环还给他。这些文书，我倒有些舍不得了。"
          }
        }
      }
    },
    "line.odile_beacon" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fundament, Turm, Schale. Drei Stufen, {mein Herr|meine Herrin}. Die Schatzkammer hat zu allen dreien eine Meinung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Footing, tower, bowl. Three stages, my {lord|lady}. The treasury has opinions about all three."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cimientos, torre, cuenco. Tres etapas, {mi señor|mi señora}. El tesoro tiene opiniones sobre las tres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fondations, tour, vasque. Trois étapes, {monseigneur|madame}. Le trésor a un avis sur chacune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fondamenta, torre, coppa. Tre fasi, {mio signore|mia signora}. Il tesoro ha un’opinione su tutte e tre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "土台、塔、火皿。三つの段階です、城主様。金庫は三つすべてに一家言ございます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alicerce, torre, bacia. Três etapas, {meu senhor|minha senhora}. O tesouro tem opiniões sobre as três."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地基、塔身、火钵。三个阶段，大人。府库对这三样都有意见。"
          }
        }
      }
    },
    "line.odile_counsel" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt bei der Audienz nach meinem Rat. Ich gebe ihn umsonst. Das Einzige hier, was umsonst ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At an audience, ask for my counsel. I give it freely. It is the only free thing in this castle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la audiencia, pídame consejo. Lo doy gratis. Es lo único gratis en este castillo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En audience, demandez mon conseil. Je le donne gratuitement. C’est la seule chose gratuite de ce château."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante l’udienza chiedete il mio consiglio. Lo do gratis. È l’unica cosa gratis in questo castello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "謁見の折には、わたくしの助言をお求めください。お代はいただきません。この城でただ一つ、ただのものです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na audiência, peça o meu conselho. Eu o dou de graça. É a única coisa de graça neste castelo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接见时，不妨听听我的谏言。我分文不取。这座城堡里，只有它不要钱。"
          }
        }
      }
    },
    "line.odile_door" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pläne setzen die Tür des Leuchtfeuers an die Westseite. Burgherrin Oriel machte keine Fehler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The plans put the beacon’s door on the west side. Lady Oriel did not make mistakes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los planos ponen la puerta de la almenara en el lado oeste. Lady Oriel no cometía errores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plans placent la porte du fanal côté ouest. Dame Oriel ne se trompait pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei progetti la porta del faro è sul lato ovest. Lady Oriel non sbagliava mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "図面では、烽火の扉は西側にございます。オリエル様は、間違いをなさらない方でした。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os planos põem a porta do farol no lado oeste. Lady Oriel não cometia erros."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图纸把烽火台的门开在西侧。奥丽尔大人从不出错。"
          }
        }
      }
    },
    "line.odile_doubted" : {
      "comment" : "Court talk: odile (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pläne des Leuchtfeuers liegen unter Später, {mein Herr|meine Herrin}. Ich sehe jeden Morgen in diese Schublade."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The beacon’s plans are filed under Later, my {lord|lady}. I check that drawer every morning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los planos de la almenara están archivados en «Más adelante», {mi señor|mi señora}. Reviso ese cajón cada mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plans du fanal sont classés sous « Plus tard », {monseigneur|madame}. Je vérifie ce tiroir chaque matin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I progetti del faro sono archiviati sotto «Più tardi», {mio signore|mia signora}. Controllo quel cassetto ogni mattina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烽火の図面は「後日」の引き出しにしまってございます、城主様。その引き出しは、毎朝確かめております。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os planos do farol estão arquivados em Mais Tarde, {meu senhor|minha senhora}. Confiro essa gaveta toda manhã."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烽火的图纸归在“日后再议”一档，大人。那个抽屉我每天早上都查看。"
          }
        }
      }
    },
    "line.odile_endless" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch eine Nacht, noch ein Morgen. Ich schreibe kein Datum mehr ins Kassenbuch. Ich schreibe „wieder“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another night, another dawn. I no longer write the date in the ledger. I write “again”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra noche, otro amanecer. Ya no escribo la fecha en el libro de cuentas. Escribo «otra vez»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore une nuit, encore une aube. Je n’écris plus la date dans le registre. J’écris « encore »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’altra notte, un’altra alba. Nel libro dei conti non scrivo più la data. Scrivo «ancora»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "またひと晩、またひと朝。帳簿にはもう日付を書きません。「また」と書くのです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais uma noite, mais uma alvorada. Já não escrevo a data no livro-caixa. Escrevo “de novo”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "又一夜，又一个黎明。我不再往账簿里写日期了。我只写“同上”。"
          }
        }
      }
    },
    "line.odile_family_hint" : {
      "comment" : "Court talk: odile, a hint about family_leaving.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Saal will eine Familie das Tal verlassen. Drei Steuerzahler, {mein Herr|meine Herrin}. Ich habe sie unterstrichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A family in the hall wants to leave the valley. Three taxpayers, my {lord|lady}. I have underlined them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una familia en el salón que quiere dejar el valle. Tres contribuyentes, {mi señor|mi señora}. Los he subrayado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une famille, dans la salle, veut quitter la vallée. Trois contribuables, {monseigneur|madame}. Je les ai soulignés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel salone c’è una famiglia che vuole lasciare la valle. Tre contribuenti, {mio signore|mia signora}. Li ho sottolineati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大広間に、谷を出たいという一家がおります。納税者が3人です、城主様。下線を引いておきました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma família no salão quer deixar o vale. Três contribuintes, {meu senhor|minha senhora}. Eu os sublinhei."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大厅里有一家人想离开河谷。三个纳税人，大人。我在他们名下画了线。"
          }
        }
      }
    },
    "line.odile_first_day" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Stirnreif ist ein Hut, der widerspricht, {mein Herr|meine Herrin}. Setzt Euch, wenn Ihr bereit seid."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A circlet is a hat that argues back, my {lord|lady}. Sit when you are ready."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un aro es un sombrero que le lleva la contraria, {mi señor|mi señora}. Siéntese cuando esté {listo|lista}."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cercle est un chapeau qui discute, {monseigneur|madame}. Asseyez-vous quand vous serez {prêt|prête}."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cerchio è un cappello che ribatte, {mio signore|mia signora}. Sedete quando sarete {pronto|pronta}."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "額輪とは、口答えをする帽子でございます、城主様。お心が決まりましたら、お掛けください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um aro é um chapéu que retruca, {meu senhor|minha senhora}. Sente-se quando estiver {pronto|pronta}."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "额环是一顶会顶嘴的帽子，大人。您准备好了，就请坐吧。"
          }
        }
      }
    },
    "line.odile_guest" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unser Gast isst nichts, schläft nirgends und zahlt keine Steuern. Ich habe ihr ein eigenes Kassenbuch angelegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our guest eats nothing, sleeps nowhere and pays no tax. I have opened a separate ledger for her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuestra huésped no come, no duerme en ninguna parte y no paga impuestos. Le he abierto un libro de cuentas aparte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notre invitée ne mange rien, ne dort nulle part et ne paie aucun impôt. Je lui ai ouvert un registre à part."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nostra ospite non mangia, non dorme da nessuna parte e non paga tasse. Le ho aperto un libro dei conti a parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客人は何も食べず、どこにも寝ず、税も納めません。あの方のために、帳簿を一冊こしらえました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nossa hóspede não come, não dorme em lugar nenhum e não paga imposto. Abri um livro-caixa só para ela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们这位客人不吃饭，不睡觉，也不纳税。我给她另立了一本账簿。"
          }
        }
      }
    },
    "line.odile_guilds" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zunftmeister verneigen sich jetzt genau so tief wie ihre Steuern. Ich habe nachgemessen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The guild masters now bow exactly as deep as their taxes. I measured."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los maestros de gremio hacen ahora reverencias exactamente tan hondas como sus impuestos. Lo he medido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les maîtres de guilde s’inclinent désormais exactement aussi bas que leurs impôts. J’ai mesuré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora i capi delle corporazioni si inchinano esattamente quanto pagano di tasse. Ho preso le misure."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "組合の親方たちは今や、納める税とちょうど同じ深さで頭を下げます。測ってみました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os mestres de guilda agora se curvam na exata medida dos seus impostos. Eu medi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行会会首们如今鞠躬的深浅，恰好与他们的税额相当。我量过。"
          }
        }
      }
    },
    "line.odile_handed" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Kassenbuch ist ausgeglichen, {mein Herr|meine Herrin}. Ich wünschte, das fühlte sich nicht so an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ledger balances, my {lord|lady}. I wish it did not feel like this when it balances."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El libro de cuentas cuadra, {mi señor|mi señora}. Ojalá no se sintiera así cuando cuadra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes sont justes, {monseigneur|madame}. Je voudrais qu’ils ne me laissent pas ce goût-là."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I conti tornano, {mio signore|mia signora}. Non dovrebbero fare quest’effetto, quando tornano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帳簿の数字は合いました、城主様。数字が合って、これほど気が重いとは。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contas fecham, {meu senhor|minha senhora}. Eu preferia que fechar as contas não tivesse este gosto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "账平了，大人。我只愿账平的时候，心里不是这种滋味。"
          }
        }
      }
    },
    "line.odile_night20" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was heute Nacht auch geschieht, {mein Herr|meine Herrin}, die Bücher sind in Ordnung. Das wird jemand wissen wollen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whatever happens tonight, my {lord|lady}, the books are in order. Someone will want to know that."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pase lo que pase esta noche, {mi señor|mi señora}, los libros están en orden. Alguien querrá saberlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quoi qu’il arrive cette nuit, {monseigneur|madame}, les comptes sont en ordre. Quelqu’un voudra le savoir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualunque cosa accada stanotte, {mio signore|mia signora}, i conti sono in ordine. Qualcuno vorrà saperlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜何が起ころうと、城主様、帳簿は整っております。それを知りたがる者が、いずれ現れるでしょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aconteça o que acontecer esta noite, {meu senhor|minha senhora}, os livros estão em ordem. Alguém vai querer saber disso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不论今夜发生什么，大人，账目都井井有条。总会有人想知道这一点。"
          }
        }
      }
    },
    "line.odile_plans_hint" : {
      "comment" : "Court talk: odile, a hint about beacon_plans.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommt heute zum Thron, {mein Herr|meine Herrin}. Ich habe im Archiv etwas gefunden, das keine Steuerrolle ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come to the throne today, my {lord|lady}. I found something in the archive that is not a tax roll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venga hoy al trono, {mi señor|mi señora}. Encontré en el archivo algo que no es un registro de impuestos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venez au trône aujourd’hui, {monseigneur|madame}. J’ai trouvé aux archives quelque chose qui n’est pas un rôle d’impôts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venite al trono oggi, {mio signore|mia signora}. In archivio ho trovato qualcosa che non è un registro delle tasse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本日は謁見にお越しください、城主様。書庫で、税の台帳ではないものを見つけました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venha ao trono hoje, {meu senhor|minha senhora}. Encontrei no arquivo algo que não é um rol de impostos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天请到主座来，大人。我在档案里翻出一样东西，不是税册。"
          }
        }
      }
    },
    "line.odile_refugees" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Leute aus Beaconfoot zahlen ihre Steuern früh und vollständig. Ich muss vielleicht aufhören, mich zu beklagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Beaconfoot folk pay their taxes early and in full. I may have to stop complaining about them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gente de Beaconfoot paga sus impuestos pronto y sin faltar una moneda. Quizá tenga que dejar de quejarme de ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les gens de Beaconfoot paient leurs impôts en avance et en entier. Je vais peut-être devoir cesser de me plaindre d’eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gente di Beaconfoot paga le tasse in anticipo e per intero. Forse dovrò smettere di lamentarmene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビーコンフットの人々は、税を早く、きっちり納めます。あの人たちへの文句は、控えねばならないかもしれません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O povo de Beaconfoot paga os impostos cedo e por inteiro. Talvez eu tenha de parar de reclamar deles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比肯富特人纳税又早又足。我恐怕不能再抱怨他们了。"
          }
        }
      }
    },
    "line.odile_taxes" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Pult setzt Ihr die Steuern. Niedrige machen Freunde, hohe machen Mauern. Wählt Eure Feinde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lectern sets the taxes. Low taxes make friends, high taxes make walls. Choose your enemies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el atril se fijan los impuestos. Los bajos hacen amigos; los altos, murallas. Elija a sus enemigos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lutrin fixe les impôts. Bas, ils font des amis ; hauts, ils font des murailles. Choisissez vos ennemis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al leggio si fissano le tasse. Tasse basse fanno amici, tasse alte fanno mura. Scegliete i vostri nemici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "税は書見台で決めます。低い税は友をつくり、高い税は城壁をつくります。どちらを敵に回すか、お選びください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O atril define os impostos. Imposto baixo faz amigos, imposto alto faz muralhas. Escolha os seus inimigos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "税在书案上定。税低交朋友，税高筑城墙。敌人由您挑。"
          }
        }
      }
    },
    "line.odile_treasury" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schatzkammer ist ein Eimer, {mein Herr|meine Herrin}. Steuern fließen hinein, und die Mauern trinken sie leer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The treasury is a bucket, my {lord|lady}. Taxes pour in, and the walls drink it dry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tesoro es una tinaja, {mi señor|mi señora}. Los impuestos la llenan y las murallas se la beben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trésor est un seau, {monseigneur|madame}. Les impôts s’y déversent, et les murailles le boivent jusqu’à la dernière goutte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tesoro è un secchio, {mio signore|mia signora}. Le tasse lo riempiono, e le mura lo prosciugano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金庫とは桶でございます、城主様。税が流れ込み、城壁がそれを飲み干していきます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tesouro é um balde, {meu senhor|minha senhora}. Os impostos entram, e as muralhas bebem tudo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "府库是只水桶，大人。税金倒进去，城墙一口就喝干了。"
          }
        }
      }
    },
    "line.odile_war_tax" : {
      "comment" : "Court talk: odile.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr habt Brannock eine Kriegssteuer versprochen. Das Pult steht gleich dort, {mein Herr|meine Herrin}. Ich erwähne es nur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You promised Brannock a war tax. The lectern is right there, my {lord|lady}. I merely mention it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le prometió a Brannock un impuesto de guerra. El atril está ahí mismo, {mi señor|mi señora}. Solo lo menciono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez promis un impôt de guerre à Brannock. Le lutrin est juste là, {monseigneur|madame}. Je me contente de le signaler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avete promesso a Brannock una tassa di guerra. Il leggio è proprio lì, {mio signore|mia signora}. Mi limito a farlo notare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラノックに戦時税を約束なさいましたね。書見台はすぐそこです、城主様。念のため申し上げたまでです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prometeu a Brannock um imposto de guerra. O atril está bem ali, {meu senhor|minha senhora}. Apenas comento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您答应过布兰诺克征战争税。书案就在那儿，大人。我只是提一句。"
          }
        }
      }
    },
    "line.orla_cleft" : {
      "comment" : "Court talk: orlaLorn.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euer Haus kam aus dem Spalt herab, Tapers {Erbe|Erbin}. Meines sah es kommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your house came down out of the Cleft, heir of Taper. Mine watched it come."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su casa bajó de la Grieta, joven Taper. La mía la vio bajar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre maison est descendue de la Faille, jeune Taper. La mienne l’a vue venir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vostra casata è scesa dalla Fenditura, giovane Taper. La mia l’ha vista scendere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの家はね、裂け目から下りてきたんだよ、若きテイパー。うちの家は、それを見ていた。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua casa desceu da Fenda, jovem Taper. A minha a viu chegar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你们家是从裂隙里下来的，小泰珀。我们家看着它下来的。"
          }
        }
      }
    },
    "line.pip_aldric" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der alte Herr ist der neue Feind, und {der neue Herr|die neue Herrin} ist {sein Vetter|seine Base}. Das gibt peinliche Familienessen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The old lord is the new enemy, and the new {lord|lady} is his cousin. Family suppers will be awkward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El antiguo señor es el nuevo enemigo, y {el nuevo señor, el antiguo farolero|la nueva señora, la antigua farolera}. Que alguien lo apunte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ancien seigneur est le nouvel ennemi, et {le nouveau seigneur|la nouvelle dame} est {l’ancien lampiste|l’ancienne lampiste}. Que quelqu’un note ça."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vecchio signore è il nuovo nemico, e {il nuovo signore|la nuova signora} è {il vecchio lampionaio|la vecchia lampionaia}. Qualcuno lo metta per iscritto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昔の城主様が今の敵で、今の城主様が昔の灯り番。どなたか、書き留めておいてくださいませ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O velho senhor é o novo inimigo, e {o novo senhor|a nova senhora} é {o velho acendedor de lampiões|a velha acendedora de lampiões}. Alguém anote isso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "老城主成了新敌人，新城主是老点灯人。谁来把这记下来。"
          }
        }
      }
    },
    "line.pip_arrows" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mareks Pfeile fliegen wie Gänse. Meistens nach Süden, und nur im Herbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek’s arrows fly like geese. Mostly south, and only in autumn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las flechas de Marek vuelan como los gansos. Casi siempre al sur, y solo en otoño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les flèches de Marek volent comme les oies. Surtout vers le sud, et seulement en automne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le frecce di Marek volano come le oche. Quasi sempre a sud, e solo d’autunno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マレクの矢は雁のように飛びますな。たいてい南へ、それも秋だけ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As flechas de Marek voam feito gansos. Quase sempre para o sul, e só no outono."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "马雷克的箭飞起来像大雁。多半往南，而且只在秋天。"
          }
        }
      }
    },
    "line.pip_beacon" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Leuchtfeuer, so hell, dass es das Dunkel bricht! Endlich ein Licht, das ich nicht tragen muss."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beacon so bright it breaks the dark! At last, a light nobody will ask me to carry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Una almenara tan brillante que rompe la oscuridad! Por fin, una luz que nadie me pedirá que cargue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fanal si brillant qu’il brise le noir ! Enfin une lumière qu’on ne me demandera pas de porter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un faro così luminoso da spezzare il buio! Finalmente una luce che nessuno mi chiederà di portare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "闇をも破る、まばゆい烽火！　ようやく、わたくしめが運べと言われずに済む灯りでございます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um farol tão forte que quebra o escuro! Enfim, uma luz que ninguém vai me pedir para carregar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一座烽火，亮得能劈开黑暗！总算有一种光，没人会叫小的去提了。"
          }
        }
      }
    },
    "line.pip_crown" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Euer Stirnreif passt, Eure Dochtheit. Schade. Ich hatte einen so guten Witz für einen lockeren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your circlet fits, Your Wickship. A pity. I had such a good joke for a loose one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su aro le queda un poco grande, Su Mechencia. No importa. Ya le quedará bien cuando se le suban los humos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre cercle est un peu grand, Votre Lumignence. Peu importe. Il vous ira quand vous aurez la grosse tête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vostro cerchio è un po’ grande, Vostra Stoppinenza. Niente paura. Vi starà a pennello appena vi si gonfia la testa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "額輪が少々大きすぎるようで、灯心閣下。なに、そのうち思い上がってお頭がふくらめば、ぴたりと合いますとも。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu aro está um pouco grande, Vossa Paviência. Não faz mal. Vai servir quando a sua cabeça inchar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的额环有点大，灯芯阁下。不要紧。等您的脑袋膨胀起来，自然就合适了。"
          }
        }
      }
    },
    "line.pip_crows" : {
      "comment" : "Court talk: pip, a hint about crow_rags.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kind will Eure Feuerschalen in Lumpen kleiden. Endlich eine Mode, die die Krähen respektieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A child wants to dress your braziers in rags. Finally, a fashion the crows respect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un niño quiere vestir sus braseros con harapos. Por fin, una moda que los cuervos respetan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un enfant veut habiller vos braseros de chiffons. Enfin une mode que les corneilles respectent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bambino vuole vestire di stracci i vostri bracieri. Finalmente una moda che le cornacchie rispettano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "篝火にぼろを着せたい、と子どもが申しております。ついに、烏どもも一目置く流行りの到来でございますな。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma criança quer vestir os seus braseiros com trapos. Enfim, uma moda que os corvos respeitam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有个孩子想给您的火盆穿上破布衣裳。总算有一种打扮，连乌鸦都服气。"
          }
        }
      }
    },
    "line.pip_endless" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nacht dreißig-irgendwas. Mir sind die Witze über das Dunkel ausgegangen. Jetzt erzähle ich welche über Brannock."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Night thirty-something. I ran out of jokes about the dark. Now I just tell them about Brannock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noche treinta y tantos. Se me acabaron los chistes sobre la oscuridad. Ahora los cuento sobre Brannock."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuit trente et quelques. Je n’ai plus de blagues sur le noir. Maintenant, je les fais sur Brannock."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notte trenta e rotti. Ho finito le battute sul buio. Adesso faccio quelle su Brannock."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三十何夜目でしたかな。闇の冗談は種切れでございます。今はもっぱら、ブラノックの冗談で。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noite trinta e tantos. Acabaram as minhas piadas sobre o escuro. Agora só conto piadas sobre Brannock."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第三十几夜了。关于黑暗的笑话，小的已经讲完了。现在只讲布兰诺克的。"
          }
        }
      }
    },
    "line.pip_farewell_hint" : {
      "comment" : "Court talk: pip, a hint about pip_farewell.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe heute etwas Wichtiges für die Audienz. Es ist ein Witz. Er ist sehr wichtig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I have something important for the audience today. It is a joke. It is very important."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy traigo algo importante para la audiencia. Es un chiste. Es muy importante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai quelque chose d’important pour l’audience aujourd’hui. C’est une blague. C’est très important."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi ho una cosa importante per l’udienza. È una battuta. È importantissima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の謁見に、大事なものを持ってまいります。冗談でございます。とても大事なのです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenho algo importante para a audiência de hoje. É uma piada. É muito importante."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天接见时，小的有件要紧事。是个笑话。非常要紧。"
          }
        }
      }
    },
    "line.pip_first" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Ein neuer Herr|Eine neue Herrin}! Der letzte ritt ins Dunkel. Folgt ihm nicht. Ich habe nur eine schwarze Kappe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new {lord|lady}! The last one rode into the dark. Don’t follow him. I own only one black cap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡{Un nuevo señor|Una nueva señora}! El último se fue a caballo hacia la oscuridad. Veamos hasta dónde llega antes de la merienda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Un nouveau seigneur|Une nouvelle dame} ! Le précédent s’en est allé dans le noir. Voyons jusqu’où vous irez avant le goûter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Un nuovo signore|Una nuova signora}! L’ultimo è sparito a cavallo nel buio. Vediamo fin dove arrivate prima di merenda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい城主様だ！　前の方は、闇の中へ馬で出ていかれた。さて、お茶の時間までにどこまで行かれますかな。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Um novo senhor|Uma nova senhora}! O último cavalgou para dentro do escuro. Vamos ver até onde chega antes da hora do chá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新城主来啦！上一位骑马进了黑暗。看看您能不能撑到喝茶的时辰。"
          }
        }
      }
    },
    "line.pip_guest" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unser Gast hat eine graue Laterne und keinen Namen. Also eine Wahrsagerin oder eine Steuereintreiberin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our guest has a grey lantern and no name. A fortune-teller, then, or a tax collector."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuestra huésped tiene un farol gris y ningún nombre. Una adivina, entonces, o una recaudadora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notre invitée a une lanterne grise et pas de nom. Une diseuse de bonne aventure, donc, ou une collectrice d’impôts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nostra ospite ha una lanterna grigia e nessun nome. Dunque un’indovina, o un’esattrice delle tasse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客人は灰色のランタンを持ち、名前がない。となると占い師か、さもなくば徴税人でございますな。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nossa hóspede tem uma lanterna cinzenta e nenhum nome. Então é cartomante, ou cobradora de impostos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们这位客人有盏灰提灯，却没有名字。那不是算命的，就是收税的。"
          }
        }
      }
    },
    "line.pip_handed" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei stille Nächte für einen Gast. Billig, wenn man es so sieht. Niemand sieht mir in die Augen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three quiet nights for one guest. Cheap, as these things go. Nobody will look me in the eye."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres noches tranquilas a cambio de una huésped. Barato, para lo que cuestan estas cosas. Nadie me mira a los ojos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois nuits tranquilles contre une invitée. Pas cher, pour ce genre d’affaire. Personne n’ose me regarder en face."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre notti tranquille per un’ospite. A buon mercato, per come vanno queste cose. Nessuno mi guarda negli occhi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客ひとりで、静かな夜が三つ。こうした取引にしては安いもので。誰もわたくしめと目を合わせてくれません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Três noites tranquilas por uma hóspede. Barato, para esse tipo de coisa. Ninguém me olha nos olhos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个客人换三个太平夜。按行情算，便宜。如今谁都不敢正眼瞧小的。"
          }
        }
      }
    },
    "line.pip_herald_hint" : {
      "comment" : "Court talk: pip, a hint about herald_demand.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Saal steht ein Herold, der nach kalter Asche riecht. Ich habe ihm einen Witz erzählt. Er hat seitdem nicht geblinzelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is a herald in the hall who smells of cold ash. I told him a joke. He has not blinked since."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un heraldo en el salón que huele a ceniza fría. Le conté un chiste. Desde entonces no ha parpadeado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a dans la salle un héraut qui sent la cendre froide. Je lui ai raconté une blague. Il n’a pas cligné des yeux depuis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel salone c’è un araldo che sa di cenere fredda. Gli ho raccontato una barzelletta. Da allora non ha più battuto ciglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大広間に、冷えた灰の匂いがする伝令がおります。冗談をひとつ聞かせましたら、それきり瞬きひとつしません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem um arauto no salão que cheira a cinza fria. Contei uma piada para ele. Desde então, não piscou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大厅里有个传令官，身上一股冷灰味。小的给他讲了个笑话。他到现在都没眨过眼。"
          }
        }
      }
    },
    "line.pip_joke_told" : {
      "comment" : "Court talk: pip (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie lachen immer noch über den Witz, Eure Dochtheit. Ich habe ihn noch viermal erzählt. Er wird besser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They are still laughing at the joke, Your Wickship. I have told it four more times. It gets better."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía se ríen del chiste, Su Mechencia. Lo he contado cuatro veces más. Cada vez sale mejor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils rient encore de la blague, Votre Lumignence. Je l’ai racontée quatre fois de plus. Elle s’améliore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ridono ancora della battuta, Vostra Stoppinenza. L’ho raccontata altre quattro volte. Migliora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "皆まだあの冗談で笑っております、灯心閣下。あれから四度話しました。話すたびに良くなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda estão rindo da piada, Vossa Paviência. Contei mais quatro vezes. Fica cada vez melhor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大家还在为那个笑话发笑，灯芯阁下。小的又讲了四遍。越讲越好笑。"
          }
        }
      }
    },
    "line.pip_matches" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Schlüssel der Burg kennt {der Erbe|die Erbin}. Endlich {ein Herr|eine Herrin}, {der|die} weiß, wo die Zündhölzer liegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The heir knows every key in this castle. At last a {lord|lady} who knows where the matches are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hicieron {señor al farolero|señora a la farolera}. Por fin alguien aquí sabe dónde está la yesca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a fait {du lampiste un seigneur|de la lampiste une dame}. Enfin quelqu’un ici qui sait où sont les allumettes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanno fatto {signore il lampionaio|signora la lampionaia}. Finalmente qualcuno qui sa dove sono gli zolfanelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灯り番が城主におなりになった。これでようやく、火種のしまい場所を知るお方が、この城にもできたわけでございますとも。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fizeram {do acendedor de lampiões um senhor|da acendedora de lampiões uma senhora}. Até que enfim alguém aqui sabe onde ficam os fósforos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们让点灯人当了城主。总算有人知道这儿的火柴放在哪儿了。"
          }
        }
      }
    },
    "line.pip_minister" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Minister für Witze habe ich den Dienstag für lustig erklärt. Keiner hat es gemerkt. Schuld ist die Düsternis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As Minister of Jokes I have declared Tuesdays funny. Nobody noticed. I blame the Gloom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como ministro de Chistes, he declarado graciosos los martes. Nadie lo notó. Le echo la culpa a la Penumbra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tant que ministre des Blagues, j’ai décrété le mardi drôle. Personne ne l’a remarqué. C’est la faute de la Pénombre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In qualità di ministro delle Battute ho dichiarato divertente il martedì. Nessuno se n’è accorto. Do la colpa alla Penombra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冗談大臣として、火曜日をおかしな日と定めました。誰も気づきません。宵闇のせいでございます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como ministro das Piadas, declarei as terças-feiras engraçadas. Ninguém notou. A culpa é da Penumbra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小的身为笑话大臣，已宣布每逢星期二都要好笑。谁也没发觉。都怪暗霭。"
          }
        }
      }
    },
    "line.pip_mocked" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe einen Herold des Lichtlosen Königs schweigend hinausgehen lassen. Mein bestes Publikum. Schwierig, allerdings."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I made a herald of the Lightless King leave in silence. My finest audience. Tough crowd, though."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hice que un heraldo del Rey sin Luz se marchara en silencio. Mi mejor público. Un poco frío, eso sí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai fait repartir en silence un héraut du Roi sans lumière. Mon plus beau public. Un peu froid, cela dit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho fatto uscire in silenzio un araldo del Re senza Luce. Il mio pubblico più illustre. Un po’ freddino, però."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光なき王の伝令を、黙って帰らせてやりました。わたくしめの生涯最高の客席。もっとも、手ごわいお客でしたが。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiz um arauto do Rei sem Luz sair em silêncio. A minha melhor plateia. Exigente, isso sim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小的让无光之王的传令官一声不吭地走了。平生最好的一场。就是观众难伺候。"
          }
        }
      }
    },
    "line.pip_pages" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elf Seiten fehlen im großen Buch. Ich habe es gefragt, warum. Bücher sind furchtbare Klatschmäuler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eleven pages gone from the big book. I asked it why. Books are terrible gossips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltan once páginas en el libro grande. Le pregunté por qué. Los libros son unos chismosos terribles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onze pages ont disparu du grand livre. Je lui ai demandé pourquoi. Les livres sont de terribles commères."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undici pagine sparite dal librone. Gli ho chiesto perché. I libri sono dei gran pettegoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きな本から十一枚が消えております。本人に理由を聞いてみました。本というのは、ひどいおしゃべりでして。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onze páginas sumiram do livro grande. Perguntei a ele por quê. Livros são uns fofoqueiros terríveis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大书里少了十一页。小的问它为什么。书这东西，嘴可碎了。"
          }
        }
      }
    },
    "line.pip_refugees_hint" : {
      "comment" : "Court talk: pip, a hint about refugees_gate.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Tor stehen Leute, die neun Nächte gelaufen sind. Unsere größte Sorge heute war die Suppe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are people at the gate who walked for nine nights. Our biggest worry today was the soup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay gente en la puerta que ha caminado nueve noches. Nuestra mayor preocupación de hoy era la sopa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a à la porte des gens qui ont marché neuf nuits. Notre plus gros souci aujourd’hui, c’était la soupe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla porta c’è gente che ha camminato per nove notti. Oggi la nostra preoccupazione più grande era la zuppa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "門に、9晩歩き通した人たちが来ております。今日の我らの悩みといえば、せいぜい鍋の中身でしたのに。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem gente no portão que andou nove noites. A nossa maior preocupação hoje era a sopa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "门口有人走了九夜才到。而我们今天最发愁的，是汤。"
          }
        }
      }
    },
    "line.pip_satire" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ganze Tal singt {vom Burgherrn, der|von der Burgherrin, die} nicht zahlen wollte. Ich habe der Ziege den Refrain beigebracht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The whole valley sings about the {lord|lady} who would not pay. I taught the goat the chorus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el valle canta sobre {el señor|la señora} que no quiso pagar. Le enseñé el estribillo a la cabra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute la vallée chante l’histoire {du seigneur|de la dame} qui ne voulait pas payer. J’ai appris le refrain à la chèvre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutta la valle canta {del signore|della signora} che non voleva pagare. Ho insegnato il ritornello alla capra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "払おうとしなかった城主様の歌を、谷じゅうが歌っております。山羊に合いの手を仕込んだのは、わたくしめで。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O vale inteiro canta sobre {o senhor|a senhora} que não quis pagar. Ensinei o refrão à cabra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整个河谷都在唱那位不肯付钱的城主。小的还教会了山羊唱副歌。"
          }
        }
      }
    },
    "line.pip_saved_joke" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich hebe den Witz immer noch auf, Eure Dochtheit. Also müsst Ihr uns alle am Leben halten. Das ist ein Befehl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am still saving the joke, Your Wickship. So you must keep us all alive. That is an order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigo guardando el chiste, Su Mechencia. Así que tiene que mantenernos a todos con vida. Es una orden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je garde toujours la blague, Votre Lumignence. Vous devez donc nous garder tous en vie. C’est un ordre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservo ancora la battuta, Vostra Stoppinenza. Quindi dovete tenerci tutti in vita. È un ordine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冗談はまだ取ってございます、灯心閣下。ですから皆を生かしておいていただかねば。これは命令でございます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda estou guardando a piada, Vossa Paviência. Então trate de manter todos nós vivos. É uma ordem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那个笑话小的还留着呢，灯芯阁下。所以您得让我们都活着。这是命令。"
          }
        }
      }
    },
    "line.pip_turned" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr sperrt eine Frau mit Laterne aus. Mutig, für {den Erben|die Erbin} eines Hauses, das nach einer heißt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You shut the gate on a woman with a lantern. Bold, for a house named after one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cerró la puerta a una mujer con un farol. Qué audacia, para {un farolero|una farolera}."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez fermé la porte à une femme qui portait une lanterne. Audacieux, pour {un|une} lampiste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avete chiuso la porta in faccia a una donna con una lanterna. Audace, per {un lampionaio|una lampionaia}."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ランタンを提げた女に、門をお閉ざしになった。灯り番にしては、大胆なことでございます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fechou o portão para uma mulher com uma lanterna. Que ousadia, para {um acendedor de lampiões|uma acendedora de lampiões}."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您把一个提灯的女人关在了门外。对点灯人来说，可真大胆。"
          }
        }
      }
    },
    "line.pip_verse_nine" : {
      "comment" : "Court talk: pip.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strophe neun geht mir nicht aus dem Kopf, Eure Dochtheit. Der Mantel ist geflickt, trallala. Meine liebste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verse nine is stuck in my head, Your Wickship. The cloak is mended, tra la. It is my favourite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No me saco la estrofa nueve de la cabeza, Su Mechencia. El aro le queda grande, tralará. Es mi favorita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le couplet neuf me trotte dans la tête, Votre Lumignence. Le cercle est trop grand, tra la la. C’est mon préféré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La strofa nove mi gira in testa, Vostra Stoppinenza. Il cerchio è troppo grande, trallallà. È la mia preferita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "九番の歌詞が頭から離れません、灯心閣下。額輪が大きすぎる、ららら。わたくしめの一番のお気に入りで。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A estrofe nove não me sai da cabeça, Vossa Paviência. O aro é grande demais, tra-lá-lá. É a minha preferida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第九段老在小的脑子里转，灯芯阁下。“额环太大啦，啦啦啦。”小的最爱这段。"
          }
        }
      }
    },
    "line.seren_aldric" : {
      "comment" : "Court talk: seren.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Früher hat er viel gelacht. Ich würde es gern noch einmal hören."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He laughed a great deal, before. I would like to hear it once more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes se reía mucho. Me gustaría oírlo reír una vez más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riait beaucoup, avant. J’aimerais l’entendre encore une fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima rideva molto. Vorrei sentirlo ancora una volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あの人は、以前はよく笑いました。もう一度、あの笑い声を聞きたい。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele ria muito, antes. Gostaria de ouvir esse riso mais uma vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他从前很爱笑。我想再听一次。"
          }
        }
      }
    },
    "line.seren_doubt" : {
      "comment" : "Court talk: seren (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr fragtet, warum erst jetzt. Fragt wieder, wenn er vor Eurer Mauer steht. Ich bin dann noch hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You asked why only now. Ask again when he stands at your wall. I will still be here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me preguntó por qué solo ahora. Pregúntelo otra vez cuando él esté ante su muralla. Yo seguiré aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez demandé pourquoi maintenant seulement. Redemandez quand il sera devant votre muraille. Je serai encore là."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avete chiesto perché solo adesso. Chiedetelo di nuovo quando lui sarà davanti alle vostre mura. Io sarò ancora qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "なぜ今になって、とお尋ねになりましたね。あの人が城壁の前に立ったら、もう一度お尋ねください。私はまだここにいます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perguntou por que só agora. Pergunte de novo quando ele estiver diante da sua muralha. Ainda estarei aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您问为何直到现在。等他站在您的城墙下，再问一次。我还会在这里。"
          }
        }
      }
    },
    "line.seren_gate" : {
      "comment" : "Court talk: seren, a hint about stranger_gate.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Licht schwindet, Lantern. Öffnet, oder seht mir beim Warten zu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The light is going, Lantern. Open, or watch me wait."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luz se va, {farolero|farolera}. Abra, o míreme esperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lumière s’en va, lampiste. Ouvrez, ou regardez-moi attendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luce se ne va, {lampionaio|lampionaia}. Aprite, o guardatemi aspettare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日が落ちます、灯り番。開けるか、私が待つさまを見ているか、です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A luz está indo embora, {acendedor de lampiões|acendedora de lampiões}. Abra, ou me veja esperar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天光要尽了，点灯人。开门，或者看着我等。"
          }
        }
      }
    },
    "line.seren_kitchen" : {
      "comment" : "Court talk: seren.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt, was dort draußen ist, und ich sage: eine Küche. Ich habe es mit anderen Wörtern versucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask what is out there and I say: a kitchen. I have tried other words."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunte qué hay más allá y le diré: una cocina. He probado otras palabras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez ce qu’il y a là-bas, et je réponds : une cuisine. J’ai essayé d’autres mots."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedetemi cosa c’è là fuori e vi dirò: una cucina. Ho provato con altre parole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向こうに何があるのかと聞かれたら、私は答えます。台所、と。ほかの言葉も試してみました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte o que há lá fora, e eu digo: uma cozinha. Já tentei outras palavras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "问我外面是什么，我说：一间厨房。别的词，我试过了。"
          }
        }
      }
    },
    "line.seren_lantern" : {
      "comment" : "Court talk: seren.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Laterne ist nicht kalt, Lantern. Sie ist nur sehr weit fort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My lantern is not cold, Lantern. It is only very far away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi farol no está frío, {farolero|farolera}. Solo está muy lejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma lanterne n’est pas froide, lampiste. Elle est seulement très loin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mia lanterna non è fredda, {lampionaio|lampionaia}. È soltanto molto lontana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私のランタンは冷たいのではありません、灯り番。ただ、とても遠くにあるだけです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A minha lanterna não está fria, {acendedor de lampiões|acendedora de lampiões}. Só está muito longe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我的提灯不冷，点灯人。它只是离得很远。"
          }
        }
      }
    },
    "line.seren_light" : {
      "comment" : "Court talk: seren.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltet ihn im Licht. Lasst ihn nicht hinausgehen. Keinen Augenblick."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold him in the light. Do not let him walk out of it. Not for a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manténgalo en la luz. No deje que salga de ella. Ni un instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez-le dans la lumière. Ne le laissez pas en sortir. Pas un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenetelo nella luce. Non lasciate che ne esca. Neanche per un istante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あの人を光の中に留めてください。光の外へ歩み出させないで。ひと時たりとも。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha-o na luz. Não o deixe sair dela. Nem por um instante."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让他待在光里。别让他走出去。一刻也不行。"
          }
        }
      }
    },
    "line.seren_nearer" : {
      "comment" : "Court talk: seren.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Nacht kommt es ein wenig näher. Nicht die Kreaturen. Das, was hinter ihnen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every night it comes a little nearer. Not the creatures. The thing behind them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada noche se acerca un poco más. No las criaturas. Lo que viene detrás de ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque nuit, cela se rapproche un peu plus. Pas les créatures. Ce qui est derrière elles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni notte si avvicina un poco. Non le creature. Ciò che sta dietro di loro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎晩、少しずつ近づいてきます。影の者たちではありません。その後ろにいるものが。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cada noite chega um pouco mais perto. Não as criaturas. O que está atrás delas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它每夜都近一些。不是那些影人。是它们背后的东西。"
          }
        }
      }
    },
    "line.seren_night20" : {
      "comment" : "Court talk: seren.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute Nacht stehe ich beim Leuchtfeuer. Wenn er fällt, fange ich auf, was von ihm bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonight I stand by the beacon. If he falls, I will be there to catch what is left."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta noche estaré junto a la almenara. Si él cae, estaré allí para recoger lo que quede."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette nuit, je me tiens près du fanal. S’il tombe, je serai là pour recueillir ce qui reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanotte starò accanto al faro. Se lui cade, sarò lì a raccogliere ciò che resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜、私は烽火のそばに立ちます。あの人が倒れたら、残ったものを受け止めるために。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta noite fico junto ao farol. Se ele cair, estarei lá para amparar o que restar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜我守在烽火旁。他若倒下，我会接住剩下的。"
          }
        }
      }
    },
    "line.seren_patient" : {
      "comment" : "Court talk: seren.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Dunkel ist geduldig. Es ist seine einzige Tugend."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dark is patient. It is its only virtue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La oscuridad es paciente. Es su única virtud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’obscurité est patiente. C’est sa seule vertu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il buio è paziente. È la sua sola virtù."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "闇は辛抱強い。それが闇の、ただ一つの美徳です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O escuro é paciente. É a sua única virtude."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黑暗很有耐心。这是它唯一的美德。"
          }
        }
      }
    },
    "line.seren_reveal_hint" : {
      "comment" : "Court talk: seren, a hint about seren_reveal.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommt heute zum Thron. Es gibt etwas, das ich Euch in der ersten Nacht hätte sagen sollen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come to the throne today. There is something I should have told you on the first night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venga hoy al trono. Hay algo que debí decirle la primera noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venez au trône aujourd’hui. Il y a une chose que j’aurais dû vous dire la première nuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venite al trono oggi. C’è una cosa che avrei dovuto dirvi la prima notte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日、城主の座へいらしてください。最初の夜にお話しすべきことが、ありました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venha ao trono hoje. Há algo que eu devia ter lhe contado na primeira noite."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天到主座来。有件事，第一夜我就该告诉您。"
          }
        }
      }
    },
    "line.seren_vow" : {
      "comment" : "Court talk: seren (answers a decision).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr gabt mir Euer Wort für Aldric. Ich habe schon weniger durch die Düsternis getragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You gave me your word for Aldric. I have carried less than that through the Gloom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me dio su palabra por Aldric. He cargado con menos que eso a través de la Penumbra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous m’avez donné votre parole pour Aldric. J’ai porté moins que cela à travers la Pénombre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi avete dato la vostra parola per Aldric. Ho portato meno di questo attraverso la Penombra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルドリックのために、約束をくださいました。宵闇の中を、私はそれより小さなものを頼りに歩いてきたのです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me deu a sua palavra por Aldric. Já carreguei menos que isso pela Penumbra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您为奥德里克向我许了诺。我穿过暗霭时，身上带的还没这么多。"
          }
        }
      }
    },
    "line.tamsin_arrows_hint" : {
      "comment" : "Court talk: tamsin, a hint about marek_arrows.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek verkauft heute Pfeile? Mein Vetter hat von dem Kahn gekauft. Die biegen sich im Regen. Merkt Euch das."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek is selling arrows today? My cousin bought from that barge. They bend in the rain. Mark me."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Que Marek vende flechas hoy? Mi primo le compró a esa barcaza. Se doblan con la lluvia. Ya verá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek vend des flèches aujourd’hui ? Mon cousin en a acheté sur ce chaland-là. Elles plient sous la pluie. Croyez-moi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek vende frecce oggi? Mio cugino ha comprato da quella chiatta. Con la pioggia si piegano. Datemi retta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マレクが今日、矢を売るんですって？　うちのいとこがあの川船から買ったんですよ。雨で曲がるんです。見ててくださいよ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marek vai vender flechas hoje? O meu primo comprou daquela barcaça. Entortam na chuva. Pode anotar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "马雷克今天卖箭？我表哥在那条驳船上买过。一下雨就弯。您记着我的话。"
          }
        }
      }
    },
    "line.tamsin_bard_hint" : {
      "comment" : "Court talk: tamsin, a hint about bard_song.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Barde im Saal, {mein Herr|meine Herrin}. Zahlt nichts, besingt alles. Achtet auf Euren Beutel und Euren Ruf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bard in the hall, my {lord|lady}. Pays nothing, sings everything. Mind your purse and your reputation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bardo en el salón, {mi señor|mi señora}. No paga nada y le canta a todo. Cuide su bolsa y su reputación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un barde dans la salle, {monseigneur|madame}. Ne paie rien, chante tout. Surveillez votre bourse et votre réputation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bardo nel salone, {mio signore|mia signora}. Non paga niente, canta tutto. Badate alla borsa e alla reputazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大広間に吟遊詩人が来てますよ、城主様。何も払わないくせに、何でも歌にするんです。財布と評判にお気をつけて。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um bardo no salão, {meu senhor|minha senhora}. Não paga nada, canta tudo. Cuide da bolsa e da reputação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大厅里来了个吟游诗人，大人。一文不付，什么都唱。看好您的钱袋，还有您的名声。"
          }
        }
      }
    },
    "line.tamsin_cough_hint" : {
      "comment" : "Court talk: tamsin, a hint about ash_cough.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die halbe Gasse hustet grau. Heute kommt jemand deswegen zum Thron. Weidenrinde hilft, sagt ihnen das."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half the lane coughs grey. Someone will come to the throne about it. Willow bark works, tell them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media calle tose gris. Alguien vendrá al trono por eso. La corteza de sauce va bien, dígaselo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La moitié de la ruelle a une toux grise. Quelqu’un viendra au trône pour ça. L’écorce de saule, ça marche, dites-le-leur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezzo vicolo tossisce grigio. Qualcuno verrà al trono per questo. La corteccia di salice aiuta, diteglielo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "路地の半分が灰色の咳をしてます。今日あたり、誰かがそのことで城主の座に来ますよ。柳の皮が効くって、伝えてやってください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metade da rua tosse cinza. Alguém vai ao trono por causa disso. Casca de salgueiro resolve, diga a eles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "半条巷子的人都咳出灰来。会有人为这事到主座前来的。柳树皮管用，您告诉他们。"
          }
        }
      }
    },
    "line.tamsin_endless" : {
      "comment" : "Court talk: tamsin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suppe für die Nachtwache, Suppe für die Tagwache. Wenn die Düsternis je endet, backe ich einen Kuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soup for the night watch, soup for the day watch. If the Gloom ever ends, I am baking a cake."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sopa para la guardia de noche, sopa para la de día. Si algún día se acaba la Penumbra, hago un pastel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la soupe pour la garde de nuit, de la soupe pour la garde de jour. Si la Pénombre finit un jour, je fais un gâteau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuppa per la guardia di notte, zuppa per la guardia di giorno. Se la Penombra finisce, sforno una torta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜の見張りにスープ、昼の見張りにもスープ。いつか宵闇が終わったら、あたしは焼き菓子を焼きますよ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sopa para a guarda da noite, sopa para a guarda do dia. Se a Penumbra um dia acabar, vou assar um bolo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜里站岗的要汤，白天站岗的也要汤。暗霭哪天真散了，我就烤个蛋糕。"
          }
        }
      }
    },
    "line.tamsin_first" : {
      "comment" : "Court talk: tamsin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wieder an meiner Küchentür, {Burgherr|Burgherrin} {lord}? Gut so. Achtet auf Katze, Ofen und Suppe, in dieser Reihenfolge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At my kitchen door again, {Lord|Lady} {lord}? Good. Mind the cat, the oven and the soup, in that order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Otra vez en mi cocina, {lord}? {Mi señor|Mi señora}, quiero decir. Cuidado con el gato, el horno y la sopa, por ese orden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De retour dans ma cuisine, {lord} ? {Monseigneur|Madame}, je veux dire. Attention au chat, au four et à la soupe, dans cet ordre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di nuovo nella mia cucina, {lord}? {Mio signore|Mia signora}, volevo dire. Badate al gatto, al forno e alla zuppa, in quest’ordine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "またあたしの台所ですか、{lord}？　いえ、城主様でしたね。猫と、かまどと、スープに気をつけて。その順番でね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De volta à minha cozinha, {lord}? {Meu senhor|Minha senhora}, quero dizer. Cuidado com o gato, o forno e a sopa, nessa ordem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "又回我厨房来了，{lord}？我是说，大人。当心猫、炉子和汤，按这个顺序。"
          }
        }
      }
    },
    "line.tamsin_goat_hint" : {
      "comment" : "Court talk: tamsin, a hint about goat_chapel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Kapelle steht eine Ziege und im Saal eine Bäuerin. Hesper tobt. Der beste Tag des Monats."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is a goat in the chapel and a farmwife in the hall. Hesper is furious. Best day this month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una cabra en la capilla y una campesina en el salón. Hesper está furiosa. El mejor día del mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a une chèvre dans la chapelle et une paysanne dans la salle. Hesper est furieuse. Meilleure journée du mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’è una capra in cappella e una contadina nel salone. Hesper è furibonda. La giornata più bella del mese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "礼拝堂に山羊が一頭、大広間に農家のおかみさんが一人。ヘスパーはかんかんですよ。今月いちばんの日です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem uma cabra na capela e uma camponesa no salão. Hesper está furiosa. Melhor dia do mês."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "礼拜堂里有头山羊，大厅里有个农妇。赫斯珀气坏了。这个月最好玩的一天。"
          }
        }
      }
    },
    "line.tamsin_gossip" : {
      "comment" : "Court talk: tamsin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bäckersfrau sagt, die Düsternis rieche nach nasser Asche. Sie muss es wissen. Sie verbrennt das Brot."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The baker’s wife says the Gloom smells of wet ash. She would know. She burns the bread."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mujer del panadero dice que la Penumbra huele a ceniza mojada. Ella sabrá. Se le quema el pan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La femme du boulanger dit que la Pénombre sent la cendre mouillée. Elle s’y connaît : elle brûle le pain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La moglie del fornaio dice che la Penombra sa di cenere bagnata. Lei se ne intende. Brucia il pane."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パン屋のおかみが言うには、宵闇は湿った灰の匂いがするんですって。あの人なら分かりますよ。いつもパンを焦がしてるんだから。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mulher do padeiro diz que a Penumbra cheira a cinza molhada. Ela entende do assunto. Queima o pão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面包师的老婆说，暗霭闻着像湿灰。她当然知道，她的面包老是烤糊。"
          }
        }
      }
    },
    "line.tamsin_guest" : {
      "comment" : "Court talk: tamsin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unser Gast isst die Suppe kalt. Ich frage nicht mehr. Manche Leute sind eben so."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our guest takes her soup cold. I have stopped asking. Some people are like that."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuestra huésped se toma la sopa fría. Ya no le pregunto. Hay gente así."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notre invitée prend sa soupe froide. J’ai arrêté de demander. Il y a des gens comme ça."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nostra ospite prende la zuppa fredda. Ho smesso di chiedere. C’è gente fatta così."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客人はスープを冷めてから飲むんです。もう聞くのはやめました。そういう人もいますよ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nossa hóspede toma a sopa fria. Parei de perguntar. Tem gente assim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "咱们那位客人喝汤只喝凉的。我不问了。有些人就是这样。"
          }
        }
      }
    },
    "line.tamsin_herald_hint" : {
      "comment" : "Court talk: tamsin, a hint about herald_demand.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Saal steht ein Mann, der nicht atmet, {mein Herr|meine Herrin}. Die Milch wurde sauer, als er an meiner Tür vorbeiging."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is a man in the hall who does not breathe, my {lord|lady}. The milk turned when he passed my door."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un hombre en el salón que no respira, {mi señor|mi señora}. La leche se cortó cuando pasó por mi puerta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a dans la salle un homme qui ne respire pas, {monseigneur|madame}. Le lait a tourné quand il est passé devant ma porte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel salone c’è un uomo che non respira, {mio signore|mia signora}. Il latte si è inacidito quando è passato davanti alla mia porta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大広間に、息をしない男がいるんですよ、城主様。あれがうちの戸口を通ったら、乳が酸っぱくなりました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem um homem no salão que não respira, {meu senhor|minha senhora}. O leite azedou quando ele passou pela minha porta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大厅里有个人不喘气，大人。他打我门口一过，牛奶就馊了。"
          }
        }
      }
    },
    "line.tamsin_herbs" : {
      "comment" : "Court talk: tamsin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kräutergarten der Witwe hat meine Suppen gerettet und die halbe Gasse dazu. Weide, Salbei und Minze."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The widow’s herb garden saved my soups and half the lane’s chests. Willow, sage and mint, love."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El huerto de la viuda salvó mis sopas y el pecho de media calle. Sauce, salvia y menta, cariño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jardin d’herbes de la veuve a sauvé mes soupes et les bronches de la moitié de la ruelle. Saule, sauge et menthe, {mon petit|ma petite}."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’orto di erbe della vedova ha salvato le mie zuppe e i polmoni di mezzo vicolo. Salice, salvia e menta, tesoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あの未亡人の薬草畑のおかげで、あたしのスープも、路地の半分の胸も助かりました。柳に、セージに、薄荷ですよ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A horta de ervas da viúva salvou as minhas sopas e o peito de meia rua. Salgueiro, sálvia e hortelã, meu bem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寡妇的草药园救了我的汤，也救了半条巷子人的胸口。柳树皮、鼠尾草，还有薄荷，您呐。"
          }
        }
      }
    },
    "line.tamsin_ludo_hint" : {
      "comment" : "Court talk: tamsin, a hint about ludo_arrives.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Saal steht ein Ritter mit einem Helm wie ein Suppentopf. Er wollte Nachschlag, bevor ich aufgetragen hatte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A knight in the hall with a helmet like a soup pot. He asked for seconds before I served firsts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un caballero en el salón con un yelmo como una olla de sopa. Pidió repetir antes de que le sirviera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un chevalier dans la salle, avec un casque comme une marmite. Il a redemandé avant que j’aie servi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel salone c’è un cavaliere con un elmo che pare una pentola da zuppa. Ha chiesto il bis prima ancora del primo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大広間に、スープ鍋みたいな兜をかぶった騎士がいますよ。一杯目をよそう前に、お代わりを頼まれました。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um cavaleiro no salão com um elmo que parece panela de sopa. Pediu para repetir antes que eu servisse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大厅里来了个骑士，头盔像口汤锅。头一碗我还没端上，他就要添第二碗了。"
          }
        }
      }
    },
    "line.tamsin_miller_hint" : {
      "comment" : "Court talk: tamsin, a hint about miller_hoard.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Müller hat wieder zugesperrt. Die Mütter stehen heute vor Eurem Thron, merkt Euch das."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The miller has locked his doors again. The mothers will be at your throne today, mark me."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El molinero ha vuelto a cerrar sus puertas. Hoy tendrá a las madres delante del trono, ya verá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le meunier a encore verrouillé ses portes. Les mères seront devant votre trône aujourd’hui, croyez-moi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mugnaio ha di nuovo sprangato le porte. Oggi le madri saranno davanti al vostro trono, datemi retta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粉屋がまた戸を閉めちまいました。今日は母親たちが城主の座に押しかけますよ。見ててくださいよ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O moleiro trancou as portas de novo. As mães vão estar diante do seu trono hoje, pode anotar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磨坊主又锁门了。今天那些当娘的准要找到主座前来，您瞧着吧。"
          }
        }
      }
    },
    "line.tamsin_mother" : {
      "comment" : "Court talk: tamsin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Mutter ging einmal hinein. Alles, was sie je davon sagte: Das Brot war noch warm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My mother went in once. All she ever said of it was: the bread was still warm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi madre entró una vez. Lo único que contó de aquello fue: el pan todavía estaba caliente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma mère y est entrée, une fois. Tout ce qu’elle en a jamais dit : le pain était encore chaud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mia madre ci è entrata, una volta. Tutto quello che ne ha mai detto: il pane era ancora caldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "母は一度、あっちへ入ったことがあるんです。そのことで言ったのは、ひと言だけ。パンはまだ温かかった、って。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A minha mãe entrou lá uma vez. Tudo o que ela disse a respeito foi: o pão ainda estava quente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我娘进去过一回。关于那里，她这辈子只说过一句：面包还是热的。"
          }
        }
      }
    },
    "line.tamsin_oven_hint" : {
      "comment" : "Court talk: tamsin, a hint about tamsin_oven.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich komme heute zu Eurer Audienz, {mein Herr|meine Herrin}. Es geht um den Ofen. Es geht immer um den Ofen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I will be at your audience today, my {lord|lady}. It is about the oven. It is always about the oven."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy vengo a su audiencia, {mi señor|mi señora}. Es por el horno. Siempre es por el horno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je viendrai à votre audience aujourd’hui, {monseigneur|madame}. C’est pour le four. C’est toujours pour le four."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi verrò alla vostra udienza, {mio signore|mia signora}. Si tratta del forno. Si tratta sempre del forno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の謁見には、あたしも伺いますよ、城主様。かまどのことです。いつだって、かまどのことなんです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoje vou à sua audiência, {meu senhor|minha senhora}. É sobre o forno. É sempre sobre o forno."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天接见我也去，大人。为了炉子。回回都是为了炉子。"
          }
        }
      }
    },
    "line.tamsin_pip" : {
      "comment" : "Court talk: tamsin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip hat gestern eine ganze Pastete gestohlen und es auf die Düsternis geschoben. Die hat wohl Krümel im Bart."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip stole a whole pie yesterday and blamed the Gloom. The Gloom has crumbs in its beard, apparently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip robó ayer una empanada entera y le echó la culpa a la Penumbra. Por lo visto, la Penumbra tiene migas en la barba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip a volé une tourte entière hier et il a accusé la Pénombre. La Pénombre a des miettes dans la barbe, apparemment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieri Pip ha rubato un pasticcio intero e ha dato la colpa alla Penombra. Pare che la Penombra abbia le briciole nella barba."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピップときたら、昨日パイをまるごと盗んで、宵闇のせいにしたんですよ。宵闇ってのは、ひげにパイくずをつけてるらしいですね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip roubou uma torta inteira ontem e pôs a culpa na Penumbra. Pelo visto, a Penumbra tem farelo na barba."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "皮普昨天偷了一整个馅饼，还赖到暗霭头上。看来暗霭的胡子上也沾着饼渣呢。"
          }
        }
      }
    },
    "line.tamsin_place" : {
      "comment" : "Court talk: tamsin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe wieder für ihn gedeckt. Sagt, ich soll aufhören, und ich höre auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I laid his place again. Tell me to stop and I will."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volví a poner su cubierto en la mesa. Dígame que pare y paro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai encore mis son couvert. Dites-moi d’arrêter, et j’arrêterai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho apparecchiato di nuovo il suo posto. Ditemi di smettere e smetterò."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "また、あの方の席を整えました。やめろとおっしゃれば、やめます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pus o lugar dele à mesa de novo. Diga para eu parar, e eu paro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我又给他摆上了碗筷。您说一声别摆，我就不摆了。"
          }
        }
      }
    },
    "line.tamsin_refugees_hint" : {
      "comment" : "Court talk: tamsin, a hint about refugees_gate.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flüchtlinge am Tor, sechs Stück, und zwei Kleine. Ich habe schon den großen Topf aufgesetzt. Nur so."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refugees at the gate, six of them, and two little ones. I have put the big pot on. Just saying."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refugiados en la puerta, seis, y dos pequeñitos. Ya puse la olla grande al fuego. Lo digo nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des réfugiés à la porte, six, et deux petits. J’ai mis la grande marmite sur le feu. Je dis ça comme ça."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profughi alla porta, sei, e due piccini. Ho già messo su il pentolone. Così, per dire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "門に避難民が6人、それに小さい子が2人。大鍋はもう火にかけてあります。一応、お耳に入れておきますね。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refugiados no portão, seis deles, e dois pequenos. Já pus o panelão no fogo. Só estou dizendo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "门口来了难民，六个，还有两个小的。我已经把大锅架上了。我就说说。"
          }
        }
      }
    },
    "line.tamsin_stranger_hint" : {
      "comment" : "Court talk: tamsin, a hint about stranger_gate.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Frau mit grauer Laterne am Tor! Der Bäcker schwört, sie sei geradewegs aus dem Nebel gekommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A woman at the gate with a grey lantern! The baker swears she walked out of the fog itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Una mujer con un farol gris en la puerta! El panadero jura que salió de la mismísima niebla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une femme à la porte, avec une lanterne grise ! Le boulanger jure qu’elle est sortie tout droit du brouillard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una donna alla porta con una lanterna grigia! Il fornaio giura che è uscita dritta dalla nebbia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灰色のランタンを持った女が門に！　パン屋の親方なんて、あの人は霧の中から出てきたって言い張ってますよ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma mulher no portão com uma lanterna cinzenta! O padeiro jura que ela saiu de dentro da própria névoa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "门口来了个提灰灯的女人！面包师赌咒说，她是直接从雾里走出来的。"
          }
        }
      }
    },
    "line.tamsin_well" : {
      "comment" : "Court talk: tamsin, a hint about well_repair.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Marktbrunnen? Grün wie eine Froschhochzeit. Heute kommt bestimmt jemand deswegen betteln, merkt Euch das."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The market well? Green as a frog’s wedding. Someone will come begging about it today, mark me."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿El pozo del mercado? Verde como una boda de ranas. Hoy vendrá alguien a suplicar por él, ya verá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le puits du marché ? Vert comme une noce de grenouilles. Quelqu’un viendra vous supplier à ce sujet aujourd’hui, croyez-moi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pozzo del mercato? Verde come un matrimonio di rane. Oggi qualcuno verrà a supplicare per quello, datemi retta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市場の井戸ですか？　蛙の婚礼みたいに緑色ですよ。今日あたり、誰かが泣きついてきますから。見ててくださいよ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O poço do mercado? Verde que nem casamento de sapo. Hoje alguém vem implorar por causa dele, pode anotar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集市那口井？绿得像青蛙办喜事。今天准有人为这事来求您，您瞧着吧。"
          }
        }
      }
    },
    "petition.ash_cough.c1" : {
      "comment" : "Petition ash_cough: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kräuterfrau bezahlen"
          }
        },
        "en" : {
