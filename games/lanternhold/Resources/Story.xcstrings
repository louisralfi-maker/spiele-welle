    "petition.ash_cough.c2" : {
      "comment" : "Petition ash_cough: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schickt die Kranken fort"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send the sick away"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que se vayan los enfermos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renvoyez les malades"
          }
        },
        "it" : {
          "stringUnit" : {
