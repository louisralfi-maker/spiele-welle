            "value" : "Bram can mend it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram puede arreglarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram peut le réparer"
          }
        },
        "it" : {
