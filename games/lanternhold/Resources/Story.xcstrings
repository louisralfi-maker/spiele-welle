          }
        }
      }
    },
    "petition.barn_fire.hint" : {
      "comment" : "Petition barn_fire: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unser Pfeil, unsere Scheune. Bezahlt sie und bittet Brannock, auf das dunkle Ende des Schlunds zu zielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our arrow, our barn. Pay for it, and ask Brannock to aim at the dark end of the Throat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuestra flecha, nuestro granero. Páguelo, y pídale a Brannock que apunte al extremo oscuro de la Garganta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notre flèche, notre grange. Payez-la, et demandez à Brannock de viser le bout sombre de la Gorge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freccia nostra, fienile nostro. Pagatelo, e chiedete a Brannock di mirare dalla parte buia della Gola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我らの矢、我らの納屋です。弁償いたしましょう。ブラノックには、喉谷の暗いほうの端を狙うよう、お頼みを。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flecha nossa, celeiro nosso. Pague, e peça a Brannock que mire no lado escuro da Garganta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们的箭，我们的谷仓。出钱吧，再请布兰诺克往喉谷黑的那头瞄。"
          }
        }
      }
    },
    "petition.barn_fire.r1" : {
      "comment" : "Petition barn_fire: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachbarn stellen die neue Scheune an einem Tag auf. Brannock schickt zwei Schützen zum Helfen, als eine Art Entschuldigung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The neighbours raise the new barn in a day. Brannock sends two archers to help, as a kind of apology."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los vecinos levantan el granero nuevo en un día. Brannock manda a dos arqueros a ayudar, como una especie de disculpa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les voisins relèvent la grange en un jour. Brannock envoie deux archers prêter la main, en guise d’excuses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I vicini tirano su il fienile nuovo in un giorno. Brannock manda due arcieri ad aiutare, come una specie di scusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近所の者たちが、一日で新しい納屋を建てる。ブラノックは詫びのつもりか、手伝いに弓兵を二人よこす。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os vizinhos erguem o celeiro novo em um dia. Brannock manda dois arqueiros para ajudar, como uma espécie de desculpa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邻居们一天就把新谷仓立了起来。布兰诺克派了两个弓手去帮忙，算是赔个不是。"
          }
        }
      }
    },
    "petition.barn_fire.r2" : {
      "comment" : "Petition barn_fire: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Scheune wird vom Sold der Schützen neu gebaut. Einer gibt seinen Bogen ab und murmelt, er habe auf einen Rußling gezielt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The barn is rebuilt from the archers’ pay. One of them hands in his bow, muttering that he was aiming at a sootling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El granero se reconstruye con la paga de los arqueros. Uno de ellos entrega el arco, mascullando que apuntaba a un hollinejo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grange est rebâtie sur la solde des archers. L’un d’eux rend son arc en marmonnant qu’il visait un fumeron."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fienile viene ricostruito con la paga degli arcieri. Uno di loro consegna l’arco, borbottando che mirava a un fuligginello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "納屋は弓兵の給金で建て直される。一人が弓を返し、煤影を狙ったんだ、とぼやく。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O celeiro é reconstruído com o soldo dos arqueiros. Um deles entrega o arco, resmungando que estava mirando num fuliginho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "谷仓用弓手的饷钱重建了。有一个交了弓，嘟囔着说他当时瞄的是一只煤影。"
          }
        }
      }
    },
    "petition.barn_fire.r3" : {
      "comment" : "Petition barn_fire: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das schwarze Gerippe der Scheune steht das ganze Jahr am ersten Feld. Niemand lässt Euch vergessen, wessen Pfeil es war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The barn’s black shell stands by the first field all year. Nobody lets you forget whose arrow it was."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El esqueleto negro del granero sigue todo el año junto al primer campo. Nadie le deja olvidar de quién fue la flecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carcasse noire de la grange reste toute l’année au bord du premier champ. Personne ne vous laisse oublier à qui était la flèche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo scheletro nero del fienile resta accanto al primo campo per tutto l’anno. Nessuno vi lascia dimenticare di chi era la freccia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "焼け焦げた納屋の骨組みが、一年じゅう最初の畑のそばに立っている。あれが誰の矢だったか、誰も忘れさせてくれない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carcaça negra do celeiro fica junto ao primeiro campo o ano inteiro. Ninguém deixa você esquecer de quem era a flecha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "谷仓烧黑的空架子在头一块田边立了一整年。没人让你忘记那是谁的箭。"
          }
        }
      }
    },
    "petition.barn_fire.text" : {
      "comment" : "Petition barn_fire (farmer): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Burgherr|Burgherrin}, einer Eurer Brandpfeile ist letzte Nacht zu kurz geflogen und in meiner Scheune gelandet. Das Heu, der Karren, das Dach, alles hin. Eure Schützen sagen, es tue ihnen leid. Den Kühen nicht. Wer bezahlt die neue Scheune?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, one of your fire arrows fell short last night and landed in my barn. The hay, the cart, the roof, all gone. Your archers say sorry. The cows do not. Who pays for a new barn?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, una de sus flechas incendiarias se quedó corta anoche y cayó en mi granero. El heno, el carro, el techo: todo perdido. Sus arqueros dicen que lo sienten. Las vacas no. ¿Quién paga un granero nuevo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, une de vos flèches enflammées est tombée trop court la nuit dernière, en plein dans ma grange. Le foin, la charrette, le toit, tout y est passé. Vos archers disent qu’ils sont désolés. Les vaches, non. Qui paie la nouvelle grange ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, la notte scorsa una delle vostre frecce incendiarie è caduta corta ed è finita nel mio fienile. Il fieno, il carro, il tetto, tutto andato. I vostri arcieri chiedono scusa. Le mucche no. Chi paga un fienile nuovo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、ゆうべお城の火矢が一本届かずに、うちの納屋に落ちました。干し草も、荷車も、屋根も、みんな駄目です。弓兵の方々は、すまないと言ってくれます。牛たちは言いません。新しい納屋の代金は、誰が払うんです？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, uma das suas flechas incendiárias caiu antes do alvo ontem à noite e foi parar no meu celeiro. O feno, a carroça, o telhado, tudo perdido. Os seus arqueiros pedem desculpa. As vacas, não. Quem paga um celeiro novo?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主大人，昨夜您的一支火矢没射够远，落进了我的谷仓。干草、车子、屋顶，全没了。您的弓手说了对不起。我的牛可没说。新谷仓谁来出钱？"
          }
        }
      }
    },
    "petition.beacon_plans.c1" : {
      "comment" : "Petition beacon_plans: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann bauen wir es"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Then we build it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entonces la construimos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alors, construisons-le"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allora lo costruiamo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "なら、建てよう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Então vamos construir"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那就建"
          }
        }
      }
    },
    "petition.beacon_plans.c2" : {
      "comment" : "Petition beacon_plans: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt der Stadt die Pläne"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the town the plans"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muéstrele los planos al pueblo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montrez les plans à la ville"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrate i progetti al borgo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "図面を町に見せてくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostre os planos à cidade"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把图纸给镇上看"
          }
        }
      }
    },
    "petition.beacon_plans.c3" : {
      "comment" : "Petition beacon_plans: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mauern gehen vor"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The walls come first"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las murallas van primero"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les murailles d’abord"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima vengono le mura"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城壁が先だ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As muralhas vêm primeiro"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先顾城墙"
          }
        }
      }
    },
    "petition.beacon_plans.hint" : {
      "comment" : "Petition beacon_plans: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mauern halten eine Nacht. Das hier könnte die Nächte beenden. Baut es, {mein Herr|meine Herrin}, bevor Brannock einen vierten Turm verlangt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walls hold a night. This could end them. Build it, my {lord|lady}, before Brannock asks for a fourth tower."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las murallas aguantan una noche. Esto podría poner fin a las noches. Constrúyala, {mi señor|mi señora}, antes de que Brannock pida una cuarta torre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les murailles tiennent une nuit. Ceci pourrait en finir avec les nuits. Construisez-le, {monseigneur|madame}, avant que Brannock réclame une quatrième tour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mura reggono una notte. Questo potrebbe mettere fine alle notti. Costruitelo, {mio signore|mia signora}, prima che Brannock chieda una quarta torre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城壁が持つのはひと晩。これなら、夜そのものを終わらせられるかもしれません。お建てなさいませ、城主様。ブラノックが四つ目の塔をねだる前に。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muralhas seguram uma noite. Isto pode acabar com as noites. Construa, {meu senhor|minha senhora}, antes que Brannock peça uma quarta torre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城墙能守一夜。这东西也许能终结黑夜。建吧，大人，赶在布兰诺克要第四座塔之前。"
          }
        }
      }
    },
    "petition.beacon_plans.r1" : {
      "comment" : "Petition beacon_plans: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile lächelt beinahe. „Ich war so frei, den Platz heute Morgen räumen zu lassen. Versucht, überrascht auszusehen.“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile almost smiles. “I took the liberty of having the site cleared this morning. Do try to look surprised.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile casi sonríe. «Me tomé la libertad de mandar despejar el terreno esta mañana. Intente parecer {sorprendido|sorprendida}.»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile sourit presque. « J’ai pris la liberté de faire dégager le terrain ce matin. Essayez d’avoir l’air {surpris|surprise}. »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile quasi sorride. «Mi sono permessa di far sgombrare il terreno stamattina. Cercate di sembrare {sorpreso|sorpresa}.»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オディールの口もとが、わずかにゆるむ。「勝手ながら、今朝のうちに用地を片づけさせておきました。どうぞ、驚いたお顔をなさってくださいませ」"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odile quase sorri. “Tomei a liberdade de mandar limpar o terreno hoje de manhã. Tente parecer {surpreso|surpresa}.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "奥黛尔几乎笑了。“我已冒昧，今早就让人把地方清出来了。请尽量装出惊讶的样子。”"
          }
        }
      }
    },
    "petition.beacon_plans.r2" : {
      "comment" : "Petition beacon_plans: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pläne werden am Marktbrunnen angeschlagen. Am Abend malen Kinder Leuchtfeuer in den Staub, viel zu hoch, jedes mit der Tür nach Westen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The plans go up on the market well. By evening children draw beacons in the dust, far too tall, each with its door facing west."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los planos se clavan junto al pozo del mercado. Por la tarde, los niños dibujan almenaras en el polvo, demasiado altas, todas con la puerta hacia el oeste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plans sont affichés au puits du marché. Le soir, les enfants dessinent des fanaux dans la poussière, bien trop hauts, chacun avec sa porte à l’ouest."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I progetti vengono affissi al pozzo del mercato. Entro sera i bambini disegnano fari nella polvere, troppo alti, ognuno con la porta rivolta a ovest."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "図面が市場の井戸に貼り出される。夕方には子どもたちが土ぼこりに烽火を描いている。どれも高すぎて、どれも扉が西を向いている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os planos são pregados no poço do mercado. À noitinha, as crianças desenham faróis na poeira, altos demais, cada um com a porta virada para o oeste."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图纸贴在了集市井边。到了傍晚，孩子们在尘土里画烽火，画得高得离谱，每一座的门都朝西。"
          }
        }
      }
    },
    "petition.beacon_plans.r3" : {
      "comment" : "Petition beacon_plans: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Natürlich“, sagt Odile und legt die Pläne unter Später ab. Ihr bemerkt, dass sie sie nicht sehr tief ablegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Of course,” says Odile, and files the plans under Later. You notice she does not file them very deep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Por supuesto», dice Odile, y archiva los planos en «Más adelante». Usted nota que no los archiva muy al fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Bien sûr », dit Odile, et elle range les plans sous « Plus tard ». Vous remarquez qu’elle ne les range pas très loin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Certo», dice Odile, e archivia i progetti sotto «Più tardi». Notate che non li archivia molto in fondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「もちろんでございます」とオディールは言い、図面を「後日」の引き出しにしまう。あまり奥にはしまわないことに、気づく。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Claro”, diz Odile, e arquiva os planos em Mais Tarde. Você repara que ela não os arquiva muito fundo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“当然。”奥黛尔说着，把图纸归进“日后再议”一档。你注意到，她没把它压得太深。"
          }
        }
      }
    },
    "petition.beacon_plans.text" : {
      "comment" : "Petition beacon_plans (odile, story days 11-12): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mein Herr|Meine Herrin}, unter neunhundert Jahren Zehntrollen fand ich dies: Burgherrin Oriels Pläne des Großen Leuchtfeuers. Fundament, Turm, Schale. Am Rand schrieb sie, sein Licht breche jedes Dunkel der Düsternis. Zweimal unterstrichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, under nine hundred years of tithe rolls I found these: Lady Oriel’s plans of the Great Beacon. Footing, tower, bowl. In the margin she wrote that its light breaks any darkness of the Gloom. Twice underlined."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mi señor|Mi señora}, bajo novecientos años de registros del diezmo encontré esto: los planos de la Gran Almenara, de lady Oriel. Cimientos, torre, cuenco. En el margen escribió que su luz rompe cualquier oscuridad de la Penumbra. Subrayado dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, sous neuf cents ans de rôles de la dîme, j’ai trouvé ceci : les plans du Grand Fanal, de la main de dame Oriel. Fondations, tour, vasque. Dans la marge, elle a écrit que sa lumière brise toute obscurité de la Pénombre. Souligné deux fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio signore|Mia signora}, sotto novecento anni di registri della decima ho trovato questi: i progetti di Lady Oriel per il Grande Faro. Fondamenta, torre, coppa. A margine ha scritto che la sua luce spezza ogni oscurità della Penombra. Sottolineato due volte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主様、九百年分の貢ぎの記録の下から、これが出てまいりました。オリエル様の、大烽火の図面です。土台、塔、火皿。余白にこうございます。その光は、宵闇のいかなる闇をも破る、と。二重線つきで。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu senhor|Minha senhora}, debaixo de novecentos anos de registros do dízimo encontrei isto: os planos do Grande Farol, de Lady Oriel. Alicerce, torre, bacia. Na margem, ela escreveu que a luz dele rompe qualquer escuridão da Penumbra. Sublinhado duas vezes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大人，在九百年的贡赋册底下，我找到了这些：奥丽尔大人的大烽火图纸。地基、塔身、火钵。她在页边写道，它的光能破开暗霭中的任何黑暗。下面画了两道线。"
          }
        }
      }
    },
    "petition.bell_for_arrows.c1" : {
      "comment" : "Petition bell_for_arrows: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schmelzt die Glocke ein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melt the bell"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funda la campana"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fondez la cloche"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fondete la campana"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鐘を溶かしてくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derreta o sino"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把钟熔了"
          }
        }
      }
    },
    "petition.bell_for_arrows.c2" : {
      "comment" : "Petition bell_for_arrows: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Glocke bleibt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bell stays"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La campana se queda"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cloche reste"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La campana resta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鐘は残す"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sino fica"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钟留着"
          }
        }
      }
    },
    "petition.bell_for_arrows.hint" : {
      "comment" : "Petition bell_for_arrows: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Glocke ruft zum Gebet. Pfeile machen es überflüssig. Trotzdem hat Hesper die Kerzen in der Hand. Behaltet die Glocke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bell calls people to prayer. Arrows spare them the need. Still, Hesper controls the candles. Keep the bell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una campana llama a la oración. Las flechas la hacen innecesaria. Aun así, las velas las controla Hesper. Quédese con la campana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une cloche appelle à la prière. Les flèches en dispensent. Mais c’est Hesper qui tient les chandelles. Gardez la cloche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una campana chiama la gente a pregare. Le frecce gliene risparmiano il bisogno. Però le candele le ha in mano Hesper. Tenete la campana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鐘は人を祈りに呼びます。矢は祈る必要をなくします。とはいえ、蝋燭を握っているのはヘスパーです。鐘はそのままに。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um sino chama as pessoas para rezar. Flechas dispensam a reza. Mesmo assim, as velas estão nas mãos de Hesper. Fique com o sino."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钟召人祈祷。箭让人不必祈祷。可蜡烛归赫斯珀管。留着钟吧。"
          }
        }
      }
    },
    "petition.bell_for_arrows.r1" : {
      "comment" : "Petition bell_for_arrows: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Nacht fliegen vierhundert Bronzespitzen von den Mauern. Im Morgengrauen schweigt die Kapelle, und Hesper sieht Euch nicht an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That night four hundred bronze heads fly from the walls. At dawn the chapel is silent, and Hesper does not look at you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa noche, cuatrocientas puntas de bronce vuelan desde las murallas. Al alba la capilla calla, y Hesper evita su mirada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette nuit-là, quatre cents pointes de bronze volent des murailles. À l’aube, la chapelle se tait, et Hesper ne vous regarde pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quella notte quattrocento punte di bronzo volano dalle mura. All’alba la cappella tace, e Hesper non vi guarda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その夜、四百の青銅の鏃が城壁から飛ぶ。夜明け、礼拝堂は静まり返り、ヘスパーは目を合わせない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naquela noite, quatrocentas pontas de bronze voam das muralhas. Na alvorada, a capela está em silêncio, e Hesper não olha para você."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那一夜，四百枚青铜箭头从城墙上飞出。黎明时，礼拜堂一片寂静，赫斯珀不看你。"
          }
        }
      }
    },
    "petition.bell_for_arrows.r2" : {
      "comment" : "Petition bell_for_arrows: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram zuckt die Schultern. „Dachte ich mir.“ Er geht zurück an die Esse und schlägt das Eisen etwas härter als sonst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram shrugs. “Thought so.” He goes back to his forge and hits the iron a little harder than usual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram se encoge de hombros. «Lo suponía.» Vuelve a su fragua y golpea el hierro algo más fuerte que de costumbre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram hausse les épaules. « M’en doutais. » Il retourne à sa forge et frappe le fer un peu plus fort que d’habitude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram alza le spalle. «Me l’aspettavo.» Torna alla forgia e batte il ferro un po’ più forte del solito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラムは肩をすくめる。「そう思った」。鍛冶場へ戻り、いつもより少し強く鉄を打つ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram dá de ombros. “Imaginei.” Volta para a forja e bate no ferro um pouco mais forte que de costume."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布拉姆耸耸肩。“猜到了。”他回到炉边，抡锤比平时重了几分。"
          }
        }
      }
    },
    "petition.bell_for_arrows.text" : {
      "comment" : "Petition bell_for_arrows (bram): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kapellenglocke. Gute Bronze. Vierhundert Pfeilspitzen stecken darin, vielleicht mehr. Hesper wird mich hassen. Frage trotzdem. Glocken halten keine Rußlinge auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chapel bell. Good bronze. Four hundred arrowheads in it, maybe more. Hesper will hate me. Asked anyway. Bells don’t stop sootlings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La campana de la capilla. Buen bronce. Cuatrocientas puntas de flecha dentro, quizá más. Hesper me odiará. Pregunto igual. Las campanas no paran hollinejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cloche de la chapelle. Du bon bronze. Quatre cents pointes de flèche là-dedans, peut-être plus. Hesper va me haïr. Demandé quand même. Les cloches n’arrêtent pas les fumerons."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La campana della cappella. Bronzo buono. Ci sono dentro quattrocento punte di freccia, forse di più. Hesper mi odierà. Chiedo lo stesso. Le campane non fermano i fuligginelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "礼拝堂の鐘。いい青銅です。鏃が四百、いやもっと取れる。ヘスパーには恨まれる。それでも、頼みに来ました。鐘じゃ煤影は止まらない。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sino da capela. Bronze bom. Quatrocentas pontas de flecha nele, talvez mais. Hesper vai me odiar. Pedi assim mesmo. Sinos não detêm fuliginhos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "礼拜堂的钟。好青铜。能打四百个箭头，也许更多。赫斯珀会恨我。还是来问了。钟挡不住煤影。"
          }
        }
      }
    },
    "petition.border_family.c1" : {
      "comment" : "Petition border_family: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen im Tal"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to the valley"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenidos al valle"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenue dans la vallée"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benvenuti nella valle"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "谷へようこそ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bem-vindos ao vale"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎来到河谷"
          }
        }
      }
    },
    "petition.border_family.c2" : {
      "comment" : "Petition border_family: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur wenn einer auf den Mauern dient"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only if one serves on the walls"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo si uno sirve en las murallas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement si l’un d’eux sert sur les murailles"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se uno dei due serve sulle mura"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一人が城壁に就くなら、いい"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só se um servir nas muralhas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "得有一个上城墙服役才行"
          }
        }
      }
    },
    "petition.border_family.c3" : {
      "comment" : "Petition border_family: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben keinen Platz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We have no room"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tenemos sitio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous n’avons pas de place"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non abbiamo posto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "置いてやれる場所がない"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não temos lugar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们没地方了"
          }
        }
      }
    },
    "petition.border_family.hint" : {
      "comment" : "Petition border_family: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Paar Hände mehr für die Felder. Felder fragen nie, woher die Hände kommen. Lasst sie herein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two more pairs of hands for the fields. Fields never ask where hands come from. Let them in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos pares de manos más para los campos. Los campos nunca preguntan de dónde vienen las manos. Déjelos entrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux paires de bras de plus pour les champs. Les champs ne demandent jamais d’où viennent les bras. Faites-les entrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altre due paia di braccia per i campi. I campi non chiedono mai da dove vengono le braccia. Fateli entrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "畑に人手が二組増えます。畑は、その手がどこから来たかを尋ねません。入れてやるべきです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais dois pares de mãos para os campos. Campo nunca pergunta de onde vêm as mãos. Deixe-os entrar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地里又多两双手。田地从不问手是打哪儿来的。让他们进来。"
          }
        }
      }
    },
    "petition.border_family.r1" : {
      "comment" : "Petition border_family: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie schlafen einen Tag und eine Nacht. Dann stehen sie im Morgengrauen auf dem fernen Feld und arbeiten, als könnte der Boden weglaufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They sleep a day and a night. Then they are out in the far field at dawn, working as if the soil might run away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duermen un día y una noche. Luego, al alba, ya están en el campo del fondo, trabajando como si la tierra pudiera escaparse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils dorment un jour et une nuit. Puis ils sont au champ du fond dès l’aube, à travailler comme si la terre risquait de s’enfuir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dormono un giorno e una notte. Poi all’alba sono già nel campo lontano, e lavorano come se la terra potesse scappare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "二人は丸一日と一晩眠る。それから夜明けには遠くの畑に出て、土が逃げ出すとでもいうように働いている。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dormem um dia e uma noite. Depois estão no campo distante desde a alvorada, trabalhando como se a terra pudesse fugir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们睡了一天一夜。然后天一亮就到了远处的田里，干起活来，仿佛那泥土会跑掉似的。"
          }
        }
      }
    },
    "petition.border_family.r2" : {
      "comment" : "Petition border_family: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einer nimmt einen Speer, der andere eine Hacke. Beide blicken zum Schlund, als wüssten sie genau, was darin lebt. Das tun sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One takes a spear, the other a hoe. Both look at the Throat as if they knew exactly what lives in it. They do."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno toma una lanza; el otro, una azada. Los dos miran hacia la Garganta como si supieran exactamente lo que vive dentro. Lo saben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’un prend une lance, l’autre une houe. Tous deux regardent la Gorge comme s’ils savaient exactement ce qui y vit. Ils le savent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno prende una lancia, l’altro una zappa. Tutti e due guardano la Gola come se sapessero esattamente cosa ci vive dentro. Lo sanno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一人は槍を、もう一人は鍬を取る。二人とも、喉谷に何が棲んでいるか知っているような目でそちらを見る。実際、知っているのだ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um pega uma lança, o outro uma enxada. Os dois olham para a Garganta como se soubessem exatamente o que vive lá. E sabem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个拿起长矛，一个拿起锄头。两人望向喉谷，仿佛清楚地知道里面住着什么。他们确实知道。"
          }
        }
      }
    },
    "petition.border_family.r3" : {
      "comment" : "Petition border_family: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ziehen weiter zur Küste. Tamsin schickt ihnen mit einem Küchenjungen Brot hinterher, und der Junge kommt ohne zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They walk on toward the coast. Tamsin sends bread after them with a kitchen boy, who comes back without it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siguen camino hacia la costa. Tamsin les manda pan con un pinche de cocina, que vuelve sin él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils poursuivent leur route vers la côte. Tamsin leur fait porter du pain par un marmiton, qui revient sans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proseguono verso la costa. Tamsin manda loro dietro del pane con uno sguattero, che torna senza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "二人は沿岸のほうへ歩いていく。タムシンが台所の小僧にパンを持たせて追わせ、小僧は手ぶらで戻ってくる。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles seguem para a costa. Tamsin manda pão atrás deles com um ajudante de cozinha, que volta sem o pão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们继续朝海岸走去。塔姆辛让一个厨房小伙计追去送面包，那孩子空着手回来了。"
          }
        }
      }
    },
    "petition.border_family.text" : {
      "comment" : "Petition border_family (refugee): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir sind zwei weitere aus Beaconfoot, alles, was von einer Familie übrig ist. Die Düsternis nahm unser Haus. Wir schlafen in einer Scheune und bestellen jedes Feld, das Ihr uns gebt. Wir bitten nur, nie wieder draußen schlafen zu müssen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We are two more from Beaconfoot, all that is left of a family. The Gloom took our house. We will sleep in a barn and work any field you give us. We only ask never to sleep outside again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somos dos más de Beaconfoot, todo lo que queda de una familia. La Penumbra se llevó nuestra casa. Dormiremos en un granero y trabajaremos cualquier campo que nos dé. Solo pedimos no volver a dormir nunca a la intemperie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous sommes deux de plus de Beaconfoot, tout ce qui reste d’une famille. La Pénombre a pris notre maison. Nous dormirons dans une grange et travaillerons n’importe quel champ que vous nous donnerez. Nous demandons seulement de ne plus jamais dormir dehors."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siamo altri due di Beaconfoot, tutto ciò che resta di una famiglia. La Penombra si è presa la nostra casa. Dormiremo in un fienile e lavoreremo qualunque campo ci darete. Chiediamo solo di non dover mai più dormire all’aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私たちもビーコンフットから来た二人です。一家で残ったのは、これだけ。宵闇に家を取られました。納屋で寝ますし、いただけるならどんな畑でも耕します。ただ、二度と外で眠らずにすむように、それだけをお願いします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somos mais dois de Beaconfoot, tudo o que restou de uma família. A Penumbra levou a nossa casa. Dormimos num celeiro e trabalhamos em qualquer campo que nos der. Só pedimos nunca mais dormir ao relento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们又是两个比肯富特人，一家人只剩下我们了。暗霭夺走了我们的房子。我们可以睡在谷仓里，您给哪块田，我们就种哪块田。我们只求再也不要睡在外面。"
          }
        }
      }
    },
    "petition.border_scouts.c1" : {
      "comment" : "Petition border_scouts: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pfähle und Pech kaufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buy the stakes and pitch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprar las estacas y la brea"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acheter les pieux et la poix"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprare pali e pece"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "杭と瀝青を買う"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprar as estacas e o piche"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "买尖桩和沥青"
          }
        }
      }
    },
    "petition.border_scouts.c2" : {
      "comment" : "Petition border_scouts: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertraut den Mauern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trust the walls"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confiar en las murallas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiez-vous aux murailles"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fidatevi delle mura"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城壁を信じよう"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confie nas muralhas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相信城墙"
          }
        }
      }
    },
    "petition.border_scouts.hint" : {
      "comment" : "Petition border_scouts: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Späher sehen jede Woche eine große Welle. Eines Tages werden sie recht haben. Heute, vermute ich, noch nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scouts see a great wave every week. One day they will be right. Not, I suspect, today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los exploradores ven una gran oleada cada semana. Algún día tendrán razón. Hoy no, sospecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éclaireurs voient une grande vague chaque semaine. Un jour, ils auront raison. Pas aujourd’hui, je pense."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli esploratori vedono una grande ondata ogni settimana. Un giorno avranno ragione. Non oggi, sospetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "斥候は毎週のように大波を見ます。いつかは当たるでしょう。今日ではない、と存じます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os batedores veem uma grande onda toda semana. Um dia vão acertar. Não hoje, suspeito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "斥候每周都看见一场大浪。总有一天他们会说中。我猜，不是今天。"
          }
        }
      }
    },
    "petition.border_scouts.r1" : {
      "comment" : "Petition border_scouts: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zur Dämmerung starrt der Grund des Schlunds vor neuen Pfählen. Als die Welle kommt, ist sie dünner, als sie sein wollte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Throat’s floor bristles with new stakes by dusk. When the wave comes, it comes thinner than it meant to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al anochecer, el fondo de la Garganta está erizado de estacas nuevas. Cuando llega la oleada, llega más rala de lo que pretendía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au crépuscule, le fond de la Gorge est hérissé de pieux neufs. Quand la vague arrive, elle est plus mince qu’elle ne l’aurait voulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al crepuscolo il fondo della Gola è irto di pali nuovi. Quando l’ondata arriva, arriva più sottile di come voleva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日暮れには、喉谷の底に新しい杭が針山のように立つ。押し寄せた波は、もくろみよりずっと薄い。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao crepúsculo, o fundo da Garganta está eriçado de estacas novas. Quando a onda vem, vem mais rala do que pretendia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "黄昏时，喉谷底竖满了新尖桩。那一波攻势来时，比它原本打算的稀薄得多。"
          }
        }
      }
    },
    "petition.border_scouts.r2" : {
      "comment" : "Petition border_scouts: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Späher salutiert. In der Nacht tun die Mauern ihre Arbeit, wie Mauern es tun, und die Späher sorgen sich weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scout salutes. That night the walls do their work, as walls do, and the scouts go back to worrying."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El explorador saluda. Esa noche las murallas hacen su trabajo, como hacen las murallas, y los exploradores vuelven a preocuparse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’éclaireur salue. Cette nuit-là, les murailles font leur travail, comme le font les murailles, et les éclaireurs se remettent à s’inquiéter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’esploratore saluta. Quella notte le mura fanno il loro lavoro, come fanno le mura, e gli esploratori tornano a preoccuparsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "斥候は敬礼する。その夜、城壁は城壁らしく務めを果たし、斥候たちはまた心配に戻る。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O batedor saúda. Naquela noite, as muralhas fazem o seu trabalho, como fazem as muralhas, e os batedores voltam a se preocupar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "斥候敬了个礼。那一夜，城墙尽了城墙的本分，斥候们又接着发愁。"
          }
        }
      }
    },
    "petition.border_scouts.text" : {
      "comment" : "Petition border_scouts (soldier, endless only): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Herr|Herrin}, die Späher sagen, die Düsternis ballt sich heute Nacht tiefer als sonst, wie ein angehaltener Atem. Zwanzig Gold kaufen zusätzliche Pfähle und Pech für den Grund des Schlunds. Oder wir vertrauen den Mauern, wie immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My {lord|lady}, the scouts say the Gloom is massing deeper than usual tonight, like a held breath. Twenty gold would buy extra stakes and pitch for the Throat’s floor. Or we trust the walls, as we always have."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Señor|Señora}, los exploradores dicen que la Penumbra se agolpa esta noche más al fondo que de costumbre, como un aliento contenido. Veinte monedas de oro comprarían estacas y brea de más para el fondo de la Garganta. O confiamos en las murallas, como siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Monseigneur|Madame}, les éclaireurs disent que la Pénombre se masse plus en profondeur que d’habitude cette nuit, comme un souffle retenu. Vingt pièces d’or achèteraient des pieux et de la poix en plus pour le fond de la Gorge. Ou on se fie aux murailles, comme toujours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Signore|Signora}, gli esploratori dicono che stanotte la Penombra si ammassa più in profondità del solito, come un respiro trattenuto. Con venti monete d’oro si comprano pali e pece in più per il fondo della Gola. Oppure ci fidiamo delle mura, come sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主、斥候の話では、今夜の宵闇はいつもより奥で寄り集まっているそうです。息を詰めているみたいに。金貨20枚あれば、喉谷の底に杭と瀝青を足せます。でなければ、いつもどおり城壁を信じるか。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Senhor|Senhora}, os batedores dizem que a Penumbra se acumula mais fundo que de costume esta noite, como quem prende a respiração. Vinte moedas de ouro comprariam estacas extras e piche para o fundo da Garganta. Ou confiamos nas muralhas, como sempre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城主，斥候说今夜暗霭在深处聚得比平常更密，像憋着一口气。20金币能多买些尖桩和沥青，布在喉谷底。或者像往常一样，相信城墙。"
          }
        }
      }
    },
    "petition.calder_audit.c1" : {
      "comment" : "Petition calder_audit: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steht heute Nacht bei den Schützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stand with the archers tonight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quédese con los arqueros esta noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez avec les archers cette nuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanotte state con gli arcieri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜は弓兵と並んで立ってくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique com os arqueiros esta noite."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜和弓手站在一起。"
          }
        }
      }
    },
    "petition.calder_audit.c2" : {
      "comment" : "Petition calder_audit: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seht vom Bergfried aus zu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch from the keep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mire desde la torre del homenaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez depuis le donjon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardate dal mastio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主塔から見ていてくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assista da torre de menagem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在主堡里看。"
          }
        }
      }
    },
    "petition.calder_audit.c3" : {
      "comment" : "Petition calder_audit: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mauer ist kein Ort für Gäste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wall is no place for guests."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La muralla no es lugar para huéspedes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La muraille n’est pas faite pour les invités."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mura non sono un luogo per ospiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城壁は客の来る所ではない"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A muralha não é lugar para hóspedes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "城墙不是客人待的地方。"
          }
        }
      }
    },
    "petition.calder_audit.hint" : {
      "comment" : "Petition calder_audit: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie glaubt nur Büchern. Gebt ihr eine Nacht, die sich eintragen lässt. Bei den Schützen, {mein Herr|meine Herrin}, nicht hinter Glas."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She believes ledgers. Give her a night worth entering in one. With the archers, my {lord|lady}, not behind glass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ella cree en los libros de cuentas. Dele una noche digna de anotarse en uno. Con los arqueros, {mi señor|mi señora}, no tras un cristal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle croit les registres. Donnez-lui une nuit qui mérite d’y être inscrite. Avec les archers, {monseigneur|madame}, pas sous verre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lei crede ai libri dei conti. Datele una notte che valga la pena di registrare. Con gli arcieri, {mio signore|mia signora}, non dietro un vetro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あの人が信じるのは帳簿です。帳簿に書き込む値打ちのある夜を、お見せになることです。弓兵と並んで、城主様。窓越しではなく。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela acredita em livros-caixa. Dê a ela uma noite que mereça um lançamento. Com os arqueiros, {meu senhor|minha senhora}, não atrás de um vidro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她只信账簿。给她一个值得记进账里的夜晚。跟弓手站在一起，大人，别隔着玻璃。"
          }
        }
      }
    },
    "petition.calder_audit.r1" : {
      "comment" : "Petition calder_audit: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder fragt, wo sie stehen soll und welcher Haken ihrer ist. Brannock reicht ihr eine nummerierte Laterne. Die Nummer schreibt sie zuerst auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder asks where to stand and which hook is hers. Brannock hands her a numbered lantern. She writes the number down first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder pregunta dónde ponerse y qué gancho es el suyo. Brannock le entrega un farol numerado. Lo primero que anota es el número."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder demande où se tenir et quel crochet est le sien. Brannock lui tend une lanterne numérotée. Elle note d’abord le numéro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder chiede dove deve stare e quale gancio è il suo. Brannock le porge una lanterna numerata. Lei annota prima il numero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エッバ・コールダーは、どこに立てばよいか、どの鉤が自分のものかを尋ねる。ブラノックが番号つきのランタンを手渡す。彼女はまず、その番号を書き留める。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder pergunta onde deve ficar e qual gancho é o dela. Brannock lhe entrega uma lanterna numerada. Ela anota o número primeiro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "埃芭·考尔德问该站在哪里，哪个钩子归她。布兰诺克递给她一盏编号提灯。她先把号码记了下来。"
          }
        }
      }
    },
    "petition.calder_audit.r2" : {
      "comment" : "Petition calder_audit: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie dankt Euch genau so viel, wie ein Fenster verdient. Die ganze Nacht brennt ihre Kerze im Bergfried. Sie schreibt sehr wenig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She thanks you exactly as much as a window deserves. All night her candle burns in the keep. She writes very little."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le da las gracias exactamente lo que merece una ventana. Toda la noche arde su vela en la torre del homenaje. Escribe muy poco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle vous remercie exactement autant que le mérite une fenêtre. Toute la nuit, sa chandelle brûle dans le donjon. Elle écrit très peu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi ringrazia esattamente quanto merita una finestra. Per tutta la notte la sua candela arde nel mastio. Scrive pochissimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エッバは、窓一枚に見合うだけの礼をきっちり述べる。夜通し、主塔に彼女の蝋燭がともる。書いたものは、ごくわずかだ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela agradece exatamente o quanto uma janela merece. A noite inteira, a vela dela arde na torre de menagem. Ela escreve muito pouco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "她道谢的分寸，恰好配得上一扇窗户。她的蜡烛在主堡里燃了一夜。她写得很少。"
          }
        }
      }
    },
    "petition.calder_audit.r3" : {
      "comment" : "Petition calder_audit: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Dann schreibe ich, dass man es mir nicht gezeigt hat“, sagt sie ohne Groll und klappt ihr Buch zu. Es klingt leise und endgültig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Then I shall write that I was not shown,” she says, without heat, and closes her ledger. It makes a small, final sound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Entonces escribiré que no se me mostró», dice, sin enojo, y cierra su libro. Hace un ruido pequeño y definitivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Alors j’écrirai qu’on ne m’a rien montré », dit-elle sans colère, et elle ferme son registre. Cela fait un petit bruit définitif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Allora scriverò che non mi è stato mostrato», dice, senza astio, e chiude il suo libro. Fa un piccolo rumore definitivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「では、見せてもらえなかったと書きます」と、彼女は熱もなく言い、帳簿を閉じる。小さな、終わりの音がする。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Então vou escrever que não me mostraram”, diz ela, sem rancor, e fecha o livro-caixa. Faz um som pequeno e definitivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“那我就写：未予出示。”她说，语气平静，合上了账簿。那声音很轻，却不容更改。"
          }
        }
      }
    },
    "petition.calder_audit.text" : {
      "comment" : "Petition calder_audit (ebbaCalder, story days 12-13): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder, Prüferin aus Stillmere. Zehn Generationen der Seestädte haben Euren Lichtzehnt gezahlt und keinen Schatten gesehen, {Lord|Lady} Lantern. Die Syndizi zahlen erst wieder, wenn einer von uns einen sieht. Ich bitte um eine Nacht auf Eurer Mauer und schreibe auf, was ich sehe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder, auditor of Stillmere. Ten generations of lake towns have paid your Lamp Tithe and seen no shadow, {Lord|Lady} Lantern. The syndics voted to stop until one of us does. I ask to stand one night on your wall and write down what I see."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder, auditora de Stillmere. Diez generaciones de los pueblos del lago han pagado su Diezmo de la Luz sin ver una sombra, {lord|lady} Lantern. Los síndicos votaron no pagar más hasta que uno de nosotros la vea. Pido pasar una noche en su muralla y anotar lo que vea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder, contrôleuse de Stillmere. Dix générations des villes du lac ont payé votre Dîme de lumière sans voir une ombre, {seigneur|dame} Lantern. Les syndics ont voté de ne plus payer jusqu’à ce que l’un de nous en voie une. Je demande à passer une nuit sur votre muraille et à noter ce que je vois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder, revisora di Stillmere. Dieci generazioni delle città del lago hanno pagato la vostra Decima della Luce senza vedere un’ombra, {Lord|Lady} Lantern. I sindaci hanno votato per smettere finché uno di noi non ne vedrà una. Chiedo di passare una notte sulle vostre mura e annotare ciò che vedo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スティルミアの監査役、エッバ・コールダーです。湖の町々は十代にわたって灯火の貢ぎを納めてきましたが、影ひとつ見ていません、ランタン様。参事たちは、私たちの誰かが見るまで支払いを止めると決めました。ひと晩、城壁に立たせてください。見たものを書き留めます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebba Calder, auditora de Stillmere. Dez gerações das cidades do lago pagaram o seu Dízimo da Luz sem ver uma sombra, {Lorde|Lady} Lantern. Os síndicos votaram suspender o pagamento até que um de nós veja uma. Peço para passar uma noite na sua muralha e anotar o que eu vir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我是斯蒂尔米尔的审计官埃芭·考尔德。湖畔诸镇十代人缴纳您的灯火贡赋，却从没见过一个影子，兰腾大人。理事们已投票停缴，直到我们当中有人亲眼见到。我请求在您的城墙上站一夜，把看到的写下来。"
          }
        }
      }
    },
    "petition.captured_sootling.c1" : {
      "comment" : "Petition captured_sootling: choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht ihn"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put it out"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apáguenlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éteignez-le"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spegnetelo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消してくれ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaguem-no"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "熄了它"
          }
        }
      }
    },
    "petition.captured_sootling.c2" : {
      "comment" : "Petition captured_sootling: choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behaltet ihn zum Erforschen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it for study"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guárdenlo para estudiarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez-le pour l’étudier"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenetelo, per studiarlo"
          }
        },
        "ja" : {
