    "petition.barn_fire.c3" : {
      "comment" : "Petition barn_fire: choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schuld ist die Düsternis"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blame the Gloom"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La culpa es de la Penumbra"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est la faute de la Pénombre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La colpa è della Penombra"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宵闇のせいだ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
