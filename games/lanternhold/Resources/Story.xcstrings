    "petition.ludo_tourney.hint" : {
      "comment" : "Petition ludo_tourney: Odile's counsel.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwanzig Gold Preisgeld oder ein Nachmittag Bogenübung, den die Stadt Feiertag nennen wird. Bogenschießen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twenty gold of prize money, or an afternoon of archery practice the town will call a holiday. Archery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veinte monedas de oro de premio, o una tarde de práctica de tiro que el pueblo llamará fiesta. El tiro con arco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vingt pièces d’or de prix, ou un après-midi d’entraînement au tir que la ville appellera un jour de fête. Le tir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venti monete d’oro di premio, oppure un pomeriggio di tiro con l’arco che il borgo chiamerà festa. Il tiro con l’arco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "賞金に金貨20枚か、弓の稽古の午後か。町はどうせ祭りと呼びます。弓です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinte moedas de ouro de prêmio, ou uma tarde de treino de arco que a cidade vai chamar de feriado. Arco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20金币的奖金，或者一下午射箭练习，镇上会当它是节日。选射箭。"
          }
        }
      }
    },
    "petition.ludo_tourney.r1" : {
      "comment" : "Petition ludo_tourney: reaction to choice 1.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bogenschießen ist prächtig, das Lanzenstechen weniger. Ser Ludo wird von einer Milchkuh aus dem Sattel geworfen und nennt es seinen schönsten Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archery is splendid, the jousting worse. Ser Ludo is unhorsed by a milk cow and calls it his finest day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiro con arco es espléndido; las justas, no tanto. A Ser Ludo lo desmonta una vaca lechera, y él dice que es el mejor día de su vida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tir à l’arc est splendide, les joutes moins. Ser Ludo est désarçonné par une vache laitière et appelle cela son plus beau jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tiro con l’arco è splendido, la giostra meno. Ser Ludo viene disarcionato da una mucca da latte e la chiama la sua giornata più bella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弓比べは見事、槍試合はそれほどでもない。サー・ルドは乳牛に鞍から振り落とされ、生涯最高の日だと言う。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tiro com arco é esplêndido; a justa, nem tanto. Ser Ludo é derrubado do cavalo por uma vaca leiteira e diz que foi o seu melhor dia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "射箭很精彩，长枪比武就差些了。卢多爵士被一头奶牛掀下了马，却说那是他最光彩的一天。"
          }
        }
      }
    },
    "petition.ludo_tourney.r2" : {
      "comment" : "Petition ludo_tourney: reaction to choice 2.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eure Schützen schießen den ganzen Nachmittag auf Strohrußlinge. Ser Ludo gewinnt den Preis für die größte Begeisterung, eine Karotte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your archers shoot at straw sootlings all afternoon. Ser Ludo wins the prize for most enthusiasm, a carrot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus arqueros disparan toda la tarde a hollinejos de paja. Ser Ludo gana el premio al mayor entusiasmo: una zanahoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos archers tirent sur des fumerons de paille tout l’après-midi. Ser Ludo remporte le prix du plus grand enthousiasme : une carotte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I vostri arcieri tirano a fuligginelli di paglia per tutto il pomeriggio. Ser Ludo vince il premio per il maggior entusiasmo: una carota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "弓兵たちは午後いっぱい、藁の煤影を射る。サー・ルドは最も熱意ある者の賞を取る。人参一本だ。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus arqueiros atiram em fuliginhos de palha a tarde toda. Ser Ludo ganha o prêmio de maior entusiasmo: uma cenoura."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的弓手射了一下午稻草扎的煤影。卢多爵士赢得了“最热情奖”，奖品是一根胡萝卜。"
          }
        }
      }
    },
    "petition.ludo_tourney.r3" : {
      "comment" : "Petition ludo_tourney: reaction to choice 3.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo salutiert, geknickt. Er verbringt den Tag damit, seinen Schild zu polieren, der längst glänzt, und ihn anzuseufzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo salutes, crestfallen. He spends the day polishing his shield, which already gleams, and sighing at it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo saluda, cabizbajo. Se pasa el día puliendo su escudo, que ya reluce, y suspirándole."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo salue, l’oreille basse. Il passe la journée à polir son bouclier, qui brille déjà, et à soupirer devant lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo saluta, mogio. Passa la giornata a lucidare lo scudo, che già brilla, e a sospirarci sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サー・ルドはしょんぼりと敬礼する。その日は、もう十分に輝いている盾を磨き、それに向かってため息をついて過ごす。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser Ludo bate continência, cabisbaixo. Passa o dia polindo o escudo, que já reluz, e suspirando para ele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卢多爵士敬了个礼，垂头丧气。他花了一整天擦他那面本就锃亮的盾牌，一边擦一边对着它叹气。"
          }
        }
      }
    },
    "petition.ludo_tourney.text" : {
      "comment" : "Petition ludo_tourney (serLudo): the request.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Edler Herr|Edle Herrin}! Ein Tal in Gefahr braucht Mut, und Mut braucht ein Turnier! Lanzenstechen, Bogenschießen, ein Preis von zwanzig Gold. Gewinnen werde natürlich ich, aber die anderen müssen glauben, sie könnten es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good my {lord|lady}! A valley in danger needs courage, and courage needs a tournament! Jousting, archery, a prize of twenty gold. I shall win, naturally, but the others must believe they could."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡{Mi noble señor|Mi noble señora}! ¡Un valle en peligro necesita valor, y el valor necesita un torneo! Justas, tiro con arco, un premio de veinte monedas de oro. Ganaré yo, naturalmente, pero los demás deben creer que podrían ganar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mon bon seigneur|Ma bonne dame} ! Une vallée en danger a besoin de courage, et le courage a besoin d’un tournoi ! Joutes, tir à l’arc, un prix de vingt pièces d’or. Je gagnerai, naturellement, mais il faut que les autres croient qu’ils le pourraient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Mio nobile signore|Mia nobile signora}! Una valle in pericolo ha bisogno di coraggio, e il coraggio ha bisogno di un torneo! Giostra, tiro con l’arco, un premio di venti monete d’oro. Vincerò io, naturalmente, ma gli altri devono credere di poterci riuscire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気高き城主殿！　危機にある谷には勇気が要り、勇気には馬上試合が要るのですぞ！　槍試合に弓比べ、賞金は金貨20枚。勝つのはもちろんわたくしですが、ほかの者にも勝てると思わせねばなりません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{Meu nobre senhor|Minha nobre senhora}! Um vale em perigo precisa de coragem, e coragem precisa de um torneio! Justa, arco e flecha, um prêmio de vinte moedas de ouro. Vou vencer, naturalmente, mas os outros precisam acreditar que poderiam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尊贵的大人！危难中的河谷需要勇气，而勇气需要一场比武大会！马上长枪、射箭，奖金20金币。获胜的自然是本骑士，但得让别人相信他们也有机会。"
          }
        }
      }
    },
    "petition.marek_arrows.c1" : {
