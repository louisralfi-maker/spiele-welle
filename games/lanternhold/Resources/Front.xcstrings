{
  "sourceLanguage" : "en",
  "strings" : {
    "front.report.away" : {
      "comment" : "Dawn report, front half: there was real fighting, and the lord was rarely near it (teaches that being there counts). Short and dry.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorn brannte es. Ihr wart anderswo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It burned at the front. You were elsewhere."
          }
        }
      }
    },
    "front.report.relit" : {
      "comment" : "Dawn report, front half: dead braziers that caught again from the lord's lantern (as the lord passed them, or while the lord stood on their wall). Short and dry; no he or she in English.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Eine Feuerschale fing an Eurer Laterne Feuer."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Feuerschalen fingen an Eurer Laterne Feuer."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "One brazier caught from your lantern."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld braziers caught from your lantern."
                }
              }
            }
          }
        }
      }
    },
    "front.report.there" : {
      "comment" : "Dawn report, front half: the lord stood where the fighting was, and the harm the lord's presence kept off the defenders came to at least one soldier's life (docs/REALM.md 3). Shown only on such nights. Short and dry; no he or she in English.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr standet, wo es brannte. Eure Leute hielten länger stand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You stood where it burned. Your people held longer."
          }
        }
      }
    },
    "front.report.thrown" : {
      "comment" : "Dawn report, front half: how often a creature reached the lord and threw the lord back (the lord cannot die). Short and dry.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Die Düsternis warf Euch einmal zurück."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Die Düsternis warf Euch %lld-mal zurück."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The Gloom threw you back once."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The Gloom threw you back %lld times."
                }
              }
            }
          }
        }
      }
    }
  },
  "version" : "1.0"
}
